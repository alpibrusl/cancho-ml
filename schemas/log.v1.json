{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alpibrusl/cancho-ml/schemas/log.v1.json",
  "title": "log.v1",
  "description": "One record of the NDJSON log (--log): a closed object whose fields are counts, flags, rule tags and hashes. No record has a field that could hold a cell, a column name or a path.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "start"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "command": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "event",
        "seq",
        "command",
        "version"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "read"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "columns": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "event",
        "seq",
        "rows",
        "columns",
        "bytes"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "write"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "event",
        "seq",
        "bytes",
        "sha256"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "end"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "ok": {
          "type": "boolean"
        },
        "exit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "rule": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/rule"
            }
          ]
        }
      },
      "required": [
        "event",
        "seq",
        "ok",
        "exit",
        "rule"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "rule": {
      "enum": [
        "args.unknown-flag",
        "args.missing-value",
        "args.bad-value",
        "args.unexpected-value",
        "args.duplicate-flag",
        "args.conflict",
        "args.missing-operand",
        "args.required-flag",
        "args.too-many-operands",
        "args.unknown-command",
        "path.empty",
        "path.dotdot",
        "path.absolute",
        "path.outside-root",
        "path.too-long",
        "path.symlink",
        "path.bad-name",
        "io.not-found",
        "io.not-a-directory",
        "io.is-a-directory",
        "io.permission-denied",
        "io.read-failed",
        "io.write-failed",
        "conflict.exists",
        "limit.line-too-long",
        "limit.input-too-large",
        "limit.log-full",
        "ml.param.out-of-range",
        "ml.input.empty",
        "ml.input.too-many-rows",
        "ml.input.too-many-columns",
        "ml.input.too-many-cells",
        "ml.input.non-numeric",
        "ml.input.non-finite",
        "ml.input.duplicate-column",
        "ml.input.unknown-column",
        "parse.csv-ragged-row",
        "parse.csv-bad-quote",
        "parse.csv-unterminated-quote",
        "ml.label.single-class",
        "ml.label.not-binary",
        "ml.label.not-integer",
        "ml.metric.undefined",
        "ml.schema.mismatch",
        "ml.model.bad-magic",
        "ml.model.version",
        "ml.model.truncated",
        "ml.model.checksum",
        "ml.model.malformed",
        "ml.linalg.not-positive-definite",
        "ml.param.threads",
        "ml.fit.non-finite",
        "ml.predict.non-finite",
        "ml.split.empty-fold",
        "ml.split.stratify-target",
        "ml.split.stratum-too-small",
        "ml.split.too-few-groups",
        "ml.split.time-format",
        "ml.split.missing-cell",
        "ml.split.combination",
        "ml.split.out-of-range",
        "ml.split.column-target",
        "ml.split.emit-too-large",
        "ml.fit.all-missing",
        "ml.limit.categories",
        "ml.limit.string-bytes",
        "ml.limit.string-pool",
        "ml.limit.categorical-columns",
        "ml.input.invalid-utf8",
        "ml.input.categorical-not-encoded",
        "ml.input.unknown-category",
        "ml.plan.column-kind",
        "ml.input.reserved-category",
        "ml.model.string-table",
        "ml.limit.string-table",
        "ml.plan.syntax",
        "ml.plan.unknown-step",
        "ml.plan.unknown-key",
        "ml.plan.missing-key",
        "ml.plan.bad-value",
        "ml.plan.duplicate-key",
        "ml.plan.model-line",
        "ml.plan.unknown-column",
        "ml.limit.plan",
        "ml.input.missing-value",
        "ml.plan.model-not-built",
        "ml.limit.depth",
        "ml.limit.nodes",
        "ml.predict.out-of-range",
        "ml.predict.no-provenance",
        "ml.runs.conflict",
        "ml.runs.too-many",
        "ml.runs.record-too-large",
        "ml.runs.not-found",
        "ml.runs.unknown-model",
        "ml.runs.damaged",
        "ml.runs.data-changed",
        "ml.runs.model-differs",
        "ml.runs.not-replayable",
        "ml.jsonl.syntax",
        "ml.jsonl.not-object",
        "ml.jsonl.missing-field",
        "ml.jsonl.not-scalar",
        "ml.jsonl.duplicate-key",
        "ml.jsonl.type-mismatch",
        "ml.jsonl.mixed-kinds",
        "ml.jsonl.too-many-nodes"
      ]
    }
  }
}
