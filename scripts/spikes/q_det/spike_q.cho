// SPIKE Q (docs/spikes.md section 15): one Newton fit of logistic regression (spike S's algorithm, 6 iterations from w = 0 by
// default) with the 253 decisive sums of each step accumulated in one of three ways:
//
//     spike_q X.bin Y.bin N ARM THREADS ITERS MUT W0 OUT
//
//   ARM      0 = A, plain sequential floats, rows ascending (spike S's order)
//            1 = B, exact accumulators (facc.cho of cancho-table, vendored), any partition, merge by integer addition
//            2 = C, the fixed block tree of lib/linalg/order.cho (K = 256 rows, G = 8 blocks per chunk)
//            3 = N, reference only: the per-row terms with three terms added, no 253-sum accumulation (needs W0, no update)
//   THREADS  1..64 (B and C only; A and N run one thread). 1 = no spawn: the sequential code
//   ITERS    Newton iterations
//   MUT      0 = the real thing;  1 = the thread-order MUTANT of B / C (partials added in thread order);  2 = threads do no work
//            (copies, spawns and joins only: the overhead measurement; the result is meaningless)
//   W0       the 21 start weights as 336 hex digits (bits of the 21 floats, w[0..19] then the bias), or `-` for zeros
//   OUT      0 = nothing extra;  1 = also print the 253 raw sums of the first iteration (`#sum k hex`);
//            2 = as 1, and write the per-row terms of the first iteration (ntr x 253 float64, little endian) to stdout BEFORE the
//                text lines (arm B, one thread only; the terms are the ones added)
//
// stdout: 21 lines of 16 hex digits (final w[0..19], bias), `#loss k hex` per iteration (mean log-loss at the start of iteration
// k), `#sum` lines if asked, `#fit_ms`, `#load_ms`. Train = first N - N/5 rows. The 253 sums: g_a (a = 0..20) at index a,
// H_ab (b <= a) at 21 + a(a+1)/2 + b, the log-loss at 252. The loader is spike S's.
edition 5;

import std.buffer;
import std.io;
import std.math;
import std.vec;
import linalg.order;
import facc;

fn number_of[&s](text: &s [byte]) -> [] int {
    var n = 0;
    var i = 0;
    while i < len(text) {
        n = n * 10 + (int_of(text[i]) - '0');
        i = i + 1;
    }
    return n;
}

fn hex_digit(c: int) -> [] int {
    if c >= 'a' {
        return c - 'a' + 10;
    }
    return c - '0';
}

fn bits_from_hex[&s](text: &s [byte]) -> [] int {
    var v = 0;
    var i = 0;
    while i < len(text) {
        v = (v << 4) | hex_digit(int_of(text[i]));
        i = i + 1;
    }
    return v;
}

fn read_all[&h, &f](heap: &!h Heap, file: &!f File, text: buffer.Buffer) -> [heap, file_read] buffer.Buffer {
    var out = text;
    var chunk = buffer.empty(heap, 4194304);
    var going = true;
    while going {
        var got = 0;
        borrow mut chunk as &!cw in {
            buffer.clear(cw);
            match file_read(file, buffer.room(cw)) {
                Read::Got(n) => {
                    buffer.filled(cw, n);
                    got = n;
                }
                Read::End => {
                    going = false;
                }
                Read::Failed(reason) => {
                    going = false;
                }
            }
        }
        if got > 0 {
            borrow chunk as &cr in {
                out = buffer.append(heap, out, buffer.bytes(cr));
            }
        }
    }
    buffer.drop(heap, chunk);
    return out;
}

// the 8 bytes at `at`, little-endian, as an int (the bit pattern)
fn word[&s](src: &s [byte], at: int) -> [] int {
    var v = 0;
    var k = 7;
    while k >= 0 {
        v = (v << 8) | int_of(src[at + k]);
        k = k - 1;
    }
    return v;
}

// 2^(e - 1075) for e = 0..2046 (index 0 unused): the scale of a normal number's 53-bit significand. Every entry is
// exactly representable (2^-1074 .. 2^971) and math.ldexp is exact where the result is representable.
fn power_table[&h](heap: &!h Heap) -> [heap] Box[[float]] {
    let t = box_slice(heap, 2047, 0.0);
    borrow mut t as &!w in {
        let s = contents(w);
        var e = 1;
        while e < 2047 {
            s[e] = math.ldexp(1.0, e - 1075);
            e = e + 1;
        }
    }
    return t;
}

// Exact decode of the binary64 whose bits are `bits`. Inf and NaN answer NaN (the caller refuses it).
fn decode[&t](bits: int, table: &t [float]) -> [] float {
    let e = (bits >> 52) & 2047;
    let m = bits & 4503599627370495;
    var v = 0.0;
    if e == 2047 {
        return 0.0 / 0.0;
    }
    if e == 0 {
        // zero or subnormal: m * 2^-1074 (m < 2^52 is exact in a float; ldexp splits the scale in two exact halves)
        v = math.ldexp(float_of(m), 0 - 1074);
    } else {
        // (2^52 + m) < 2^53 is exact; times an exact power of two is exact (the result is a normal number)
        v = float_of(m + 4503599627370496) * table[e];
    }
    if bits < 0 {
        v = v * (0.0 - 1.0);
    }
    return v;
}

// decode count doubles from src into out; answers the number of values refused or not reproduced bit for bit
fn load[&s, &t, &o](src: &s [byte], table: &t [float], out: &!o [float], count: int) -> [] int {
    var bad = 0;
    var i = 0;
    while i < count {
        let bits = word(src, i * 8);
        let v = decode(bits, table);
        if v != v {
            bad = bad + 1;
        } else if bits_of(v) != bits {
            bad = bad + 1;
        }
        out[i] = v;
        i = i + 1;
    }
    return bad;
}

// Cholesky H = L L^T then L u = g, L^T d = u, every sum in ascending index order. Answers 1 if a pivot is not > 0.
fn newton_solve[&w](ws: &!w [float]) -> [] int {
    var i = 0;
    while i < 21 {
        var j = 0;
        while j <= i {
            var s = ws[42 + i * 21 + j];
            var k = 0;
            while k < j {
                s = s - ws[483 + i * 21 + k] * ws[483 + j * 21 + k];
                k = k + 1;
            }
            if i == j {
                if !(s > 0.0) {
                    return 1;
                }
                ws[483 + i * 21 + i] = sqrt(s);
            } else {
                ws[483 + i * 21 + j] = s / ws[483 + j * 21 + j];
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < 21 {
        var s = ws[21 + i];
        var k = 0;
        while k < i {
            s = s - ws[483 + i * 21 + k] * ws[924 + k];
            k = k + 1;
        }
        ws[924 + i] = s / ws[483 + i * 21 + i];
        i = i + 1;
    }
    i = 20;
    while i >= 0 {
        var s = ws[924 + i];
        var k = i + 1;
        while k < 21 {
            s = s - ws[483 + k * 21 + i] * ws[945 + k];
            k = k + 1;
        }
        ws[945 + i] = s / ws[483 + i * 21 + i];
        i = i - 1;
    }
    return 0;
}

fn exp_t[&t](x: float, tab: &t [float]) -> [] float {
    if x > 660.0 || x < 0.0 - 660.0 || x != x {
        return math.exp(x);
    }
    let kf = x * 1.44269504088896338700e+00;
    var h = 0.5;
    if kf < 0.0 {
        h = 0.0 - 0.5;
    }
    let k = truncate(kf + h);
    let n = float_of(k);
    let hi = x - n * 6.93147180369123816490e-01;
    let lo = n * 1.90821492927058770002e-10;
    let r = hi - lo;
    let t = r * r;
    let c = r - t * (1.66666666666666019037e-01 + t * (-2.77777777770155933842e-03 + t * (6.61375632143793436117e-05 + t * (-1.65339022054652515390e-06 + t * 4.13813679705723846039e-08))));
    let y = 1.0 - (lo - r * c / (2.0 - c) - hi);
    return y * tab[k + 1075];
}
// ---------------------------------------------------------------------------------------------------------------
// The per-row terms and the three ways to add them. W = 253 sums per step; the state of B is 253 x 73 = 18,469 integers.

fn copy_floats[&d, &s](dst: &!d [float], src: &s [float], n: int) -> [] int {
    let o = dst[0..n];
    let i = src[0..n];
    var k = 0;
    while k < n {
        o[k] = i[k];
        k = k + 1;
    }
    return 0;
}

// Rows [r0, r1) (local indices into xs / ys) added into acc[0..253] by plain floats, rows ascending, each sum's own order.
// rb holds the row with 1.0 in slot 20 (set by the caller). This is spike S's pass (newton_pass) with exp_t for exp and the loss.
fn rows_float[&x, &y, &w, &t, &a, &q](xs: &x [float], ys: &y [float], r0: int, r1: int, wv: &w [float], tab: &t [float], acc: &!a [float], rb: &!q [float]) -> [] int {
    var i = r0;
    while i < r1 {
        let row = xs[i * 20..i * 20 + 20];
        var z = wv[20];
        var j = 0;
        while j < 20 {
            let v = row[j];
            rb[j] = v;
            z = z + v * wv[j];
            j = j + 1;
        }
        let ez = exp_t(0.0 - z, tab);
        let p = 1.0 / (1.0 + ez);
        var e = ez;
        var pos = z;
        if z < 0.0 {
            e = exp_t(z, tab);
            pos = 0.0;
        }
        let yi = ys[i];
        let loss = (pos + math.log1p(e)) - yi * z;
        let rr = p - yi;
        let s = p * (1.0 - p);
        acc[252] = acc[252] + loss;
        var a = 0;
        while a < 21 {
            let xa = rb[a];
            acc[a] = acc[a] + rr * xa;
            let t2 = s * xa;
            let lo = 21 + a * (a + 1) / 2;
            let hrow = acc[lo..lo + a + 1];
            let rs = rb[0..a + 1];
            var b = 0;
            while b <= a {
                hrow[b] = hrow[b] + t2 * rs[b];
                b = b + 1;
            }
            a = a + 1;
        }
        i = i + 1;
    }
    return 0;
}

// The same terms (the same expressions) into the exact accumulators: sum k is accumulator k, at k * 73. When dumpon != 0 the
// terms are also stored in dmp[i * 253 + k] (a predictable branch outside the accumulator calls).
fn rows_exact[&x, &y, &w, &t, &a, &q, &d](xs: &x [float], ys: &y [float], r0: int, r1: int, wv: &w [float], tab: &t [float], av: &!a vec.Vec[int], rb: &!q [float], dmp: &!d [float], dumpon: int) -> [] int {
    var i = r0;
    while i < r1 {
        let row = xs[i * 20..i * 20 + 20];
        var z = wv[20];
        var j = 0;
        while j < 20 {
            let v = row[j];
            rb[j] = v;
            z = z + v * wv[j];
            j = j + 1;
        }
        let ez = exp_t(0.0 - z, tab);
        let p = 1.0 / (1.0 + ez);
        var e = ez;
        var pos = z;
        if z < 0.0 {
            e = exp_t(z, tab);
            pos = 0.0;
        }
        let yi = ys[i];
        let loss = (pos + math.log1p(e)) - yi * z;
        let rr = p - yi;
        let s = p * (1.0 - p);
        facc.add_bits(av, 252 * 73, bits_of(loss));
        if dumpon != 0 {
            dmp[i * 253 + 252] = loss;
        }
        var a = 0;
        while a < 21 {
            let xa = rb[a];
            let tg = rr * xa;
            facc.add_bits(av, a * 73, bits_of(tg));
            if dumpon != 0 {
                dmp[i * 253 + a] = tg;
            }
            let t2 = s * xa;
            let lo = 21 + a * (a + 1) / 2;
            let rs = rb[0..a + 1];
            var b = 0;
            while b <= a {
                let th = t2 * rs[b];
                facc.add_bits(av, (lo + b) * 73, bits_of(th));
                if dumpon != 0 {
                    dmp[i * 253 + lo + b] = th;
                }
                b = b + 1;
            }
            a = a + 1;
        }
        i = i + 1;
    }
    return 0;
}

// arm N: the terms, three of them added (no accumulation of the 253 sums)
fn rows_null[&x, &y, &w, &t, &a, &q](xs: &x [float], ys: &y [float], r0: int, r1: int, wv: &w [float], tab: &t [float], acc: &!a [float], rb: &!q [float]) -> [] int {
    var i = r0;
    while i < r1 {
        let row = xs[i * 20..i * 20 + 20];
        var z = wv[20];
        var j = 0;
        while j < 20 {
            let v = row[j];
            rb[j] = v;
            z = z + v * wv[j];
            j = j + 1;
        }
        let ez = exp_t(0.0 - z, tab);
        let p = 1.0 / (1.0 + ez);
        var e = ez;
        var pos = z;
        if z < 0.0 {
            e = exp_t(z, tab);
            pos = 0.0;
        }
        let yi = ys[i];
        let loss = (pos + math.log1p(e)) - yi * z;
        acc[0] = acc[0] + (p - yi);
        acc[1] = acc[1] + p * (1.0 - p);
        acc[252] = acc[252] + loss;
        i = i + 1;
    }
    return 0;
}

// the exact sum k, rounded once, as a double (key -> bits as in cancho-table's flt.cho, bits -> double by spike S's exact decode)
fn fin[&v, &t](av: &!v vec.Vec[int], at: int, tab: &t [float]) -> [] float {
    let (key, over) = facc.finalize_key(av, at);
    var bits = key;
    if key < 0 {
        bits = key ^ 0x7fffffffffffffff;
    }
    return decode(bits, tab);
}

// Blocks [b0, b1) of the local rows 0..rows pushed on the stack (st/lv, width 253) from slot sp0, each block summed ascending from +0.0.
fn c_blocks[&x, &y, &w, &t, &s, &l, &q](xs: &x [float], ys: &y [float], rows: int, b0: int, b1: int, wv: &w [float], tab: &t [float], st: &!s [float], lv: &!l [int], sp0: int, rb: &!q [float]) -> [] int {
    var sp = sp0;
    var b = b0;
    while b < b1 {
        var hi = (b + 1) * 256;
        if hi > rows {
            hi = rows;
        }
        let slot = st[sp * 253..sp * 253 + 253];
        var j = 0;
        while j < 253 {
            slot[j] = 0.0;
            j = j + 1;
        }
        rows_float(xs, ys, b * 256, hi, wv, tab, slot, rb);
        sp = order.settle(st, lv, sp, 253);
        b = b + 1;
    }
    return sp;
}

// ---------------------------------------------------------------------------------------------------------------
// Threads (the pattern of lib/linalg/par.cho): a thread owns copies of its rows, made per Newton iteration, in the timed region.

res struct Job {
    jxs: Box[[float]],
    jys: Box[[float]],
    jwv: Box[[float]],
    jtab: Box[[float]],
    jrb: Box[[float]],
    jout: Box[[float]],
    jst: Box[[float]],
    jlv: Box[[int]],
    jdm: Box[[float]],
    jacc: vec.Vec[int],
    jp: Box[[int]],
}

// p: 0 kind (1 = B, 2 = C), 1 rows of the piece, 2 chunks in the piece, 3 mut
fn work[&r](job: &!r Job) -> [] int {
    let kind = contents(job.jp)[0];
    let rows = contents(job.jp)[1];
    let nch = contents(job.jp)[2];
    let mt = contents(job.jp)[3];
    if mt == 2 {
        return 0;
    }
    if kind == 2 {
        let nb = order.blocks(rows);
        var c = 0;
        while c < nch {
            var b1 = c * 8 + 8;
            if b1 > nb {
                b1 = nb;
            }
            let sp = c_blocks(contents(job.jxs), contents(job.jys), rows, c * 8, b1, contents(job.jwv), contents(job.jtab), contents(job.jst), contents(job.jlv), 0, contents(job.jrb));
            order.finish(contents(job.jst), sp, 253);
            copy_floats(contents(job.jout)[c * 253..c * 253 + 253], contents(job.jst), 253);
            c = c + 1;
        }
        if mt == 1 {
            // MUTANT: the thread's own chunk roots are folded into ONE partial of the thread (out[0..253]); the parent adds the threads' partials in thread order
            var sp2 = 0;
            c = 0;
            while c < nch {
                sp2 = order.settle_root(contents(job.jst), contents(job.jlv), sp2, 253, contents(job.jout), c * 253, 3);
                c = c + 1;
            }
            order.finish(contents(job.jst), sp2, 253);
            copy_floats(contents(job.jout), contents(job.jst), 253);
        }
        return 0;
    }
    // kind 1: exact accumulators
    var k = 0;
    while k < 18469 {
        vec.set(job.jacc, k, 0);
        k = k + 1;
    }
    rows_exact(contents(job.jxs), contents(job.jys), 0, rows, contents(job.jwv), contents(job.jtab), job.jacc, contents(job.jrb), contents(job.jdm), 0);
    k = 0;
    while k < 253 {
        facc.normalize(job.jacc, k * 73);
        k = k + 1;
    }
    if mt == 1 {
        // MUTANT: each thread rounds its own sums to doubles (the exact merge is given up)
        k = 0;
        while k < 253 {
            contents(job.jout)[k] = fin(job.jacc, k * 73, contents(job.jtab));
            k = k + 1;
        }
    }
    return 0;
}

pub fn bound(k: int, t: int, nchunks: int) -> [] int {
    return k * nchunks / t;
}

fn fan[&h, &x, &y, &w, &t, &o, &q](heap: &!h Heap, kind: int, mt: int, xs: &x [float], ys: &y [float], wv: &w [float], tab: &t [float], ntr: int, nchunks: int, k: int, tt: int, so_f: &!o [float], so_i: &!q [int]) -> [heap, conc] int {
    if k >= tt {
        return 0;
    }
    let c0 = bound(k, tt, nchunks);
    let c1 = bound(k + 1, tt, nchunks);
    let r0 = c0 * 2048;
    var r1 = c1 * 2048;
    if r1 > ntr {
        r1 = ntr;
    }
    let rows = r1 - r0;
    var outn = 253 + 8;
    var stn = 8;
    var accn = 1;
    if kind == 2 {
        outn = (c1 - c0) * 253 + 253;
        stn = 40 * 253 + 8;
    } else {
        accn = 18469;
    }
    var job = Job { jxs: box_slice(heap, rows * 20 + 1, 0.0), jys: box_slice(heap, rows + 1, 0.0), jwv: box_slice(heap, 21, 0.0), jtab: box_slice(heap, 2047, 0.0), jrb: box_slice(heap, 21, 1.0), jout: box_slice(heap, outn, 0.0), jst: box_slice(heap, stn, 0.0), jlv: box_slice(heap, 41, 0), jdm: box_slice(heap, 1, 0.0), jacc: vec.empty(heap, accn, 0), jp: box_slice(heap, 8, 0) };
    borrow mut job as &!jk in {
        contents(jk.jp)[0] = kind;
        contents(jk.jp)[1] = rows;
        contents(jk.jp)[2] = c1 - c0;
        contents(jk.jp)[3] = mt;
        copy_floats(contents(jk.jxs), xs[r0 * 20..r1 * 20], rows * 20);
        copy_floats(contents(jk.jys), ys[r0..r1], rows);
        copy_floats(contents(jk.jwv), wv[0..21], 21);
        copy_floats(contents(jk.jtab), tab[0..2047], 2047);
    }
    var rest = 0;
    borrow mut job as &!jk in {
        let body = work;
        let th = spawn(jk, body);
        rest = fan(heap, kind, mt, xs, ys, wv, tab, ntr, nchunks, k + 1, tt, so_f, so_i);
        join(th);
    }
    let Job { jxs, jys, jwv, jtab, jrb, jout, jst, jlv, jdm, jacc, jp } = job;
    borrow jout as &ow in {
        if kind == 2 && mt != 1 {
            copy_floats(so_f[c0 * 253..c1 * 253], contents(ow), (c1 - c0) * 253);
        } else if mt == 1 || (kind == 1 && mt == 1) {
            copy_floats(so_f[k * 253..k * 253 + 253], contents(ow), 253);
        }
    }
    if kind == 1 && mt != 1 {
        borrow jacc as &av in {
            var i = 0;
            while i < 18469 {
                so_i[k * 18469 + i] = vec.get(av, i);
                i = i + 1;
            }
        }
    }
    unbox_slice(heap, jxs);
    unbox_slice(heap, jys);
    unbox_slice(heap, jwv);
    unbox_slice(heap, jtab);
    unbox_slice(heap, jrb);
    unbox_slice(heap, jout);
    unbox_slice(heap, jst);
    unbox_slice(heap, jlv);
    unbox_slice(heap, jdm);
    vec.drop(heap, jacc);
    unbox_slice(heap, jp);
    return rest;
}

// ---------------------------------------------------------------------------------------------------------------
// One step from the sums to the update: g and H (lower, square storage) from the means, Cholesky, w = w - d. Answers 1 if a pivot fails.
fn step_update[&s, &w](sums: &s [float], nf: float, ws: &!w [float]) -> [] int {
    var j = 0;
    while j < 21 {
        ws[21 + j] = sums[j] / nf;
        j = j + 1;
    }
    j = 0;
    while j < 441 {
        ws[42 + j] = 0.0;
        j = j + 1;
    }
    var a = 0;
    while a < 21 {
        var b = 0;
        while b <= a {
            ws[42 + a * 21 + b] = sums[21 + a * (a + 1) / 2 + b] / nf;
            b = b + 1;
        }
        a = a + 1;
    }
    if newton_solve(ws) != 0 {
        return 1;
    }
    j = 0;
    while j < 21 {
        ws[j] = ws[j] - ws[945 + j];
        j = j + 1;
    }
    return 0;
}

// The fit. ws: w 0, g 21, H 42, L 483, u 924, d 945 (spike S's workspace). losses[k]: mean log-loss at the start of iteration k.
// sum0: the 253 raw sums of iteration 0. dmp: the per-row terms of iteration 0 when dumpon != 0 (arm B, one thread).
fn fit[&h, &x, &y, &w, &l, &o, &d, &t](heap: &!h Heap, arm: int, tt: int, mt: int, xs: &x [float], ys: &y [float], ntr: int, iters: int, tab: &t [float], ws: &!w [float], losses: &!l [float], sum0: &!o [float], dmp: &!d [float], dumpon: int) -> [heap, conc] int {
    let nf = float_of(ntr);
    let nchunks = (order.blocks(ntr) + 7) / 8;
    var te = tt;
    if te > nchunks {
        te = nchunks;
    }
    let sums = box_slice(heap, 253, 0.0);
    let wv = box_slice(heap, 21, 0.0);
    let rb = box_slice(heap, 21, 1.0);
    let st = box_slice(heap, 40 * 253 + 8, 0.0);
    let lv = box_slice(heap, 41, 0);
    let sof = box_slice(heap, nchunks * 253 + 253, 0.0);
    let soi = box_slice(heap, te * 18469 + 1, 0);
    var av = vec.empty(heap, 18469, 0);
    var tot = vec.empty(heap, 18469, 0);
    var failed = 0;
    borrow mut sums as &!sw in {
    borrow mut wv as &!wvw in {
    borrow mut rb as &!rbw in {
    borrow mut st as &!stw in {
    borrow mut lv as &!lvw in {
    borrow mut sof as &!sofw in {
    borrow mut soi as &!soiw in {
    borrow mut av as &!avw in {
    borrow mut tot as &!totw in {
        let s = contents(sw);
        let wvs = contents(wvw);
        let rbs = contents(rbw);
        var it = 0;
        while it < iters && failed == 0 {
            var j = 0;
            while j < 21 {
                wvs[j] = ws[j];
                j = j + 1;
            }
            if arm == 0 || arm == 3 || tt == 1 {
                if arm == 1 {
                    j = 0;
                    while j < 18469 {
                        vec.set(avw, j, 0);
                        j = j + 1;
                    }
                    var dflag = 0;
                    if it == 0 {
                        dflag = dumpon;
                    }
                    rows_exact(xs, ys, 0, ntr, wvs, tab, avw, rbs, dmp, dflag);
                    j = 0;
                    while j < 253 {
                        s[j] = fin(avw, j * 73, tab);
                        j = j + 1;
                    }
                } else if arm == 2 {
                    let sp = c_blocks(xs, ys, ntr, 0, order.blocks(ntr), wvs, tab, contents(stw), contents(lvw), 0, rbs);
                    order.finish(contents(stw), sp, 253);
                    copy_floats(s, contents(stw), 253);
                } else {
                    j = 0;
                    while j < 253 {
                        s[j] = 0.0;
                        j = j + 1;
                    }
                    if arm == 0 {
                        rows_float(xs, ys, 0, ntr, wvs, tab, s, rbs);
                    } else {
                        rows_null(xs, ys, 0, ntr, wvs, tab, s, rbs);
                    }
                }
            } else {
                // arm 1 or 2 on tt > 1 threads
                fan(heap, arm, mt, xs, ys, wvs, tab, ntr, nchunks, 0, te, contents(sofw), contents(soiw));
                if arm == 2 {
                    if mt == 1 {
                        var k = 0;
                        while k < 253 {
                            var acc = contents(sofw)[k];
                            var th = 1;
                            while th < te {
                                acc = acc + contents(sofw)[th * 253 + k];
                                th = th + 1;
                            }
                            s[k] = acc;
                            k = k + 1;
                        }
                    } else {
                        var sp = 0;
                        var c = 0;
                        while c < nchunks {
                            sp = order.settle_root(contents(stw), contents(lvw), sp, 253, contents(sofw), c * 253, 3);
                            c = c + 1;
                        }
                        order.finish(contents(stw), sp, 253);
                        copy_floats(s, contents(stw), 253);
                    }
                } else {
                    if mt == 1 {
                        var k = 0;
                        while k < 253 {
                            var acc = contents(sofw)[k];
                            var th = 1;
                            while th < te {
                                acc = acc + contents(sofw)[th * 253 + k];
                                th = th + 1;
                            }
                            s[k] = acc;
                            k = k + 1;
                        }
                    } else {
                        // exact merge: limb-wise integer addition of the normalised accumulators, then one rounding per sum
                        var i = 0;
                        while i < 18469 {
                            var v = 0;
                            var th = 0;
                            while th < te {
                                v = v + contents(soiw)[th * 18469 + i];
                                th = th + 1;
                            }
                            vec.set(totw, i, v);
                            i = i + 1;
                        }
                        var k = 0;
                        while k < 253 {
                            vec.set(totw, k * 73 + 72, 0);
                            s[k] = fin(totw, k * 73, tab);
                            k = k + 1;
                        }
                    }
                }
            }
            if it == 0 {
                copy_floats(sum0, s, 253);
            }
            losses[it] = s[252] / nf;
            if arm != 3 && mt != 2 {
                failed = step_update(s, nf, ws);
            }
            it = it + 1;
        }
    }
    }
    }
    }
    }
    }
    }
    }
    }
    unbox_slice(heap, sums);
    unbox_slice(heap, wv);
    unbox_slice(heap, rb);
    unbox_slice(heap, st);
    unbox_slice(heap, lv);
    unbox_slice(heap, sof);
    unbox_slice(heap, soi);
    vec.drop(heap, av);
    vec.drop(heap, tot);
    return failed;
}

fn hex_line[&i, &l](io: &!i Io, line: &!l [byte], bits: int) -> [io_write] int {
    var k = 0;
    while k < 16 {
        let nib = (bits >> (60 - 4 * k)) & 15;
        if nib < 10 {
            line[k] = byte_of('0' + nib);
        } else {
            line[k] = byte_of('a' + nib - 10);
        }
        k = k + 1;
    }
    line[16] = byte_of(10);
    io.write_all(io, line);
    return 0;
}


// 8 bytes, little endian, of each of count floats of src starting at 0, to stdout (the term dump)
fn dump_floats[&i, &s, &b](io: &!i Io, src: &s [float], count: int, buf: &!b [byte]) -> [io_write] int {
    var done = 0;
    while done < count {
        var m = count - done;
        if m > 4096 {
            m = 4096;
        }
        var k = 0;
        while k < m {
            let bits = bits_of(src[done + k]);
            var q = 0;
            while q < 8 {
                buf[k * 8 + q] = byte_of((bits >> (8 * q)) & 255);
                q = q + 1;
            }
            k = k + 1;
        }
        io.write_all(io, buf[0..m * 8]);
        done = done + m;
    }
    return 0;
}

fn main(world: World) -> [conc] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(ffi);
    release(net);
    var n = 0;
    var arm = 0;
    var tt = 1;
    var iters = 0;
    var mt = 0;
    var outm = 0;
    var havew0 = false;
    var t0 = 0;
    var t1 = 0;
    var t2 = 0;
    var bad = 0;
    var failed = 0;
    borrow args as &g in {
        n = number_of(arg(g, 3));
        arm = number_of(arg(g, 4));
        tt = number_of(arg(g, 5));
        iters = number_of(arg(g, 6));
        mt = number_of(arg(g, 7));
        outm = number_of(arg(g, 9));
    }
    borrow clock as &k in {
        t0 = clock_ms(k);
    }
    borrow mut heap as &!hp in {
        let w0 = box_slice(hp, 21, 0.0);
        var xbytes = buffer.empty(hp, 1048576);
        var ybytes = buffer.empty(hp, 1048576);
        borrow fs as &f in {
            borrow args as &g in {
                match open_read(f, arg(g, 1)) {
                    Opened::Ok(file) => {
                        var fl = file;
                        borrow mut fl as &!fw in {
                            xbytes = read_all(hp, fw, xbytes);
                        }
                        file_close(fl);
                    }
                    Opened::Failed(reason) => {
                    }
                }
                match open_read(f, arg(g, 2)) {
                    Opened::Ok(file) => {
                        var fl = file;
                        borrow mut fl as &!fw in {
                            ybytes = read_all(hp, fw, ybytes);
                        }
                        file_close(fl);
                    }
                    Opened::Failed(reason) => {
                    }
                }
                if len(arg(g, 8)) == 336 {
                    havew0 = true;
                }
            }
        }
        borrow mut io as &!i in {
            let table = power_table(hp);
            let xs = box_slice(hp, n * 20, 0.0);
            let ys = box_slice(hp, n, 0.0);
            let ntr = n - n / 5;
            let ws = box_slice(hp, 1000, 0.0);
            let losses = box_slice(hp, iters + 1, 0.0);
            let sum0 = box_slice(hp, 253, 0.0);
            var dn = 1;
            if outm == 2 {
                dn = ntr * 253 + 1;
            }
            let dmp = box_slice(hp, dn, 0.0);
            let line = box_slice(hp, 17, byte_of(10));
            let dbuf = box_slice(hp, 4096 * 8, byte_of(0));
            borrow table as &tr in {
                let tab = contents(tr);
                borrow xbytes as &xb in {
                    borrow mut xs as &!xw in {
                        bad = bad + load(buffer.bytes(xb), tab, contents(xw), n * 20);
                    }
                }
                borrow ybytes as &yb in {
                    borrow mut ys as &!yw in {
                        bad = bad + load(buffer.bytes(yb), tab, contents(yw), n);
                    }
                }
                if havew0 {
                    // the start weights: decoded again with the real table (the dummy above left bits only)
                    borrow args as &g in {
                        let hex = arg(g, 8);
                        borrow mut w0 as &!w0w in {
                            let w0s = contents(w0w);
                            var k = 0;
                            while k < 21 {
                                w0s[k] = decode(bits_from_hex(hex[k * 16..k * 16 + 16]), tab);
                                k = k + 1;
                            }
                        }
                    }
                }
            }
            borrow clock as &k in {
                t1 = clock_ms(k);
            }
            var sx = 0;
            var sy = 0;
            borrow xbytes as &xb in {
                sx = len(buffer.bytes(xb));
            }
            borrow ybytes as &yb in {
                sy = len(buffer.bytes(yb));
            }
            if bad == 0 && sy == n * 8 && sx == n * 160 {
                borrow mut ws as &!ww in {
                    if havew0 {
                        borrow w0 as &w0r in {
                            copy_floats(contents(ww), contents(w0r), 21);
                        }
                    }
                }
                borrow xs as &xr in {
                    borrow ys as &yr in {
                        borrow table as &tr in {
                            borrow mut ws as &!ww in {
                                borrow mut losses as &!lw in {
                                    borrow mut sum0 as &!s0w in {
                                        borrow mut dmp as &!dw in {
                                            var dflag = 0;
                                            if outm == 2 {
                                                dflag = 1;
                                            }
                                            failed = fit(hp, arm, tt, mt, contents(xr), contents(yr), ntr, iters, contents(tr), contents(ww), contents(lw), contents(s0w), contents(dw), dflag);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                borrow clock as &k in {
                    t2 = clock_ms(k);
                }
                if outm == 2 {
                    borrow dmp as &dr in {
                        borrow mut dbuf as &!bw in {
                            dump_floats(i, contents(dr), ntr * 253, contents(bw));
                        }
                    }
                }
                borrow ws as &wr in {
                    let s = contents(wr);
                    borrow mut line as &!lw in {
                        var j = 0;
                        while j < 21 {
                            hex_line(i, contents(lw), bits_of(s[j]));
                            j = j + 1;
                        }
                    }
                }
                borrow losses as &lr in {
                    let ls = contents(lr);
                    borrow mut line as &!lw in {
                        var j = 0;
                        while j < iters {
                            io.write_all(i, "#loss ");
                            hex_line(i, contents(lw), bits_of(ls[j]));
                            j = j + 1;
                        }
                    }
                }
                if outm >= 1 {
                    borrow sum0 as &sr in {
                        let ss = contents(sr);
                        borrow mut line as &!lw in {
                            var j = 0;
                            while j < 253 {
                                io.write_all(i, "#sum ");
                                hex_line(i, contents(lw), bits_of(ss[j]));
                                j = j + 1;
                            }
                        }
                    }
                }
                io.write_all(i, "#fit_ms ");
                io.print_int(i, t2 - t1);
                io.newline(i);
                io.write_all(i, "#load_ms ");
                io.print_int(i, t1 - t0);
                io.newline(i);
                if failed != 0 {
                    io.write_all(i, "#error: solver.not_positive_definite");
                    io.newline(i);
                }
            } else {
                io.write_all(i, "#error: bad values or wrong file size, bad=");
                io.print_int(i, bad);
                io.newline(i);
            }
            unbox_slice(hp, table);
            unbox_slice(hp, xs);
            unbox_slice(hp, ys);
            unbox_slice(hp, ws);
            unbox_slice(hp, losses);
            unbox_slice(hp, sum0);
            unbox_slice(hp, dmp);
            unbox_slice(hp, line);
            unbox_slice(hp, dbuf);
        }
        buffer.drop(hp, xbytes);
        buffer.drop(hp, ybytes);
        unbox_slice(hp, w0);
    }
    release(args);
    release(fs);
    release(clock);
    release(heap);
    release(io);
    return 0;
}
