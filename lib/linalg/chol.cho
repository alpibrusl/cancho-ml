module linalg.chol;

import linalg.tensor;
import ml.refuse;

// Cholesky A = L L^T and the two triangular solves (docs/linalg.md section 2.1). Only the lower triangle of A is read and only
// the lower triangle of L is written. Every sum is ONE running value in ascending k (no blocks; a recurrence, not a free
// reduction):
//   L_jj = sqrt(A_jj - L_j0 L_j0 - L_j1 L_j1 - ...)      refused (ml.linalg.not-positive-definite) unless the value is > 0.0
//   L_ij = (A_ij - L_i0 L_j0 - L_i1 L_j1 - ...) / L_jj    for i > j, terms for k = 0..j-1
//   forward  L x = b:   x_i = (b_i - L_i0 x_0 - ... - L_i,i-1 x_i-1) / L_ii               k ascending
//   backward L^T x = b: x_i = (b_i - L_d-1,i x_d-1 - ... - L_i+1,i x_i+1) / L_ii          k DESCENDING (corrected from the
//     first draft of the document: ascending k makes each row's first term the x just computed, one serial chain for the
//     whole solve; descending k lets four columns be summed together)
// The speed comes from independent chains: a column of L is computed 8 rows at a time (the diagonal chain rides with them),
// a solve 4 rows (forward) or 4 columns (backward) at a time; each entry's own additions keep the order above.

// the diagonal and eight rows below it for column j, fast path: `lv` is L (positioned at L[0][0], row stride ls), `av` is A
// (positioned at A[0][0], row stride as_). Rows i0 .. i0 + 8 (all < d). Writes L[i][j] for the 8 rows; answers the diagonal
// sum s_jj in the value of `diag_sum` (via the returned float): s_jj is computed separately by the caller for j.
fn rows8[&l, &a](lv: &!l [float], ls: int, av: &a [float], as_: int, j: int, i0: int, ljj: float) -> [] int {
    let rj = lv[j * ls..j * ls + j];
    let r0 = lv[(i0 + 0) * ls..(i0 + 0) * ls + j];
    let r1 = lv[(i0 + 1) * ls..(i0 + 1) * ls + j];
    let r2 = lv[(i0 + 2) * ls..(i0 + 2) * ls + j];
    let r3 = lv[(i0 + 3) * ls..(i0 + 3) * ls + j];
    let r4 = lv[(i0 + 4) * ls..(i0 + 4) * ls + j];
    let r5 = lv[(i0 + 5) * ls..(i0 + 5) * ls + j];
    let r6 = lv[(i0 + 6) * ls..(i0 + 6) * ls + j];
    let r7 = lv[(i0 + 7) * ls..(i0 + 7) * ls + j];
    var s0 = av[(i0 + 0) * as_ + j];
    var s1 = av[(i0 + 1) * as_ + j];
    var s2 = av[(i0 + 2) * as_ + j];
    var s3 = av[(i0 + 3) * as_ + j];
    var s4 = av[(i0 + 4) * as_ + j];
    var s5 = av[(i0 + 5) * as_ + j];
    var s6 = av[(i0 + 6) * as_ + j];
    var s7 = av[(i0 + 7) * as_ + j];
    var k = 0;
    while k < j {
        let c = rj[k];
        s0 = s0 - r0[k] * c;
        s1 = s1 - r1[k] * c;
        s2 = s2 - r2[k] * c;
        s3 = s3 - r3[k] * c;
        s4 = s4 - r4[k] * c;
        s5 = s5 - r5[k] * c;
        s6 = s6 - r6[k] * c;
        s7 = s7 - r7[k] * c;
        k = k + 1;
    }
    lv[(i0 + 0) * ls + j] = s0 / ljj;
    lv[(i0 + 1) * ls + j] = s1 / ljj;
    lv[(i0 + 2) * ls + j] = s2 / ljj;
    lv[(i0 + 3) * ls + j] = s3 / ljj;
    lv[(i0 + 4) * ls + j] = s4 / ljj;
    lv[(i0 + 5) * ls + j] = s5 / ljj;
    lv[(i0 + 6) * ls + j] = s6 / ljj;
    lv[(i0 + 7) * ls + j] = s7 / ljj;
    return 0;
}

// the diagonal sum of column j: A_jj - L_j0 L_j0 - ..., ascending
fn diag_sum[&l, &a](lv: &l [float], ls: int, av: &a [float], as_: int, j: int) -> [] float {
    let rj = lv[j * ls..j * ls + j];
    var s = av[j * as_ + j];
    var k = 0;
    while k < j {
        s = s - rj[k] * rj[k];
        k = k + 1;
    }
    return s;
}

// fast path (unit column strides on A and L, non-negative row strides): positioned slices, d x d
fn chol_fast[&l, &a](lv: &!l [float], ls: int, av: &a [float], as_: int, d: int) -> [] int {
    var j = 0;
    while j < d {
        let s = diag_sum(lv, ls, av, as_, j);
        if !(s > 0.0) {
            return refuse.not_positive_definite();
        }
        let ljj = sqrt(s);
        lv[j * ls + j] = ljj;
        var i = j + 1;
        while i + 8 <= d {
            rows8(lv, ls, av, as_, j, i, ljj);
            i = i + 8;
        }
        while i < d {
            let ri = lv[i * ls..i * ls + j];
            let rj = lv[j * ls..j * ls + j];
            var t = av[i * as_ + j];
            var k = 0;
            while k < j {
                t = t - ri[k] * rj[k];
                k = k + 1;
            }
            lv[i * ls + j] = t / ljj;
            i = i + 1;
        }
        j = j + 1;
    }
    return 0;
}

// generic path: any strides, one entry at a time, same sums
fn chol_generic[&l, &a](lv: &!l [float], lt: tensor.Tensor, av: &a [float], at: tensor.Tensor, d: int) -> [] int {
    var j = 0;
    while j < d {
        var i = j;
        while i < d {
            var s = av[at.off + i * at.t0 + j * at.t1];
            var k = 0;
            while k < j {
                s = s - lv[lt.off + i * lt.t0 + k * lt.t1] * lv[lt.off + j * lt.t0 + k * lt.t1];
                k = k + 1;
            }
            if i == j {
                if !(s > 0.0) {
                    return refuse.not_positive_definite();
                }
                lv[lt.off + j * lt.t0 + j * lt.t1] = sqrt(s);
            } else {
                lv[lt.off + i * lt.t0 + j * lt.t1] = s / lv[lt.off + j * lt.t0 + j * lt.t1];
            }
            i = i + 1;
        }
        j = j + 1;
    }
    return 0;
}

// A (d x d) -> L (d x d, lower triangle written; the rest untouched). Answers a refusal code, 0 when done. On
// not-positive-definite the columns before the failing one are written and the rest is not (the contents are unspecified).
pub fn cholesky[&a, &l](at: tensor.Tensor, ad: &a [float], lt: tensor.Tensor, ld: &!l [float]) -> [] int {
    var c = tensor.expect(at, 2, len(ad));
    if c != 0 {
        return c;
    }
    c = tensor.expect(lt, 2, len(ld));
    if c != 0 {
        return c;
    }
    c = tensor.writable(lt);
    if c != 0 {
        return c;
    }
    let d = at.s0;
    if at.s1 != d || lt.s0 != d || lt.s1 != d {
        return refuse.tensor_shape();
    }
    if d == 0 {
        return 0;
    }
    if at.t1 == 1 && lt.t1 == 1 && at.t0 >= d && lt.t0 >= d {
        return chol_fast(ld[lt.off..len(ld)], lt.t0, ad[at.off..len(ad)], at.t0, d);
    }
    return chol_generic(ld, lt, ad, at, d);
}

// ---------------------------------------------------------------- triangular solves

// forward, fast path: L positioned at L[0][0] (row stride ls, unit column stride), b and x unit stride
fn fwd_fast[&l, &b, &x](lv: &l [float], ls: int, bv: &b [float], xv: &!x [float], d: int) -> [] int {
    var i = 0;
    while i + 4 <= d {
        let r0 = lv[(i + 0) * ls..(i + 0) * ls + i];
        let r1 = lv[(i + 1) * ls..(i + 1) * ls + i];
        let r2 = lv[(i + 2) * ls..(i + 2) * ls + i];
        let r3 = lv[(i + 3) * ls..(i + 3) * ls + i];
        let xs = xv[0..i];
        var s0 = bv[i + 0];
        var s1 = bv[i + 1];
        var s2 = bv[i + 2];
        var s3 = bv[i + 3];
        var k = 0;
        while k < i {
            let c = xs[k];
            s0 = s0 - r0[k] * c;
            s1 = s1 - r1[k] * c;
            s2 = s2 - r2[k] * c;
            s3 = s3 - r3[k] * c;
            k = k + 1;
        }
        // the four diagonal entries are checked by the caller (nonzero)
        let x0 = s0 / lv[(i + 0) * ls + i + 0];
        s1 = s1 - lv[(i + 1) * ls + i] * x0;
        let x1 = s1 / lv[(i + 1) * ls + i + 1];
        s2 = s2 - lv[(i + 2) * ls + i] * x0;
        s2 = s2 - lv[(i + 2) * ls + i + 1] * x1;
        let x2 = s2 / lv[(i + 2) * ls + i + 2];
        s3 = s3 - lv[(i + 3) * ls + i] * x0;
        s3 = s3 - lv[(i + 3) * ls + i + 1] * x1;
        s3 = s3 - lv[(i + 3) * ls + i + 2] * x2;
        let x3 = s3 / lv[(i + 3) * ls + i + 3];
        xv[i + 0] = x0;
        xv[i + 1] = x1;
        xv[i + 2] = x2;
        xv[i + 3] = x3;
        i = i + 4;
    }
    while i < d {
        let r = lv[i * ls..i * ls + i];
        let xs = xv[0..i];
        var s = bv[i];
        var k = 0;
        while k < i {
            s = s - r[k] * xs[k];
            k = k + 1;
        }
        xv[i] = s / lv[i * ls + i];
        i = i + 1;
    }
    return 0;
}

// backward, fast path: L^T x = b; four columns of L per pass, k descending from d - 1
fn bwd_fast[&l, &b, &x](lv: &l [float], ls: int, bv: &b [float], xv: &!x [float], d: int) -> [] int {
    var top = d;
    // columns are taken from the right: groups [top - 4, top), then singles
    while top - 4 >= 0 {
        let i = top - 4;
        var s0 = bv[i + 0];
        var s1 = bv[i + 1];
        var s2 = bv[i + 2];
        var s3 = bv[i + 3];
        var k = d - 1;
        while k >= top {
            let r = lv[k * ls + i..k * ls + i + 4];
            let c = xv[k];
            s0 = s0 - r[0] * c;
            s1 = s1 - r[1] * c;
            s2 = s2 - r[2] * c;
            s3 = s3 - r[3] * c;
            k = k - 1;
        }
        // k = i + 3 down to i + 1 within the group: x3 first
        let x3 = s3 / lv[(i + 3) * ls + i + 3];
        s2 = s2 - lv[(i + 3) * ls + i + 2] * x3;
        s1 = s1 - lv[(i + 3) * ls + i + 1] * x3;
        s0 = s0 - lv[(i + 3) * ls + i + 0] * x3;
        let x2 = s2 / lv[(i + 2) * ls + i + 2];
        s1 = s1 - lv[(i + 2) * ls + i + 1] * x2;
        s0 = s0 - lv[(i + 2) * ls + i + 0] * x2;
        let x1 = s1 / lv[(i + 1) * ls + i + 1];
        s0 = s0 - lv[(i + 1) * ls + i + 0] * x1;
        let x0 = s0 / lv[(i + 0) * ls + i + 0];
        xv[i + 0] = x0;
        xv[i + 1] = x1;
        xv[i + 2] = x2;
        xv[i + 3] = x3;
        top = top - 4;
    }
    var i = top - 1;
    while i >= 0 {
        var s = bv[i];
        var k = d - 1;
        while k > i {
            s = s - lv[k * ls + i] * xv[k];
            k = k - 1;
        }
        xv[i] = s / lv[i * ls + i];
        i = i - 1;
    }
    return 0;
}

// The solves. L is d x d (its lower triangle is read), b and x rank-1 of extent d, x writable. A zero diagonal entry is
// refused (ml.linalg.singular) before anything is written. `trans` = 0: L x = b; any other: L^T x = b. b and x are
// separate borrows (the solve is out of place).
pub fn solve[&l, &b, &x](trans: int, lt: tensor.Tensor, ld: &l [float], bt: tensor.Tensor, bd: &b [float], xt: tensor.Tensor, xd: &!x [float]) -> [] int {
    var c = tensor.expect(lt, 2, len(ld));
    if c != 0 {
        return c;
    }
    c = tensor.expect(bt, 1, len(bd));
    if c != 0 {
        return c;
    }
    c = tensor.expect(xt, 1, len(xd));
    if c != 0 {
        return c;
    }
    c = tensor.writable(xt);
    if c != 0 {
        return c;
    }
    let d = lt.s0;
    if lt.s1 != d || bt.s0 != d || xt.s0 != d {
        return refuse.tensor_shape();
    }
    var i = 0;
    while i < d {
        if !(ld[lt.off + i * lt.t0 + i * lt.t1] != 0.0) {
            return refuse.singular();
        }
        i = i + 1;
    }
    if d == 0 {
        return 0;
    }
    if lt.t1 == 1 && lt.t0 >= 0 && bt.t0 == 1 && xt.t0 == 1 {
        if trans == 0 {
            return fwd_fast(ld[lt.off..len(ld)], lt.t0, bd[bt.off..bt.off + d], xd[xt.off..xt.off + d], d);
        }
        return bwd_fast(ld[lt.off..len(ld)], lt.t0, bd[bt.off..bt.off + d], xd[xt.off..xt.off + d], d);
    }
    if trans == 0 {
        i = 0;
        while i < d {
            var s = bd[bt.off + i * bt.t0];
            var k = 0;
            while k < i {
                s = s - ld[lt.off + i * lt.t0 + k * lt.t1] * xd[xt.off + k * xt.t0];
                k = k + 1;
            }
            xd[xt.off + i * xt.t0] = s / ld[lt.off + i * lt.t0 + i * lt.t1];
            i = i + 1;
        }
        return 0;
    }
    i = d - 1;
    while i >= 0 {
        var s = bd[bt.off + i * bt.t0];
        var k = d - 1;
        while k > i {
            s = s - ld[lt.off + k * lt.t0 + i * lt.t1] * xd[xt.off + k * xt.t0];
            k = k - 1;
        }
        xd[xt.off + i * xt.t0] = s / ld[lt.off + i * lt.t0 + i * lt.t1];
        i = i - 1;
    }
    return 0;
}
