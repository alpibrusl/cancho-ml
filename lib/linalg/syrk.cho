module linalg.syrk;

import linalg.order;
import linalg.tensor;
import ml.refuse;

// C = X^T X, the entries C[j][k] with j <= k written (the other triangle is not touched). Order: docs/linalg.md section 2.1:
// each entry is the block rule (blocks of 256 rows, ascending from +0.0) and the tree rule over rows i of X_ij * X_ik.
// A block's partial is built tile by tile (4 x 4 accumulators held across the whole block); the partials of the blocks are
// settled on the order.* stack, a d x d square per slot (only j <= k is meaningful).

// accumulators of a full 4 x 4 tile over rows [r0, r1) of one block; xs positioned at X[0, 0], row stride rs
fn tile44[&x, &s](xs: &x [float], rs: int, r0: int, r1: int, j0: int, k0: int, slot: &!s [float], d: int) -> [] int {
    var c00 = 0.0;
    var c01 = 0.0;
    var c02 = 0.0;
    var c03 = 0.0;
    var c10 = 0.0;
    var c11 = 0.0;
    var c12 = 0.0;
    var c13 = 0.0;
    var c20 = 0.0;
    var c21 = 0.0;
    var c22 = 0.0;
    var c23 = 0.0;
    var c30 = 0.0;
    var c31 = 0.0;
    var c32 = 0.0;
    var c33 = 0.0;
    var i = r0;
    while i < r1 {
        let p = xs[i * rs + j0..i * rs + j0 + 4];
        let q = xs[i * rs + k0..i * rs + k0 + 4];
        let a0 = p[0];
        let a1 = p[1];
        let a2 = p[2];
        let a3 = p[3];
        let b0 = q[0];
        let b1 = q[1];
        let b2 = q[2];
        let b3 = q[3];
        c00 = c00 + a0 * b0;
        c01 = c01 + a0 * b1;
        c02 = c02 + a0 * b2;
        c03 = c03 + a0 * b3;
        c10 = c10 + a1 * b0;
        c11 = c11 + a1 * b1;
        c12 = c12 + a1 * b2;
        c13 = c13 + a1 * b3;
        c20 = c20 + a2 * b0;
        c21 = c21 + a2 * b1;
        c22 = c22 + a2 * b2;
        c23 = c23 + a2 * b3;
        c30 = c30 + a3 * b0;
        c31 = c31 + a3 * b1;
        c32 = c32 + a3 * b2;
        c33 = c33 + a3 * b3;
        i = i + 1;
    }
    let o0 = slot[(j0 + 0) * d + k0..(j0 + 0) * d + k0 + 4];
    o0[0] = c00;
    o0[1] = c01;
    o0[2] = c02;
    o0[3] = c03;
    let o1 = slot[(j0 + 1) * d + k0..(j0 + 1) * d + k0 + 4];
    o1[0] = c10;
    o1[1] = c11;
    o1[2] = c12;
    o1[3] = c13;
    let o2 = slot[(j0 + 2) * d + k0..(j0 + 2) * d + k0 + 4];
    o2[0] = c20;
    o2[1] = c21;
    o2[2] = c22;
    o2[3] = c23;
    let o3 = slot[(j0 + 3) * d + k0..(j0 + 3) * d + k0 + 4];
    o3[0] = c30;
    o3[1] = c31;
    o3[2] = c32;
    o3[3] = c33;
    return 0;
}

// an edge tile (jb x kb entries, each at most 4): one chain per entry
fn tile_edge[&x, &s](xs: &x [float], rs: int, r0: int, r1: int, j0: int, jb: int, k0: int, kb: int, slot: &!s [float], d: int) -> [] int {
    var j = 0;
    while j < jb {
        var k = 0;
        while k < kb {
            var c = 0.0;
            var i = r0;
            while i < r1 {
                c = c + xs[i * rs + j0 + j] * xs[i * rs + k0 + k];
                i = i + 1;
            }
            slot[(j0 + j) * d + k0 + k] = c;
            k = k + 1;
        }
        j = j + 1;
    }
    return 0;
}

// the partial of rows [r0, r1) (one block) into slot, all tiles with k0 >= j0
fn block_tiles[&x, &s](xs: &x [float], rs: int, r0: int, r1: int, slot: &!s [float], d: int) -> [] int {
    var j0 = 0;
    while j0 < d {
        var jb = 4;
        if j0 + 4 > d {
            jb = d - j0;
        }
        var k0 = j0;
        while k0 < d {
            var kb = 4;
            if k0 + 4 > d {
                kb = d - k0;
            }
            if jb == 4 && kb == 4 {
                tile44(xs, rs, r0, r1, j0, k0, slot, d);
            } else {
                tile_edge(xs, rs, r0, r1, j0, jb, k0, kb, slot, d);
            }
            k0 = k0 + 4;
        }
        j0 = j0 + 4;
    }
    return 0;
}

// blocks [b0, b1) pushed on the stack (st/lv, width d*d) from slot sp0; xs positioned at X[0, 0]; answers the new sp
pub fn syrk_blocks[&x, &s, &l](xs: &x [float], rs: int, n: int, d: int, b0: int, b1: int, st: &!s [float], lv: &!l [int], sp0: int) -> [] int {
    var sp = sp0;
    var b = b0;
    while b < b1 {
        var hi = (b + 1) * 256;
        if hi > n {
            hi = n;
        }
        block_tiles(xs, rs, b * 256, hi, st[sp * d * d..sp * d * d + d * d], d);
        sp = order.settle(st, lv, sp, d * d);
        b = b + 1;
    }
    return sp;
}

// the same partial through arbitrary strides: one chain per entry, indexed through the descriptor
fn block_generic[&x, &s](xd: &x [float], xo: int, rs: int, cs: int, r0: int, r1: int, slot: &!s [float], d: int) -> [] int {
    var j = 0;
    while j < d {
        var k = j;
        while k < d {
            var c = 0.0;
            var i = r0;
            while i < r1 {
                c = c + xd[xo + i * rs + j * cs] * xd[xo + i * rs + k * cs];
                i = i + 1;
            }
            slot[j * d + k] = c;
            k = k + 1;
        }
        j = j + 1;
    }
    return 0;
}

// write the upper triangle of the d x d square `sq` into the output matrix
pub fn store_upper[&r, &c](sq: &r [float], ct: tensor.Tensor, cd: &!c [float], d: int) -> [] int {
    var j = 0;
    while j < d {
        var k = j;
        while k < d {
            cd[ct.off + j * ct.t0 + k * ct.t1] = sq[j * d + k];
            k = k + 1;
        }
        j = j + 1;
    }
    return 0;
}

// X is n x d; C is d x d and writable. Answers a refusal code, 0 when done.
pub fn syrk[&h, &x, &c](heap: &!h Heap, xt: tensor.Tensor, xd: &x [float], ct: tensor.Tensor, cd: &!c [float]) -> [heap] int {
    var cc = tensor.expect(xt, 2, len(xd));
    if cc != 0 {
        return cc;
    }
    cc = tensor.expect(ct, 2, len(cd));
    if cc != 0 {
        return cc;
    }
    cc = tensor.writable(ct);
    if cc != 0 {
        return cc;
    }
    let n = xt.s0;
    let d = xt.s1;
    if ct.s0 != d || ct.s1 != d {
        return refuse.tensor_shape();
    }
    if d == 0 {
        return 0;
    }
    let st = box_slice(heap, 40 * d * d, 0.0);
    let lv = box_slice(heap, 40, 0);
    borrow mut st as &!sw in {
        borrow mut lv as &!lw in {
            if n == 0 {
                // the sum over no rows: +0.0 everywhere (slot 0 is already zero)
                store_upper(contents(sw), ct, cd, d);
            } else {
                var sp = 0;
                let nb = order.blocks(n);
                if xt.t1 == 1 && xt.t0 >= 0 {
                    sp = syrk_blocks(xd[xt.off..len(xd)], xt.t0, n, d, 0, nb, contents(sw), contents(lw), 0);
                } else {
                    var b = 0;
                    while b < nb {
                        var hi = (b + 1) * 256;
                        if hi > n {
                            hi = n;
                        }
                        block_generic(xd, xt.off, xt.t0, xt.t1, b * 256, hi, contents(sw)[sp * d * d..sp * d * d + d * d], d);
                        sp = order.settle(contents(sw), contents(lw), sp, d * d);
                        b = b + 1;
                    }
                }
                order.finish(contents(sw), sp, d * d);
                store_upper(contents(sw), ct, cd, d);
            }
        }
    }
    unbox_slice(heap, st);
    unbox_slice(heap, lv);
    return 0;
}
