module pipeline.modeldefs;

import std.bytes;

// GENERATED by scripts/gen_models.py from lib/models/*/model.toml -- do not edit.

// The keys of the `model` line of a plan (docs/pipeline.md section 2, docs/modules.md section 3): the grammar of lib/pipeline/plan.cho reads these def
// strings (`name:type:rule`). The order is the manifests' plan_order; the keys of a model are in the order of its [[hyperparameter]] tables.

pub fn count() -> [] int {
    return 9;
}

// the model names, in plan order
pub fn name(i: int) -> [] &static [byte] {
    if i == 0 {
        return "constant";
    }
    if i == 1 {
        return "linear";
    }
    if i == 2 {
        return "logistic";
    }
    if i == 3 {
        return "kmeans";
    }
    if i == 4 {
        return "tree";
    }
    if i == 5 {
        return "forest";
    }
    if i == 6 {
        return "boost";
    }
    if i == 7 {
        return "softmax";
    }
    return "recommend";
}

pub fn defs[&s](verb: &s [byte]) -> [] &static [byte] {
    if bytes.equal(verb, "model") {
        return "kind:enum=constant,linear,logistic,kmeans,tree,forest,boost,softmax,recommend:req";
    }
    if bytes.equal(verb, "model:constant") {
        return "task:enum=regression,classification:req";
    }
    if bytes.equal(verb, "model:linear") {
        return "l2:fnn:=0.0";
    }
    if bytes.equal(verb, "model:logistic") {
        return "iterations:int=1,1000:=100 l2:fnn:=0.0";
    }
    if bytes.equal(verb, "model:kmeans") {
        return "k:int=1,1024:req iterations:int=1,1000:=10 init:enum=random,kmeans++:=kmeans++";
    }
    if bytes.equal(verb, "model:tree") {
        return "task:enum=classification,regression:req max-depth:int=1,1000:=8 min-leaf:int=1,1000000:=1 bins:int=2,255:=64 max-nodes:int=1,999999999:=4194304";
    }
    if bytes.equal(verb, "model:forest") {
        return "task:enum=classification,regression:req trees:int=1,1024:=100 max-depth:int=1,1000:=8 min-leaf:int=1,1000000:=1 bins:int=2,255:=64 mtry:int=0,4096:=0 bootstrap:int=0,1:=1 max-nodes:int=1,999999999:=4194304";
    }
    if bytes.equal(verb, "model:boost") {
        return "task:enum=classification,regression,ranking,lambdarank:req rounds:int=1,10000:=100 learning-rate:fnn:=0.1 max-depth:int=1,1000:=4 min-leaf:int=1,1000000:=10 bins:int=2,255:=64 l2:fnn:=1.0 subsample:fnn:=1.0 early-stopping:int=0,1000:=0 max-nodes:int=1,999999999:=4194304";
    }
    if bytes.equal(verb, "model:softmax") {
        return "iterations:int=1,1000:=100 l2:fnn:=0.0";
    }
    if bytes.equal(verb, "model:recommend") {
        return "factors:int=1,256:=32 l2:fnn:=0.1 iterations:int=1,1000:=10 alpha:fnn:=40.0 feedback:enum=explicit,implicit:=explicit";
    }
    return "";
}

// the keys of the model called `name`, or "" when there is no such model
pub fn model_defs[&s](name: &s [byte]) -> [] &static [byte] {
    if bytes.equal(name, "constant") {
        return "task:enum=regression,classification:req";
    }
    if bytes.equal(name, "linear") {
        return "l2:fnn:=0.0";
    }
    if bytes.equal(name, "logistic") {
        return "iterations:int=1,1000:=100 l2:fnn:=0.0";
    }
    if bytes.equal(name, "kmeans") {
        return "k:int=1,1024:req iterations:int=1,1000:=10 init:enum=random,kmeans++:=kmeans++";
    }
    if bytes.equal(name, "tree") {
        return "task:enum=classification,regression:req max-depth:int=1,1000:=8 min-leaf:int=1,1000000:=1 bins:int=2,255:=64 max-nodes:int=1,999999999:=4194304";
    }
    if bytes.equal(name, "forest") {
        return "task:enum=classification,regression:req trees:int=1,1024:=100 max-depth:int=1,1000:=8 min-leaf:int=1,1000000:=1 bins:int=2,255:=64 mtry:int=0,4096:=0 bootstrap:int=0,1:=1 max-nodes:int=1,999999999:=4194304";
    }
    if bytes.equal(name, "boost") {
        return "task:enum=classification,regression,ranking,lambdarank:req rounds:int=1,10000:=100 learning-rate:fnn:=0.1 max-depth:int=1,1000:=4 min-leaf:int=1,1000000:=10 bins:int=2,255:=64 l2:fnn:=1.0 subsample:fnn:=1.0 early-stopping:int=0,1000:=0 max-nodes:int=1,999999999:=4194304";
    }
    if bytes.equal(name, "softmax") {
        return "iterations:int=1,1000:=100 l2:fnn:=0.0";
    }
    if bytes.equal(name, "recommend") {
        return "factors:int=1,256:=32 l2:fnn:=0.1 iterations:int=1,1000:=10 alpha:fnn:=40.0 feedback:enum=explicit,implicit:=explicit";
    }
    return "";
}
