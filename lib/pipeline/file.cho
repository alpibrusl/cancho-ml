module pipeline.file;

import std.buffer;
import std.bytes;
import std.crypto;
import ml.fbits;
import ml.kinds;
import transforms.codes;
import transforms.strtab;
import pipeline.mixed;
import pipeline.plan;
import pipeline.provsec;
import pipeline.names;
import pipeline.schema;
import pipeline.run;

// The model file with its steps (docs/pipeline.md section 5): `CML1 | u32 version = 1 | u32 sections = 5 | section * 5 | SHA-256 of every byte before it`,
// a section being `u32 tag | u64 length | payload`, tags 1 plan, 2 schema, 3 steps, 4 model, 5 meta (lib/core/kinds.cho). The layout is the one of
// tools/ml/mfile.cho: a file with no steps is the same bytes (a test). `decode` is the ONLY way to a Loaded, and it checks, in the order of
// mfile.cho: magic, version, structure (truncated), the checksum, then every field (malformed); `run.apply_steps` takes the steps bytes of a Loaded.
// A model with a categorical step has a sixth section, the string table (tag 6, docs/stringtable.md): `sections` is then 6, the `steps` section holds an 8-byte stub for each
// categorical step, and `decode` rebuilds the steps payload `pipeline.mixed.fit` made (`effective_steps`). A file with no categorical step is the five-section file of before.
// The estimator is a hook: `encode` takes the bytes of the `model` section (u32 kind then the records) and `decode` hands them back; only the
// leading kind is checked here (the estimator's own reader checks the rest).

pub fn version() -> [] int {
    return 1;
}

fn put32[&h](heap: &!h Heap, b: buffer.Buffer, v: int) -> [heap] buffer.Buffer {
    var o = b;
    o = buffer.push(heap, o, byte_of(v & 255));
    o = buffer.push(heap, o, byte_of(v >> 8 & 255));
    o = buffer.push(heap, o, byte_of(v >> 16 & 255));
    return buffer.push(heap, o, byte_of(v >> 24 & 255));
}

fn put64[&h](heap: &!h Heap, b: buffer.Buffer, v: int) -> [heap] buffer.Buffer {
    var o = b;
    var k = 0;
    while k < 8 {
        o = buffer.push(heap, o, byte_of(v >> 8 * k & 255));
        k = k + 1;
    }
    return o;
}

fn get32[&s](src: &s [byte], at: int) -> [] int {
    return int_of(src[at]) | int_of(src[at + 1]) << 8 | int_of(src[at + 2]) << 16 | int_of(src[at + 3]) << 24;
}

fn section[&h, &p](heap: &!h Heap, out: buffer.Buffer, tag: int, payload: &p [byte]) -> [heap] buffer.Buffer {
    var o = put32(heap, out, tag);
    o = put64(heap, o, len(payload));
    return buffer.append(heap, o, payload);
}

// the SHA-256 of data as 32 bytes appended to out
fn digest_into[&h, &d](heap: &!h Heap, out: buffer.Buffer, data: &d [byte]) -> [heap] buffer.Buffer {
    let state = box_slice(heap, crypto.sha256_state_len(), 0);
    let dg = box_slice(heap, 32, byte_of(0));
    var sw = state;
    var dw = dg;
    var o = out;
    borrow mut sw as &!s in {
        crypto.sha256_init(contents(s));
        crypto.sha256_update(contents(s), data);
        borrow mut dw as &!x in {
            crypto.sha256_final(contents(s), contents(x));
        }
    }
    borrow dw as &r in {
        o = buffer.append(heap, o, contents(r));
    }
    unbox_slice(heap, sw);
    unbox_slice(heap, dw);
    return o;
}

// The file. plan: the canonical text; schema_payload: schema.encode; steps_payload: Fitted.payload; model_payload: u32 kind then the estimator's records;
// columns: the number of columns of the schema; the meta section is `u64 rows | u64 columns | u64 seed | u32 0 | u32 length | pin`, and for a model
// kind of 4 or above (the leading u32 of model_payload) `| u32 sum_order` (kinds.sum_order_for(kind): 2, or 3 for a tree or a forest; design.md section 4.1); kinds 1 to 3 have the bytes of mfile.cho.
pub fn encode[&h, &a, &b, &c, &e, &f](heap: &!h Heap, plan_text: &a [byte], schema_payload: &b [byte], steps_payload: &c [byte], model_payload: &e [byte], rows: int, columns: int, seed: int, pin: &f [byte]) -> [heap] buffer.Buffer {
    return encode_with_table(heap, plan_text, schema_payload, steps_payload, "", model_payload, rows, columns, seed, pin);
}

// The same with a string table: `table` is the section payload of strtab.pack, and is empty for a file with no categorical step (then the file has five sections and is
// the file `encode` writes). `steps_payload` is then the section strtab.pack made, with the stubs.
pub fn encode_with_table[&h, &a, &b, &c, &t, &e, &f](heap: &!h Heap, plan_text: &a [byte], schema_payload: &b [byte], steps_payload: &c [byte], table: &t [byte], model_payload: &e [byte], rows: int, columns: int, seed: int, pin: &f [byte]) -> [heap] buffer.Buffer {
    return encode_full(heap, plan_text, schema_payload, steps_payload, table, "", model_payload, rows, columns, seed, pin);
}

// The same with the provenance section (tag 7, docs/tracking.md section 2): `prov` is the payload of pipeline.provsec.pack, and is empty for a file with no provenance (then the file is the one
// `encode_with_table` writes). The section follows the string table when there is one, and the header's count is 5 plus one for each of the two optional sections that is there.
pub fn encode_full[&h, &a, &b, &c, &t, &v, &e, &f](heap: &!h Heap, plan_text: &a [byte], schema_payload: &b [byte], steps_payload: &c [byte], table: &t [byte], prov: &v [byte], model_payload: &e [byte], rows: int, columns: int, seed: int, pin: &f [byte]) -> [heap] buffer.Buffer {
    var me = put64(heap, buffer.empty(heap, 64), rows);
    me = put64(heap, me, columns);
    me = put64(heap, me, seed);
    me = put32(heap, me, 0);
    me = put32(heap, me, len(pin));
    me = buffer.append(heap, me, pin);
    if len(model_payload) >= 4 && get32(model_payload, 0) >= kinds.first_ordered_model() {
        me = put32(heap, me, kinds.sum_order_for(get32(model_payload, 0)));
    }
    var out = buffer.empty(heap, 256);
    out = buffer.append(heap, out, "CML1");
    out = put32(heap, out, 1);
    var count = kinds.core_sections();
    if len(table) > 0 {
        count = count + 1;
    }
    if len(prov) > 0 {
        count = count + 1;
    }
    out = put32(heap, out, count);
    out = section(heap, out, kinds.section_plan(), plan_text);
    out = section(heap, out, kinds.section_schema(), schema_payload);
    out = section(heap, out, kinds.section_steps(), steps_payload);
    out = section(heap, out, kinds.section_model(), model_payload);
    borrow me as &r in {
        out = section(heap, out, kinds.section_meta(), buffer.bytes(r));
    }
    buffer.drop(heap, me);
    if len(table) > 0 {
        out = section(heap, out, kinds.section_strings(), table);
    }
    if len(prov) > 0 {
        out = section(heap, out, kinds.section_provenance(), prov);
    }
    var sum = buffer.empty(heap, 40);
    borrow out as &r in {
        sum = digest_into(heap, sum, buffer.bytes(r));
    }
    borrow sum as &w in {
        out = buffer.append(heap, out, buffer.bytes(w));
    }
    buffer.drop(heap, sum);
    return out;
}

// The same file with the SHA-256 trailer recomputed over the bytes before it (a repaired checksum: what a test, or an attacker, does after editing
// a field). Not used by the product; the edit-and-repair tests and the fuzz need it.
pub fn reseal[&h, &d](heap: &!h Heap, data: &d [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, len(data) + 32);
    if len(data) < 32 {
        return buffer.append(heap, out, data);
    }
    out = buffer.append(heap, out, data[0..len(data) - 32]);
    var sum = buffer.empty(heap, 40);
    borrow out as &r in {
        sum = digest_into(heap, sum, buffer.bytes(r));
    }
    borrow sum as &w in {
        out = buffer.append(heap, out, buffer.bytes(w));
    }
    buffer.drop(heap, sum);
    return out;
}

// ---------------------------------------------------------------- decode

// A file that passed every check. The file is kept as it is; the sections are views into it.
pub res struct Loaded {
    data: buffer.Buffer,
    // payload start and length of sections 1 to 5, of the string table and of the provenance (the last four cells, zero for a section the file does not have)
    places: Box[[int]],
    nsteps: int,
    features: int,
    width: int,
    columns: int,
    rows: int,
    seed: int,
    model_kind: int,
    // the categorical input columns of the schema (type 3), and the steps payload rebuilt from the stubs and the table (empty when the file has no table)
    ncat: int,
    full: buffer.Buffer,
}

pub fn drop[&h](heap: &!h Heap, l: Loaded) -> [heap] int {
    let Loaded { data, places, nsteps, features, width, columns, rows, seed, model_kind, ncat, full } = l;
    buffer.drop(heap, data);
    buffer.drop(heap, full);
    unbox_slice(heap, places);
    return rows;
}

pub fn empty[&h](heap: &!h Heap) -> [heap] Loaded {
    return Loaded { data: buffer.empty(heap, 1), places: box_slice(heap, 14, 0), nsteps: 0, features: 0, width: 0, columns: 0, rows: 0, seed: 0, model_kind: 0, ncat: 0, full: buffer.empty(heap, 1) };
}

fn sec[&l](l: &l Loaded, i: int) -> [] &l [byte] {
    let p = contents(l.places);
    return buffer.bytes(l.data)[p[2 * i]..p[2 * i] + p[2 * i + 1]];
}

pub fn plan_bytes[&l](l: &l Loaded) -> [] &l [byte] {
    return sec(l, 0);
}

pub fn schema_bytes[&l](l: &l Loaded) -> [] &l [byte] {
    return sec(l, 1);
}

// the steps section as it is stored (with the stubs of the categorical steps)
pub fn stored_steps_bytes[&l](l: &l Loaded) -> [] &l [byte] {
    return sec(l, 2);
}

// the steps payload: the argument of run.apply_steps, or of mixed.apply_steps when the file has a string table (the stubs replaced by the payloads of the table)
pub fn steps_bytes[&l](l: &l Loaded) -> [] &l [byte] {
    if l.ncat > 0 {
        return buffer.bytes(l.full);
    }
    return sec(l, 2);
}

// whether the file has a string table, and its payload
pub fn has_table[&l](l: &l Loaded) -> [] bool {
    return l.ncat > 0;
}

pub fn table_bytes[&l](l: &l Loaded) -> [] &l [byte] {
    return sec(l, 5);
}

// whether the file has a provenance section, and its payload (empty when it has none)
pub fn has_provenance[&l](l: &l Loaded) -> [] bool {
    return contents(l.places)[12] > 0;
}

pub fn provenance_bytes[&l](l: &l Loaded) -> [] &l [byte] {
    return sec(l, 6);
}

// the categorical input columns of the schema
pub fn categorical_columns[&l](l: &l Loaded) -> [] int {
    return l.ncat;
}

// the model section: u32 kind then the estimator's records
pub fn model_bytes[&l](l: &l Loaded) -> [] &l [byte] {
    return sec(l, 3);
}

pub fn meta_bytes[&l](l: &l Loaded) -> [] &l [byte] {
    return sec(l, 4);
}

pub fn bytes_of[&l](l: &l Loaded) -> [] &l [byte] {
    return buffer.bytes(l.data);
}

pub fn features[&l](l: &l Loaded) -> [] int {
    return l.features;
}

// the columns the steps leave (the width the estimator is given)
pub fn width[&l](l: &l Loaded) -> [] int {
    return l.width;
}

pub fn nsteps[&l](l: &l Loaded) -> [] int {
    return l.nsteps;
}

pub fn rows[&l](l: &l Loaded) -> [] int {
    return l.rows;
}

pub fn seed[&l](l: &l Loaded) -> [] int {
    return l.seed;
}

pub fn model_kind[&l](l: &l Loaded) -> [] int {
    return l.model_kind;
}

fn mal(sec_tag: int, step: int) -> [] codes.Fault {
    return codes.fault(codes.malformed(), sec_tag, step, 0);
}

// the checksum matches the 32 bytes at the end
fn checksum_ok[&h, &d](heap: &!h Heap, data: &d [byte]) -> [heap] bool {
    let n = len(data);
    let state = box_slice(heap, crypto.sha256_state_len(), 0);
    let dg = box_slice(heap, 32, byte_of(0));
    var sw = state;
    var dw = dg;
    var same = false;
    borrow mut sw as &!s in {
        crypto.sha256_init(contents(s));
        crypto.sha256_update(contents(s), data[0..n - 32]);
        borrow mut dw as &!x in {
            crypto.sha256_final(contents(s), contents(x));
        }
    }
    borrow dw as &r in {
        same = bytes.equal(contents(r), data[n - 32..n]);
    }
    unbox_slice(heap, sw);
    unbox_slice(heap, dw);
    return same;
}

// the structure: where each of the five payloads is, and then, in the order of their tags, the string table (tag 6) and the provenance (tag 7) when the file has them. The header's count
// is 5, 6 or 7 and a count of 6 can be either optional section: the walk reads the tags. places[2 k], places[2 k + 1] is the payload of slot k: 0 to 4 the core sections, 5 the string table, 6 the provenance.
// (code, a): 0, or truncated, or malformed with a = the tag at fault
fn structure[&d, &o](data: &d [byte], places: &!o [int]) -> [] (int, int) {
    let n = len(data);
    let body = n - 32;
    if body < 12 {
        return (codes.truncated(), 0);
    }
    let count = get32(data, 8);
    if count < kinds.core_sections() || count > kinds.section_count() {
        return (codes.malformed(), 0);
    }
    var pos = 12;
    var s = 0;
    var prev = 0;
    while s < count {
        if pos + 12 > body {
            return (codes.truncated(), 0);
        }
        let tag = get32(data, pos);
        let length = fbits.get64(data, pos + 4);
        if length < 0 || length > body - pos - 12 {
            return (codes.truncated(), 0);
        }
        var slot = s;
        if s < kinds.core_sections() {
            if tag != kinds.section_at(s + 1) {
                return (codes.malformed(), tag);
            }
        } else {
            if tag <= prev || tag != kinds.section_strings() && tag != kinds.section_provenance() {
                return (codes.malformed(), tag);
            }
            slot = tag - 1;
        }
        places[2 * slot] = pos + 12;
        places[2 * slot + 1] = length;
        prev = tag;
        pos = pos + 12 + length;
        s = s + 1;
    }
    if pos != body {
        return (codes.malformed(), 0);
    }
    return (0, 0);
}

// the model families a plan's `model kind` may have as the leading u32 of the model section
fn model_family_ok(pk: int, mk: int) -> [] bool {
    if pk == 0 {
        return mk >= kinds.model_const_regression() && mk <= kinds.model_const_float_regression();
    }
    if pk == 1 {
        return mk == kinds.model_linear();
    }
    if pk == 2 {
        return mk == kinds.model_logistic();
    }
    if pk == 3 {
        return mk == kinds.model_kmeans();
    }
    return mk == kinds.model_tree();
}

// every field of the five sections (the checksum is right). (Fault, features, width, nsteps, rows, seed, model kind)
fn content[&h, &d, &p](heap: &!h Heap, data: &d [byte], places: &p [int]) -> [heap] (codes.Fault, int, int, int, int, int, int) {
    let none = codes.none();
    // 0 the sum order of a model of kind 4 or above (design.md 4.1): first, so that a file of another order is not reported as malformed for its parameters
    let md0 = data[places[6]..places[6] + places[7]];
    if len(md0) >= 4 && get32(md0, 0) >= kinds.first_ordered_model() && get32(md0, 0) <= kinds.model_count() {
        // a meta of the shape the rule gives (36 + length bytes) has the field; any other shape is left to the checks below, which refuse it as malformed
        let me0 = data[places[8]..places[8] + places[9]];
        if len(me0) >= 36 {
            let cl0 = get32(me0, 28);
            if cl0 >= 0 && cl0 <= 255 && len(me0) == 36 + cl0 {
                let so = get32(me0, 32 + cl0);
                if so != kinds.sum_order_for(get32(md0, 0)) {
                    return (codes.fault(codes.bad_version(), so, 1, kinds.sum_order_for(get32(md0, 0))), 0, 0, 0, 0, 0, 0);
                }
            }
        }
    }
    // 1 plan: it parses and is its own canonical form
    let pbytes = data[places[0]..places[0] + places[1]];
    let (pl, pf) = plan.parse(heap, pbytes);
    if pf.code != 0 {
        plan.drop(heap, pl);
        return (mal(1, 0), 0, 0, 0, 0, 0, 0);
    }
    var canon = false;
    var nplan = 0;
    var pkind = 0;
    borrow pl as &pr in {
        canon = bytes.equal(plan.text(pr), pbytes);
        nplan = plan.steps(pr);
        pkind = plan.model_kind(pr);
    }
    if !canon {
        plan.drop(heap, pl);
        return (mal(1, 0), 0, 0, 0, 0, 0, 0);
    }
    // 2 schema: the features are every column but the target; a column of type 3 is categorical, and then the file has a string table (and only then)
    let (sc, sf) = schema.decode(heap, data[places[2]..places[2] + places[3]]);
    if sf != 0 {
        schema.drop(heap, sc);
        plan.drop(heap, pl);
        return (mal(2, 0), 0, 0, 0, 0, 0, 0);
    }
    var feats = 0;
    var scols = 0;
    var has_target = true;
    var ncat = 0;
    var target_cat = false;
    var cnames = names.empty(heap);
    var nnames = names.empty(heap);
    var fnames = names.empty(heap);
    borrow sc as &sr in {
        feats = schema.features(sr);
        scols = schema.columns(sr);
        has_target = schema.has_target(sr);
        var j = 0;
        while j < schema.columns(sr) {
            if schema.type_of(sr, j) == 3 {
                if j == schema.target(sr) {
                    target_cat = true;
                }
                ncat = ncat + 1;
                cnames = names.add(heap, cnames, schema.name(sr, j));
            } else if j != schema.target(sr) {
                nnames = names.add(heap, nnames, schema.name(sr, j));
            }
            if j != schema.target(sr) {
                fnames = names.add(heap, fnames, schema.name(sr, j));
            }
            j = j + 1;
        }
    }
    schema.drop(heap, sc);
    let has_table = places[10] > 0;
    var early = none;
    if target_cat || ncat > 0 && !has_table {
        early = mal(2, 0);
    } else if has_table && ncat == 0 {
        early = codes.fault(codes.string_table(), strtab.r_schema(), 0, 0);
    }
    if early.code != 0 {
        names.drop(heap, cnames);
        names.drop(heap, nnames);
        names.drop(heap, fnames);
        plan.drop(heap, pl);
        return (early, 0, 0, 0, 0, 0, 0);
    }
    // 3 steps, chained from the number of numeric features; their kinds are the ones the plan lines ask for. With a string table: the table first (its digest,
    // its fields, its names against the schema's), then the steps the stubs and the table make together
    let stb = data[places[4]..places[4] + places[5]];
    var nsteps = 0;
    var width = 0;
    var failed = mal(0, 0);
    var full = buffer.empty(heap, 1);
    if has_table {
        let tb = data[places[10]..places[10] + places[11]];
        let tf = strtab.validate(heap, tb);
        if tf.code != 0 {
            failed = tf;
        } else {
            let (fb, jf) = strtab.join(heap, stb, tb);
            buffer.drop(heap, full);
            full = fb;
            if jf.code != 0 {
                failed = jf;
            } else {
                var same = false;
                borrow full as &fr in {
                    borrow cnames as &cr in {
                        same = mixed.columns_agree(heap, buffer.bytes(fr), cr);
                    }
                }
                if !same {
                    failed = codes.fault(codes.string_table(), strtab.r_schema(), 0, 0);
                } else {
                    borrow full as &fr in {
                        let (n, w, f) = mixed.check_steps(heap, buffer.bytes(fr), feats - ncat);
                        nsteps = n;
                        width = w;
                        failed = f;
                    }
                }
            }
        }
    } else if feats < 1 {
        failed = mal(3, 0);
    } else {
        let (n, w, f) = run.check_steps(heap, stb, feats);
        nsteps = n;
        width = w;
        failed = f;
    }
    if failed.code == 0 && nsteps != nplan {
        failed = mal(3, 0);
    }
    if failed.code != 0 {
        names.drop(heap, cnames);
        names.drop(heap, nnames);
        names.drop(heap, fnames);
        buffer.drop(heap, full);
        plan.drop(heap, pl);
        return (failed, 0, 0, 0, 0, 0, 0);
    }
    var agree = false;
    var at = 0;
    borrow pl as &pr in {
        if has_table {
            borrow nnames as &nr in {
                borrow cnames as &cr in {
                    borrow full as &fr in {
                        let (a2, s2) = mixed.agrees(heap, pr, nr, cr, buffer.bytes(fr));
                        agree = a2;
                        at = s2;
                    }
                }
            }
        } else {
            borrow fnames as &fr in {
                let (a2, s2) = run.agrees(heap, pr, fr, stb);
                agree = a2;
                at = s2;
            }
        }
    }
    names.drop(heap, cnames);
    names.drop(heap, nnames);
    names.drop(heap, fnames);
    buffer.drop(heap, full);
    plan.drop(heap, pl);
    if !agree {
        if has_table {
            return (codes.fault(codes.string_table(), strtab.r_plan(), at, 0), 0, 0, 0, 0, 0, 0);
        }
        return (mal(3, at), 0, 0, 0, 0, 0, 0);
    }
    // 4 model
    let md = data[places[6]..places[6] + places[7]];
    if len(md) < 4 {
        return (mal(4, 0), 0, 0, 0, 0, 0, 0);
    }
    let mk = get32(md, 0);
    if mk < 1 || mk > kinds.model_count() || !model_family_ok(pkind, mk) {
        return (mal(4, 0), 0, 0, 0, 0, 0, 0);
    }
    // a clustering has no target and every other model has one: the schema and the model must agree
    if mk == kinds.model_kmeans() == has_target {
        return (mal(2, 0), 0, 0, 0, 0, 0, 0);
    }
    // 5 meta
    let me = data[places[8]..places[8] + places[9]];
    if len(me) < 32 {
        return (mal(5, 0), 0, 0, 0, 0, 0, 0);
    }
    let rows = fbits.get64(me, 0);
    let mc = fbits.get64(me, 8);
    let seed = fbits.get64(me, 16);
    let nh = get32(me, 24);
    let cl = get32(me, 28);
    var tail = 0;
    if mk >= kinds.first_ordered_model() {
        tail = 4;
    }
    if rows < 1 || rows > 1000000000 || mc != scols || nh != 0 || cl < 0 || cl > 255 || len(me) != 32 + cl + tail {
        return (mal(5, 0), 0, 0, 0, 0, 0, 0);
    }
    // 7 provenance (only a file that has it): the training identity and the range of each numeric feature, checked against the rows of `meta` and the numeric features of the schema
    if places[12] > 0 {
        if provsec.validate(data[places[12]..places[12] + places[13]], rows, feats - ncat) != 0 {
            return (mal(7, 0), 0, 0, 0, 0, 0, 0);
        }
    }
    return (none, feats, width, nsteps, rows, seed, mk);
}

// Decode the file in `data`. (Loaded, Fault): the Loaded is empty unless the Fault is none. A file is input: a right checksum says it is the file
// that was written, not that it is sensible.
pub fn decode[&h, &d](heap: &!h Heap, data: &d [byte]) -> [heap] (Loaded, codes.Fault) {
    let n = len(data);
    if n < 4 {
        return (empty(heap), codes.fault(codes.truncated(), 0, 0, 0));
    }
    if !bytes.equal(data[0..4], "CML1") {
        return (empty(heap), codes.fault(codes.bad_magic(), 0, 0, 0));
    }
    if n < 8 {
        return (empty(heap), codes.fault(codes.truncated(), 0, 0, 0));
    }
    let v = get32(data, 4);
    if v != 1 {
        return (empty(heap), codes.fault(codes.bad_version(), v, 0, 0));
    }
    let places = box_slice(heap, 14, 0);
    var pw = places;
    var code = 0;
    var tag = 0;
    borrow mut pw as &!p in {
        let (c, t) = structure(data, contents(p));
        code = c;
        tag = t;
    }
    if code != 0 {
        unbox_slice(heap, pw);
        return (empty(heap), codes.fault(code, tag, 0, 0));
    }
    if !checksum_ok(heap, data) {
        unbox_slice(heap, pw);
        return (empty(heap), codes.fault(codes.checksum(), 0, 0, 0));
    }
    var fault = codes.none();
    var feats = 0;
    var width = 0;
    var nsteps = 0;
    var rows = 0;
    var seed = 0;
    var mk = 0;
    borrow pw as &pr in {
        let (f, a, b, c, d2, e, g) = content(heap, data, contents(pr));
        fault = f;
        feats = a;
        width = b;
        nsteps = c;
        rows = d2;
        seed = e;
        mk = g;
    }
    if fault.code != 0 {
        unbox_slice(heap, pw);
        return (empty(heap), fault);
    }
    let keep = buffer.append(heap, buffer.empty(heap, n), data);
    // the categorical columns and the steps payload of a file with a string table (the checks above passed, so neither can fail here)
    var ncat = 0;
    var full = buffer.empty(heap, 1);
    borrow pw as &pr in {
        let p2 = contents(pr);
        let (sc, sf) = schema.decode(heap, data[p2[2]..p2[2] + p2[3]]);
        borrow sc as &sr in {
            var j = 0;
            while j < schema.columns(sr) {
                if schema.type_of(sr, j) == 3 {
                    ncat = ncat + 1;
                }
                j = j + 1;
            }
        }
        schema.drop(heap, sc);
        if ncat > 0 {
            let (fb, jf) = strtab.join(heap, data[p2[4]..p2[4] + p2[5]], data[p2[10]..p2[10] + p2[11]]);
            buffer.drop(heap, full);
            full = fb;
        }
    }
    // the columns of the schema: the features and the target, if the model has one
    var ncolumns = feats + 1;
    if mk == kinds.model_kmeans() {
        ncolumns = feats;
    }
    return (Loaded { data: keep, places: pw, nsteps: nsteps, features: feats, width: width, columns: ncolumns, rows: rows, seed: seed, model_kind: mk, ncat: ncat, full: full }, codes.none());
}
