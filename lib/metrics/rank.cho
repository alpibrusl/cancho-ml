module metrics.rank;

import metrics.rules;
import metrics.ratio;
import metrics.classify;
import metrics.regress;

// ROC-AUC by the midrank rule in integers (docs/metrics.md section 2.6). The scores of the negatives and of the positives are
// sorted apart by an LSD radix sort on an order-preserving integer key (no comparison, no data-dependent trap), then walked together:
//     2U = sum over distinct scores v of (2 p b + p q),  AUC = 2U / (2 P N)
// with p, q the positives and negatives equal to v and b the negatives below v. One correctly rounded division at the end.

pub fn min_int() -> [] int {
    return 0 - 9223372036854775807 - 1;
}

// the key of a finite float: signed-int order equals float order, -0.0 equals +0.0
pub fn key_of(x: float) -> [] int {
    if x == 0.0 {
        return 0;
    }
    let b = bits_of(x);
    if b < 0 {
        return b ^ 9223372036854775807;
    }
    return b;
}

// byte d (0 = lowest) of the key in unsigned order of (key xor sign bit)
fn digit(k: int, d: int) -> [] int {
    let v = k >> 8 * d & 255;
    if d == 7 {
        return v ^ 128;
    }
    return v;
}

// one counting pass over src[lo, hi) into dst[lo, hi) on byte d; cnt has 256 ints. Answers 0 if the pass was a no-op (every key has
// the same byte; dst is then not written), else 1
fn pass[&s, &t, &c](src: &s [int], dst: &!t [int], cnt: &!c [int], lo: int, hi: int, d: int) -> [] int {
    var b = 0;
    while b < 256 {
        cnt[b] = 0;
        b = b + 1;
    }
    var i = lo;
    while i < hi {
        let g = digit(src[i], d);
        cnt[g] = cnt[g] + 1;
        i = i + 1;
    }
    if cnt[digit(src[lo], d)] == hi - lo {
        return 0;
    }
    var run = lo;
    b = 0;
    while b < 256 {
        let k = cnt[b];
        cnt[b] = run;
        run = run + k;
        b = b + 1;
    }
    i = lo;
    while i < hi {
        let v = src[i];
        let g = digit(v, d);
        dst[cnt[g]] = v;
        cnt[g] = cnt[g] + 1;
        i = i + 1;
    }
    return 1;
}

// sort a[lo, hi) ascending (signed order) using t[lo, hi) as scratch; stable LSD radix, 8 bits a pass, passes whose byte is
// constant are skipped. The result is in a.
pub fn sort_range[&x, &y, &c](a: &!x [int], t: &!y [int], cnt: &!c [int], lo: int, hi: int) -> [] int {
    if hi - lo < 2 {
        return 0;
    }
    var in_a = true;
    var d = 0;
    while d < 8 {
        var moved = 0;
        if in_a {
            moved = pass(a, t, cnt, lo, hi, d);
        } else {
            moved = pass(t, a, cnt, lo, hi, d);
        }
        if moved == 1 {
            in_a = in_a == false;
        }
        d = d + 1;
    }
    if in_a == false {
        var i = lo;
        while i < hi {
            a[i] = t[i];
            i = i + 1;
        }
    }
    return 0;
}

pub fn auc[&h, &y, &s](heap: &!h Heap, y_true: &y [int], score: &s [float], pos: int, cap: int) -> [heap] rules.Scored {
    let n = len(y_true);
    let c = classify.check_size(n, len(score), cap, classify.ceiling_rows());
    if c != 0 {
        return rules.fail(c);
    }
    if regress.all_finite(score) == false {
        return rules.fail(rules.non_finite());
    }
    var np = 0;
    var other = pos;
    var have = false;
    var i = 0;
    while i < n {
        let t = y_true[i];
        if t == pos {
            np = np + 1;
        } else if have == false {
            other = t;
            have = true;
        } else if t != other {
            return rules.fail(rules.not_binary());
        }
        i = i + 1;
    }
    let nn = n - np;
    if np == 0 || nn == 0 {
        return rules.fail(rules.single_class());
    }
    // negatives in keys[0, nn), positives in keys[nn, n)
    let keys = box_slice(heap, n + 1, 0);
    let tmp = box_slice(heap, n + 1, 0);
    let cnt = box_slice(heap, 256, 0);
    var kk = keys;
    var tt = tmp;
    var cc = cnt;
    var two_u = 0;
    borrow mut kk as &!kw in {
        borrow mut tt as &!tw in {
            borrow mut cc as &!cw in {
                let a = contents(kw);
                let t = contents(tw);
                let k = contents(cw);
                var pn = 0;
                var pp = nn;
                i = 0;
                while i < n {
                    if y_true[i] == pos {
                        a[pp] = key_of(score[i]);
                        pp = pp + 1;
                    } else {
                        a[pn] = key_of(score[i]);
                        pn = pn + 1;
                    }
                    i = i + 1;
                }
                sort_range(a, t, k, 0, nn);
                sort_range(a, t, k, nn, n);
                var ni = 0;
                var pj = nn;
                while ni < nn || pj < n {
                    var v = 0;
                    if ni >= nn {
                        v = a[pj];
                    } else if pj >= n {
                        v = a[ni];
                    } else if a[ni] < a[pj] {
                        v = a[ni];
                    } else {
                        v = a[pj];
                    }
                    var q = 0;
                    while ni < nn && a[ni] == v {
                        ni = ni + 1;
                        q = q + 1;
                    }
                    var p = 0;
                    while pj < n && a[pj] == v {
                        pj = pj + 1;
                        p = p + 1;
                    }
                    let below = ni - q;
                    two_u = two_u + 2 * p * below + p * q;
                }
            }
        }
    }
    unbox_slice(heap, kk);
    unbox_slice(heap, tt);
    unbox_slice(heap, cc);
    return rules.ok(ratio.ratio(two_u, 2 * np * nn));
}
