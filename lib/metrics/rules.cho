module metrics.rules;

// The refusals of lib/metrics (docs/metrics.md section 4): a code (an int, 0 is "no refusal"), a stable rule tag, an exit code
// from the toolbox table (arguments 2, a limit or a parse failure 8). The codes are this library's own numbering (they are not
// ml.refuse's); the tags are design.md section 8's where they exist there. `table()` has the convention of tools/ml/spec.cho
// (tag|exit|repairable|summary, entries separated by `;`), so the wiring stage appends it to `extra()`.

pub fn count() -> [] int {
    return 11;
}

pub fn input_empty() -> [] int {
    return 1;
}

pub fn too_many_rows() -> [] int {
    return 2;
}

pub fn non_finite() -> [] int {
    return 3;
}

pub fn single_class() -> [] int {
    return 4;
}

pub fn not_binary() -> [] int {
    return 5;
}

pub fn undefined() -> [] int {
    return 6;
}

pub fn out_of_range() -> [] int {
    return 7;
}

pub fn length_mismatch() -> [] int {
    return 8;
}

pub fn bad_probability() -> [] int {
    return 9;
}

pub fn empty_fold() -> [] int {
    return 10;
}

pub fn stratum_too_small() -> [] int {
    return 11;
}

pub fn tag(code: int) -> [] &static [byte] {
    if code == 1 {
        return "ml.input.empty";
    }
    if code == 2 {
        return "ml.input.too-many-rows";
    }
    if code == 3 {
        return "ml.input.non-finite";
    }
    if code == 4 {
        return "ml.label.single-class";
    }
    if code == 5 {
        return "ml.label.not-binary";
    }
    if code == 6 {
        return "ml.metric.undefined";
    }
    if code == 7 {
        return "ml.param.out-of-range";
    }
    if code == 8 {
        return "ml.metric.length-mismatch";
    }
    if code == 9 {
        return "ml.metric.bad-probability";
    }
    if code == 10 {
        return "ml.split.empty-fold";
    }
    if code == 11 {
        return "ml.split.stratum-too-small";
    }
    return "";
}

// the toolbox exit code: arguments 2 (ml.param.out-of-range), a limit or a parse failure 8, no refusal 0
pub fn exit_code(code: int) -> [] int {
    if code == 7 {
        return 2;
    }
    if code >= 1 && code <= 11 {
        return 8;
    }
    return 0;
}

// tag|exit|repairable|summary, in the convention of tools/ml/spec.cho extra(); the order is the order of the codes
pub fn table() -> [] &static [byte] {
    return "ml.input.empty|8|never|a split of zero rows. Hint: give at least two rows. Repair: none.;ml.input.too-many-rows|8|never|more rows than the row cap. Hint: raise the cap up to its ceiling, or use a sample. Repair: none.;ml.input.non-finite|8|never|a score, target or prediction is nan or an infinity. Hint: remove the row or impute. Repair: none.;ml.label.single-class|8|never|ROC-AUC or a stratified split with one class. Hint: both classes must be present. Repair: none.;ml.label.not-binary|8|never|more than two distinct labels where two are needed. Hint: only two-class labels are built. Repair: none.;ml.metric.undefined|8|never|the metric has no value: empty input, a constant target for R-squared, a ratio with a zero denominator, a non-finite result. Hint: the fold or data has too little in it. Repair: none.;ml.param.out-of-range|2|never|k below 2, a test size out of range, a cap out of range or a negative repeat. Hint: the range is in detail. Repair: none.;ml.metric.length-mismatch|8|never|two arrays have different lengths. Hint: give one prediction per row. Repair: none.;ml.metric.bad-probability|8|never|a probability outside 0 to 1. Hint: log-loss needs the probability of the positive class. Repair: none.;ml.split.empty-fold|8|never|k is larger than the number of rows, or a train/test split would leave a side empty. Hint: use fewer folds or a smaller test size. Repair: none.;ml.split.stratum-too-small|8|never|a class has fewer rows than k. Hint: use fewer folds. Repair: none.";
}

// a metric's answer: the value, or the code of the refusal (v is 0.0 then)
pub struct Scored {
    code: int,
    v: float,
}

pub fn ok(v: float) -> [] Scored {
    return Scored { code: 0, v: v };
}

pub fn fail(code: int) -> [] Scored {
    return Scored { code: code, v: 0.0 };
}
