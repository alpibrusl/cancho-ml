module metrics.sums;

import linalg.order;

// The order of every decisive sum of the metrics (docs/metrics.md section 2.4): blocks of K = 256 terms, 4 lanes inside a block
// (term i of the block goes to lane i mod 4, each lane ascending from +0.0), block partial = (l0 + l1) + (l2 + l3), block
// partials combined by the fixed tree of linalg.order. `lanes` is this module's own constant: lib/linalg/order.cho has one
// chain per block.

pub fn lanes() -> [] int {
    return 4;
}

// the partial of buf[0 .. m), m <= 256
pub fn block_partial[&b](buf: &b [float], m: int) -> [] float {
    var s0 = 0.0;
    var s1 = 0.0;
    var s2 = 0.0;
    var s3 = 0.0;
    var j = 0;
    while j + 4 <= m {
        s0 = s0 + buf[j];
        s1 = s1 + buf[j + 1];
        s2 = s2 + buf[j + 2];
        s3 = s3 + buf[j + 3];
        j = j + 4;
    }
    if j < m {
        s0 = s0 + buf[j];
        j = j + 1;
    }
    if j < m {
        s1 = s1 + buf[j];
        j = j + 1;
    }
    if j < m {
        s2 = s2 + buf[j];
    }
    return s0 + s1 + (s2 + s3);
}

// term kinds of `terms`
pub fn kind_sq() -> [] int {
    return 1;
}

pub fn kind_abs() -> [] int {
    return 2;
}

pub fn kind_dev() -> [] int {
    return 3;
}

pub fn kind_val() -> [] int {
    return 4;
}

// buf[0 .. m) = the terms of rows [at, at + m): sq: (a - b)^2, abs: |a - b|, dev: (a - c)^2 with c = `center`, val: a
pub fn terms[&x, &y, &o](kind: int, a: &x [float], b: &y [float], center: float, at: int, m: int, buf: &!o [float]) -> [] int {
    var j = 0;
    if kind == 1 {
        while j < m {
            let e = a[at + j] - b[at + j];
            buf[j] = e * e;
            j = j + 1;
        }
    } else if kind == 2 {
        while j < m {
            let e = a[at + j] - b[at + j];
            if e < 0.0 {
                buf[j] = 0.0 - e;
            } else {
                buf[j] = e;
            }
            j = j + 1;
        }
    } else if kind == 3 {
        while j < m {
            let e = a[at + j] - center;
            buf[j] = e * e;
            j = j + 1;
        }
    } else {
        while j < m {
            buf[j] = a[at + j];
            j = j + 1;
        }
    }
    return 0;
}

// the decisive sum of n >= 1 terms of the given kind. buf has 256 floats, st 40 floats, lv 40 ints (the caller's workspace).
pub fn reduce[&x, &y, &o, &s, &l](kind: int, a: &x [float], b: &y [float], center: float, n: int, buf: &!o [float], st: &!s [float], lv: &!l [int]) -> [] float {
    var sp = 0;
    var at = 0;
    while at < n {
        var m = n - at;
        if m > 256 {
            m = 256;
        }
        terms(kind, a, b, center, at, m, buf);
        st[sp] = block_partial(buf, m);
        sp = order.settle(st, lv, sp, 1);
        at = at + m;
    }
    order.finish(st, sp, 1);
    return st[0];
}
