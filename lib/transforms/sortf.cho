module transforms.sortf;

// Sort the first n doubles of a slice ascending, in place. The values are finite (a reader never stores NaN or an infinity), so `<` is a
// total order and the result does not depend on the algorithm (equal values are equal doubles; docs/transforms.md section 2.5). Heap
// sort: O(n log n) in the worst case and no recursion, no allocation.

fn sift[&s](a: &!s [float], start: int, end: int) -> [] int {
    var root = start;
    while 2 * root + 1 < end {
        var child = 2 * root + 1;
        if child + 1 < end && a[child] < a[child + 1] {
            child = child + 1;
        }
        if a[root] < a[child] {
            let t = a[root];
            a[root] = a[child];
            a[child] = t;
            root = child;
        } else {
            return 0;
        }
    }
    return 0;
}

pub fn sort[&s](a: &!s [float], n: int) -> [] int {
    if n < 2 {
        return 0;
    }
    var i = n / 2 - 1;
    while i >= 0 {
        sift(a, i, n);
        i = i - 1;
    }
    var end = n - 1;
    while end > 0 {
        let t = a[0];
        a[0] = a[end];
        a[end] = t;
        sift(a, 0, end);
        end = end - 1;
    }
    return 0;
}

// the first n values are in ascending order
pub fn is_sorted[&s](a: &s [float], n: int) -> [] bool {
    var i = 1;
    while i < n {
        if a[i] < a[i - 1] {
            return false;
        }
        i = i + 1;
    }
    return true;
}
