module ml.kinds;

// The registry of the numbers two stages could claim twice (docs/design.md section 4.1 for the model kinds, docs/rng.md for the stream
// kinds). A number is never reused and never renumbered once a file or a stream depends on it. tests/t_registry.cho fails if two entries
// of either list are equal, or if a stage's own constant (models.record, tree.model, metrics.splits, models.kmeans, tools/ml/mfile.cho's
// readers) differs from this table; scripts/check_registry.py compares this file with the tables of the documents and with the places
// that still write a number (tree.grow's two stream kinds).

// ---- model kinds: the `u32 kind` that opens the payload of the `model` section of a CML1 file
pub fn model_const_regression() -> [] int {
    return 1;
}

pub fn model_const_classification() -> [] int {
    return 2;
}

pub fn model_const_float_regression() -> [] int {
    return 3;
}

pub fn model_linear() -> [] int {
    return 4;
}

pub fn model_logistic() -> [] int {
    return 5;
}

pub fn model_kmeans() -> [] int {
    return 6;
}

// decision tree or random forest; the task (classification or regression) is a field of the first record
pub fn model_tree() -> [] int {
    return 7;
}

// gradient-boosted trees (docs/models-boost.md); the task is a field of the first record
pub fn model_boost() -> [] int {
    return 8;
}

// multinomial logistic regression (docs/multiclass.md section 3)
pub fn model_softmax() -> [] int {
    return 9;
}

// a recommender (docs/recommend.md, docs/wiring-recommend.md section 5): ALS factors, the id tables and the history of the log
pub fn model_recommend() -> [] int {
    return 10;
}

pub fn model_count() -> [] int {
    return 10;
}

// ---- the sum order recorded in `meta` (docs/design.md section 4.1, `v1-post`): a model of a kind from first_ordered_model() on has a `u32 sum_order` as the
// last four bytes of its `meta`, equal to sum_order(); the constant models (kinds 1 to 3) have none. 1 was the order before `v1-lanes` (retired, never written).
pub fn first_ordered_model() -> [] int {
    return 4;
}

pub fn sum_order() -> [] int {
    return 2;
}

// the sum order of a tree or a forest (kind 7, docs/wiring-trees.md section 4): no lane sum is made, every float sum is a sequential left fold in a fixed row
// (or tree) order, docs/models-tree.md section 3.2. A file of kind 7 records this value instead of sum_order(), and a reader requires it exactly.
pub fn sum_order_sequential() -> [] int {
    return 3;
}

// the sum order a model of `kind` (4 or above) records in its meta
pub fn sum_order_for(kind: int) -> [] int {
    if kind == model_tree() {
        return sum_order_sequential();
    }
    if kind == model_boost() {
        return sum_order_sequential();
    }
    if kind == model_recommend() {
        return sum_order_sequential();
    }
    return sum_order();
}

// ---- stream kinds: derive(derive(seed, kind), index)
pub fn stream_tree_bootstrap() -> [] int {
    return 1;
}

pub fn stream_tree_features() -> [] int {
    return 2;
}

pub fn stream_kmeans() -> [] int {
    return 3;
}

pub fn stream_train_test() -> [] int {
    return 4;
}

pub fn stream_kfold() -> [] int {
    return 5;
}

pub fn stream_stratified() -> [] int {
    return 6;
}

// stratified holdout of `ml fit --split ... --stratify` (docs/splits.md section 3), index = the class rank
pub fn stream_strat_holdout() -> [] int {
    return 7;
}

// the shuffle of the groups of `--split-group` (docs/splits.md section 3), index = the repeat
pub fn stream_group() -> [] int {
    return 8;
}

// the row sample of a boosting round: derive(derive(seed, 9), round); the validation split of early stopping: derive(seed, 10) (docs/models-boost.md section 2.2).
// Boost first wrote 7 and 8; the splits took those numbers on main, so boost has 9 and 10 (docs/rng.md).
pub fn stream_boost_sample() -> [] int {
    return 9;
}

pub fn stream_boost_validation() -> [] int {
    return 10;
}

// the shuffle of one raw column by `ml importance --data` (docs/interpret.md section 3.4), derive(derive(derive(seed, 11), repeat), column)
pub fn stream_permutation() -> [] int {
    return 11;
}

// the initial item factors of an ALS fit (docs/recommend.md section 4.1), derive(derive(seed, 12), item)
pub fn stream_als_init() -> [] int {
    return 12;
}

pub fn stream_count() -> [] int {
    return 12;
}

// ---- section tags of the CML1 file (docs/design.md section 4.1; only tools/ml/mfile.cho and lib/pipeline/file.cho write them)
pub fn section_plan() -> [] int {
    return 1;
}

pub fn section_schema() -> [] int {
    return 2;
}

pub fn section_steps() -> [] int {
    return 3;
}

pub fn section_model() -> [] int {
    return 4;
}

pub fn section_meta() -> [] int {
    return 5;
}

// the string table, present only when a step of kind 7 to 10 needs it (docs/stringtable.md); a file has `core_sections()` sections, or one more with the table
pub fn section_strings() -> [] int {
    return 6;
}

// the provenance of the training data (docs/tracking.md section 2): the training file's SHA-256 and size, its rows, and the range of every numeric feature. Present in every file `fit`
// of this version writes (after the string table when there is one); a file of an older version has none. The section count of the header is 5, 6 or 7: the reader walks the tags.
pub fn section_provenance() -> [] int {
    return 7;
}

// the layout number of the provenance payload
pub fn provenance_layout() -> [] int {
    return 1;
}

pub fn core_sections() -> [] int {
    return 5;
}

pub fn section_count() -> [] int {
    return 7;
}

// the layout number of the string table, and the layout number that marks the 8-byte stub of a categorical step in the `steps` section (layout 1 is the full
// payload of docs/categorical-encoders.md section 5.2, which a file never holds)
pub fn table_layout() -> [] int {
    return 1;
}

pub fn stub_layout() -> [] int {
    return 2;
}

// ---- step kinds: the `u32 kind` that opens one step of the `steps` section (docs/transforms.md section 4)
pub fn step_impute() -> [] int {
    return 1;
}

pub fn step_minmax() -> [] int {
    return 2;
}

pub fn step_standard() -> [] int {
    return 3;
}

pub fn step_onehot() -> [] int {
    return 4;
}

pub fn step_label() -> [] int {
    return 5;
}

pub fn step_bucket() -> [] int {
    return 6;
}

// the numeric steps (kinds 1 to 6) are the only ones transforms.steps reads; the categorical steps (docs/categorical-encoders.md section 5.2) are transforms.catenc's
pub fn step_numeric_count() -> [] int {
    return 6;
}

pub fn step_cat_onehot() -> [] int {
    return 7;
}

pub fn step_cat_label() -> [] int {
    return 8;
}

pub fn step_freq() -> [] int {
    return 9;
}

pub fn step_hash() -> [] int {
    return 10;
}

pub fn step_count() -> [] int {
    return 10;
}

// ---- column kinds of the reader's shape (tools/ml/csv.cho `kind`; docs/categorical.md section 3) and the schema type code of a categorical column
// (docs/wiring.md section 3 reserved 3; the model file of a categorical fit writes it, docs/stringtable.md). The numeric kinds are inferred, widening only; the categorical one is only ever declared.
pub fn column_none() -> [] int {
    return 0;
}

pub fn column_int() -> [] int {
    return 1;
}

pub fn column_dec() -> [] int {
    return 2;
}

pub fn column_float() -> [] int {
    return 3;
}

pub fn column_categorical() -> [] int {
    return 4;
}

pub fn column_count() -> [] int {
    return 4;
}

// the schema type codes: 0 int, 1 dec, 2 float (tools/ml/mfile.cho), and 3 for a categorical column
pub fn schema_type_categorical() -> [] int {
    return 3;
}

// the number of the i-th entry of each list, 1 <= i <= count (0 beyond), for the registry test
pub fn model_at(i: int) -> [] int {
    if i == 1 {
        return model_const_regression();
    }
    if i == 2 {
        return model_const_classification();
    }
    if i == 3 {
        return model_const_float_regression();
    }
    if i == 4 {
        return model_linear();
    }
    if i == 5 {
        return model_logistic();
    }
    if i == 6 {
        return model_kmeans();
    }
    if i == 7 {
        return model_tree();
    }
    if i == 8 {
        return model_boost();
    }
    if i == 9 {
        return model_softmax();
    }
    if i == 10 {
        return model_recommend();
    }
    return 0;
}

pub fn stream_at(i: int) -> [] int {
    if i == 1 {
        return stream_tree_bootstrap();
    }
    if i == 2 {
        return stream_tree_features();
    }
    if i == 3 {
        return stream_kmeans();
    }
    if i == 4 {
        return stream_train_test();
    }
    if i == 5 {
        return stream_kfold();
    }
    if i == 6 {
        return stream_stratified();
    }
    if i == 7 {
        return stream_strat_holdout();
    }
    if i == 8 {
        return stream_group();
    }
    if i == 9 {
        return stream_boost_sample();
    }
    if i == 10 {
        return stream_boost_validation();
    }
    if i == 11 {
        return stream_permutation();
    }
    if i == 12 {
        return stream_als_init();
    }
    return 0;
}

pub fn section_at(i: int) -> [] int {
    if i == 1 {
        return section_plan();
    }
    if i == 2 {
        return section_schema();
    }
    if i == 3 {
        return section_steps();
    }
    if i == 4 {
        return section_model();
    }
    if i == 5 {
        return section_meta();
    }
    if i == 6 {
        return section_strings();
    }
    if i == 7 {
        return section_provenance();
    }
    return 0;
}

pub fn column_at(i: int) -> [] int {
    if i == 0 {
        return column_none();
    }
    if i == 1 {
        return column_int();
    }
    if i == 2 {
        return column_dec();
    }
    if i == 3 {
        return column_float();
    }
    if i == 4 {
        return column_categorical();
    }
    return 0 - 1;
}

pub fn step_at(i: int) -> [] int {
    if i == 1 {
        return step_impute();
    }
    if i == 2 {
        return step_minmax();
    }
    if i == 3 {
        return step_standard();
    }
    if i == 4 {
        return step_onehot();
    }
    if i == 5 {
        return step_label();
    }
    if i == 6 {
        return step_bucket();
    }
    if i == 7 {
        return step_cat_onehot();
    }
    if i == 8 {
        return step_cat_label();
    }
    if i == 9 {
        return step_freq();
    }
    if i == 10 {
        return step_hash();
    }
    return 0;
}
