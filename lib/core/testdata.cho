module ml.testdata;

import ml.rng;

// Test and benchmark inputs (docs/rng.md): element i of the data set of a seed is rng.element(seed, i). numpy rebuilds them
// bit for bit (scripts/oracle_linalg.py). The hash of a result is a wrapping sum over i of mix(bits_i ^ mix(i)), so that the
// order of a vectorised computation does not matter on the numpy side.

pub fn fill[&o](out: &!o [float], n: int, seed: int) -> [] int {
    var i = 0;
    while i < n {
        out[i] = rng.element(seed, i);
        i = i + 1;
    }
    return 0;
}

// a symmetric, strictly diagonally dominant (so positive definite) d x d matrix, row-major, all entries written:
// off-diagonal 0.5 * (E_ij + E_ji), diagonal d + 1 + E_ii, E = the data set of `seed`
pub fn spd[&o](out: &!o [float], d: int, seed: int) -> [] int {
    var i = 0;
    while i < d {
        var j = 0;
        while j < d {
            if i == j {
                out[i * d + j] = float_of(d) + 1.0 + rng.element(seed, i * d + j);
            } else {
                out[i * d + j] = 0.5 * (rng.element(seed, i * d + j) + rng.element(seed, j * d + i));
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}

pub fn hash[&v](vals: &v [float], n: int) -> [] int {
    var h = 0;
    var i = 0;
    while i < n {
        h = wrapping_add(h, rng.mix(bits_of(vals[i]) ^ rng.mix(i)));
        i = i + 1;
    }
    return h;
}
