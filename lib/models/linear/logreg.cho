module models.logreg;

import linalg.tensor;
import linalg.chol;
import linalg.dot;
import linalg.order;
import ml.refuse;
import ml.limits;
import models.common;
import models.score;
import models.mexp;
import models.npass;
import models.par;
import models.rank;

// Binary logistic regression by Newton's method, a fixed number of iterations, no line search, no stopping rule, optional l2
// that never touches the bias (docs/models-linear.md 3.2). The parameters are w[0..d) and the bias w[d], from zero.

// The loss bound of the separation test (docs/refusals-fit.md D2): ln 2 = 0.693147..., rounded down. A pass whose summed loss is below it has a positive margin on every
// row: the w it started from classifies every training row, so the classes are separated and, with l2 = 0, no optimum exists.
pub fn separable_bound() -> [] float {
    return 0.6931;
}

// The scale bound of the second separation test (docs/refusals-fit.md D2): the root mean square of the linear predictor z over the training rows, which does not depend on the
// units of the features. A maximum-likelihood fit has predictions that saturate only as far as the data force it (a probability of 1e-9 is z = -20.7); a root mean square
// of 50 means probabilities of 2e-22: the fit is running away along a direction that separates the classes completely or with ties (quasi-complete separation, which the
// loss test does not see: the tied rows keep a loss of ln 2 each).
pub fn scale_bound() -> [] float {
    return 50.0;
}

// sqrt(w' G w / n) for the Gram matrix G of the columns with the bias: slot 0 of diag holds the decisive sums of pass 0, where w = 0, so its Hessian part is G / (4 n)
fn predictor_scale[&w, &g](p: int, nf: float, wv: &w [float], diag: &g [float]) -> [] float {
    var q = 0.0;
    var a = 0;
    while a < p {
        var b = 0;
        while b <= a {
            let t = wv[a] * wv[b] * (diag[p + a * (a + 1) / 2 + b] / nf);
            if a == b {
                q = q + t;
            } else {
                q = q + 2.0 * t;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    if q < 0.0 {
        q = 0.0;
    }
    return sqrt(4.0 * q);
}

// The record of a separation refusal in diag (floats): [0] the pass, [1] the reason (0 the summed loss was under the bound, 1 the pivot test failed at a pass after the
// first, 2 the predictor scale was over its bound), [2] the summed loss of the pass, [3] the Euclidean norm of w (the bias included), [4] the largest diagonal element of
// the Hessian of pass 0 (diag holds its sums in slot 0), [5] the predictor scale. Everything is read before anything is written.
fn note_separable[&w, &g](p: int, ww: int, nf: float, it: int, reason: int, loss: float, wv: &w [float], diag: &!g [float]) -> [] int {
    var hmax = 0.0;
    var a = 0;
    while a < p {
        let v = diag[p + a * (a + 1) / 2 + a] / nf;
        if v > hmax {
            hmax = v;
        }
        a = a + 1;
    }
    var q = 0.0;
    a = 0;
    while a < p {
        q = q + wv[a] * wv[a];
        a = a + 1;
    }
    let sc = predictor_scale(p, nf, wv, diag);
    diag[0] = float_of(it);
    diag[1] = float_of(reason);
    diag[2] = loss;
    diag[3] = sqrt(q);
    diag[4] = hmax;
    diag[5] = sc;
    return 0;
}

// the iterations. xs positioned at X[0, 0], row stride rs; kind 1, or 4 with ys of 2 n values (the labels, then the weights), nf the divisor of the sums (n, or the sum
// of the weights) and wmin the smallest positive weight (1.0 unweighted: docs/weights.md 2.3). diag receives, per iteration, the W raw sums then the objective.
fn newton[&h, &x, &y, &o, &g](heap: &!h Heap, t: int, kind: int, xs: &x [float], rs: int, ys: &y [float], n: int, d: int, iters: int, l2: float, nf: float, wmin: float, out: &!o [float], diag: &!g [float]) -> [heap, conc] int {
    let p = d + 1;
    let ww = npass.width(d);
    let sl = npass.scratch_len(d);
    let depth = common.depth_for(order.blocks(n));
    let wv = box_slice(heap, p, 0.0);
    let sc = box_slice(heap, sl, 0.0);
    let st = box_slice(heap, depth * ww, 0.0);
    let lv = box_slice(heap, depth + 1, 0);
    let hm = box_slice(heap, p * p, 0.0);
    let lm = box_slice(heap, p * p, 0.0);
    let gv = box_slice(heap, p, 0.0);
    let uv = box_slice(heap, p, 0.0);
    let dl = box_slice(heap, p, 0.0);
    let nolab = box_slice(heap, 1, 0);
    var code = 0;
    var it = 0;
    while it < iters && code == 0 {
        borrow wv as &wr in {
            borrow mut sc as &!scw in {
                borrow mut st as &!stw in {
                    borrow mut lv as &!lvw in {
                        borrow mut nolab as &!nlw in {
                            code = par.pass(heap, t, kind, xs, rs, ys, contents(wr), n, d, 0, ww, sl, contents(scw), contents(stw), contents(lvw), contents(nlw));
                        }
                    }
                }
            }
        }
        if code == 0 {
            borrow st as &sr in {
                let sums = contents(sr);
                var i = 0;
                var finite = true;
                while i < ww {
                    diag[it * (ww + 1) + i] = sums[i];
                    if !common.is_finite(sums[i]) {
                        finite = false;
                    }
                    i = i + 1;
                }
                if !finite {
                    code = refuse.fit_non_finite();
                } else {
                    borrow wv as &wr in {
                        let w = contents(wr);
                        // the objective at the w this iteration started from
                        var q = 0.0;
                        var j = 0;
                        while j < d {
                            q = q + w[j] * w[j];
                            j = j + 1;
                        }
                        diag[it * (ww + 1) + ww] = sums[ww - 1] / nf + 0.5 * l2 * q;
                        // g = sums / n (+ l2 * w on the d feature entries), H = sums / n (+ l2 on the d feature diagonal entries)
                        borrow mut gv as &!gw in {
                            var a = 0;
                            while a < p {
                                var gg = sums[a] / nf;
                                if a < d {
                                    gg = gg + l2 * w[a];
                                }
                                contents(gw)[a] = gg;
                                a = a + 1;
                            }
                        }
                        borrow mut hm as &!hw in {
                            var a = 0;
                            while a < p {
                                var b = 0;
                                while b <= a {
                                    var hh = sums[p + a * (a + 1) / 2 + b] / nf;
                                    if a < d && b == a {
                                        hh = hh + l2;
                                    }
                                    contents(hw)[a * p + b] = hh;
                                    b = b + 1;
                                }
                                a = a + 1;
                            }
                        }
                    }
                }
            }
        }
        if code == 0 && l2 == 0.0 {
            // separation (docs/refusals-fit.md D2): the summed loss of the pass is one of the decisive sums already computed
            borrow st as &sr in {
                borrow wv as &wr in {
                    let loss = contents(sr)[ww - 1];
                    if loss < wmin * separable_bound() {
                        note_separable(p, ww, nf, it, 0, loss, contents(wr), diag);
                        code = refuse.fit_separable();
                    } else if predictor_scale(p, nf, contents(wr), diag) > scale_bound() {
                        note_separable(p, ww, nf, it, 2, loss, contents(wr), diag);
                        code = refuse.fit_separable();
                    }
                }
            }
        }
        if code == 0 {
            borrow hm as &hr in {
                borrow mut lm as &!lw in {
                    code = chol.cholesky(common.mat(p, p), contents(hr), common.mat(p, p), contents(lw));
                }
            }
            if code == refuse.not_positive_definite() {
                if it == 0 {
                    // the Hessian of the first pass is the Gram matrix over 4n (plus l2): the columns are dependent (docs/refusals-fit.md D1)
                    borrow hm as &hr in {
                        if rank.record(heap, p, contents(hr), 0, diag) >= 0 {
                            code = refuse.fit_collinear();
                        }
                    }
                } else if l2 == 0.0 {
                    // the first Hessian passed, so the columns are not dependent: the weights have vanished, the numerical face of separation
                    borrow st as &sr in {
                        borrow wv as &wr in {
                            let loss = contents(sr)[ww - 1];
                            note_separable(p, ww, nf, it, 1, loss, contents(wr), diag);
                            code = refuse.fit_separable();
                        }
                    }
                }
            }
        }
        if code == 0 {
            borrow lm as &lr in {
                borrow gv as &gr in {
                    borrow mut uv as &!uw in {
                        code = chol.solve(0, common.mat(p, p), contents(lr), common.vec(p), contents(gr), common.vec(p), contents(uw));
                    }
                }
                if code == 0 {
                    borrow uv as &ur in {
                        borrow mut dl as &!dw in {
                            code = chol.solve(1, common.mat(p, p), contents(lr), common.vec(p), contents(ur), common.vec(p), contents(dw));
                        }
                    }
                }
            }
        }
        if code == 0 {
            borrow dl as &dr in {
                borrow mut wv as &!wm in {
                    var a = 0;
                    while a < p {
                        contents(wm)[a] = contents(wm)[a] - contents(dr)[a];
                        if !common.is_finite(contents(wm)[a]) {
                            code = refuse.fit_non_finite();
                        }
                        a = a + 1;
                    }
                }
            }
        }
        it = it + 1;
    }
    if code == 0 {
        borrow wv as &wr in {
            var a = 0;
            while a < p {
                out[a] = contents(wr)[a];
                a = a + 1;
            }
        }
    }
    unbox_slice(heap, wv);
    unbox_slice(heap, sc);
    unbox_slice(heap, st);
    unbox_slice(heap, lv);
    unbox_slice(heap, hm);
    unbox_slice(heap, lm);
    unbox_slice(heap, gv);
    unbox_slice(heap, uv);
    unbox_slice(heap, dl);
    unbox_slice(heap, nolab);
    return code;
}

// Fit. xt: n x d rank 2, d <= 256; y: n values, each exactly 0.0 or 1.0, both present; iters in 1..1000; l2 >= 0 finite; out: d + 1
// values (the bias last); diag: iters * (W + 1) values, W = npass.width(d) = P + P (P + 1) / 2 + 1 with P = d + 1: per iteration the W raw
// decisive sums (g, the lower triangle of H by rows, the bias row, the summed loss) and the objective at the start of the iteration.
pub fn fit[&h, &x, &y, &o, &g](heap: &!h Heap, t: int, xt: tensor.Tensor, xd: &x [float], yd: &y [float], iters: int, l2: float, out: &!o [float], diag: &!g [float]) -> [heap, conc] int {
    if limits.check_threads(t) != 0 {
        return refuse.threads();
    }
    var c = common.check_iters(iters);
    if c != 0 {
        return c;
    }
    c = common.check_l2(l2);
    if c != 0 {
        return c;
    }
    c = common.check_x(xt, len(xd), common.max_features());
    if c != 0 {
        return c;
    }
    let n = xt.s0;
    let d = xt.s1;
    let p = d + 1;
    let ww = npass.width(d);
    if ww > common.max_slot() {
        return refuse.param_out_of_range();
    }
    c = common.check_len(n, len(yd));
    if c != 0 {
        return c;
    }
    c = common.check_len(p, len(out));
    if c != 0 {
        return c;
    }
    if iters > len(diag) / (ww + 1) {
        return refuse.tensor_bounds();
    }
    if common.count_bad(xd[xt.off..len(xd)], xt.t0, n, d) != 0 || common.count_bad_vec(yd, n) != 0 {
        return refuse.input_non_finite();
    }
    var ones = 0;
    var i = 0;
    while i < n {
        if yd[i] == 1.0 {
            ones = ones + 1;
        } else if yd[i] != 0.0 {
            return refuse.label_not_binary();
        }
        i = i + 1;
    }
    if ones == 0 || ones == n {
        return refuse.label_single_class();
    }
    return newton(heap, t, 1, xd[xt.off..len(xd)], xt.t0, yd, n, d, iters, l2, float_of(n), 1.0, out, diag);
}

// Fit with a weight per row (docs/weights.md section 2.3). wd: n weights, each finite, 0 <= w <= 1e12, not all 0; both classes must have a row of positive
// weight. Same shapes of out and diag as `fit`. The sums are divided by the sum of the weights.
pub fn fit_weighted[&h, &x, &y, &w, &o, &g](heap: &!h Heap, t: int, xt: tensor.Tensor, xd: &x [float], yd: &y [float], wd: &w [float], iters: int, l2: float, out: &!o [float], diag: &!g [float]) -> [heap, conc] int {
    if limits.check_threads(t) != 0 {
        return refuse.threads();
    }
    var c = common.check_iters(iters);
    if c != 0 {
        return c;
    }
    c = common.check_l2(l2);
    if c != 0 {
        return c;
    }
    c = common.check_x(xt, len(xd), common.max_features());
    if c != 0 {
        return c;
    }
    let n = xt.s0;
    let d = xt.s1;
    let p = d + 1;
    let ww = npass.width(d);
    if ww > common.max_slot() {
        return refuse.param_out_of_range();
    }
    c = common.check_len(n, len(yd));
    if c != 0 {
        return c;
    }
    c = common.check_len(n, len(wd));
    if c != 0 {
        return c;
    }
    c = common.check_len(p, len(out));
    if c != 0 {
        return c;
    }
    if iters > len(diag) / (ww + 1) {
        return refuse.tensor_bounds();
    }
    if common.count_bad(xd[xt.off..len(xd)], xt.t0, n, d) != 0 || common.count_bad_vec(yd, n) != 0 {
        return refuse.input_non_finite();
    }
    c = common.check_weights(wd, n);
    if c != 0 {
        return c;
    }
    // the classes are judged on the rows that have a weight
    var ones = 0;
    var zeros = 0;
    var wmin = 0.0;
    var i = 0;
    while i < n {
        if yd[i] != 1.0 && yd[i] != 0.0 {
            return refuse.label_not_binary();
        }
        if wd[i] > 0.0 {
            if yd[i] == 1.0 {
                ones = ones + 1;
            } else {
                zeros = zeros + 1;
            }
            if wmin == 0.0 || wd[i] < wmin {
                wmin = wd[i];
            }
        }
        i = i + 1;
    }
    if ones == 0 || zeros == 0 {
        return refuse.label_single_class();
    }
    // the sum of the weights: the package's dot with ones (the same order at any thread count), once
    let one = box_slice(heap, n, 1.0);
    var sw = 0.0;
    borrow one as &onr in {
        let r = dot.dot(heap, common.vec(n), wd[0..n], common.vec(n), contents(onr));
        c = r.code;
        sw = r.v;
    }
    unbox_slice(heap, one);
    if c != 0 {
        return c;
    }
    if !common.is_finite(sw) || sw <= 0.0 {
        return refuse.fit_non_finite();
    }
    let yw = box_slice(heap, 2 * n, 0.0);
    borrow mut yw as &!yq in {
        var k = 0;
        while k < n {
            contents(yq)[k] = yd[k];
            contents(yq)[n + k] = wd[k];
            k = k + 1;
        }
    }
    var code = 0;
    borrow yw as &yr in {
        code = newton(heap, t, 4, xd[xt.off..len(xd)], xt.t0, contents(yr), n, d, iters, l2, sw, wmin, out, diag);
    }
    unbox_slice(heap, yw);
    return code;
}

// the probability of class 1: e = exp(-|z|); 1 / (1 + e) for z >= 0, else e / (1 + e)
pub fn proba_of(z: float) -> [] float {
    var az = z;
    if z < 0.0 {
        az = 0.0 - z;
    }
    let e = mexp.exp(0.0 - az);
    if z >= 0.0 {
        return 1.0 / (1.0 + e);
    }
    return e / (1.0 + e);
}

pub fn predict_proba[&x, &w, &o](xt: tensor.Tensor, xd: &x [float], wv: &w [float], out: &!o [float]) -> [] int {
    let c = score.scores(xt, xd, wv, out);
    if c != 0 {
        return c;
    }
    var i = 0;
    while i < xt.s0 {
        out[i] = proba_of(out[i]);
        i = i + 1;
    }
    return 0;
}

// class 1.0 if the score z > 0.0, else 0.0
pub fn predict[&x, &w, &o](xt: tensor.Tensor, xd: &x [float], wv: &w [float], out: &!o [float]) -> [] int {
    let c = score.scores(xt, xd, wv, out);
    if c != 0 {
        return c;
    }
    var i = 0;
    while i < xt.s0 {
        if out[i] > 0.0 {
            out[i] = 1.0;
        } else {
            out[i] = 0.0;
        }
        i = i + 1;
    }
    return 0;
}
