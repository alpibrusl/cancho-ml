module models.npass;

import models.mexp;

// One block of the Newton pass of logistic regression (docs/models-linear.md 3.2): the partial of the W decisive sums over the
// rows [r0, r1) of one block (at most 256), each sum ascending from +0.0 over the rows of the block, in the rows' order. The
// partials of the blocks are combined by the package's tree (linalg.order), by the caller.
//
// The loop is the tuned one of cancho-ml-opt and cancho-ml-armb (docs/spikes.md 8.3) with one change of shape: instead of a
// rank-1 update of 231 accumulators per row (a load and a store each), the block is staged. Phase 1 reads the rows once, eight at
// a time (eight independent chains of z, eight independent exps), copies each row into the scratch A (zero padded to pd columns,
// a multiple of 4), and keeps r, s and the loss term of each row. Phase 2 makes SX = s * A and the gradient and bias-row
// accumulators. Phase 3 forms the lower triangle of H = SX^T A in 4 x 4 register tiles held across the block's rows (the tiles
// of linalg.syrk). Every sum receives the same terms, ascending in the row, as the per-row version: the terms are
// fl(r * a_ia), fl(fl(s * a_ia) * a_ib), fl(s * a_ib) for the bias row, and the loss.
//
// Scratch layout (floats), pd = 4 * ceil(d / 4): A 256*pd, SX 256*pd, hacc pd*pd, gacc pd, hb pd, rr 256, ss 256.

pub fn pad(d: int) -> [] int {
    return (d + 3) / 4 * 4;
}

pub fn scratch_len(d: int) -> [] int {
    let pd = pad(d);
    return 512 * pd + pd * pd + 2 * pd + 512 + 8;
}

// number of sums: P + P (P + 1) / 2 + 1, P = d + 1
pub fn width(d: int) -> [] int {
    let p = d + 1;
    return p + p * (p + 1) / 2 + 1;
}

// r, s and the loss term of a row with score z and label y. No data-dependent branch: the two forms of the sigmoid differ in
// the numerator only (1 for z >= 0, e otherwise), and the sign of z is a select.
fn row_terms(z: float, y: float) -> [] (float, float, float) {
    var az = z;
    if z < 0.0 {
        az = 0.0 - z;
    }
    let e = mexp.exp(0.0 - az);
    var num = e;
    var pos = 0.0;
    if z >= 0.0 {
        num = 1.0;
        pos = z;
    }
    let p = num / (1.0 + e);
    let r = p - y;
    let s = p * (1.0 - p);
    let loss = pos + mexp.log1p(e) - y * z;
    return (r, s, loss);
}

// eight rows i0 .. i0 + 7 (local indices into the block, absolute rows r0 + i): the scores, A, r, s, and the loss added in row order
fn rows8[&x, &y, &w, &a, &q, &u](xs: &x [float], rs: int, ys: &y [float], r0: int, i0: int, d: int, pd: int, wv: &w [float], am: &!a [float], rr: &!q [float], ss: &!u [float], lsum0: float) -> [] float {
    let x0 = xs[(r0 + i0 + 0) * rs..(r0 + i0 + 0) * rs + d];
    let x1 = xs[(r0 + i0 + 1) * rs..(r0 + i0 + 1) * rs + d];
    let x2 = xs[(r0 + i0 + 2) * rs..(r0 + i0 + 2) * rs + d];
    let x3 = xs[(r0 + i0 + 3) * rs..(r0 + i0 + 3) * rs + d];
    let x4 = xs[(r0 + i0 + 4) * rs..(r0 + i0 + 4) * rs + d];
    let x5 = xs[(r0 + i0 + 5) * rs..(r0 + i0 + 5) * rs + d];
    let x6 = xs[(r0 + i0 + 6) * rs..(r0 + i0 + 6) * rs + d];
    let x7 = xs[(r0 + i0 + 7) * rs..(r0 + i0 + 7) * rs + d];
    let a0 = am[(i0 + 0) * pd..(i0 + 0) * pd + d];
    let a1 = am[(i0 + 1) * pd..(i0 + 1) * pd + d];
    let a2 = am[(i0 + 2) * pd..(i0 + 2) * pd + d];
    let a3 = am[(i0 + 3) * pd..(i0 + 3) * pd + d];
    let a4 = am[(i0 + 4) * pd..(i0 + 4) * pd + d];
    let a5 = am[(i0 + 5) * pd..(i0 + 5) * pd + d];
    let a6 = am[(i0 + 6) * pd..(i0 + 6) * pd + d];
    let a7 = am[(i0 + 7) * pd..(i0 + 7) * pd + d];
    let wr = wv[0..d];
    let b = wv[d];
    var z0 = b;
    var z1 = b;
    var z2 = b;
    var z3 = b;
    var z4 = b;
    var z5 = b;
    var z6 = b;
    var z7 = b;
    var j = 0;
    while j < d {
        let wj = wr[j];
        let v0 = x0[j];
        let v1 = x1[j];
        let v2 = x2[j];
        let v3 = x3[j];
        let v4 = x4[j];
        let v5 = x5[j];
        let v6 = x6[j];
        let v7 = x7[j];
        a0[j] = v0;
        a1[j] = v1;
        a2[j] = v2;
        a3[j] = v3;
        a4[j] = v4;
        a5[j] = v5;
        a6[j] = v6;
        a7[j] = v7;
        z0 = z0 + v0 * wj;
        z1 = z1 + v1 * wj;
        z2 = z2 + v2 * wj;
        z3 = z3 + v3 * wj;
        z4 = z4 + v4 * wj;
        z5 = z5 + v5 * wj;
        z6 = z6 + v6 * wj;
        z7 = z7 + v7 * wj;
        j = j + 1;
    }
    let (r0t, s0t, l0t) = row_terms(z0, ys[r0 + i0 + 0]);
    let (r1t, s1t, l1t) = row_terms(z1, ys[r0 + i0 + 1]);
    let (r2t, s2t, l2t) = row_terms(z2, ys[r0 + i0 + 2]);
    let (r3t, s3t, l3t) = row_terms(z3, ys[r0 + i0 + 3]);
    let (r4t, s4t, l4t) = row_terms(z4, ys[r0 + i0 + 4]);
    let (r5t, s5t, l5t) = row_terms(z5, ys[r0 + i0 + 5]);
    let (r6t, s6t, l6t) = row_terms(z6, ys[r0 + i0 + 6]);
    let (r7t, s7t, l7t) = row_terms(z7, ys[r0 + i0 + 7]);
    rr[i0 + 0] = r0t;
    rr[i0 + 1] = r1t;
    rr[i0 + 2] = r2t;
    rr[i0 + 3] = r3t;
    rr[i0 + 4] = r4t;
    rr[i0 + 5] = r5t;
    rr[i0 + 6] = r6t;
    rr[i0 + 7] = r7t;
    ss[i0 + 0] = s0t;
    ss[i0 + 1] = s1t;
    ss[i0 + 2] = s2t;
    ss[i0 + 3] = s3t;
    ss[i0 + 4] = s4t;
    ss[i0 + 5] = s5t;
    ss[i0 + 6] = s6t;
    ss[i0 + 7] = s7t;
    var l = lsum0;
    l = l + l0t;
    l = l + l1t;
    l = l + l2t;
    l = l + l3t;
    l = l + l4t;
    l = l + l5t;
    l = l + l6t;
    l = l + l7t;
    return l;
}

fn row1[&x, &y, &w, &a, &q, &u](xs: &x [float], rs: int, ys: &y [float], r0: int, i: int, d: int, pd: int, wv: &w [float], am: &!a [float], rr: &!q [float], ss: &!u [float], lsum0: float) -> [] float {
    let x0 = xs[(r0 + i) * rs..(r0 + i) * rs + d];
    let a0 = am[i * pd..i * pd + d];
    let wr = wv[0..d];
    var z0 = wv[d];
    var j = 0;
    while j < d {
        let v0 = x0[j];
        a0[j] = v0;
        z0 = z0 + v0 * wr[j];
        j = j + 1;
    }
    let (r0t, s0t, l0t) = row_terms(z0, ys[r0 + i]);
    rr[i] = r0t;
    ss[i] = s0t;
    return lsum0 + l0t;
}

// the 4 x 4 tile of SX^T A at (a0, b0) over the m rows of the block, into hacc (pd x pd). Offsets carried (wrapping adds).
fn tile44[&s, &a, &h](sx: &s [float], am: &a [float], pd: int, m: int, a0: int, b0: int, hacc: &!h [float]) -> [] int {
    var c00 = 0.0;
    var c01 = 0.0;
    var c02 = 0.0;
    var c03 = 0.0;
    var c10 = 0.0;
    var c11 = 0.0;
    var c12 = 0.0;
    var c13 = 0.0;
    var c20 = 0.0;
    var c21 = 0.0;
    var c22 = 0.0;
    var c23 = 0.0;
    var c30 = 0.0;
    var c31 = 0.0;
    var c32 = 0.0;
    var c33 = 0.0;
    var po = a0;
    var qo = b0;
    var i = 0;
    while i < m {
        let p = sx[po..wrapping_add(po, 4)];
        let q = am[qo..wrapping_add(qo, 4)];
        po = wrapping_add(po, pd);
        qo = wrapping_add(qo, pd);
        let u0 = p[0];
        let u1 = p[1];
        let u2 = p[2];
        let u3 = p[3];
        let v0 = q[0];
        let v1 = q[1];
        let v2 = q[2];
        let v3 = q[3];
        c00 = c00 + u0 * v0;
        c01 = c01 + u0 * v1;
        c02 = c02 + u0 * v2;
        c03 = c03 + u0 * v3;
        c10 = c10 + u1 * v0;
        c11 = c11 + u1 * v1;
        c12 = c12 + u1 * v2;
        c13 = c13 + u1 * v3;
        c20 = c20 + u2 * v0;
        c21 = c21 + u2 * v1;
        c22 = c22 + u2 * v2;
        c23 = c23 + u2 * v3;
        c30 = c30 + u3 * v0;
        c31 = c31 + u3 * v1;
        c32 = c32 + u3 * v2;
        c33 = c33 + u3 * v3;
        i = i + 1;
    }
    let o0 = hacc[(a0 + 0) * pd + b0..(a0 + 0) * pd + b0 + 4];
    o0[0] = c00;
    o0[1] = c01;
    o0[2] = c02;
    o0[3] = c03;
    let o1 = hacc[(a0 + 1) * pd + b0..(a0 + 1) * pd + b0 + 4];
    o1[0] = c10;
    o1[1] = c11;
    o1[2] = c12;
    o1[3] = c13;
    let o2 = hacc[(a0 + 2) * pd + b0..(a0 + 2) * pd + b0 + 4];
    o2[0] = c20;
    o2[1] = c21;
    o2[2] = c22;
    o2[3] = c23;
    let o3 = hacc[(a0 + 3) * pd + b0..(a0 + 3) * pd + b0 + 4];
    o3[0] = c30;
    o3[1] = c31;
    o3[2] = c32;
    o3[3] = c33;
    return 0;
}

// The partial of rows [r0, r1) (at most 256) into slot (W values). xs is positioned at X[0, 0] with row stride rs, ys at y[0]; wv
// holds the d + 1 parameters; sc is the scratch (scratch_len(d)), zero on entry for the first block and left in a state that only
// ever differs from zero in columns [0, d) of A (the padding columns are never written).
pub fn block[&x, &y, &w, &c, &s](xs: &x [float], rs: int, ys: &y [float], r0: int, r1: int, d: int, wv: &w [float], sc: &!c [float], slot: &!s [float]) -> [] int {
    let pd = pad(d);
    let m = r1 - r0;
    let am = sc[0..256 * pd];
    let sx = sc[256 * pd..512 * pd];
    let hacc = sc[512 * pd..512 * pd + pd * pd];
    let gacc = sc[512 * pd + pd * pd..512 * pd + pd * pd + pd];
    let hb = sc[512 * pd + pd * pd + pd..512 * pd + pd * pd + 2 * pd];
    let rr = sc[512 * pd + pd * pd + 2 * pd..512 * pd + pd * pd + 2 * pd + 256];
    let ss = sc[512 * pd + pd * pd + 2 * pd + 256..512 * pd + pd * pd + 2 * pd + 512];
    // phase 1: scores, A, r, s, the loss
    var lsum = 0.0;
    var i = 0;
    while i + 8 <= m {
        lsum = rows8(xs, rs, ys, r0, i, d, pd, wv, am, rr, ss, lsum);
        i = i + 8;
    }
    while i < m {
        lsum = row1(xs, rs, ys, r0, i, d, pd, wv, am, rr, ss, lsum);
        i = i + 1;
    }
    // phase 2: SX = s * A; gradient and bias-row accumulators, ascending in the row
    var j = 0;
    while j < pd {
        gacc[j] = 0.0;
        hb[j] = 0.0;
        j = j + 1;
    }
    var gb = 0.0;
    var hbb = 0.0;
    i = 0;
    while i < m {
        let ar = am[i * pd..i * pd + pd];
        let sr = sx[i * pd..i * pd + pd];
        let ri = rr[i];
        let si = ss[i];
        j = 0;
        while j < pd {
            let v = ar[j];
            let t = si * v;
            gacc[j] = gacc[j] + ri * v;
            hb[j] = hb[j] + t;
            sr[j] = t;
            j = j + 1;
        }
        gb = gb + ri;
        hbb = hbb + si;
        i = i + 1;
    }
    // phase 3: the lower triangle of H (b <= a) in 4 x 4 tiles
    var a0 = 0;
    while a0 < pd {
        var b0 = 0;
        while b0 <= a0 {
            tile44(sx, am, pd, m, a0, b0, hacc);
            b0 = b0 + 4;
        }
        a0 = a0 + 4;
    }
    // the slot: g (d + 1), H rows a < d, the bias row, the loss
    let p = d + 1;
    var a = 0;
    while a < d {
        slot[a] = gacc[a];
        let row = slot[p + a * (a + 1) / 2..p + a * (a + 1) / 2 + a + 1];
        let hr = hacc[a * pd..a * pd + a + 1];
        var b = 0;
        while b <= a {
            row[b] = hr[b];
            b = b + 1;
        }
        a = a + 1;
    }
    slot[d] = gb;
    let brow = slot[p + d * (d + 1) / 2..p + d * (d + 1) / 2 + d + 1];
    var b = 0;
    while b < d {
        brow[b] = hb[b];
        b = b + 1;
    }
    brow[d] = hbb;
    slot[p + p * (p + 1) / 2] = lsum;
    return 0;
}
