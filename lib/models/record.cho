module models.record;

import ml.fbits;

// Tensor records of the model file (docs/design.md 4.1, docs/models-linear.md 3.4): u32 dtype | u32 rank | rank x u64 shape | the
// elements row-major, all little-endian. dtype 1 = i64 (tools/ml/mfile.cho), dtype 2 = f64 (new here). The estimator payload of the
// `model` section is u32 kind then records: kind 4 linear (coef: rank 1, d; intercept: rank 1, 1), kind 5 logistic (the same), kind 6
// k-means (centroids: rank 2, k x d). Nothing here is wired into tools/ml/mfile.cho yet.

pub fn dtype_f64() -> [] int {
    return 2;
}

pub fn kind_linear() -> [] int {
    return 4;
}

pub fn kind_logistic() -> [] int {
    return 5;
}

pub fn kind_kmeans() -> [] int {
    return 6;
}

// the statuses of a decode
pub fn ok() -> [] int {
    return 0;
}

pub fn truncated() -> [] int {
    return 1;
}

pub fn bad_dtype() -> [] int {
    return 2;
}

pub fn bad_shape() -> [] int {
    return 3;
}

pub fn bad_value() -> [] int {
    return 4;
}

pub fn put32[&d](dst: &!d [byte], at: int, v: int) -> [] int {
    var k = 0;
    while k < 4 {
        dst[at + k] = byte_of(v >> 8 * k & 255);
        k = k + 1;
    }
    return 0;
}

pub fn get32[&s](src: &s [byte], at: int) -> [] int {
    var v = 0;
    var k = 3;
    while k >= 0 {
        v = v << 8 | int_of(src[at + k]);
        k = k - 1;
    }
    return v;
}

// bytes of a record of the given rank and element count
pub fn size(rank: int, count: int) -> [] int {
    return 8 + 8 * rank + 8 * count;
}

// write a rank 1 (s1 = 0) or rank 2 f64 record of vals at `at` in dst (which must hold size() bytes from `at`); answers the end offset
pub fn encode_f64[&d, &v](dst: &!d [byte], at: int, rank: int, s0: int, s1: int, vals: &v [float]) -> [] int {
    var pos = at;
    put32(dst, pos, dtype_f64());
    put32(dst, pos + 4, rank);
    pos = pos + 8;
    fbits.put64(dst, pos, s0);
    pos = pos + 8;
    var count = s0;
    if rank == 2 {
        fbits.put64(dst, pos, s1);
        pos = pos + 8;
        count = s0 * s1;
    }
    fbits.store(vals, dst, pos, count);
    return pos + 8 * count;
}

// the result of a decode: a status, the rank, the extents and the offset after the record
pub struct Rec {
    code: int,
    rank: int,
    s0: int,
    s1: int,
    end: int,
}

fn rec(code: int, rank: int, s0: int, s1: int, end: int) -> [] Rec {
    return Rec { code: code, rank: rank, s0: s0, s1: s1, end: end };
}

// Read a record at `at` of src: the structure is checked against the bytes that are there and against `max_count` before out is
// written; the elements go to out (which must hold max_count values). A non-finite or not reproducible element is bad_value.
pub fn decode_f64[&s, &o](src: &s [byte], at: int, max_count: int, out: &!o [float]) -> [] Rec {
    if at < 0 || len(src) - at < 16 {
        return rec(truncated(), 0, 0, 0, at);
    }
    if get32(src, at) != dtype_f64() {
        return rec(bad_dtype(), 0, 0, 0, at);
    }
    let rank = get32(src, at + 4);
    if rank < 1 || rank > 2 {
        return rec(bad_shape(), rank, 0, 0, at);
    }
    var pos = at + 8;
    if len(src) - pos < 8 * rank {
        return rec(truncated(), rank, 0, 0, at);
    }
    let s0 = fbits.get64(src, pos);
    pos = pos + 8;
    var s1 = 0;
    var count = s0;
    if rank == 2 {
        s1 = fbits.get64(src, pos);
        pos = pos + 8;
        if s0 < 1 || s1 < 1 || s0 > max_count / s1 {
            return rec(bad_shape(), rank, s0, s1, at);
        }
        count = s0 * s1;
    } else if s0 < 1 || s0 > max_count {
        return rec(bad_shape(), rank, s0, s1, at);
    }
    if count > max_count {
        return rec(bad_shape(), rank, s0, s1, at);
    }
    if (len(src) - pos) / 8 < count {
        return rec(truncated(), rank, s0, s1, at);
    }
    if fbits.load(src, pos, out, count) != 0 {
        return rec(bad_value(), rank, s0, s1, at);
    }
    return rec(ok(), rank, s0, s1, pos + 8 * count);
}

// bytes of the payload of a linear or logistic model with d features
pub fn linear_size(d: int) -> [] int {
    return 4 + size(1, d) + size(1, 1);
}

pub fn kmeans_size(k: int, d: int) -> [] int {
    return 4 + size(2, k * d);
}

// kind | coef record | intercept record, from w = (coef[0..d), intercept); answers the end offset
pub fn encode_linear[&d, &w](dst: &!d [byte], at: int, kind: int, nfeat: int, wv: &w [float]) -> [] int {
    put32(dst, at, kind);
    var pos = encode_f64(dst, at + 4, 1, nfeat, 0, wv[0..nfeat]);
    pos = encode_f64(dst, pos, 1, 1, 0, wv[nfeat..nfeat + 1]);
    return pos;
}

pub fn encode_kmeans[&d, &c](dst: &!d [byte], at: int, k: int, nfeat: int, cen: &c [float]) -> [] int {
    put32(dst, at, kind_kmeans());
    return encode_f64(dst, at + 4, 2, k, nfeat, cen[0..k * nfeat]);
}

// ---------------------------------------------------------------- the payloads the wiring reads and writes (docs/wiring.md section 4)

pub fn dtype_i64() -> [] int {
    return 1;
}

// a decoded payload: code 0 or 1 (malformed: any field outside what the layout allows), the two labels of a classifier, the offset after it
pub struct Decoded {
    code: int,
    c0: int,
    c1: int,
    end: int,
}

pub fn decoded(code: int, c0: int, c1: int, end: int) -> [] Decoded {
    return Decoded { code: code, c0: c0, c1: c1, end: end };
}

// bytes of the logistic payload: the linear one and the labels record
pub fn logistic_size(d: int) -> [] int {
    return linear_size(d) + size(1, 2);
}

// an i64 record of rank 1 with two elements; answers the end offset
pub fn encode_labels[&d](dst: &!d [byte], at: int, c0: int, c1: int) -> [] int {
    put32(dst, at, dtype_i64());
    put32(dst, at + 4, 1);
    fbits.put64(dst, at + 8, 2);
    fbits.put64(dst, at + 16, c0);
    fbits.put64(dst, at + 24, c1);
    return at + 32;
}

// the largest class label: 999,999,999,999
pub fn label_max() -> [] int {
    return 999999999999;
}

// the labels record at `at`: (ok, c0, c1, end). The two labels differ and are within +- label_max().
pub fn decode_labels[&s](src: &s [byte], at: int) -> [] Decoded {
    if at < 0 || len(src) - at < 32 {
        return decoded(1, 0, 0, at);
    }
    if get32(src, at) != dtype_i64() || get32(src, at + 4) != 1 || fbits.get64(src, at + 8) != 2 {
        return decoded(1, 0, 0, at);
    }
    let a = fbits.get64(src, at + 16);
    let b = fbits.get64(src, at + 24);
    // a label is an integer column's value: at most 12 digits (a longer integer column is a float and is no class label), so a file with a label past that was not written by fit
    // and its printing (which negates the label) cannot overflow
    if a == b || a < 0 - label_max() || a > label_max() || b < 0 - label_max() || b > label_max() {
        return decoded(1, 0, 0, at);
    }
    return decoded(0, a, b, at + 32);
}

// kind | coef (shape [d]) | intercept (shape [1]) [| labels]: the parameters to out (d + 1 values, the intercept last), then the labels when `labels`.
// The payload must end where the layout does.
pub fn decode_linear[&s, &o](src: &s [byte], kind: int, d: int, labels: bool, out: &!o [float]) -> [] Decoded {
    if len(src) < 4 || get32(src, 0) != kind || d < 1 {
        return decoded(1, 0, 0, 0);
    }
    let r1 = decode_f64(src, 4, d, out[0..d]);
    if r1.code != 0 || r1.rank != 1 || r1.s0 != d {
        return decoded(1, 0, 0, 0);
    }
    let r2 = decode_f64(src, r1.end, 1, out[d..d + 1]);
    if r2.code != 0 || r2.rank != 1 || r2.s0 != 1 {
        return decoded(1, 0, 0, 0);
    }
    if !labels {
        if r2.end != len(src) {
            return decoded(1, 0, 0, 0);
        }
        return decoded(0, 0, 0, r2.end);
    }
    let r3 = decode_labels(src, r2.end);
    if r3.code != 0 || r3.end != len(src) {
        return decoded(1, 0, 0, 0);
    }
    return r3;
}
