nput.empty\",\"ml.input.too-many-rows\",\"ml.input.too-many-columns\",\"ml.input.too-many-cells\",\"ml.input.non-numeric\",\"ml.input.non-finite\",\"ml.input.duplicate-column\",\"ml.input.unknown-column\",\"parse.csv-ragged-row\",\"parse.csv-bad-quote\",\"parse.csv-unterminated-quote\",\"ml.label.single-class\",\"ml.label.not-binary\",\"ml.label.not-integer\",\"ml.metric.undefined\",\"ml.schema.mismatch\",\"ml.model.bad-magic\",\"ml.model.version\",\"ml.model.truncated\",\"ml.model.checksum\",\"ml.model.malformed\",\"ml.linalg.not-positive-definite\",\"ml.param.threads\",\"ml.fit.non-finite\",\"ml.fit.collinear\",\"ml.fit.separable\",\"ml.predict.non-finite\",\"ml.split.empty-fold\",\"ml.split.stratify-target\",\"ml.split.stratum-too-small\",\"ml.split.too-few-groups\",\"ml.split.time-format\",\"ml.split.missing-cell\",\"ml.split.combination\",\"ml.split.out-of-range\",\"ml.split.column-target\",\"ml.split.emit-too-large\",\"ml.fit.all-missing\",\"ml.limit.categories\",\"ml.limit.string-bytes\",\"ml.limit.string-pool\",\"ml.limit.categorical-columns\",\"ml.input.invalid-utf8\",\"ml.input.categorical-not-encoded\",\"ml.input.unknown-category\",\"ml.plan.column-kind\",\"ml.input.reserved-category\",\"ml.model.string-table\",\"ml.limit.string-table\",\"ml.plan.syntax\",\"ml.plan.unknown-step\",\"ml.plan.unknown-key\",\"ml.plan.missing-key\",\"ml.plan.bad-value\",\"ml.plan.duplicate-key\",\"ml.plan.model-line\",\"ml.plan.unknown-column\",\"ml.limit.plan\",\"ml.input.missing-value\",\"ml.plan.model-not-built\",\"ml.limit.depth\",\"ml.limit.nodes\",\"ml.predict.out-of-range\",\"ml.predict.no-provenance\",\"ml.runs.conflict\",\"ml.runs.too-many\",\"ml.runs.record-too-large\",\"ml.runs.not-found\",\"ml.runs.unknown-model\",\"ml.runs.damaged\",\"ml.runs.data-changed\",\"ml.runs.model-differs\",\"ml.runs.not-replayable\",\"ml.jsonl.syntax\",\"ml.jsonl.not-object\",\"ml.jsonl.missing-field\",\"ml.jsonl.not-scalar\",\"ml.jsonl.duplicate-key\",\"ml.jsonl.type-mismatch\",\"ml.jsonl.mixed-kinds\",\"ml.jsonl.too-many-nodes\",\"ml.importance.unsupported-model\",\"ml.importance.no-scale\",\"ml.importance.bad-metric\",\"ml.importance.undefined-metric\",\"ml.importance.too-few-rows\",\"ml.limit.work\",\"ml.dump.unsupported-model\",\"ml.label.unseen\",\"ml.limit.classes\",\"ml.limit.parameters\",\"ml.weight.missing\",\"ml.weight.negative\",\"ml.weight.too-large\",\"ml.weight.zero-total\",\"ml.rank.bad-relevance\",\"ml.rank.group-missing\",\"ml.limit.group-size\",\"ml.limit.pairs\",\"ml.split.group-required\",\"mcp.read-only\",\"mcp.record-column\",\"serve.number-not-exact\",\"serve.string-not-renderable\"]},\"text_or_bytes\":{\"description\":\"UTF-8 text as a string; other bytes as base64 (RFC 4648 section 4, padded).\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"object\",\"properties\":{\"b64\":{\"type\":\"string\",\"pattern\":\"^[A-Za-z0-9+/]*={0,2}$\"}},\"required\":[\"b64\"],\"additionalProperties\":false}]}}},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}},{\"name\":\"cv\",\"title\":\"cv\",\"description\":\"Fit, apply and score a model on a CSV file, with the refusals of a tool an agent can read. Usage of the command line this tool is: `ml [--root DIR] [--model constant|linear|logistic|kmeans|tree|forest|boost|softmax] [--plan PLAN | --step STEPS] [--target NAME] [--folds K] [--repeats R] [--stratify | --split-group COLUMN | --split-by time:COLUMN] [--group COLUMN] [--rank-k K] [--gain exp|linear] [--emit-folds] [--seed N] [--threads N] [--drop NAMES] [--format json|text] cv FILE`. Values the library refuses (ranges, conflicts between flags, unknown columns) come back as a tool error with the rule, the exit code and the repair.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"model\":{\"type\":\"string\",\"enum\":[\"constant\",\"linear\",\"logistic\",\"kmeans\",\"tree\",\"forest\",\"boost\",\"softmax\"],\"default\":\"constant\",\"description\":\"the model fit builds: constant (supported), linear (supported), logistic (supported), kmeans (supported), tree (supported), forest (supported), boost (supported), softmax (experimental). constant (the default) is the training mean for a regression and the majority class with its probability for a classification. linear fits by least squares and logistic by Newton's method and kmeans clusters the rows around k centres by a fixed number of Lloyd iterations and needs no target (--k, --iterations, --init, --seed) and tree is a CART decision tree with histogram splits (--task chooses classification or regression) and forest is a bagged random forest of such trees, parallel over trees (--task, --trees, --seed) and boost is a gradient-boosted ensemble of such trees, fitted round by round to the gradients of the squared-error or the logistic loss (--task, --rounds, --learning-rate, --subsample, --early-stopping, --seed). All but constant are fitted through the pipeline of --plan or --step. A name outside this list is args.bad-value\"},\"task\":{\"type\":\"string\",\"enum\":[\"regression\",\"classification\",\"ranking\",\"lambdarank\"],\"default\":\"regression\",\"description\":\"what the target column is: a number to predict (regression), a label with exactly two values (classification) or a graded relevance 0 to 30 whose order inside a group is learned (ranking, boost only, needs --group, docs/ranking.md). It is also the task of a tree or forest, which serve both and never guess it from the target. kmeans is a clustering and takes no task\"},\"target\":{\"type\":\"string\",\"minLength\":1,\"description\":\"fit: the name of the column to predict, as the header spells it. Every model but kmeans needs it, and kmeans has no target and refuses the flag (args.conflict)\"},\"drop\":{\"type\":\"string\",\"minLength\":1,\"description\":\"columns to ignore, header names separated by commas (fit, predict, eval, importance). A dropped column is not part of the stored schema, and its cells are not read as numbers (it may hold text, quoted fields and line breaks)\"},\"float\":{\"type\":\"string\",\"minLength\":1,\"description\":\"fit: columns to read as floating point whatever their cells are, header names separated by commas. A column with an exponent, a leading or trailing point or more than 12 digits is a float without being named. A float is read to the nearest double, ties to even, by cancho-table's exact reader (pinned, not copied). On a float target the constant is the exact sum of the doubles over the count, rounded once\"},\"cat\":{\"type\":\"string\",\"minLength\":1,\"description\":\"fit: columns to read as categorical text, header names separated by commas (docs/categorical.md). Every cell of such a column is a string, compared byte for byte: no case folding, no trimming, no Unicode normalisation, and it must be well-formed UTF-8. The distinct strings of a column are kept in a dictionary sorted bytewise (the id of a string is its rank), so the result does not depend on the order of the rows or on --threads. An empty cell and a cell equal to a --na-values marker are missing. A text column that is not named here is refused (ml.input.non-numeric). The target, a dropped column and a --float column cannot be named. The columns are encoded by the steps encode, freq and hash of a planned model (docs/categorical-encoders.md). A declared column that no step reads is refused with ml.input.categorical-not-encoded. The model file stores the training strings of every encoded column (a hash step stores none), so predict and eval read the columns by name from the file alone\"},\"na-values\":{\"type\":\"string\",\"minLength\":1,\"description\":\"fit, with --cat: strings that mean missing in a categorical column besides the empty cell, separated by commas (so a marker holds no comma), for example NA,?. At most 64 markers of 1 to 255 bytes. A marker is compared with the whole cell, byte for byte, after unquoting. Numeric columns are not affected\"},\"max-categories\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1024,\"default\":64,\"description\":\"fit, with --cat: the most distinct values in one categorical column, 1 to 1024. More is ml.limit.categories, at the value that passes the limit, before anything is stored for it\"},\"max-string-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":65536,\"default\":255,\"description\":\"fit, with --cat: the longest cell of a categorical column in bytes, 1 to 65536. A longer one is ml.limit.string-bytes\"},\"max-pool-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":8388608,\"default\":1048576,\"description\":\"fit, with --cat: the most bytes of all the distinct categories of all the categorical columns together, 1 to 8388608. More is ml.limit.string-pool\"},\"max-cat-columns\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":4096,\"default\":128,\"description\":\"fit, with --cat: the most categorical columns, 1 to 4096. More is ml.limit.categorical-columns, before the file is read past its header\"},\"plan\":{\"type\":\"string\",\"minLength\":1,\"description\":\"fit: a plan text file (steps and a final model line, docs/pipeline.md section 2) for a model other than constant. It is the one description of the fit: --model, --step, --task and the hyperparameter flags are then args.conflict. The canonical plan is stored in the model file\"},\"step\":{\"type\":\"string\",\"minLength\":1,\"description\":\"fit: the steps of the pipeline of a model other than constant, written verb key=value as in a plan, several separated by semicolons (ASCII 59), for example impute column=* strategy=mean then scale column=a,b kind=standard. The flag may be given once. The model line is built from --model and the hyperparameter flags\"},\"bins\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":255,\"default\":64,\"description\":\"the quantile bins of the split search\"},\"bootstrap\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1,\"default\":1,\"description\":\"1 draws the rows of each tree with replacement, 0 uses every row once\"},\"early-stopping\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1000,\"default\":0,\"description\":\"0 is off, N stops after N rounds without a better loss on a tenth of the training rows kept for it (needs --split)\"},\"init\":{\"type\":\"string\",\"enum\":[\"random\",\"kmeans++\"],\"default\":\"kmeans++\",\"description\":\"how the initial centres are drawn from the seed: random (seeded rows without repetition) or kmeans++ (each next centre drawn in proportion to its squared distance to the nearest chosen)\"},\"iterations\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1000,\"description\":\"logistic: the Newton iterations, a fixed number: 1 to 1000 (default 100). kmeans: the Lloyd iterations, a fixed number: 1 to 1000 (default 10). softmax: the Newton iterations, a fixed number: 1 to 1000 (default 100)\"},\"k\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1024,\"description\":\"the number of clusters of a kmeans fit: required, 1 to 1024 and at most the number of training rows\"},\"l2\":{\"type\":\"string\",\"minLength\":1,\"description\":\"linear: the ridge penalty, a finite number, 0 or more. The intercept is not penalised (default 0.0). logistic: the ridge penalty, a finite number, 0 or more. The intercept is not penalised (default 0.0). boost: the ridge penalty of the leaf values and of the split gain, a finite number, 0 or more (default 1.0). softmax: the ridge penalty, a finite number, 0 or more. The intercepts are not penalised (default 0.0)\"},\"learning-rate\":{\"type\":\"string\",\"minLength\":1,\"default\":\"0.1\",\"description\":\"the shrinkage applied to each tree, above 0 and at most 1 (else ml.param.out-of-range)\"},\"max-depth\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1000,\"description\":\"the deepest tree: 1 to 1000 are accepted and a depth above 30 is refused with ml.limit.depth\"},\"max-nodes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":999999999,\"default\":4194304,\"description\":\"tree: the most nodes one tree may have: above 4194304, or fewer than the tree needs, is ml.limit.nodes (a tree is never cut). dump: the most nodes of the tree printed, at most 4194304 (absent: 10000) (default 4194304). forest: the most nodes one tree may have: above 4194304, or fewer than the tree needs, is ml.limit.nodes (a tree is never cut). dump: the most nodes of the tree printed, at most 4194304 (absent: 10000) (default 4194304). boost: the most nodes one tree may have: above 4194304, or fewer than the tree needs, is ml.limit.nodes (a tree is never cut) (default 4194304)\"},\"min-leaf\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1000000,\"description\":\"the fewest rows in a leaf\"},\"mtry\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":4096,\"default\":0,\"description\":\"the features tried at each node, 0 for floor of the square root of d (classification) or d over 3 (regression): above d is ml.param.out-of-range\"},\"rounds\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":10000,\"default\":100,\"description\":\"the number of boosting rounds, one tree each (fewer are kept when early stopping ends the fit)\"},\"subsample\":{\"type\":\"string\",\"minLength\":1,\"default\":\"1.0\",\"description\":\"the fraction of the rows each boosting round fits its tree on, above 0 and at most 1 (else ml.param.out-of-range)\"},\"trees\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1024,\"default\":100,\"description\":\"the number of trees\"},\"positive\":{\"type\":\"string\",\"minLength\":1,\"description\":\"fit, eval: the positive label of a two-class classification (logistic, tree, forest or boost: a softmax model of three or more classes has none and refuses it). fit: the label whose probability the model predicts (default: the larger of the two labels). eval: the label that precision, recall, F1, ROC-AUC and log-loss are about (default: the model's own)\"},\"split\":{\"type\":\"string\",\"minLength\":1,\"description\":\"fit, eval: train=F with 0 < F < 1 (at most 6 digits after the point). fit trains on the train rows and reports the held-out rows. eval scores the test rows only. The rows are chosen by the seeded train/test split of lib/metrics (--seed), the test side being ceil(n * (1 - F)) rows\"},\"seed\":{\"type\":\"integer\",\"minimum\":0,\"default\":0,\"description\":\"importance: the seed of the permutation streams (the stream registry, kind 11). fit, eval: the seed of --split (the stream registry, kind 4), of the bootstrap and feature draws of a tree or forest (kinds 1 and 2) and of the initial centres of kmeans (kind 3): one flag, so a forest fitted with --split draws its bootstrap from the seed that chose the split. Stored in the model file\"},\"threads\":{\"type\":\"integer\",\"minimum\":0,\"default\":1,\"description\":\"fit, eval, importance, runs verify: the threads of the numeric kernels, 1 to 64 (ml.param.threads outside). No thread count changes a byte of the model file or of the answer. In eval and importance nothing is threaded and the flag is checked and unused. In runs verify it is the thread count of the refit\"},\"stratify\":{\"type\":\"boolean\",\"description\":\"fit, eval, cv: hold the rows out (or deal them into folds) so that each class keeps its share: with --split, per class the held-out rows are the floor or the ceiling of its exact share, and with cv, per class and fold the count is the floor or the ceiling of the class size over --folds. A classification target only (ml.split.stratify-target otherwise). Not with --split-by or --split-group (ml.split.combination)\"},\"split-by\":{\"type\":\"string\",\"minLength\":1,\"description\":\"fit, eval, cv: time:COLUMN orders the rows by COLUMN, a number or an ISO-8601 date or datetime (YYYY-MM-DD, then T or a space, hh:mm, optional :ss, optional .fraction of 1 to 9 digits, optional Z, no numeric offset). With --split the oldest train=F of the rows train and the newest test, and with cv the rows are cut into folds+1 blocks and fold i trains on blocks 0 to i and tests on block i+1 (an expanding window). Ties keep the order of the file. A text column needs --drop. Not with --stratify or --split-group\"},\"split-group\":{\"type\":\"string\",\"minLength\":1,\"description\":\"fit, eval, cv: COLUMN names a column (text or integer) whose values are groups: all the rows of a group are on one side of --split, or in one fold of cv. Groups are compared byte for byte and assigned by the seeded stream. A text column needs --drop. Not with --stratify or --split-by\"},\"weight\":{\"type\":\"string\",\"minLength\":1,\"description\":\"fit, cv: the name of the column that holds the weight of each training row, as the header spells it: a number from 0 to 1e12, and a row of weight w counts as w copies of the row in the fit. Only --model linear, logistic, tree, forest and boost take it. The column is not a feature and is not stored in the model file, and the held-out rows are scored without weights. Not the target, not in --drop or --cat. docs/weights.md\"},\"group\":{\"type\":\"string\",\"minLength\":1,\"description\":\"fit, eval, cv, predict (with --rank): the name of the column that holds the group of each row (a query id: any text or integer) for --task ranking or lambdarank (the pairs weighted by the change in NDCG), as the header spells it. The rows of a group are ranked together, in file order. The column is not a feature and is not stored in the schema of the model file. The group split is implied: fit --split and cv put every group wholly on one side. Not the target, not in --drop or --cat. docs/ranking.md\"},\"rank-k\":{\"type\":\"integer\",\"minimum\":0,\"default\":10,\"description\":\"eval, cv: the cut-off k of the ranking metrics NDCG@k, MAP@k, MRR@k, precision@k and recall@k, 1 to 4096, and 0 is the whole group. docs/ranking.md\"},\"gain\":{\"type\":\"string\",\"enum\":[\"exp\",\"linear\"],\"default\":\"exp\",\"description\":\"eval, cv: the gain of NDCG, 2^rel - 1 (exp) or rel (linear). docs/ranking.md\"},\"folds\":{\"type\":\"integer\",\"minimum\":0,\"default\":5,\"description\":\"cv: the number of folds, 2 to 20 (ml.split.out-of-range outside)\"},\"repeats\":{\"type\":\"integer\",\"minimum\":0,\"default\":1,\"description\":\"importance with --data: how many times each column is permuted, 1 to 100 (absent: 5). cv: how many times the fold assignment is drawn again with the next index of the stream, 1 to 10. The mean and the standard deviation are over all folds of all repeats. Not above 1 with --split-by\"},\"emit-folds\":{\"type\":\"boolean\",\"description\":\"fit, eval, cv: put the assignment of the rows in the answer: for each row (in file order) the fold, or 0 for a train row and 1 for a held-out row of --split. At most 1048576 entries (ml.split.emit-too-large)\"},\"max-rows\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1000000000,\"default\":10000000,\"description\":\"the most data rows read. More is ml.input.too-many-rows\"},\"max-columns\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":8192,\"default\":4096,\"description\":\"the most columns read. More is ml.input.too-many-columns\"},\"max-cells\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1099511627776,\"default\":400000000,\"description\":\"the most rows times columns. More is ml.input.too-many-cells\"},\"max-line-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":16777216,\"default\":1048576,\"description\":\"the longest line read. A longer one is limit.line-too-long\"},\"max-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":268435456,\"default\":16777216,\"description\":\"fit: the largest model file written, the limit predict and eval apply when they read it. A larger one is limit.input-too-large and nothing is written. predict, eval, describe: the largest model file read. A larger one is limit.input-too-large. predict from standard input (the operand - or none): the CSV is held in memory, so this is also the most bytes of standard input read. More is limit.input-too-large\"},\"input-format\":{\"type\":\"string\",\"enum\":[\"csv\",\"jsonl\",\"ndjson\"],\"default\":\"csv\",\"description\":\"fit, predict, eval, cv: the format of the input. jsonl (and its spelling ndjson) is JSON lines: one JSON object a line, read into the columns that fit declares with --fields (predict and eval read the columns of the model file, by key, in any order, and ignore other keys). A number is its exact text, a string is text, null is a missing cell, a key a line lacks is --absent, true and false are text in a --cat column and refused in a number column, an object or an array is refused (docs/jsonl.md section 3). The model file is the one fitted from the equivalent CSV except the identity of the training file in its provenance section (its SHA-256 and size). Never guessed from the name or the bytes\"},\"fields\":{\"type\":\"string\",\"minLength\":1,\"description\":\"fit and cv, with --input-format jsonl: the columns, the keys of the top-level object, separated by commas, in the order of the table. Required for jsonl at fit and cv. A name is the key itself (a dot is part of it, no path is followed) and holds no comma\"},\"absent\":{\"type\":\"string\",\"enum\":[\"refuse\",\"empty\"],\"default\":\"refuse\",\"description\":\"jsonl input: what a declared key that a line does not hold is. refuse is ml.jsonl.missing-field, empty is a missing cell. A null value is a missing cell either way\"},\"max-json-nodes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1048576,\"default\":4096,\"description\":\"jsonl input: the most JSON nodes a line may hold (a value, and a key, is a node), 1 to 1048576. A line with more is ml.jsonl.too-many-nodes before anything is sized by it\"},\"file\":{\"type\":\"string\",\"minLength\":1,\"description\":\"the CSV file, relative to the server's root\"}},\"required\":[\"file\"],\"additionalProperties\":false},\"outputSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"One JSON object on one line. ok is false exactly when errors is present; error is its first element. A dry run (fit --dry-run) has ok true, exit 9, dry_run and planned_actions. No float appears: every decimal is a string with its digits exact.\",\"type\":\"object\",\"properties\":{\"ok\":{\"type\":\"boolean\"},\"command\":{\"const\":\"ml\"},\"schema\":{\"const\":\"ml.v1\"},\"data\":{\"$ref\":\"#/$defs/data\"},\"dry_run\":{\"const\":true},\"planned_actions\":{\"type\":\"array\",\"items\":{\"oneOf\":[{\"type\":\"object\",\"properties\":{\"op\":{\"enum\":[\"create\",\"replace\"]},\"path\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"bytes\":{\"type\":\"integer\",\"minimum\":0},\"sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"}},\"required\":[\"op\",\"path\",\"bytes\",\"sha256\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"op\":{\"const\":\"create\"},\"dir\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"file\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"bytes\":{\"type\":\"integer\",\"minimum\":0},\"sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"}},\"required\":[\"op\",\"dir\",\"file\",\"bytes\",\"sha256\"],\"additionalProperties\":false}]}},\"error\":{\"$ref\":\"#/$defs/error\"},\"errors\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/$defs/error\"},\"minItems\":1},\"meta\":{\"$ref\":\"#/$defs/meta\"}},\"required\":[\"ok\",\"command\",\"schema\",\"meta\"],\"additionalProperties\":false,\"allOf\":[{\"if\":{\"properties\":{\"ok\":{\"const\":true}}},\"then\":{\"not\":{\"anyOf\":[{\"required\":[\"error\"]},{\"required\":[\"errors\"]}]}},\"else\":{\"required\":[\"error\",\"errors\"]}}],\"title\":\"ml.v1 cv\",\"$defs\":{\"data\":{\"type\":\"object\",\"properties\":{\"model\":{\"enum\":[\"linear\",\"logistic\",\"kmeans\",\"tree\",\"forest\",\"boost\",\"softmax\"]},\"task\":{\"enum\":[\"regression\",\"classification\",\"clustering\",\"ranking\"]},\"target\":{\"oneOf\":[{\"$ref\":\"#/$defs/text_or_bytes\"},{\"type\":\"null\"}]},\"rows\":{\"type\":\"integer\",\"minimum\":0},\"columns\":{\"type\":\"integer\",\"minimum\":0},\"plan\":{\"type\":\"string\"},\"split\":{\"type\":\"string\"},\"strategy\":{\"enum\":[\"kfold\",\"stratified\",\"group\",\"time\"]},\"folds\":{\"type\":\"integer\",\"minimum\":0},\"repeats\":{\"type\":\"integer\",\"minimum\":0},\"results\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"repeat\":{\"type\":\"integer\",\"minimum\":0},\"fold\":{\"type\":\"integer\",\"minimum\":0},\"train\":{\"type\":\"integer\",\"minimum\":0},\"test\":{\"type\":\"integer\",\"minimum\":0},\"metrics\":{\"oneOf\":[{\"type\":\"object\",\"properties\":{\"rmse\":{\"oneOf\":[{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?(e[+-]?[0-9]+)?$\"},{\"type\":\"null\"}]},\"mae\":{\"oneOf\":[{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?(e[+-]?[0-9]+)?$\"},{\"type\":\"null\"}]},\"r2\":{\"oneOf\":[{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?(e[+-]?[0-9]+)?$\"},{\"type\":\"null\"}]}},\"required\":[\"rmse\",\"mae\",\"r2\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"accuracy\":{\"oneOf\":[{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?(e[+-]?[0-9]+)?$\"},{\"type\":\"null\"}]},\"precision\":{\"oneOf\":[{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?(e[+-]?[0-9]+)?$\"},{\"type\":\"null\"}]},\"recall\":{\"oneOf\":[{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?(e[+-]?[0-9]+)?$\"},{\"type\":\"null\"}]},\"f1\":{\"oneOf\":[{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?(e[+-]?[0-9]+)?$\"},{\"type\":\"null\"}]},\"roc_auc\":{\"oneOf\":[{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?(e[+-]?[0-9]+)?$\"},{\"type\":\"null\"}]},\"log_loss\":{\"oneOf\":[{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?(e[+-]?[0-9]+)?$\"},{\"type\":\"null\"}]}},\"required\":[\"accuracy\",\"precision\",\"recall\",\"f1\",\"roc_auc\",\"log_loss\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"inertia\":{\"oneOf\":[{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\