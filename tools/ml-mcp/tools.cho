imit.log-full\",\"ml.param.out-of-range\",\"ml.input.empty\",\"ml.input.too-many-rows\",\"ml.input.too-many-columns\",\"ml.input.too-many-cells\",\"ml.input.non-numeric\",\"ml.input.non-finite\",\"ml.input.duplicate-column\",\"ml.input.unknown-column\",\"parse.csv-ragged-row\",\"parse.csv-bad-quote\",\"parse.csv-unterminated-quote\",\"ml.label.single-class\",\"ml.label.not-binary\",\"ml.label.not-integer\",\"ml.metric.undefined\",\"ml.schema.mismatch\",\"ml.model.bad-magic\",\"ml.model.version\",\"ml.model.truncated\",\"ml.model.checksum\",\"ml.model.malformed\",\"ml.linalg.not-positive-definite\",\"ml.param.threads\",\"ml.fit.non-finite\",\"ml.fit.collinear\",\"ml.fit.separable\",\"ml.predict.non-finite\",\"ml.split.empty-fold\",\"ml.split.stratify-target\",\"ml.split.stratum-too-small\",\"ml.split.too-few-groups\",\"ml.split.time-format\",\"ml.split.missing-cell\",\"ml.split.combination\",\"ml.split.out-of-range\",\"ml.split.column-target\",\"ml.split.emit-too-large\",\"ml.fit.all-missing\",\"ml.limit.categories\",\"ml.limit.string-bytes\",\"ml.limit.string-pool\",\"ml.limit.categorical-columns\",\"ml.input.invalid-utf8\",\"ml.input.categorical-not-encoded\",\"ml.input.unknown-category\",\"ml.plan.column-kind\",\"ml.input.reserved-category\",\"ml.model.string-table\",\"ml.limit.string-table\",\"ml.plan.syntax\",\"ml.plan.unknown-step\",\"ml.plan.unknown-key\",\"ml.plan.missing-key\",\"ml.plan.bad-value\",\"ml.plan.duplicate-key\",\"ml.plan.model-line\",\"ml.plan.unknown-column\",\"ml.limit.plan\",\"ml.input.missing-value\",\"ml.plan.model-not-built\",\"ml.limit.depth\",\"ml.limit.nodes\",\"ml.predict.out-of-range\",\"ml.predict.no-provenance\",\"ml.runs.conflict\",\"ml.runs.too-many\",\"ml.runs.record-too-large\",\"ml.runs.not-found\",\"ml.runs.unknown-model\",\"ml.runs.damaged\",\"ml.runs.data-changed\",\"ml.runs.model-differs\",\"ml.runs.not-replayable\",\"ml.jsonl.syntax\",\"ml.jsonl.not-object\",\"ml.jsonl.missing-field\",\"ml.jsonl.not-scalar\",\"ml.jsonl.duplicate-key\",\"ml.jsonl.type-mismatch\",\"ml.jsonl.mixed-kinds\",\"ml.jsonl.too-many-nodes\",\"ml.importance.unsupported-model\",\"ml.importance.no-scale\",\"ml.importance.bad-metric\",\"ml.importance.undefined-metric\",\"ml.importance.too-few-rows\",\"ml.limit.work\",\"ml.dump.unsupported-model\",\"ml.label.unseen\",\"ml.limit.classes\",\"ml.limit.parameters\",\"ml.weight.missing\",\"ml.weight.negative\",\"ml.weight.too-large\",\"ml.weight.zero-total\",\"ml.rank.bad-relevance\",\"ml.rank.group-missing\",\"ml.limit.group-size\",\"ml.limit.pairs\",\"ml.split.group-required\",\"mcp.read-only\",\"mcp.record-column\",\"serve.number-not-exact\",\"serve.string-not-renderable\"]},\"text_or_bytes\":{\"description\":\"UTF-8 text as a string; other bytes as base64 (RFC 4648 section 4, padded).\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"object\",\"properties\":{\"b64\":{\"type\":\"string\",\"pattern\":\"^[A-Za-z0-9+/]*={0,2}$\"}},\"required\":[\"b64\"],\"additionalProperties\":false}]}}},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}},{\"name\":\"dump\",\"title\":\"dump\",\"description\":\"Fit, apply and score a model on a CSV file, with the refusals of a tool an agent can read. Usage of the command line this tool is: `ml [--root DIR] --model-file MODEL [--tree I] [--max-nodes N] [--max-bytes N] [--format json|text] dump`. Values the library refuses (ranges, conflicts between flags, unknown columns) come back as a tool error with the rule, the exit code and the repair.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"model-file\":{\"type\":\"string\",\"minLength\":1,\"description\":\"predict, eval, describe, importance, dump: the model file to read\"},\"tree\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1023,\"description\":\"dump: the tree of a forest to print, counted from 0 (absent: tree 0). At or above the number of trees it is ml.param.out-of-range, and a model that is not a tree or a forest refuses the flag\"},\"max-nodes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":999999999,\"default\":4194304,\"description\":\"tree: the most nodes one tree may have: above 4194304, or fewer than the tree needs, is ml.limit.nodes (a tree is never cut). dump: the most nodes of the tree printed, at most 4194304 (absent: 10000) (default 4194304). forest: the most nodes one tree may have: above 4194304, or fewer than the tree needs, is ml.limit.nodes (a tree is never cut). dump: the most nodes of the tree printed, at most 4194304 (absent: 10000) (default 4194304). boost: the most nodes one tree may have: above 4194304, or fewer than the tree needs, is ml.limit.nodes (a tree is never cut) (default 4194304)\"},\"max-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":268435456,\"default\":16777216,\"description\":\"fit: the largest model file written, the limit predict and eval apply when they read it. A larger one is limit.input-too-large and nothing is written. predict, eval, describe: the largest model file read. A larger one is limit.input-too-large. predict from standard input (the operand - or none): the CSV is held in memory, so this is also the most bytes of standard input read. More is limit.input-too-large\"}},\"required\":[\"model-file\"],\"additionalProperties\":false},\"outputSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"One JSON object on one line. ok is false exactly when errors is present; error is its first element. A dry run (fit --dry-run) has ok true, exit 9, dry_run and planned_actions. No float appears: every decimal is a string with its digits exact.\",\"type\":\"object\",\"properties\":{\"ok\":{\"type\":\"boolean\"},\"command\":{\"const\":\"ml\"},\"schema\":{\"const\":\"ml.v1\"},\"data\":{\"$ref\":\"#/$defs/data\"},\"dry_run\":{\"const\":true},\"planned_actions\":{\"type\":\"array\",\"items\":{\"oneOf\":[{\"type\":\"object\",\"properties\":{\"op\":{\"enum\":[\"create\",\"replace\"]},\"path\":{\"$r