ad-relevance\",\"ml.rank.group-missing\",\"ml.limit.group-size\",\"ml.limit.pairs\",\"ml.split.group-required\",\"mcp.read-only\",\"mcp.record-column\",\"serve.number-not-exact\",\"serve.string-not-renderable\"]},\"text_or_bytes\":{\"description\":\"UTF-8 text as a string; other bytes as base64 (RFC 4648 section 4, padded).\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"object\",\"properties\":{\"b64\":{\"type\":\"string\",\"pattern\":\"^[A-Za-z0-9+/]*={0,2}$\"}},\"required\":[\"b64\"],\"additionalProperties\":false}]}}},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}},{\"name\":\"dump\",\"title\":\"dump\",\"description\":\"Fit, apply and score a model on a CSV file, with the refusals of a tool an agent can read. Usage of the command line this tool is: `ml [--root DIR] --model-file MODEL [--tree I] [--max-nodes N] [--max-bytes N] [--format json|text] dump`. Values the library refuses (ranges, conflicts between flags, unknown columns) come back as a tool error with the rule, the exit code and the repair.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"model-file\":{\"type\":\"string\",\"minLength\":1,\"description\":\"predict, eval, describe, importance, dump: the model file to read\"},\"tree\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1023,\"description\":\"dump: the tree of a forest to print, counted from 0 (absent: tree 0). At or above the number of trees it is ml.param.out-of-range, and a model that is not a tree or a forest refuses the flag\"},\"max-nodes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":999999999,\"default\":4194304,\"description\":\"tree: the most nodes one tree may have: above 4194304, or fewer than the tree needs, is ml.limit.nodes (a tree is never cut). dump: the most nodes of the tree printed, at most 4194304 (absent: 10000) (default 4194304). forest: the most nodes one tree may have: above 4194304, or fewer than the tree needs, is ml.limit.nodes (a tree is never cut). dump: the most nodes of the tree printed, at most 4194304 (absent: 10000) (default 4194304). boost: the most nodes one tree may have: above 4194304, or fewer than the tree needs, is ml.limit.nodes (a tree is never cut) (default 4194304)\"},\"max-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":268435456,\"default\":16777216,\"description\":\"fit: the largest model file written, the limit predict and eval apply when they read it. A larger one is limit.input-too-large and nothing is written. predict, eval, describe: the largest model file read. A larger one is limit.input-too-large. predict from standard input (the operand - or none): the CSV is held in memory, so this is also the most bytes of standard input read. More is limit.input-too-large\"}},\"required\":[\"model-file\"],\"additionalProperties\":false},\"outputSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"One JSON object on one line. ok is false exactly when errors is present; error is its first element. A dry run (fit --dry-run) has ok true, exit 9, dry_run and planned_actions. No float appears: every decimal is a string with its digits exact.\",\"type\":\"object\",\"properties\":{\"ok\":{\"type\":\"boolean\"},\"command\":{\"const\":\"ml\"},\"schema\":{\"const\":\"ml.v1\"},\"data\":{\"$ref\":\"#/$defs/data\"},\"dry_run\":{\"const\":true},\"planned_actions\":{\"type\":\"array\",\"items\":{\"oneOf\":[{\"type\":\"object\",\"properties\":{\"op\":{\"enum\":[\"create\",\"replace\"]},\"path\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"bytes\":{\"type\":\"integer\",\"minimum\":0},\"sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"}},\"required\":[\"op\",\"path\",\"bytes\",\"sha256\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"op\":{\"const\":\"create\"},\"dir\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"file\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"bytes\":{\"type\":\"integer\",\"minimum\":0},\"sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"}},\"required\":[\"op\",\"dir\",\"file\",\"bytes\",\"sha256\"],\"additionalProperties\":false}]}},\"error\":{\"$ref\":\"#/$defs/error\"},\"errors\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/$defs/error\"},\"minItems\":1},\"meta\":{\"$ref\":\"#/$defs/meta\"}},\"required\":[\"ok\",\"command\",\"schema\",\"meta\"],\"additionalProperties\":false,\"allOf\":[{\"if\":{\"properties\":{\"ok\":{\"const\":true}}},\"then\":{\"not\":{\"anyOf\":[{\"required\":[\"error\"]},{\"required\":[\"errors\"]}]}},\"else\":{\"required\":[\"error\",\"errors\"]}}],\"title\":\"ml.v1 dump\",\"$defs\":{\"data\":{\"oneOf\":[{\"type\":\"object\",\"properties\":{\"model\":{\"enum\":[\"tree\",\"forest\"]},\"task\":{\"enum\":[\"regression\",\"classification\"]},\"kind\":{\"const\":7},\"trees\":{\"type\":\"integer\",\"minimum\":0},\"tree\":{\"type\":\"integer\",\"minimum\":0},\"nodes\":{\"type\":\"integer\",\"minimum\":0},\"depth\":{\"type\":\"integer\",\"minimum\":0},\"list\":{\"type\":\"array\",\"items\":{\"oneOf\":[{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"integer\",\"minimum\":0},\"depth\":{\"type\":\"integer\",\"minimum\":0},\"leaf\":{\"const\":true},\"value\":{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?(e[+-]?[0-9]+)?$\"},\"counts\":{\"type\":\"array\",\"items\":{\"type\":\"integer\",\"minimum\":0},\"minItems\":1,\"maxItems\":2},\"rows\":{\"type\":\"integer\",\"minimum\":0}},\"required\":[\"id\",\"depth\",\"leaf\",\"value\",\"counts\",\"rows\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"integer\",\"minimum\":0},\"depth\":{\"type\":\"integer\",\"minimum\":0},\"leaf\":{\"const\":false},\"column\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"source\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"threshold\":{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?(e[+-]?[0-9]+)?$\"},\"cell\":{\"oneOf\":[{\"type\":\"null\"},{\"type\":\"string\"}]},\"missing\":{\"enum\":[\"left\",\"right\"]},\"left\":{\"type\":\"integer\",\"minimum\":0},\"right\":{\"type\":\"integer\",\"minimum\":0},\"counts\":{\"type\":\"array\",\"items\":{\"type\":\"integer\",\"minimum\":0},\"minItems\":1,\"maxItems\":2},\"rows\":{\"type\":\"integer\",\"minimum\":0}},\"required\":[\"id\",\"depth\",\"leaf\",\"column\",\"source\",\"threshold\",\"cell\",\"missing\",\"left\",\"right\",\"counts\",\"rows\"],\"additionalProperties\":false}]}}},\"required\":[\"model\",\"task\",\"kind\",\"trees\",\"tree\",\"nodes\",\"depth\",\"list\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"model\":{\"enum\":[\"linear\",\"logistic\"]},\"task\":{\"enum\":[\"regression\",\"classification\"]},\"kind\":{\"enum\":[4,5]},\"intercept\":{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?(e[+-]?[0-9]+)?$\"},\"coefficients\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"column\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"source\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"coefficient\":{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?(e[+-]?[0-9]+)?$\"}},\"required\":[\"column\",\"source\",\"coefficient\"],\"additionalProperties\":false}}},\"required\":[\"model\",\"task\",\"kind\",\"intercept\",\"coefficients\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"model\":{\"const\":\"kmeans\"},\"task\":{\"const\":\"clustering\"},\"kind\":{\"const\":6},\"k\":{\"type\":\"integer\",\"minimum\":0},\"centroids\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"cluster\":{\"type\":\"integer\",\"minimum\":0},\"values\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"column\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"source\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"value\":{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?(e[+-]?[0-9]+)?$\"},\"raw\":{\"oneOf\":[{\"type\":\"null\"},{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?(e[+-]?[0-9]+)?$\"}]}},\"required\":[\"column\",\"source\",\"value\",\"raw\"],\"additiona