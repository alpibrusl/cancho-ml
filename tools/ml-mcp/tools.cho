pe\":\"object\",\"properties\":{\"id\":{\"type\":\"integer\",\"minimum\":0},\"depth\":{\"type\":\"integer\",\"minimum\":0},\"leaf\":{\"const\":false},\"column\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"source\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"threshold\":{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?(e[+-]?[0-9]+)?$\"},\"cell\":{\"oneOf\":[{\"type\":\"null\"},{\"type\":\"string\"}]},\"missing\":{\"enum\":[\"left\",\"right\"]},\"left\":{\"type\":\"integer\",\"minimum\":0},\"right\":{\"type\":\"integer\",\"minimum\":0},\"counts\":{\"type\":\"array\",\"items\":{\"type\":\"integer\",\"minimum\":0},\"minItems\":1,\"maxItems\":2},\"rows\":{\"type\":\"integer\",\"minimum\":0}},\"required\":[\"id\",\"depth\",\"leaf\",\"column\",\"source\",\"threshold\",\"cell\",\"missing\",\"left\",\"right\",\"counts\",\"rows\"],\"additionalProperties\":false}]}}},\"required\":[\"model\",\"task\",\"kind\",\"trees\",\"tree\",\"nodes\",\"depth\",\"list\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"model\":{\"enum\":[\"linear\",\"logistic\"]},\"task\":{\"enum\":[\"regression\",\"classification\"]},\"kind\":{\"enum\":[4,5]},\"intercept\":{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?(e[+-]?[0-9]+)?$\"},\"coefficients\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"column\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"source\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"coefficient\":{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?(e[+-]?[0-9]+)?$\"}},\"required\":[\"column\",\"source\",\"coefficient\"],\"additionalProperties\":false}}},\"required\":[\"model\",\"task\",\"kind\",\"intercept\",\"coefficients\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"model\":{\"const\":\"kmeans\"},\"task\":{\"const\":\"clustering\"},\"kind\":{\"const\":6},\"k\":{\"type\":\"integer\",\"minimum\":0},\"centroids\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"cluster\":{\"type\":\"integ