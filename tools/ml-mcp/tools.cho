tside-root\",\"path.too-long\",\"path.symlink\",\"path.bad-name\",\"io.not-found\",\"io.not-a-directory\",\"io.is-a-directory\",\"io.permission-denied\",\"io.read-failed\",\"io.write-failed\",\"conflict.exists\",\"limit.line-too-long\",\"limit.input-too-large\",\"limit.log-full\",\"ml.param.out-of-range\",\"ml.input.empty\",\"ml.input.too-many-rows\",\"ml.input.too-many-columns\",\"ml.input.too-many-cells\",\"ml.input.non-numeric\",\"ml.input.non-finite\",\"ml.input.duplicate-column\",\"ml.input.unknown-column\",\"parse.csv-ragged-row\",\"parse.csv-bad-quote\",\"parse.csv-unterminated-quote\",\"ml.label.single-class\",\"ml.label.not-binary\",\"ml.label.not-integer\",\"ml.metric.undefined\",\"ml.schema.mismatch\",\"ml.model.bad-magic\",\"ml.model.version\",\"ml.model.truncated\",\"ml.model.checksum\",\"ml.model.malformed\",\"ml.linalg.not-positive-definite\",\"ml.param.threads\",\"ml.fit.non-finite\",\"ml.fit.collinear\",\"ml.fit.separable\",\"ml.predict.non-finite\",\"ml.split.empty-fold\",\"ml.split.stratify-target\",\"ml.split.stratum-too-small\",\"ml.split.too-few-groups\",\"ml.split.time-format\",\"ml.split.missing-cell\",\"ml.split.combination\",\"ml.split.out-of-range\",\"ml.split.column-target\",\"ml.split.emit-too-large\",\"ml.fit.all-missing\",\"ml.limit.categories\",\"ml.limit.string-bytes\",\"ml.limit.string-pool\",\"ml.limit.categorical-columns\",\"ml.input.invalid-utf8\",\"ml.input.categorical-not-encoded\",\"ml.input.unknown-category\",\"ml.plan.column-kind\",\"ml.input.reserved-category\",\"ml.model.string-table\",\"ml.limit.string-table\",\"ml.plan.syntax\",\"ml.plan.unknown-step\",\"ml.plan.unknown-key\",\"ml.plan.missing-key\",\"ml.plan.bad-value\",\"ml.plan.duplicate-key\",\"ml.plan.model-line\",\"ml.plan.unknown-column\",\"ml.limit.plan\",\"ml.input.missing-value\",\"ml.plan.model-not-built\",\"ml.limit.depth\",\"ml.limit.nodes\",\"ml.predict.out-of-range\",\"ml.predict.no-provenance\",\"ml.runs.conflict\",\"ml.runs.too-many\",\"ml.runs.record-too-large\",\"ml.runs.not-found\",\"ml.runs.unknown-model\",\"ml.runs.damaged\",\"ml.runs.data-changed\",\"ml.runs.model-differs\",\"ml.runs.not-replayable\",\"ml.jsonl.syntax\",\"ml.jsonl.not-object\",\"ml.jsonl.missing-field\",\"ml.jsonl.not-scalar\",\"ml.jsonl.duplicate-key\",\"ml.jsonl.type-mismatch\",\"ml.jsonl.mixed-kinds\",\"ml.jsonl.too-many-nodes\",\"ml.importance.unsupported-model\",\"ml.importance.no-scale\",\"ml.importance.bad-metric\",\"ml.importance.undefined-metric\",\"ml.importance.too-few-rows\",\"ml.limit.work\",\"ml.dump.unsupported-model\",\"ml.label.unseen\",\"ml.limit.classes\",\"ml.limit.parameters\",\"ml.weight.missing\",\"ml.weight.negative\",\"ml.weight.too-large\",\"ml.weight.zero-total\",\"ml.rank.bad-relevance\",\"ml.rank.group-missing\",\"ml.limit.group-size\",\"ml.limit.pairs\",\"ml.split.group-required\",\"mcp.read-only\",\"mcp.record-column\",\"serve.number-not-exact\",\"serve.string-not-renderable\"]},\"text_or_bytes\":{\"description\":\"UTF-8 text as a string; other bytes as base64 (RFC 4648 section 4, padded).\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"object\",\"properties\":{\"b64\":{\"type\":\"string\",\"pattern\":\"^[A-Za-z0-9+/]*={0,2}$\"}},\"required\":[\"b64\"],\"additionalProperties\":false}]}}},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}},{\"name\":\"runs_verify\",\"title\":\"runs verify\",\"description\":\"Fit, apply and score a model on a CSV file, with the refusals of a tool an agent can read. Usage of the command line this tool is: `ml runs verify ...`. Values the library refuses (ranges, conflicts between flags, unknown columns) come back as a tool error with the rule, the exit code and the repair.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"threads\":{\"type\":\"integer\",\"minimum\":0,\"default\":1,\"description\":\"fit, eval, importance, runs verify: the threads of the numeric kernels, 1 to 64 (ml.param.threads outside). No thread count changes a byte of the model file or of the answer. In eval and importance nothing is threaded and the flag is checked and unused. In runs verify it is the thread count of the refit\"},\"max-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":268435456,\"default\":16777216,\"description\":\"fit: the largest model file written, the limit predict and eval apply when they read it. A larger one is limit.input-too-large and nothing is written. predict, eval, describe: the largest model file read. A larger one is limit.input-too-large. predict from standard input (the operand - or none): the CSV is held in memory, so this is also the most bytes of standard input read. More is limit.input-too-large\"},\"dir\":{\"type\":\"string\",\"minLength\":1,\"description\":\"the directory of run records, relative to the server's root\"},\"id\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\",\"description\":\"a run id: 64 lowercase hexadecimal digits\"}},\"required\":[\"dir\",\"id\"],\"additionalProperties\":false},\"outputSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"One JSON object on one line. ok is false exactly when errors is present; error is its first element. A dry run (fit --dry-run) has ok true, exit 9, dry_run and planned_actions. No float appears: every decimal is a string with its digits exact.\",\"type\":\"object\",\"properties\":{\"ok\":{\"type\":\"boolean\"},\"command\":{\"const\":\"ml\"},\"schema\":{\"const\":\"ml.v1\"},\"data\":{\"$ref\":\"#/$defs/data\"},\"dry_run\":{\"const\":true},\"planned_actions\":{\"type\":\"array\",\"items\":{\"oneOf\":[{\"type\":\"object\",\"properties\":{\"op\":{\"enum\":[\"create\",\"replace\"]},\"path\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"bytes\":{\"type\":\"integer\",\"minimum\":0},\"sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"}},\"required\":[\"op\",\"path\",\"bytes\",\"sha256\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"op\":{\"const\":\"create\"},\"dir\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"file\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"bytes\":{\"type\":\"integer\",\"minimum\":0},\"sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"}},\"required\":[\"op\",\"dir\",\"file\",\"bytes\",\"sha256\"],\"additionalProperties\":false}]}},\"error\":{\"$ref\":\"#/$defs/error\"},\"errors\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/$defs/error\"},\"minItems\":1},\"meta\":{\"$ref\":\"#/$defs/meta\"}},\"required\":[\"ok\",\"command\",\"schema\",\"meta\"],\"additionalProperties\":false,\"allOf\":[{\"if\":{\"properties\":{\"ok\":{\"const\":true}}},\"then\":{\"not\":{\"anyOf\":[{\"required\":[\"error\"]},{\"required\":[\"errors\"]}]}},\"else\":{\"required\":[\"error\",\"errors\"]}}],\"title\":\"ml.v1 runs_verify\",\"$defs\":{\"data\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"},\"verified\":{\"const\":true},\"model_sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"},\"data_sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"},\"threads\":{\"type\":\"integer\",\"minimum\":0},\"compiler\":{\"$ref\":\"#/$defs/text_or_bytes\"}},\"required\":[\"id\",\"verified\",\"model_sha256\",\"data_sha256\",\"threads\",\"compiler\"],\"additionalProperties\":false},\"error\":{\"type\":\"object\",\"properties\":{\"code\":{\"enum\":[\"GENERAL_ERROR\",\"INVALID_ARGS\",\"NOT_FOUND\",\"PERMISSION_DENIED\",\"CONFLICT\",\"PRECONDITION_FAILED\"]},\"rule\":{\"$ref\":\"#/$defs/rule\"},\"message\":{\"type\":\"string\"},\"hint\":{\"type\":[\"string\",\"null\"]},\"repair\":{\"$ref\":\"#/$defs/repair\"},\"detail\":{\"type\":\"object\"}},\"required\":[\"code\",\"rule\",\"message\",\"hint\",\"repair\",\"detail\"],\"additionalProperties\":false},\"meta\":{\"type\":\"object\",\"properties\":{\"version\":{\"type\":\"string\"}},\"required\":[\"version\"],\"additionalProperties\":false},\"repair\":{\"oneOf\":[{\"type\":\"null\"},{\"type\":\"object\",\"properties\":{\"kind\":{\"const\":\"retry\"},\"argv\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"minItems\":1}},\"required\":[\"kind\",\"argv\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"kind\":{\"const\":\"none\"},\"reason\":{\"type\":\"string\"}},\"required\":[\"kind\",\"reason\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"kind\":{\"const\":\"choose\"},\"options\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"argv\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"argv\"],\"additionalProperties\":false}}},\"required\":[\"kind\",\"options\"],\"additionalProperties\":false}]},\"rule\":{\"description\":\"Every rule tag ml can emit (the `rules` of spec.cho).\",\"enum\":[\"args.unknown-flag\",\"args.missing-value\",\"args.bad-value\",\"args.unexpected-value\",\"args.duplicate-flag\",\"args.conflict\",\"args.missing-operand\",\"args.required-flag\",\"args.too-many-operands\",\"args.unknown-command\",\"path.empty\",\"path.dotdot\",\"path.absolute\",\"path.outside-root\",\"path.too-long\",\"path.symlink\",\"path.bad-name\",\"io.not-found\",\"io.not-a-directory\",\"io.is-a-directory\",\"io.permission-denied\",\"io.read-failed\",\"io.write-failed\",\"conflict.exists\",\"limit.line-too-long\",\"limit.input-too-large\",\"limit.log-full\",\"ml.param.out-of-range\",\"ml.input.empty\",\"ml.input.too-many-rows\",\"ml.input.too-many-columns\",\"ml.input.too-many-cells\",\"ml.input.non-numeric\",\"ml.input.non-finite\",\"ml.input.duplicate-column\",\"ml.input.unknown-column\",\"parse.csv-ragged-row\",\"parse.csv-bad-quote\",\"parse.csv-unterminated-quote\",\"ml.label.single-class\",\"ml.label.not-binary\",\"ml.label.not-integer\",\"ml.metric.undefined\",\"ml.schema.mismatch\",\"ml.model.bad-magic\",\"ml.model.version\",\"ml.model.truncated\",\"ml.model.checksum\",\"ml.model.malformed\",\"ml.linalg.not-positive-definite\",\"ml.param.threads\",\"ml.fit.non-finite\",\"ml.fit.collinear\",\"ml.fit.separable\",\"ml.predict.non-finite\",\"ml.split.empty-fold\",\"ml.split.stratify-target\",\"ml.split.stratum-too-small\",\"ml.split.too-few-groups\",\"ml.split.time-format\",\"ml.split.missing-cell\",\"ml.split.combination\",\"ml.split.out-of-range\",\"ml.split.column-target\",\"ml.split.emit-too-large\",\"ml.fit.all-missing\",\"ml.limit.categories\",\"ml.limit.string-bytes\",\"ml.limit.string-pool\",\"ml.limit.categorical-columns\",\"ml.input.invalid-utf8\",\"ml.input.categorical-not-encoded\",\"ml.input.unknown-category\",\"ml.plan.column-kind\",\"ml.input.reserved-category\",\"ml.model.string-table\",\"ml.limit.string-table\",\"ml.plan.syntax\",\"ml.plan.unknown-step\",\"ml.plan.unknown-key\",\"ml.plan.missing-key\",\"ml.plan.bad-value\",\"ml.plan.duplicate-key\",\"ml.plan.model-line\",\"ml.plan.unknown-column\",\"ml.limit.plan\",\"ml.input.missing-value\",\"ml.plan.model-not-built\",\"ml.limit.depth\",\"ml.limit.nodes\",\"ml.predict.out-of-range\",\"ml.predict.no-provenance\",\"ml.runs.conflict\",\"ml.runs.too-many\",\"ml.runs.record-too-large\",\"ml.runs.not-found\",\"ml.runs.unknown-model\",\"ml.runs.damaged\",\"ml.runs.data-changed\",\"ml.runs.model-differs\",\"ml.runs.not-replayable\",\"ml.jsonl.syntax\",\"ml.jsonl.not-object\",\"ml.jsonl.missing-field\",\"ml.jsonl.not-scalar\",\"ml.jsonl.duplicate-key\",\"ml.jsonl.type-mismatch\",\"ml.jsonl.mixed-kinds\",\"ml.jsonl.too-many-nodes\",\"ml.importance.unsupported-model\",\"ml.importance.no-scale\",\"ml.importance.bad-metric\",\"ml.importance.undefined-metric\",\"ml.importance.too-few-rows\",\"ml.limit.work\",\"ml.dump.unsupported-model\",\"ml.label.unseen\",\"ml.limit.classes\",\"ml.limit.parameters\",\"ml.weight.missing\",\"ml.weight.negative\",\"ml.weight.too-large\",\"ml.weight.zero-total\",\"ml.rank.bad-relevance\",\"ml.rank.group-missing\",\"ml.limit.group-size\",\"ml.limit.pairs\",\"ml.split.group-required\",\"mcp.read-only\",\"mcp.record-column\",\"serve.number-not-exact\",\"serve.string-not-renderable\"]},\"text_or_bytes\":{\"description\":\"UTF-8 text as a string; other bytes as base64 (RFC 4648 section 4, padded).\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"object\",\"properties\":{\"b64\":{\"type\":\"string\",\"pattern\":\"^[A-Za-z0-9+/]*={0,2}$\"}},\"required\":[\"b64\"],\"additionalProperties\":false}]}}},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}}]}";
}

// the same, read-only
pub fn list_readonly() -> [] &static [byte] {
    return "{\"tools\":[{\"name\":\"predict\",\"title\":\"predict\",\"description\":\"Fit, apply and score a model on a CSV file, with the refusals of a tool an agent can read. Usage of the command line this tool is: `ml [--root DIR] --model-file MODEL [--proba] [--distance] [--rank --group COLUMN] [--drop NAMES] [--limit N] [--from N] [--max-bytes N] [--max-out-of-range N] [--log FILE] [--format json|text] predict FILE|-`. Values the library refuses (ranges, conflicts between flags, unknown columns) come back as a tool error with the rule, the exit code and the repair.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"model-file\":{\"type\":\"string\",\"minLength\":1,\"description\":\"predict, eval, describe, importance, dump: the model file to read\"},\"drop\":{\"type\":\"string\",\"minLength\":1,\"description\":\"columns to ignore, header names separated by commas (fit, predict, eval, importance). A dropped column is not part of the stored schema, and its cells are not read as numbers (it may hold text, quoted fields and line breaks)\"},\"limit\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1000000,\"default\":1000,\"description\":\"predict: the most rows in one page of predictions, at least 1. describe: the most category strings listed for each categorical column and the most rows of the importance table, at least 1 (a longer table lists the best ranks). runs list: the most run records listed, at least 1\"},\"from\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1000000000,\"default\":0,\"description\":\"predict: the row to start the page at, counting data rows from 0\"},\"proba\":{\"type\":\"boolean\",\"description\":\"predict: add the probability column (the positive label's probability) to the answer of a classification model (logistic, tree or forest)\"},\"distance\":{\"type\":\"boolean\",\"description\":\"predict: add the distance column (the squared Euclidean distance of the row to the centre of its cluster) to the answer of a kmeans model\"},\"rank\":{\"type\":\"boolean\",\"description\":\"predict: add the column rank, the position of each row inside its group by score (1 is the best, ties in file order), for a ranking model, and needs --group. docs/ranking.md\"},\"group\":{\"type\":\"string\",\"minLength\":1,\"description\":\"fit, eval, cv, predict (with --rank): the name of the column that holds the group of each row (a query id: any text or integer) for --task ranking or lambdarank (the pairs weighted by the change in NDCG), as the header spells it. The rows of a group are ranked together, in file order. The column is not a feature and is not stored in the schema of the model file. The group split is implied: fit --split and cv put every group wholly on one side. Not the target, not in --drop or --cat. docs/ranking.md\"},\"max-rows\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1000000000,\"default\":10000000,\"description\":\"the most data rows read. More is ml.input.too-many-rows\"},\"max-columns\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":8192,\"default\":4096,\"description\":\"the most columns read. More is ml.input.too-many-columns\"},\"max-cells\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1099511627776,\"default\":400000000,\"description\":\"the most rows times columns. More is ml.input.too-many-cells\"},\"max-line-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":16777216,\"default\":1048576,\"description\":\"the longest line read. A longer one is limit.line-too-long\"},\"max-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":268435456,\"default\":16777216,\"description\":\"fit: the largest model file written, the limit predict and eval apply when they read it. A larger one is limit.input-too-large and nothing is written. predict, eval, describe: the largest model file read. A larger one is limit.input-too-large. predict from standard input (the operand - or none): the CSV is held in memory, so this is also the most bytes of standard input read. More is limit.input-too-large\"},\"input-format\":{\"type\":\"string\",\"enum\":[\"csv\",\"jsonl\",\"ndjson\"],\"default\":\"csv\",\"description\":\"fit, predict, eval, cv: the format of the input. jsonl (and its spelling ndjson) is JSON lines: one JSON object a line, read into the columns that fit declares with --fields (predict and eval read the columns of the model file, by key, in any order, and ignore other keys). A number is its exact text, a string is text, null is a missing cell, a key a line lacks is --absent, true and false are text in a --cat column and refused in a number column, an object or an array is refused (docs/jsonl.md section 3). The model file is the one fitted from the equivalent CSV except the identity of the training file in its provenance section (its SHA-256 and size). Never guessed from the name or the bytes\"},\"absent\":{\"type\":\"string\",\"enum\":[\"refuse\",\"empty\"],\"default\":\"refuse\",\"description\":\"jsonl input: what a declared key that a line does not hold is. refuse is ml.jsonl.missing-field, empty is a missing cell. A null value is a missing cell either way\"},\"max-json-nodes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1048576,\"default\":4096,\"description\":\"jsonl input: the most JSON nodes a line may hold (a value, and a key, is a node), 1 to 1048576. A line with more is ml.jsonl.too-many-nodes before anything is sized by it\"},\"max-out-of-range\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1000000000,\"description\":\"predict, eval: refuse with ml.predict.out-of-range when more than N rows hold a non-missing numeric feature strictly below the minimum or above the maximum of the training rows, as stored in the model file (0 refuses any). Absent, the counts are reported and no bound applies. A model file with no provenance section (fitted before run tracking) refuses the flag with ml.predict.no-provenance\"},\"file\":{\"type\":\"string\",\"minLength\":1,\"description\":\"the CSV file, relative to the server's root (predict: or give records)\"},\"records\":{\"type\":\"array\",\"minItems\":1,\"maxItems\":1000000,\"items\":{\"type\":\"object\"},\"description\":\"rows to predict inline: objects keyed by the columns the model requires (describe lists them); rendered to the CSV the predictor reads by the byte rule of docs/serving-http.md section 4. Give this or file\"}},\"required\":[\"model-file\"],\"additionalProperties\":false,\"oneOf\":[{\"required\":[\"file\"]},{\"required\":[\"records\"]}]},\"outputSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"One JSON object on one line. ok is false exactly when errors is present; error is its first element. A dry run (fit --dry-run) has ok true, exit 9, dry_run and planned_actions. No float appears: every decimal is a string with its digits exact.\",\"type\":\"object\",\"properties\":{\"ok\":{\"type\":\"boolean\"},\"command\":{\"const\":\"ml\"},\"schema\":{\"const\":\"ml.v1\"},\"data\":{\"$ref\":\"#/$defs/data\"},\"dry_run\":{\"const\":true},\"planned_actions\":{\"type\":\"array\",\"items\":{\"oneOf\":[{\"type\":\"object\",\"properties\":{\"op\":{\"enum\":[\"create\",\"replace\"]},\"path\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"bytes\":{\"type\":\"integer\",\"minimum\":0},\"sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"}},\"required\":[\"op\",\"path\",\"bytes\",\"sha256\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"op\":{\"const\":\"create\"},\"dir\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"file\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"bytes\":{\"type\":\"integer\",\"minimum\":0},\"sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"}},\"required\":[\"op\",\"dir\",\"file\",\"bytes\",\"sha256\"],\"additionalProperties\":false}]}},\"error\":{\"$ref\":\"#/$defs/error\"},\"errors\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/$defs/error\"},\"minItems\":1},\"meta\":{\"$ref\":\"#/$defs/meta\"}},\"required\":[\"ok\",\"command\",\"schema\",\"meta\"],\"additionalProperties\":false,\"allOf\":[{\"if\":{\"properties\":{\"ok\":{\"const\":true}}},\"then\":{\"not\":{\"anyOf\":[{\"required\":[\"error\"]},{\"required\":[\"errors\"]}]}},\"else\":{\"required\":[\"error\",\"errors\"]}}],\"title\":\"ml.v1 predict\",\"$defs\":{\"data\":{\"oneOf\":[{\"type\":\"object\",\"properties\":{\"model\":{\"const\":\"constant\"},\"task\":{\"enum\":[\"regression\",\"classification\"]},\"columns\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"rows\":{\"type\":\"array\",\"items\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"row_count\":{\"type\":\"integer\",\"minimum\":0},\"total_rows\":{\"type\":\"integer\",\"minimum\":0},\"truncated\":{\"type\":\"boolean\"},\"next\":{\"oneOf\":[{\"type\":\"null\"},{\"type\":\"object\",\"properties\":{\"from\":{\"type\":\"integer\",\"minimum\":0}},\"required\":[\"from\"],\"additionalProperties\":false}]}},\"required\":[\"model\",\"task\",\"columns\",\"rows\",\"row_count\",\"total_rows\",\"truncated\",\"next\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"model\":{\"enum\":[\"linear\",\"logistic\",\"kmeans\",\"tree\",\"forest\",\"boost\",\"softmax\"]},\"task\":{\"enum\":[\"regression\",\"classification\",\"clustering\",\"ranking\"]},\"columns\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"rows\":{\"type\":\"array\",\"items\":{\"type\":\"array\",\"items\":{\"oneOf\":[{\"type\":\"string\"},{\"type\":\"object\",\"additionalProperties\":{\"type\":\"string\"}}]}}},\"row_count\":{\"type\":\"integer\",\"minimum\":0},\"total_rows\":{\"type\":\"integer\",\"minimum\":0},\"truncated\":{\"type\":\"boolean\"},\"next\":{\"oneOf\":[{\"type\":\"null\"},{\"type\":\"object\",\"properties\":{\"from\":{\"type\":\"integer\",\"minimum\":0}},\"required\":[\"from\"],\"additionalProperties\":false}]},\"unknown_categories\":{\"type\":\"integer\",\"minimum\":0},\"out_of_range\":{\"oneOf\":[{\"type\":\"null\"},{\"type\":\"object\",\"properties\":{\"cells\":{\"type\":\"integer\",\"minimum\":0},\"rows\":{\"type\":\"integer\",\"minimum\":0},\"columns\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"name\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"count\":{\"type\":\"integer\",\"minimum\":0}},\"required\":[\"name\",\"count\"],\"additionalProperties\":false}}},\"required\":[\"cells\",\"rows\",\"columns\"],\"additionalProperties\":false}]},\"ignored_columns\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/$defs/text_or_bytes\"}}},\"required\":[\"model\",\"task\",\"columns\",\"rows\",\"row_count\",\"total_rows\",\"truncated\",\"next\",\"unknown_categories\",\"out_of_range\",\"ignored_columns\"],\"additionalProperties\":false}]},\"error\":{\"type\":\"object\",\"properties\":{\"code\":{\"enum\":[\"GENERAL_ERROR\",\"INVALID_ARGS\",\"NOT_FOUND\",\"PERMISSION_DENIED\",\"CONFLICT\",\"PRECONDITION_FAILED\"]},\"rule\":{\"$ref\":\"#/$defs/rule\"},\"message\":{\"type\":\"string\"},\"hint\":{\"type\":[\"string\",\"null\"]},\"repair\":{\"$ref\":\"#/$defs/repair\"},\"detail\":{\"type\":\"object\"}},\"required\":[\"code\",\"rule\",\"message\",\"hint\",\"repair\",\"detail\"],\"additionalProperties\":false},\"meta\":{\"type\":\"object\",\"properties\":{\"version\":{\"type\":\"string\"}},\"required\":[\"version\"],\"additionalProperties\":false},\"repair\":{\"oneOf\":[{\"type\":\"null\"},{\"type\":\"object\",\"properties\":{\"kind\":{\"const\":\"retry\"},\"argv\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"minItems\":1}},\"required\":[\"kind\",\"argv\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"kind\":{\"const\":\"none\"},\"reason\":{\"type\":\"string\"}},\"required\":[\"kind\",\"reason\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"kind\":{\"const\":\"choose\"},\"options\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"argv\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"argv\"],\"additionalProperties\":false}}},\"required\":[\"kind\",\"options\"],\"additionalProperties\":false}]},\"rule\":{\"description\":\"Every rule tag ml can emit (the `rules` of spec.cho).\",\"enum\":[\"args.unknown-flag\",\"args.missing-value\",\"args.bad-value\",\"args.unexpected-value\",\"args.duplicate-flag\",\"args.conflict\",\"args.missing-operand\",\"args.required-flag\",\"args.too-many-operands\",\"args.unknown-command\",\"path.empty\",\"path.dotdot\",\"path.absolute\",\"path.outside-root\",\"path.too-long\",\"path.symlink\",\"path.bad-name\",\"io.not-found\",\"io.not-a-directory\",\"io.is-a-directory\",\"io.permission-denied\",\"io.read-failed\",\"io.write-failed\",\"conflict.exists\",\"limit.line-too-long\",\"limit.input-too-large\",\"limit.log-full\",\"ml.param.out-of-range\",\"ml.input.empty\",\"ml.input.too-many-rows\",\"ml.input.too-many-columns\",\"ml.input.too-many-cells\",\"ml.input.non-numeric\",\"ml.input.non-finite\",\"ml.input.duplicate-column\",\"ml.input.unknown-column\",\"parse.csv-ragged-row\",\"parse.csv-bad-quote\",\"parse.csv-unterminated-quote\",\"ml.label.single-class\",\"ml.label.not-binary\",\"ml.label.not-integer\",\"ml.metric.undefined\",\"ml.schema.mismatch\",\"ml.model.bad-magic\",\"ml.model.version\",\"ml.model.truncated\",\"ml.model.checksum\",\"ml.model.malformed\",\"ml.linalg.not-positive-definite\",\"ml.param.threads\",\"ml.fit.non-finite\",\"ml.fit.collinear\",\"ml.fit.separable\",\"ml.predict.non-finite\",\"ml.split.empty-fold\",\"ml.split.stratify-target\",\"ml.split.stratum-too-small\",\"ml.split.too-few-groups\",\"ml.split.time-format\",\"ml.split.missing-cell\",\"ml.split.combination\",\"ml.split.out-of-range\",\"ml.split.column-target\",\"ml.split.emit-too-large\",\"ml.fit.all-missing\",\"ml.limit.categories\",\"ml.limit.string-bytes\",\"ml.limit.string-pool\",\"ml.limit.categorical-columns\",\"ml.input.invalid-utf8\",\"ml.input.categorical-not-encoded\",\"ml.input.unknown-category\",\"ml.plan.column-kind\",\"ml.input.reserved-category\",\"ml.model.string-table\",\"ml.limit.string-table\",\"ml.plan.syntax\",\"ml.plan.unknown-step\",\"ml.plan.unknown-key\",\"ml.plan.missing-key\",\"ml.plan.bad-value\",\"ml.plan.duplicate-key\",\"ml.plan.model-line\",\"ml.plan.unknown-column\",\"ml.limit.plan\",\"ml.input.missing-value\",\"ml.plan.model-not-built\",\"ml.limit.depth\",\"ml.limit.nodes\",\"ml.predict.out-of-range\",\"ml.predict.no-provenance\",\"ml.runs.conflict\",\"ml.runs.too-many\",\"ml.runs.record-too-large\",\"ml.runs.not-found\",\"ml.runs.unknown-model\",\"ml.runs.damaged\",\"ml.runs.data-changed\",\"ml.runs.model-differs\",\"ml.runs.not-replayable\",\"ml.jsonl.syntax\",\"ml.jsonl.not-object\",\"ml.jsonl.missing-field\",\"ml.jsonl.not-scalar\",\"ml.jsonl.duplicate-key\",\"ml.jsonl.type-mismatch\",\"ml.jsonl.mixed-kinds\",\"ml.jsonl.too-many-nodes\",\"ml.importance.unsupported-model\",\"ml.importance.no-scale\",\"ml.importance.bad-metric\",\"ml.importance.undefined-metric\",\"ml.importance.too-few-rows\",\"ml.limit.work\",\"ml.dump.unsupported-model\",\"ml.label.unseen\",\"ml.limit.classes\",\"ml.limit.parameters\",\"ml.weight.missing\",\"ml.weight.negative\",\"ml.weight.too-large\",\"ml.weight.zero-total\",\"ml.rank.bad-relevance\",\"ml.rank.group-missing\",\"ml.limit.group-size\",\"ml.limit.pairs\",\"ml.split.group-required\",\"mcp.read-only\",\"mcp.record-column\",\"serve.number-not-exact\",\"serve.string-not-renderable\"]},\"text_or_bytes\":{\"description\":\"UTF-8 text as a string; other bytes as base64 (RFC 4648 section 4, padded).\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"object\",\"properties\":{\"b64\":{\"type\":\"string\",\"pattern\":\"^[A-Za-z0-9+/]*={0,2}$\"}},\"required\":[\"b64\"],\"additionalProperties\":false}]}}},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}},{\"name\":\"eval\",\"title\":\"eval\",\"description\":\"Fit, apply and score a model on a CSV file, with the refusals of a tool an agent can read. Usage of the command line this tool is: `ml [--root DIR] --model-file MODEL [--positive LABEL] [--group COLUMN] [--rank-k K] [--gain exp|linear] [--split train=F] [--seed N] [--threads N] [--drop NAMES] [--max-bytes N] [--max-out-of-range N] [--track DIR] [--log FILE] [--format json|text] eval FILE`. Values the library refuses (ranges, conflicts between flags, unknown columns) come back as a tool error with the rule, the exit code and the repair.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"model-file\":{\"type\":\"string\",\"minLength\":1,\"description\":\"predict, eval, describe, importance, dump: the model file to read\"},\"drop\":{\"type\":\"string\",\"minLength\":1,\"description\":\"columns to ignore, header names separated by commas (fit, predict, eval, importance). A dropped column is not part of the stored schema, and its cells are not read as numbers (it may hold text, quoted fields and line breaks)\"},\"positive\":{\"type\":\"string\",\"minLength\":1,\"description\":\"fit, eval: the positive label of a two-class classification (logistic, tree, forest or boost: a softmax model of three or more classes has none and refuses it). fit: the label whose probability the model predicts (default: the larger of the two labels). eval: the label that precision, recall, F1, ROC-AUC and log-loss are about (default: the model's own)\"},\"split\":{\"type\":\"string\",\"minLength\":1,\"description\":\"fit, eval: train=F with 0 < F < 1 (at most 6 digits after the point). fit trains on the train rows and reports the held-out rows. eval scores the test rows only. The rows are chosen by the seeded train/test split of lib/metrics (--seed), the test side being ceil(n * (1 - F)) rows\"},\"seed\":{\"type\":\"integer\",\"minimum\":0,\"default\":0,\"description\":\"importance: the seed of the permutation streams (the stream registry, kind 11). fit, eval: the seed of --split (the stream registry, kind 4), of the bootstrap and feature draws of a tree or forest (kinds 1 and 2) and of the initial centres of kmeans (kind 3): one flag, so a forest fitted with --split draws its bootstrap from the seed that chose the split. Stored in the model file\"},\"threads\":{\"type\":\"integer\",\"minimum\":0,\"default\":1,\"description\":\"fit, eval, importance, runs verify: the threads of the numeric kernels, 1 to 64 (ml.param.threads outside). No thread count changes a byte of the model file or of the answer. In eval and importance nothing is threaded and the flag is checked and unused. In runs verify it is the thread count of the refit\"},\"stratify\":{\"type\":\"boolean\",\"description\":\"fit, eval, cv: hold the rows out (or deal them into folds) so that each class keeps its share: with --split, per class the held-out rows are the floor or the ceiling of its exact share, and with cv, per class and fold the count is the floor or the ceiling of the class size over --folds. A classification target only (ml.split.stratify-target otherwise). Not with --split-by or --split-group (ml.split.combination)\"},\"split-by\":{\"type\":\"string\",\"minLength\":1,\"description\":\"fit, eval, cv: time:COLUMN orders the rows by COLUMN, a number or an ISO-8601 date or datetime (YYYY-MM-DD, then T or a space, hh:mm, optional :ss, optional .fraction of 1 to 9 digits, optional Z, no numeric offset). With --split the oldest train=F of the rows train and the newest test, and with cv the rows are cut into folds+1 blocks and fold i trains on blocks 0 to i and tests on block i+1 (an expanding window). Ties keep the order of the file. A text column needs --drop. Not with --stratify or --split-group\"},\"split-group\":{\"type\":\"string\",\"minLength\":1,\"description\":\"fit, eval, cv: COLUMN names a column (text or integer) whose values are groups: all the rows of a group are on one side of --split, or in one fold of cv. Groups are compared byte for byte and assigned by the seeded stream. A text column needs --drop. Not with --stratify or --split-by\"},\"group\":{\"type\":\"string\",\"minLength\":1,\"description\":\"fit, eval, cv, predict (with --rank): the name of the column that holds the group of each row (a query id: any text or integer) for --task ranking or lambdarank (the pairs weighted by the change in NDCG), as the header spells it. The rows of a group are ranked together, in file order. The column is not a feature and is not stored in the schema of the model file. The group split is implied: fit --split and cv put every group wholly on one side. Not the target, not in --drop or --cat. docs/ranking.md\"},\"rank-k\":{\"type\":\"integer\",\"minimum\":0,\"default\":10,\"description\":\"eval, cv: the cut-off k of the ranking metrics NDCG@k, MAP@k, MRR@k, precision@k and recall@k, 1 to 4096, and 0 is the whole group. docs/ranking.md\"},\"gain\":{\"type\":\"string\",\"enum\":[\"exp\",\"linear\"],\"default\":\"exp\",\"description\":\"eval, cv: the gain of NDCG, 2^rel - 1 (exp) or rel (linear). docs/ranking.md\"},\"emit-folds\":{\"type\":\"boolean\",\"description\":\"fit, eval, cv: put the assignment of the rows in the answer: for each row (in file order) the fold, or 0 for a train row and 1 for a held-out row of --split. At most 1048576 entries (ml.split.emit-too-large)\"},\"max-rows\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1000000000,\"default\":10000000,\"description\":\"the most data rows read. More is ml.input.too-many-rows\"},\"max-columns\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":8192,\"default\":4096,\"description\":\"the most columns read. More is ml.input.too-many-columns\"},\"max-cells\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1099511627776,\"default\":400000000,\"description\":\"the most rows times columns. More is ml.input.too-many-cells\"},\"max-line-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":16777216,\"default\":1048576,\"description\":\"the longest line read. A longer one is limit.line-too-long\"},\"max-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":268435456,\"default\":16777216,\"description\":\"fit: the largest model file written, the limit predict and eval apply when they read it. A larger one is limit.input-too-large and nothing is written. predict, eval, describe: the largest model file read. A larger one is limit.input-too-large. predict from standard input (the operand - or none): the CSV is held in memory, so this is also the most bytes of standard input read. More is limit.input-too-large\"},\"input-format\":{\"type\":\"string\",\"enum\":[\"csv\",\"jsonl\",\"ndjson\"],\"default\":\"csv\",\"description\":\"fit, predict, eval, cv: the format of the input. jsonl (and its spelling ndjson) is JSON lines: one JSON object a line, read into the columns that fit declares with --fields (predict and eval read the columns of the model file, by key, in any order, and ignore other keys). A number is its exact text, a string is text, null is a missing cell, a key a line lacks is --absent, true and false are text in a --cat column and refused in a number column, an object or an array is refused (docs/jsonl.md section 3). The model file is the one fitted from the equivalent CSV except the identity of the training file in its provenance section (its SHA-256 and size). Never guessed from the name or the bytes\"},\"absent\":{\"type\":\"string\",\"enum\":[\"refuse\",\"empty\"],\"default\":\"refuse\",\"description\":\"jsonl input: what a declared key that a line does not hold is. refuse is ml.jsonl.missing-field, empty is a missing cell. A null value is a missing cell either way\"},\"max-json-nodes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1048576,\"default\":4096,\"description\":\"jsonl input: the most JSON nodes a line may hold (a value, and a key, is a node), 1 to 1048576. A line with more is ml.jsonl.too-many-nodes before anything is sized by it\"},\"max-out-of-range\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1000000000,\"description\":\"predict, eval: refuse with ml.predict.out-of-range when more than N rows hold a non-missing numeric feature strictly below the minimum or above the maximum of the training rows, as stored in the model file (0 refuses any). Absent, the counts are reported and no bound applies. A model file with no provenance section (fitted before run tracking) refuses the flag with ml.predict.no-provenance\"},\"file\":{\"type\":\"string\",\"minLength\":1,\"description\":\"the CSV file, relative to the server's root\"}},\"required\":[\"file\",\"model-file\"],\"additionalProperties\":false},\"outputSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"One JSON object on one line. ok is false exactly when errors is present; error is its first element. A dry run (fit --dry-run) has ok true, exit 9, dry_run and planned_actions. No float appears: every decimal is a string with its digits exact.\",\"type\":\"object\",\"properties\":{\"ok\":{\"type\":\"boolean\"},\"command\":{\"const\":\"ml\"},\"schema\":{\"const\":\"ml.v1\"},\"data\":{\"$ref\":\"#/$defs/data\"},\"dry_run\":{\"const\":true},\"planned_actions\":{\"type\":\"array\",\"items\":{\"oneOf\":[{\"type\":\"object\",\"properties\":{\"op\":{\"enum\":[\"create\",\"replace\"]},\"path\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"bytes\":{\"type\":\"integer\",\"minimum\":0},\"sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"}},\"required\":[\"op\",\"path\",\"bytes\",\"sha256\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"op\":{\"const\":\"create\"},\"dir\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"file\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"bytes\":{\"type\":\"integer\",\"minimum\":0},\"sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"}},\"required\":[\"op\",\"dir\",\"file\",\"bytes\",\"sha256\"],\"additionalProperties\":false}]}},\"error\":{\"$ref\":\"#/$defs/error\"},\"errors\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/$defs/error\"},\"minItems\":1},\"meta\":{\"$ref\":\"#/$defs/meta\"}},\"required\":[\"ok\",\"command\",\"schema\",\"meta\"],\"additionalProperties\":false,\"allOf\":[{\"if\":{\"properties\":{\"ok\":{\"const\":true}}},\"then\":{\"not\":{\"anyOf\":[{\"required\":[\"error\"]},{\"required\":[\"errors\"]}]}},\"else\":{\"required\":[\"error\",\"errors\"]}}],\"title\":\"ml.v1 eval\",\"$defs\":{\"data\":{\"oneOf\":[{\"type\":\"object\",\"properties\":{\"model\":{\"const\":\"constant\"},\"task\":{\"const\":\"regression\"},\"rows\":{\"type\":\"integer\",\"minimum\":0},\"on\":{\"enum\":[\"train\",\"other\",\"unknown\"]},\"metrics\":{\"type\":\"object\",\"properties\":{\"rmse\":{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?$\"},\"sse\":{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?$\"},\"prediction\":{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?$\"}},\"required\":[\"rmse\",\"sse\",\"prediction\"],\"additionalProperties\":false}},\"required\":[\"model\",\"task\",\"rows\",\"on\",\"metrics\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"model\":{\"const\":\"constant\"},\"task\":{\"const\":\"classification\"},\"rows\":{\"type\":\"integer\",\"minimum\":0},\"on\":{\"enum\":[\"train\",\"other\",\"unknown\"]},\"metrics\":{\"type\":\"object\",\"properties\":{\"accuracy\":{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?$\"},\"correct\":{\"type\":\"integer\",\"minimum\":0},\"total\":{\"type\":\"integer\",\"minimum\":0},\"prediction\":{\"type\":\"integer\"}},\"required\":[\"accuracy\",\"correct\",\"total\",\"prediction\"],\"additionalProperties\":false}},\"required\":[\"model\",\"task\",\"rows\",\"on\",\"metrics\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"model\":{\"enum\":[\"linear\",\"logistic\",\"kmeans\",\"tree\",\"forest\",\"boost\",\"softmax\"]},\"task\":{\"const\":\"regression\"},\"rows\":{\"type\":\"integer\",\"minimum\":0},\"on\":{\"enum\":[\"train\",\"other\",\"unknown\"]},\"metrics\":{\"type\":\"object\",\"properties\":{\"rmse\":{\"oneOf\":[{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?(e[+-]?[0-9]+)?$\"},{\"type\":\"null\"}]},\"mae\":{\"oneOf\":[{\"type\":\"