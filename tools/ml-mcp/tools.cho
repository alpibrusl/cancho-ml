\",\"limit.input-too-large\",\"limit.log-full\",\"ml.param.out-of-range\",\"ml.input.empty\",\"ml.input.too-many-rows\",\"ml.input.too-many-columns\",\"ml.input.too-many-cells\",\"ml.input.non-numeric\",\"ml.input.non-finite\",\"ml.input.duplicate-column\",\"ml.input.unknown-column\",\"parse.csv-ragged-row\",\"parse.csv-bad-quote\",\"parse.csv-unterminated-quote\",\"ml.label.single-class\",\"ml.label.not-binary\",\"ml.label.not-integer\",\"ml.metric.undefined\",\"ml.schema.mismatch\",\"ml.model.bad-magic\",\"ml.model.version\",\"ml.model.truncated\",\"ml.model.checksum\",\"ml.model.malformed\",\"ml.linalg.not-positive-definite\",\"ml.param.threads\",\"ml.fit.non-finite\",\"ml.fit.collinear\",\"ml.fit.separable\",\"ml.predict.non-finite\",\"ml.split.empty-fold\",\"ml.split.stratify-target\",\"ml.split.stratum-too-small\",\"ml.split.too-few-groups\",\"ml.split.time-format\",\"ml.split.missing-cell\",\"ml.split.combination\",\"ml.split.out-of-range\",\"ml.split.column-target\",\"ml.split.emit-too-large\",\"ml.fit.all-missing\",\"ml.limit.categories\",\"ml.limit.string-bytes\",\"ml.limit.string-pool\",\"ml.limit.categorical-columns\",\"ml.input.invalid-utf8\",\"ml.input.categorical-not-encoded\",\"ml.input.unknown-category\",\"ml.plan.column-kind\",\"ml.input.reserved-category\",\"ml.model.string-table\",\"ml.limit.string-table\",\"ml.plan.syntax\",\"ml.plan.unknown-step\",\"ml.plan.unknown-key\",\"ml.plan.missing-key\",\"ml.plan.bad-value\",\"ml.plan.duplicate-key\",\"ml.plan.model-line\",\"ml.plan.unknown-column\",\"ml.limit.plan\",\"ml.input.missing-value\",\"ml.plan.model-not-built\",\"ml.limit.depth\",\"ml.limit.nodes\",\"ml.predict.out-of-range\",\"ml.predict.no-provenance\",\"ml.runs.conflict\",\"ml.runs.too-many\",\"ml.runs.record-too-large\",\"ml.runs.not-found\",\"ml.runs.unknown-model\",\"ml.runs.damaged\",\"ml.runs.data-changed\",\"ml.runs.model-differs\",\"ml.runs.not-replayable\",\"ml.jsonl.syntax\",\"ml.jsonl.not-object\",\"ml.jsonl.missing-field\",\"ml.jsonl.not-scalar\",\"ml.jsonl.duplicate-key\",\"ml.jsonl.type-mismatch\",\"ml.jsonl.mixed-kinds\",\"ml.jsonl.too-many-nodes\",\"ml.importance.unsupported-model\",\"ml.importance.no-scale\",\"ml.importance.bad-metric\",\"ml.importance.undefined-metric\",\"ml.importance.too-few-rows\",\"ml.limit.work\",\"ml.dump.unsupported-model\",\"ml.label.unseen\",\"ml.limit.classes\",\"ml.limit.parameters\",\"ml.weight.missing\",\"ml.weight.negative\",\"ml.weight.too-large\",\"ml.weight.zero-total\",\"ml.rank.bad-relevance\",\"ml.rank.group-missing\",\"ml.limit.group-size\",\"ml.limit.pairs\",\"ml.split.group-required\",\"mcp.read-only\",\"mcp.record-column\",\"serve.number-not-exact\",\"serve.string-not-renderable\"]},\"text_or_bytes\":{\"description\":\"UTF-8 text as a string; other bytes as base64 (RFC 4648 section 4, padded).\",\"oneOf\":[{\"type\":\"string\"},{\"type\":\"object\",\"properties\":{\"b64\":{\"type\":\"string\",\"pattern\":\"^[A-Za-z0-9+/]*={0,2}$\"}},\"required\":[\"b64\"],\"additionalProperties\":false}]}}},\"annotations\":{\"readOnlyHint\":true,\"destructiveHint\":false,\"idempotentHint\":true,\"openWorldHint\":false}},{\"name\":\"importance\",\"title\":\"importance\",\"description\":\"Fit, apply and score a model on a CSV file, with the refusals of a tool an agent can read. Usage of the command line this tool is: `ml [--root DIR] --model-file MODEL [--data FILE] [--metric NAME] [--repeats R] [--seed N] [--threads N] [--drop NAMES] [--max-work N] [--max-bytes N] [--log FILE] [--format json|text] importance`. Values the library refuses (ranges, conflicts between flags, unknown columns) come back as a tool error with the rule, the exit code and the repair.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"model-file\":{\"type\":\"string\",\"minLength\":1,\"description\":\"predict, eval, describe, importance, dump: the model file to read\"},\"data\":{\"type\":\"string\",\"minLength\":1,\"description\":\"importance: the CSV, with the target column, on which the permutation importance is measured, beneath --root. Absent, only the table that needs no data is printed (docs/interpret.md)\"},\"metric\":{\"type\":\"string\",\"minLength\":1,\"description\":\"importance with --data: the metric whose change a permutation measures. A regression: rmse (the default), mae or r2. A classification: roc_auc (the default), accuracy, precision, recall, f1 or log_loss. A name that is not a metric of the task is ml.importance.bad-metric\"},\"repeats\":{\"type\":\"integer\",\"minimum\":0,\"default\":1,\"description\":\"importance with --data: how many times each column is permuted, 1 to 100 (absent: 5). cv: how many times the fold assignment is drawn again with the next index of the stream, 1 to 10. The mean and the standard deviation are over all folds of all repeats. Not above 1 with --split-by\"},\"seed\":{\"type\":\"integer\",\"minimum\":0,\"default\":0,\"description\":\"importance: the seed of the permutation streams (the stream registry, kind 11). fit, eval: the seed of --split (the stream registry, kind 4), of the bootstrap and feature draws of a tree or forest (kinds 1 and 2) and of the initial centres of kmeans (kind 3): one flag, so a forest fitted with --split draws its bootstrap from the seed that chose the split. Stored in the model file\"},\"threads\":{\"type\":\"integer\",\"minimum\":0,\"default\":1,\"description\":\"fit, eval, importance, runs verify: the threads of the numeric kernels, 1 to 64 (ml.param.threads outside). No thread count changes a byte of the model file or of the answer. In eval and importance nothing is threaded and the flag is checked and unused. In runs verify it is the thread count of the refit\"},\"drop\":{\"type\":\"string\",\"minLength\":1,\"description\":\"columns to ignore, header names separated by commas (fit, predict, eval, importance). A dropped column is not part of the stored schema, and its cells are not read as numbers (it may hold text, quoted fields and line breaks)\"},\"max-work\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1099511627776,\"default\":4294967296,\"description\":\"importance with --data: the most row evaluations of the permutation run, rows times columns times repeats, checked before the first permutation. More is ml.limit.work\"},\"max-rows\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1000000000,\"default\":10000000,\"description\":\"the most data rows read. More is ml.input.too-many-rows\"},\"max-columns\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":8192,\"default\":4096,\"description\":\"the most columns read. More is ml.input.too-many-columns\"},\"max-cells\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":1099511627776,\"default\":400000000,\"description\":\"the most rows times columns. More is ml.input.too-many-cells\"},\"max-line-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":16777216,\"default\":1048576,\"description\":\"the longest line read. A longer one is limit.line-too-long\"},\"max-bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":268435456,\"default\":16777216,\"description\":\"fit: the largest model file written, the limit predict and eval apply when they read it. A larger one is limit.input-too-large and nothing is written. predict, eval, describe: the largest model file read. A larger one is limit.input-too-large. predict from standard input (the operand - or none): the CSV is held in memory, so this is also the most bytes of standard input read. More is limit.input-too-large\"}},\"required\":[\"model-file\"],\"additionalProperties\":false},\"outputSchema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"One JSON object on one line. ok is false exactly when errors is present; error is its first element. A dry run (fit --dry-run) has ok true, exit 9, dry_run and planned_actions. No float appears: every decimal is a string with its digits exact.\",\"type\":\"object\",\"properties\":{\"ok\":{\"type\":\"boolean\"},\"command\":{\"const\":\"ml\"},\"schema\":{\"const\":\"ml.v1\"},\"data\":{\"$ref\":\"#/$defs/data\"},\"dry_run\":{\"const\":true},\"planned_actions\":{\"type\":\"array\",\"items\":{\"oneOf\":[{\"type\":\"object\",\"properties\":{\"op\":{\"enum\":[\"create\",\"replace\"]},\"path\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"bytes\":{\"type\":\"integer\",\"minimum\":0},\"sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"}},\"required\":[\"op\",\"path\",\"bytes\",\"sha256\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"op\":{\"const\":\"create\"},\"dir\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"file\":{\"$ref\":\"#/$defs/text_or_bytes\"},\"bytes\":{\"type\":\"integer\",\"minimum\":0},\"sha256\":{\"type\":\"string\",\"pattern\":\"^[0-9a-f]{64}$\"}},\"required\":[\"op\",\"dir\",\"file\",\"bytes\",\"sha256\"],\"additionalProperties\":false}]}},\"error\":{\"$ref\":\"#/$defs/error\"},\"errors\":{\"type\":\"array\",\"items\":{\"$ref\":\"#/$defs/error\"},\"minItems\":1},\"meta\":{\"$ref\":\"#/$defs/meta\"}},\"required\":[\"ok\",\"command\",\"schema\",\"meta\"],\"additionalProperties\":false,\"allOf\":[{\"if\":{\"properties\":{\"ok\":{\"const\":true}}},\"then\":{\"not\":{\"anyOf\":[{\"required\":[\"error\"]},{\"required\":[\"errors\"]}]}},\"else\":{\"required\":[\"error\",\"errors\"]}}],\"title\":\"ml.v1 importance\",\"$defs\":{\"data\":{\"type\":\"object\",\"properties\":{\"model\":{\"enum\":[\"linear\",\"logistic\",\"tree\",\"forest\"]},\"task\":{\"enum\":[\"regression\",\"classification\"]},\"kind\":{\"enum\":[4,5,7]},\"importance\":{\"oneOf\":[{\"type\":\"object\",\"properties\":{\"method\":{\"const\":\"standardised_coefficient\"},\"available\":{\"const\":true},\"measure\":{\"type\":\"string\"},\"total\":{\"type\":\"string\",\"pattern\":\"^-?[0-9]+(\\\\.[0-9]+)?(e[+-]?[0-9]+)?$\"},\"listed\":{\"type\":\"integer\",\"minimum\":0},\"truncated\":{\"type\":\"boolean\"},\"columns\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"column\":{\"$ref\":\"#/$defs/text_or_bytes\"},\