// reader-check: reads a CSV file into the matrix of lib/core (tools/ml/csvload.cho) and prints what it holds, so that a script can
// compare every cell, bit for bit, with Python (scripts/gate_reader.py; docs/reader.md section 5). Not a product: a driver for gates,
// the way tools/linalg-check is.
//
//     reader-check [--mode shape|dump|hash|cat] [--max-rows N] [--max-columns N] [--max-cells N] [--max-line-bytes N]
//                  [--drop NAMES] [--float NAMES] [--cat NAMES] [--na-values LIST] [--max-categories N] [--max-string-bytes N]
//                  [--max-pool-bytes N] [--max-cat-columns N] [--target NAME] [--predict FILE2 [--predict-skip]] FILE
//
// shape: pass 1 only (no matrix): rows, columns, the kind of every column. dump: the matrix, every cell. hash: the matrix, one hash.
// cat (docs/categorical.md section 7): the loader with categorical columns. The numeric matrix as in dump, then the vocabulary and the ids:
//     vocab NCOLS / vcol J COUNT NAME / cat J I HEX (the bytes of the category of rank I of column J) / dump HEX (the canonical dump of the vocabulary)
//     id R J ID BIT (ID: -1 missing, -2 unseen; BIT: the missing bitmap's bit, 1 exactly when the id is -1) / unseen J N
// with --predict FILE2 the vocabulary built from FILE is then given to a second load of FILE2 (predict: the same in-memory vocabulary), and its lines are
// printed with a `p-` in front (p-rows, p-id, p-unseen, p-refused, p-refused-matrix); --predict-skip skips the target column of the second load.
// stdout, one `key value...` per line:
//     rows R / cols C (kept columns)            col J KIND SCALE MISSING NAME     (KIND 0 none, 1 int, 2 dec, 3 float)
//     cell R J HEX16 | cell R J M               (dump: the 64 bits of the double, or M for a missing cell)
//     hash H (16 hex digits), missing M (total) (hash)
//     refused STATUS LINE COL AUX               (the report of ml.csv: docs/reader.md, ml.csv.Report)
//     refused-matrix TAG                        (a shape over a cap, or no rows)
// exit status: 0 read, 8 refused, 3 the file did not open, 2 the arguments.
edition 5;

import std.buffer;
import std.io;
import ml.catmat;
import ml.csv;
import ml.csvload;
import ml.dict;
import ml.limits;
import ml.matrix;
import ml.refuse;
import ml.rng;
import ml.pathcheck;
import linalg.tensor;

// decimal digits only, at most 18 of them; anything else answers -1
fn number_of[&s](text: &s [byte]) -> [] int {
    if len(text) == 0 || len(text) > 18 {
        return 0 - 1;
    }
    var n = 0;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < '0' || c > '9' {
            return 0 - 1;
        }
        n = n * 10 + (c - '0');
        i = i + 1;
    }
    return n;
}

fn same[&a, &b](x: &a [byte], y: &b [byte]) -> [] bool {
    if len(x) != len(y) {
        return false;
    }
    var i = 0;
    while i < len(x) {
        if x[i] != y[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn hex16[&i](io: &!i Io, bits: int) -> [io_write] int {
    var k = 0;
    while k < 16 {
        let nib = bits >> 60 - 4 * k & 15;
        if nib < 10 {
            putchar(io, '0' + nib);
        } else {
            putchar(io, 'a' + nib - 10);
        }
        k = k + 1;
    }
    return 0;
}

fn put_int[&i](io: &!i Io, v: int) -> [io_write] int {
    if v < 0 {
        putchar(io, '-');
        return put_int(io, 0 - v);
    }
    if v >= 10 {
        put_int(io, v / 10);
    }
    putchar(io, '0' + v % 10);
    return 0;
}

fn word[&i](io: &!i Io, text: &static [byte]) -> [io_write] int {
    io.write_all(io, text);
    return 0;
}

fn shape_lines[&i, &s](io: &!i Io, sh: &s csv.Shape) -> [io_write] int {
    word(io, "rows ");
    put_int(io, csv.rows(sh));
    io.newline(io);
    var kept = 0;
    var j = 0;
    while j < csv.cols(sh) {
        if !csv.dropped(sh, j) {
            kept = kept + 1;
        }
        j = j + 1;
    }
    word(io, "cols ");
    put_int(io, kept);
    io.newline(io);
    var k = 0;
    j = 0;
    while j < csv.cols(sh) {
        if !csv.dropped(sh, j) {
            word(io, "col ");
            put_int(io, k);
            word(io, " ");
            put_int(io, csv.kind(sh, j));
            word(io, " ");
            put_int(io, csv.scale(sh, j));
            word(io, " ");
            io.write_all(io, csv.name(sh, j));
            io.newline(io);
            k = k + 1;
        }
        j = j + 1;
    }
    return 0;
}

// prints the refusal of a report and answers the exit status: 3 the file did not open, else 8
fn refusal[&i](io: &!i Io, rep: csv.Report) -> [io_write] int {
    if rep.status == 99 {
        word(io, "refused-open ");
        put_int(io, rep.aux);
        io.newline(io);
        return 3;
    }
    word(io, "refused ");
    put_int(io, rep.status);
    word(io, " ");
    put_int(io, rep.line);
    word(io, " ");
    put_int(io, rep.col);
    word(io, " ");
    put_int(io, rep.aux);
    io.newline(io);
    return 8;
}

fn shape_only[&h, &i, &f](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), file: &static [byte], cfg: csv.Cfg) -> [heap, io_write, fs_read(""), dir_read, file_read] int {
    let (sh, rep, sk) = csvload.pass(heap, fs, "", file, file, cfg, "", csv.plain_sinks(heap, 8, false));
    csv.drop_sinks(heap, sk);
    var code = 0;
    if rep.status != 0 {
        code = refusal(io, rep);
    } else {
        borrow sh as &sr in {
            shape_lines(io, sr);
        }
    }
    csv.drop_shape(heap, sh);
    return code;
}

// the whole matrix: mode 1 prints every cell, mode 2 one hash
fn whole[&h, &i, &f](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), file: &static [byte], cfg: csv.Cfg, mode: int) -> [heap, io_write, fs_read(""), dir_read, file_read] int {
    let (mx, sh, rep, code) = csvload.load(heap, fs, "", file, file, cfg);
    var out = 0;
    if rep.status != 0 {
        out = refusal(io, rep);
    } else if code != 0 {
        word(io, "refused-matrix ");
        io.write_all(io, refuse.tag(code));
        io.newline(io);
        out = 8;
    } else {
        borrow sh as &sr in {
            shape_lines(io, sr);
        }
        borrow mx as &mr in {
            let rows = matrix.rows(mr);
            let cols = matrix.cols(mr);
            var h = 0;
            var missing = 0;
            var r = 0;
            while r < rows {
                var c = 0;
                while c < cols {
                    let gone = matrix.is_missing(mr, r, c);
                    if gone {
                        missing = missing + 1;
                    }
                    if mode == 1 {
                        word(io, "cell ");
                        put_int(io, r);
                        word(io, " ");
                        put_int(io, c);
                        word(io, " ");
                        if gone {
                            word(io, "M");
                        } else {
                            hex16(io, bits_of(matrix.value(mr, r, c)));
                        }
                        io.newline(io);
                    } else {
                        var bits = bits_of(matrix.value(mr, r, c));
                        if gone {
                            bits = 0 - 1;
                        }
                        h = wrapping_add(h, rng.mix(bits ^ rng.mix(r * cols + c)));
                    }
                    c = c + 1;
                }
                r = r + 1;
            }
            if mode == 2 {
                word(io, "hash ");
                hex16(io, h);
                io.newline(io);
            }
            word(io, "missing ");
            put_int(io, missing);
            io.newline(io);
        }
    }
    csv.drop_shape(heap, sh);
    matrix.drop(heap, mx);
    return out;
}

fn hexbyte[&i](io: &!i Io, b: int) -> [io_write] int {
    let hi = b >> 4 & 15;
    let lo = b & 15;
    if hi < 10 {
        putchar(io, '0' + hi);
    } else {
        putchar(io, 'a' + hi - 10);
    }
    if lo < 10 {
        putchar(io, '0' + lo);
    } else {
        putchar(io, 'a' + lo - 10);
    }
    return 0;
}

fn hexs[&i, &t](io: &!i Io, text: &t [byte]) -> [io_write] int {
    var k = 0;
    while k < len(text) {
        hexbyte(io, int_of(text[k]));
        k = k + 1;
    }
    return 0;
}

// the ids of a load, with `pre` in front of each line's key ("" or "p-")
fn print_ids[&i, &m](io: &!i Io, ids: &m catmat.Ids, pre: &static [byte]) -> [io_write] int {
    var r = 0;
    while r < catmat.rows(ids) {
        var c = 0;
        while c < catmat.cols(ids) {
            word(io, pre);
            word(io, "id ");
            put_int(io, r);
            word(io, " ");
            put_int(io, c);
            word(io, " ");
            put_int(io, catmat.id(ids, r, c));
            word(io, " ");
            if catmat.is_missing(ids, r, c) {
                word(io, "1");
            } else {
                word(io, "0");
            }
            io.newline(io);
            c = c + 1;
        }
        r = r + 1;
    }
    var c = 0;
    while c < catmat.cols(ids) {
        word(io, pre);
        word(io, "unseen ");
        put_int(io, c);
        word(io, " ");
        put_int(io, catmat.unseen_count(ids, c));
        io.newline(io);
        c = c + 1;
    }
    return 0;
}

fn print_vocab[&i, &v](io: &!i Io, v: &v dict.Vocab) -> [io_write] int {
    word(io, "vocab ");
    put_int(io, dict.ncols(v));
    io.newline(io);
    var c = 0;
    while c < dict.ncols(v) {
        word(io, "vcol ");
        put_int(io, c);
        word(io, " ");
        put_int(io, dict.count(v, c));
        word(io, " ");
        io.write_all(io, dict.name(v, c));
        io.newline(io);
        var k = 0;
        while k < dict.count(v, c) {
            word(io, "cat ");
            put_int(io, c);
            word(io, " ");
            put_int(io, k);
            word(io, " ");
            hexs(io, dict.string(v, c, k));
            io.newline(io);
            k = k + 1;
        }
        c = c + 1;
    }
    return 0;
}

// the refusal of a load, with the `p-` prefix when it is the second
fn load_refusal[&i](io: &!i Io, rep: csv.Report, code: int, pre: &static [byte]) -> [io_write] int {
    if rep.status != 0 {
        if rep.status == 99 {
            word(io, pre);
            word(io, "refused-open ");
            put_int(io, rep.aux);
            io.newline(io);
            return 3;
        }
        word(io, pre);
        word(io, "refused ");
        put_int(io, rep.status);
        word(io, " ");
        put_int(io, rep.line);
        word(io, " ");
        put_int(io, rep.col);
        word(io, " ");
        put_int(io, rep.aux);
        io.newline(io);
        return 8;
    }
    word(io, pre);
    word(io, "refused-matrix ");
    io.write_all(io, refuse.tag(code));
    io.newline(io);
    return 8;
}

fn cat_mode[&h, &i, &f, &t](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), file: &static [byte], file2: &static [byte], skip2: bool, cfg: csv.Cfg, cc: csv.CatCfg, target: &t [byte]) -> [heap, io_write, fs_read(""), dir_read, file_read] int {
    let l = csvload.load_cat(heap, fs, "", file, file, cfg, cc, target, false, dict.empty_vocab(heap), false);
    let (mx, ids, voc, sh, rep, code) = csvload.cat_load_parts(l);
    var out = 0;
    if rep.status != 0 || code != 0 {
        out = load_refusal(io, rep, code, "");
        matrix.drop(heap, mx);
        catmat.drop(heap, ids);
        dict.drop_vocab(heap, voc);
        csv.drop_shape(heap, sh);
        return out;
    }
    borrow sh as &sr in {
        shape_lines(io, sr);
    }
    borrow mx as &mr in {
        var r = 0;
        while r < matrix.rows(mr) {
            var c = 0;
            while c < matrix.cols(mr) {
                word(io, "cell ");
                put_int(io, r);
                word(io, " ");
                put_int(io, c);
                word(io, " ");
                if matrix.is_missing(mr, r, c) {
                    word(io, "M");
                } else {
                    hex16(io, bits_of(matrix.value(mr, r, c)));
                }
                io.newline(io);
                c = c + 1;
            }
            r = r + 1;
        }
    }
    word(io, "rows ");
    borrow ids as &ir in {
        put_int(io, catmat.rows(ir));
        io.newline(io);
        print_ids(io, ir, "");
    }
    borrow voc as &vr in {
        print_vocab(io, vr);
        var dumped = dict.dump(heap, vr);
        borrow dumped as &dr in {
            word(io, "dump ");
            hexs(io, buffer.bytes(dr));
            io.newline(io);
        }
        buffer.drop(heap, dumped);
    }
    matrix.drop(heap, mx);
    catmat.drop(heap, ids);
    csv.drop_shape(heap, sh);
    if len(file2) > 0 {
        let l2 = csvload.load_cat(heap, fs, "", file2, file2, cfg, cc, target, skip2, voc, true);
        let (mx2, ids2, voc2, sh2, rep2, code2) = csvload.cat_load_parts(l2);
        if rep2.status != 0 || code2 != 0 {
            out = load_refusal(io, rep2, code2, "p-");
        } else {
            borrow ids2 as &ir2 in {
                word(io, "p-rows ");
                put_int(io, catmat.rows(ir2));
                io.newline(io);
                print_ids(io, ir2, "p-");
            }
        }
        matrix.drop(heap, mx2);
        catmat.drop(heap, ids2);
        dict.drop_vocab(heap, voc2);
        csv.drop_shape(heap, sh2);
    } else {
        dict.drop_vocab(heap, voc);
    }
    return out;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(ffi);
    release(net);
    release(clock);
    var mode = 1;
    var max_rows = limits.default_rows();
    var max_cols = limits.default_cols();
    var max_cells = limits.default_cells();
    var max_line = 1048576;
    var drops: &static [byte] = "";
    var floats: &static [byte] = "";
    var cats: &static [byte] = "";
    var nas: &static [byte] = "";
    var max_cats = dict.default_categories();
    var max_str = dict.default_string_bytes();
    var max_pool = dict.default_pool_bytes();
    var max_catcols = dict.default_columns();
    var target: &static [byte] = "";
    var file2: &static [byte] = "";
    var skip2 = false;
    var file: &static [byte] = "";
    var bad = false;
    borrow args as &g in {
        var i = 1;
        while i < arg_count(g) {
            let a = arg(g, i);
            if same(a, "--mode") && i + 1 < arg_count(g) {
                let v = arg(g, i + 1);
                if same(v, "shape") {
                    mode = 0;
                } else if same(v, "dump") {
                    mode = 1;
                } else if same(v, "hash") {
                    mode = 2;
                } else if same(v, "cat") {
                    mode = 3;
                } else {
                    bad = true;
                }
                i = i + 2;
            } else if same(a, "--max-rows") && i + 1 < arg_count(g) {
                max_rows = number_of(arg(g, i + 1));
                i = i + 2;
            } else if same(a, "--max-columns") && i + 1 < arg_count(g) {
                max_cols = number_of(arg(g, i + 1));
                i = i + 2;
            } else if same(a, "--max-cells") && i + 1 < arg_count(g) {
                max_cells = number_of(arg(g, i + 1));
                i = i + 2;
            } else if same(a, "--max-line-bytes") && i + 1 < arg_count(g) {
                max_line = number_of(arg(g, i + 1));
                i = i + 2;
            } else if same(a, "--drop") && i + 1 < arg_count(g) {
                drops = arg(g, i + 1);
                i = i + 2;
            } else if same(a, "--float") && i + 1 < arg_count(g) {
                floats = arg(g, i + 1);
                i = i + 2;
            } else if same(a, "--cat") && i + 1 < arg_count(g) {
                cats = arg(g, i + 1);
                i = i + 2;
            } else if same(a, "--na-values") && i + 1 < arg_count(g) {
                nas = arg(g, i + 1);
                i = i + 2;
            } else if same(a, "--max-categories") && i + 1 < arg_count(g) {
                max_cats = number_of(arg(g, i + 1));
                i = i + 2;
            } else if same(a, "--max-string-bytes") && i + 1 < arg_count(g) {
                max_str = number_of(arg(g, i + 1));
                i = i + 2;
            } else if same(a, "--max-pool-bytes") && i + 1 < arg_count(g) {
                max_pool = number_of(arg(g, i + 1));
                i = i + 2;
            } else if same(a, "--max-cat-columns") && i + 1 < arg_count(g) {
                max_catcols = number_of(arg(g, i + 1));
                i = i + 2;
            } else if same(a, "--target") && i + 1 < arg_count(g) {
                target = arg(g, i + 1);
                i = i + 2;
            } else if same(a, "--predict") && i + 1 < arg_count(g) {
                file2 = arg(g, i + 1);
                i = i + 2;
            } else if same(a, "--predict-skip") {
                skip2 = true;
                i = i + 1;
            } else if len(a) > 1 && int_of(a[0]) == '-' && int_of(a[1]) == '-' {
                bad = true;
                i = i + 1;
            } else {
                file = a;
                i = i + 1;
            }
        }
    }
    var code = 0;
    if !bad && pathcheck.has_double_dot(file) {
        // the same tag and exit as ml, models-check and tree-check: open_read traps on two dots in a row
        borrow mut io as &!ip in {
            word(ip, "refused ");
            word(ip, pathcheck.tag());
            io.newline(ip);
        }
        code = pathcheck.exit_code();
    } else if bad || len(file) == 0 || max_rows < 1 || max_cols < 1 || max_cells < 1 || max_line < 1 {
        borrow mut io as &!ip in {
            word(ip, "usage: reader-check [--mode shape|dump|hash|cat] [--max-rows N] [--max-columns N] [--max-cells N] [--max-line-bytes N] [--drop NAMES] [--float NAMES] [--cat NAMES] [--na-values LIST] [--max-categories N] [--max-string-bytes N] [--max-pool-bytes N] [--max-cat-columns N] [--target NAME] [--predict FILE2] [--predict-skip] FILE\n");
        }
        code = 2;
    } else {
        let cfg = csv.Cfg { cap: max_line, max_rows: max_rows, max_cols: max_cols, max_cells: max_cells, mode: 0, tscale: 0, pred: 0, drops: drops, floats: floats, missing: true, mrows: 0, mcols: 0, wpc: 0 };
        borrow mut heap as &!hp in {
            borrow mut io as &!ip in {
                borrow fs as &fr in {
                    if mode == 3 {
                        let cc = csv.CatCfg { cols: cats, na: nas, max_cats: max_cats, max_str: max_str, max_pool: max_pool, max_catcols: max_catcols, lenient: false };
                        code = cat_mode(hp, ip, fr, file, file2, skip2, cfg, cc, target);
                    } else if mode == 0 {
                        code = shape_only(hp, ip, fr, file, cfg);
                    } else {
                        code = whole(hp, ip, fr, file, cfg, mode);
                    }
                }
            }
        }
    }
    release(fs);
    release(args);
    release(heap);
    release(io);
    return code;
}
