edition 5;

// `ml-predict` -- the prediction half of `ml` (docs/serving.md section 3): predict and describe, built from the sources of `ml`. This is its entry point: it
// opens the world, checks the command line with the code of tools/ml/app.cho, runs one of the two verbs and answers. It never calls the code of `fit`, `eval`
// or of the log, so the authority the compiler derives from it (what `main` reaches) has no write of any kind and no thread.

import std.buffer;
import std.bytes;
import ml.app;
import ml.argv;
import ml.jsonlcli;
import ml.mdesc;
import ml.paths;
import ml.spec;
import ml.verbs;
import ml.wireio;
import toolbox.built;
import toolbox.cli;
import toolbox.describe;
import toolbox.fail;
import toolbox.path;

fn built() -> [] describe.Built {
    return describe.Built { authority: built.authority(), schema: built.schema(), compiler: built.compiler() };
}

// run the verb: predict or describe. There is no log: the Out's log buffer stays empty and is dropped by `finish`.
fn execute[&h, &f, &r, &pp, &cl](heap: &!h Heap, src: &cl [byte], fs: &f Fs(""), root: &r [byte], verb: int, ps: &pp app.Paths, errs: fail.Errors) -> [heap, fs_read(""), dir_read, file_read] verbs.Out {
    let table = spec.predict_flag_table();
    let lg = buffer.empty(heap, 1);
    let (e1, go) = app.clean(errs);
    if !go {
        return verbs.nothing(heap, e1, lg);
    }
    let o = app.options(src, table);
    if verb == 4 {
        return mdesc.describe(heap, fs, root, ps.model, o, e1, lg);
    }
    return wireio.predict(heap, src, fs, root, ps.file, ps.model, o, e1, lg);
}

// the answer
fn finish[&h, &i, &cl](heap: &!h Heap, src: &cl [byte], io: &!i Io, result: verbs.Out) -> [heap, io_write, err_write] int {
    let table = spec.predict_flag_table();
    let (payload, plain, extra, errs, log, dry) = verbs.parts(result);
    buffer.drop(heap, log);
    var status = 0;
    borrow errs as &er in {
        borrow payload as &d in {
            borrow extra as &x in {
                borrow plain as &t in {
                    status = app.respond(heap, src, table, io, er, buffer.bytes(d), buffer.bytes(x), buffer.bytes(t), dry);
                }
            }
        }
    }
    buffer.drop(heap, payload);
    buffer.drop(heap, plain);
    buffer.drop(heap, extra);
    fail.drop(heap, errs);
    return status;
}

fn body[&h, &f, &i, &cl](heap: &!h Heap, src: &cl [byte], fs: &f Fs(""), io: &!i Io, errs: fail.Errors) -> [heap, fs_read(""), dir_read, file_read, io_read, io_write, err_write] int {
    let table = spec.predict_flag_table();
    let (verb, e0a) = app.cmdline(heap, src, errs, table, 2);
    let e0 = jsonlcli.check_flags(heap, src, e0a, table, verb);
    let (root, e1a) = paths.root(heap, src, argv.text(src, "root"), argv.value_index(src, "root"), e0);
    var e1 = e1a;
    borrow root as &rb in {
        if paths.has_double_dot(buffer.bytes(rb)) {
            e1 = paths.refuse_double_dot(heap, e1, buffer.bytes(rb), argv.value_index(src, "root"));
        }
    }
    var status = 0;
    borrow root as &rr in {
        let (ps0, e2a) = app.resolve_all(heap, src, table, verb, buffer.bytes(rr), e1);
        let (ps1, e2b) = app.stdin_into(heap, src, table, io, verb, ps0, e2a);
        let (ps, e2) = jsonlcli.input_into(heap, src, table, fs, buffer.bytes(rr), verb, ps1, e2b);
        borrow ps as &pr in {
            let result = execute(heap, src, fs, buffer.bytes(rr), verb, pr, e2);
            status = finish(heap, src, io, result);
        }
        app.drop_paths(heap, ps);
    }
    buffer.drop(heap, root);
    return status;
}

fn run[&h, &f, &i, &g](heap: &!h Heap, args: &g Args, fs: &f Fs(""), io: &!i Io) -> [heap, args, fs_read(""), dir_read, file_read, io_read, io_write, err_write] int {
    let which = cli.subcommand(args);
    if which != 0 {
        return describe.answer(heap, io, which, spec.predict_tool(), built());
    }
    let (parsed, e) = cli.parse(heap, args, spec.predict_flag_table(), fail.empty_in(heap, spec.extra()));
    var status = 0;
    borrow parsed as &p in {
        let packed = argv.from_cli(heap, args, p, spec.predict_flag_table());
        borrow packed as &pk in {
            status = body(heap, buffer.bytes(pk), fs, io, e);
        }
        buffer.drop(heap, packed);
    }
    cli.drop(heap, parsed);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    // No foreign code, no network, no clock.
    release(ffi);
    release(net);
    release(clock);
    var status = 0;
    borrow mut heap as &!h in {
        borrow args as &g in {
            borrow fs as &f in {
                borrow mut io as &!i in {
                    status = run(h, g, f, i);
                }
            }
        }
    }
    release(heap);
    release(args);
    release(fs);
    release(io);
    return status;
}
