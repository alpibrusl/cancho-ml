// ---------------------------------------------------------------- the model file's kind

// whether the plan text names a tree, a forest or a boosted model on its model line (a kind 7 payload under a boost plan is then this module's refusal, malformed)
fn names_tree[&p](plan: &p [byte]) -> [] bool {
    return bytes.find(plan, "model kind=tree") >= 0 || bytes.find(plan, "model kind=forest") >= 0 || bytes.find(plan, "model kind=boost") >= 0;
}

// The kind of the model in a CML1 file, from the structure alone (nothing is checked but what is needed to find it); 0 when the structure does not
// allow it. The old reader gives the real error for such a file.
pub fn peek_kind[&d](data: &d [byte]) -> [] int {
    let n = len(data);
    if n < 44 || !bytes.equal(data[0..4], "CML1") || record.get32(data, 8) < 5 || record.get32(data, 8) > 7 {
        return 0;
    }
    let body = n - 32;
    var pos = 12;
    var s = 0;
    var plan_at = 0;
    var plan_len = 0;
    while s < 5 {
        if pos + 12 > body {
            return 0;
        }
        let length = fbits.get64(data, pos + 4);
        if length < 0 || length > body - pos - 12 {
            return 0;
        }
        if s == 0 {
            plan_at = pos + 12;
            plan_len = length;
        }
        if s == 3 {
            if length < 4 {
                return 0;
            }
            let kind = record.get32(data, pos + 12);
            // the payload of a tree or forest (kind 7) is this module's only when the plan names one: a constant plan with a kind 7 payload is the old reader's refusal
            if kind == 7 && !names_tree(data[plan_at..plan_at + plan_len]) {
                return 0;
            }
            return kind;
        }
        pos = pos + 12 + length;
        s = s + 1;
    }
    return 0;
}

// whether the model file is one of the planned kinds (the wired kinds, or a file with a string table): the files `predict` and `describe` decode with load_stored
pub fn planned_file[&d](data: &d [byte]) -> [] bool {
    return est.wired(peek_kind(data)) || six_sections(data);
}

pub fn stored_file[&s](st: &s Stored) -> [] &s file.Loaded {
    return st.lo;
}

pub fn stored_schema[&s](st: &s Stored) -> [] &s schema.Schema {
    return st.sc;
}

pub fn stored_kind[&s](st: &s Stored) -> [] int {
    return st.kind;
}

pub fn stored_task[&s](st: &s Stored) -> [] int {
    return st.task;
}

pub fn stored_c0[&s](st: &s Stored) -> [] int {
    return st.c0;
}

pub fn stored_c1[&s](st: &s Stored) -> [] int {
    return st.c1;
}

// whether the file has a string table (docs/stringtable.md): seven sections, or six of which the sixth is not the provenance (tag 7). The constant models never have a table, so such a file is
// this module's whatever its model section says, and its refusals are the pipeline's, in the order of design.md 4.1. The sixth tag is read from the structure; a structure that does not allow
// it is the pipeline's refusal too.
fn six_sections[&d](data: &d [byte]) -> [] bool {
    if len(data) < 12 || !bytes.equal(data[0..4], "CML1") {
        return false;
    }
    let count = record.get32(data, 8);
    if count == 7 {
        return true;
    }
    if count != 6 {
        return false;
    }
    // a file whose plan is the constant model's has no string table: its damage is the constant reader's to report (it carries section 7 since M22, so its count is 6)
    if len(data) >= 43 && bytes.equal(data[24..43], "model kind=constant") {
        return false;
    }
    let body = len(data) - 32;
    var pos = 12;
    var s = 0;
    while s < 5 {
        if pos + 12 > body {
            return true;
        }
        let length = fbits.get64(data, pos + 4);
        if length < 0 || length > body - pos - 12 {
            return true;
        }
        pos = pos + 12 + length;
        s = s + 1;
    }
    if pos + 12 > body {
        return true;
    }
    return record.get32(data, pos) != kinds.section_provenance();
}

// ---------------------------------------------------------------- the stored model

// A model file of a planned kind, decoded and checked: the file (kept: the stored steps are views into it), the schema, the estimator's parameters and labels,
// and the schema as the old schema check reads it (an mfile.Model with no statistics)
pub res struct Stored {
    lo: file.Loaded,
    sc: schema.Schema,
    kind: int,
    wv: Box[[float]],
    c0: int,
    c1: int,
    d: int,
    // 1 regression, 2 classification: the estimator's for the linear models, the payload's for the tree and the forest
    task: int,
    view: mfile.Model,
    // whether the file has a string table: the categorical columns are then read through the vocabulary of its steps (docs/stringtable.md section 5)
    cat: bool,
}

pub fn drop_stored[&h](heap: &!h Heap, s: Stored) -> [heap] int {
    let Stored { lo, sc, kind, wv, c0, c1, d, task, view, cat } = s;
    file.drop(heap, lo);
    schema.drop(heap, sc);
    unbox_slice(heap, wv);
    mfile.drop_model(heap, view);
    return kind;
}

pub fn empty_stored[&h](heap: &!h Heap) -> [heap] Stored {
    return Stored { lo: file.empty(heap), sc: schema.empty(heap), kind: 0, wv: box_slice(heap, 2, 0.0), c0: 0, c1: 0, d: 0, task: 0, view: mfile.empty_model(heap), cat: false };
}

// the schema as an mfile.Model without statistics
fn view_of[&h, &s](heap: &!h Heap, sc: &s schema.Schema, rows: int) -> [heap] mfile.Model {
    let cols = schema.columns(sc);
    var nm = buffer.empty(heap, 64);
    var ends = vec.empty(heap, 16, 0);
    var types = box_slice(heap, 2 * cols + 1, 0);
    borrow mut types as &!tw in {
        var i = 0;
        while i < cols {
            nm = buffer.append(heap, nm, schema.name(sc, i));
            var size = 0;
            borrow nm as &nr in {
                size = buffer.size(nr);
            }
            ends = vec.push(heap, ends, size);
            contents(tw)[i] = schema.type_of(sc, i);
            contents(tw)[cols + i] = schema.scale_of(sc, i);
            i = i + 1;
        }
    }
    return mfile.Model { kind: 0, rows: rows, cols: cols, target: schema.target(sc), names: nm, ends: ends, types: types, stats: box_slice(heap, 8, 0), nstats: 0, prov: buffer.empty(heap, 1) };
}

pub fn load_stored[&h, &d, &p](heap: &!h Heap, data: &d [byte], shown: &p [byte], errs: fail.Errors) -> [heap] (Stored, bool, fail.Errors) {
    var e = errs;
    let (lo, f) = file.decode(heap, data);
    if f.code != 0 {
        file.drop(heap, lo);
        return (empty_stored(heap), false, wiredata.file_fault(heap, e, f, shown));
    }
    var kind = 0;
    var width = 0;
    var rows = 0;
    borrow lo as &lr in {
        kind = file.model_kind(lr);
        width = file.width(lr);
        rows = file.rows(lr);
    }
    let bad = codes.fault(codes.malformed(), 4, 0, 0);
    if !est.wired(kind) {
        file.drop(heap, lo);
        return (empty_stored(heap), false, wiredata.file_fault(heap, e, bad, shown));
    }
    // the model the plan names: the dispatch key (the tree and the forest share the kind 7 of their payload, the plan says which was fitted)
    var key = kind;
    // the task the plan's model line names (a model of both tasks); 0 for the others
    var plan_task = 0;
    // the k of the plan's model line (a clustering); 0 for the others
    var plan_k = 0;
    borrow lo as &lr in {
        let (pl, pf) = plan.parse(heap, file.plan_bytes(lr));
        borrow pl as &pr in {
            key = est.kind_named(plan.model_name(plan.model_kind(pr)));
            if est.task(key) == 3 || est.task(key) == 4 {
                var ip = box_slice(heap, est.nints(key) + 1, 0);
                var fp = box_slice(heap, est.nfloats(key) + 1, 0.0);
                var bad = 1;
                borrow mut ip as &!iw in {
                    borrow mut fp as &!fw in {
                        bad = est.hparams(key, plan.model_line(pr), contents(iw), contents(fw));
                    }
                }
                if bad == 0 {
                    borrow ip as &ir in {
                        if est.task(key) == 3 {
                            plan_task = est.task_of(key, contents(ir));
                        } else {
                            plan_k = contents(ir)[0];
                        }
                    }
                }
                unbox_slice(heap, ip);
                unbox_slice(heap, fp);
            }
        }
        plan.drop(heap, pl);
    }
    if est.kind_of(key) != kind {
        file.drop(heap, lo);
        return (empty_stored(heap), false, wiredata.file_fault(heap, e, bad, shown));
    }
    kind = key;
    var sc = schema.empty(heap);
    var scode = 0;
    borrow lo as &lr in {
        let (s2, c2) = schema.decode(heap, file.schema_bytes(lr));
        schema.drop(heap, sc);
        sc = s2;
        scode = c2;
    }
    if scode != 0 {
        file.drop(heap, lo);
        schema.drop(heap, sc);
        return (empty_stored(heap), false, wiredata.file_fault(heap, e, codes.fault(codes.malformed(), 2, 0, 0), shown));
    }
    var nw = 2;
    if !est.is_blob(kind) {
        nw = est.out_len(kind, width) + 1;
    }
    var wv = box_slice(heap, nw, 0.0);
    var c0 = 0;
    var c1 = 0;
    var dcode = 0;
    var task = est.task(kind);
    borrow lo as &lr in {
        if est.is_blob(kind) {
            // the tree and the forest: the payload is checked whole, and kept in the file (the model section) for predict
            let dec = est.decode_blob(heap, kind, file.model_bytes(lr), width);
            dcode = dec.code;
            c0 = dec.c0;
            c1 = dec.c1;
            task = dec.end;
        } else {
            borrow mut wv as &!ww in {
                let dec = est.decode(kind, file.model_bytes(lr), width, contents(ww));
                dcode = dec.code;
                c0 = dec.c0;
                c1 = dec.c1;
            }
        }
    }
    if dcode == 0 && plan_task != 0 && plan_task != task {
        // the plan says classification and the payload is a regression, or the other way: a file that disagrees with itself
        dcode = 1;
    }
    if dcode == 0 && plan_k != 0 && plan_k != c0 {
        // the plan says k clusters and the payload holds another number of centroids
        dcode = 1;
    }
    if dcode != 0 {
        file.drop(heap, lo);
        schema.drop(heap, sc);
        unbox_slice(heap, wv);
        return (empty_stored(heap), false, wiredata.file_fault(heap, e, bad, shown));
    }
    var view = mfile.empty_model(heap);
    borrow sc as &scr in {
        mfile.drop_model(heap, view);
        view = view_of(heap, scr, rows);
    }
    var is_cat = false;
    borrow lo as &lr in {
        is_cat = file.has_table(lr);
    }
    return (Stored { lo: lo, sc: sc, kind: kind, wv: wv, c0: c0, c1: c1, d: width, task: task, view: view, cat: is_cat }, true, e);
}

// ---------------------------------------------------------------- the input of predict and eval

// The CSV aligned to the fitted features by name: the matrix of the fitted features in the fitted order (`xa`), the matrix as read (`x`) and the shape (`sh`).
// For a model with a string table `x` holds the NUMERIC columns only, `ids` the categorical ones (read through `voc`, the vocabulary of the stored steps: by name,
// in any order of the file's columns) and `cols` the numeric features' places in `x`
res struct Input {
    x: matrix.Matrix,
    sh: csv.Shape,
    // the fitted features' columns in x, in the order of the schema
    cols: Box[[int]],
    // the target's column in x (eval), -1 when the matrix has none
    tj: int,
    ids: catmat.Ids,
    voc: dict.Vocab,
}

fn drop_input[&h](heap: &!h Heap, i: Input) -> [heap] int {
    let Input { x, sh, cols, tj, ids, voc } = i;
    matrix.drop(heap, x);
    csv.drop_shape(heap, sh);
    unbox_slice(heap, cols);
    catmat.drop(heap, ids);
    dict.drop_vocab(heap, voc);
    return tj;
}

fn empty_input[&h](heap: &!h Heap) -> [heap] Input {
    return Input { x: matrix.empty(heap), sh: csv.empty_shape(heap), cols: box_slice(heap, 2, 0), tj: 0 - 1, ids: catmat.empty(heap), voc: dict.empty_vocab(heap) };
}

// Read the CSV (predict: the target column is skipped; eval: it is a column) and check it against the stored schema: the old schema check (ml.schema.mismatch,
// named columns, --drop as the repair), then the place in the matrix of each fitted feature
fn read_input[&h, &f, &r, &pf, &ss, &cl](heap: &!h Heap, src: &cl [byte], fs: &f Fs(""), root: &r [byte], datafile: &pf paths.Rp, st: &ss Stored, o: verbs.Opts, need_target: bool, errs: fail.Errors, log: buffer.Buffer) -> [heap, fs_read(""), dir_read, file_read] (Input, bool, fail.Errors, buffer.Buffer) {
    var e = errs;
    var lg = log;
    var go = true;
    // the target's name, or the empty name of a model with no target (a clustering: every column is a feature, and eval needs no target column)
    var tidx = 0;
    if schema.has_target(st.sc) {
        tidx = schema.target(st.sc);
    }
    let tfull = schema.name(st.sc, tidx);
    var tlen = 0;
    if schema.has_target(st.sc) {
        tlen = len(tfull);
    }
    let tname = tfull[0..tlen];
    let want_target = need_target && schema.has_target(st.sc);
    var x = matrix.empty(heap);
    var sh = csv.empty_shape(heap);
    var rep = csv.Report { status: 0, line: 0, col: 0, aux: 0 };
    var code = 0;
    var ids = catmat.empty(heap);
    var voc = dict.empty_vocab(heap);
    if st.cat {
        let payload = file.steps_bytes(st.lo);
        let tbl = file.table_bytes(st.lo);
        let (v0, vcode) = mixed.vocab_of(heap, payload);
        if vcode != 0 {
            dict.drop_vocab(heap, v0);
            matrix.drop(heap, x);
            csv.drop_shape(heap, sh);
            catmat.drop(heap, ids);
            dict.drop_vocab(heap, voc);
            e = wiredata.file_fault(heap, e, codes.fault(codes.malformed(), 3, 0, 0), paths.shown(datafile));
            return (empty_input(heap), false, e, lg);
        }
        let cc = csv.CatCfg { cat_mask: 0, max_cats: strtab.limit_of(tbl, 0), max_str: strtab.limit_of(tbl, 1), max_pool: strtab.limit_of(tbl, 2), max_catcols: strtab.limit_of(tbl, 3), lenient: true };
        let l = csvload.load_cat_with(heap, src, fs, root, datafile, verbs.config(o, 0, 0, 0), cc, tname, !want_target, v0, true, strtab.na_of(tbl));
        let (x2, ids2, voc2, sh2, rep2, code2) = csvload.cat_load_parts(l);
        matrix.drop(heap, x);
        csv.drop_shape(heap, sh);
        catmat.drop(heap, ids);
        dict.drop_vocab(heap, voc);
        x = x2;
        ids = ids2;
        voc = voc2;
        sh = sh2;
        rep = rep2;
        code = code2;
    } else {
        let (x2, sh2, rep2, code2) = csvload.load_t_rp(heap, src, fs, root, datafile, verbs.config(o, 0, 0, 0), tname, !want_target);
        matrix.drop(heap, x);
        csv.drop_shape(heap, sh);
        x = x2;
        sh = sh2;
        rep = rep2;
        code = code2;
    }
    borrow sh as &sr in {
        if rep.status == 99 {
            e = fail.io_error(heap, e, rep.aux, false, paths.shown(datafile));
            go = false;
        } else if rep.status != 0 {
            e = verbs.explain(heap, src, e, rep, sr, o, paths.shown(datafile));
            go = false;
        } else if code != 0 {
            e = wiredata.code_error(heap, e, code, 0, 0, 0);
            go = false;
        } else {
            lg = logrec.read(heap, lg, csv.rows(sr), csv.cols(sr), csv.bytes_read(sr));
            let (e2, same) = verbs.schema_check(heap, src, e, st.view, sr, o, need_target, est.takes_missing(st.kind));
            e = e2;
            go = same;
        }
    }
    if !go {
        csv.drop_shape(heap, sh);
        matrix.drop(heap, x);
        catmat.drop(heap, ids);
        dict.drop_vocab(heap, voc);
        return (empty_input(heap), false, e, lg);
    }
    // the matrix columns are the kept (numeric) columns of the file in order, the target's left out when it is skipped
    var cols = box_slice(heap, schema.columns(st.sc) + 1, 0);
    var tj = 0 - 1;
    borrow sh as &sr in {
        var gn = names.empty(heap);
        var m = 0;
        var i = 0;
        while i < csv.cols(sr) {
            if !csv.dropped(sr, i) && (want_target || i != csv.tcol(sr)) && csv.catplace(sr, i) == 0 {
                gn = names.add(heap, gn, csv.name(sr, i));
                m = m + 1;
            }
            i = i + 1;
        }
        borrow gn as &gq in {
            tj = names.find(gq, tname);
        }
        if !want_target {
            tj = 0 - 1;
        }
        borrow mut cols as &!cw in {
            var f2 = 0;
            var j = 0;
            while j < schema.columns(st.sc) {
                if j != schema.target(st.sc) && schema.type_of(st.sc, j) != kinds.schema_type_categorical() {
                    borrow gn as &gq2 in {
                        contents(cw)[f2] = names.find(gq2, schema.name(st.sc, j));
                    }
                    f2 = f2 + 1;
                }
                j = j + 1;
            }
        }
        names.drop(heap, gn);
    }
    return (Input { x: x, sh: sh, cols: cols, tj: tj, ids: ids, voc: voc }, true, e, lg);
}

// the names of the columns the steps left: the features' when the width is the same, else the positions (`#0`, `#1`, ...)
fn output_names[&h, &s](heap: &!h Heap, sc: &s schema.Schema, width: int) -> [heap] names.Names {
    if width == schema.features(sc) {
        return wiredata.feature_names(heap, sc);
    }
    var nm = names.empty(heap);
    var j = 0;
    while j < width {
        var one = buffer.empty(heap, 8);
        one = buffer.push(heap, one, byte_of('#'));
        one = buffer.push_nat(heap, one, j);
        borrow one as &or in {
            nm = names.add(heap, nm, buffer.bytes(or));
        }
        buffer.drop(heap, one);
        j = j + 1;
    }
    return nm;
}

// the names of the numeric feature columns of the schema (not the target, not a categorical column), in order
fn numeric_names[&h, &s](heap: &!h Heap, sc: &s schema.Schema) -> [heap] names.Names {
    var nm = names.empty(heap);
    var j = 0;
    while j < schema.columns(sc) {
        if j != schema.target(sc) && schema.type_of(sc, j) != kinds.schema_type_categorical() {
            nm = names.add(heap, nm, schema.name(sc, j));
        }
        j = j + 1;
    }
    return nm;
}

// the rows of the input that `want` selects, through the stored steps: (the matrix the estimator takes, the unknown categories met, ok, errors)
fn through_steps[&h, &ii, &ss, &s, &cl](heap: &!h Heap, src: &cl [byte], inp: &ii Input, st: &ss Stored, sel: &s [int], want: int, o: verbs.Opts, errs: fail.Errors) -> [heap] (matrix.Matrix, int, bool, fail.Errors) {
    var e = errs;
    var go = true;
    var unknown = 0;
    var xs = matrix.empty(heap);
    let nfeat = schema.features(st.sc) - file.categorical_columns(st.lo);
    if st.cat {
        // the numeric features in the fitted order, the ids of the same rows, and the stored steps over both
        var xa = matrix.empty(heap);
        if nfeat > 0 {
            let (xa2, code) = wiredata.take(heap, inp.x, sel, want, contents(inp.cols), nfeat, o.max_rows, o.max_cols, o.max_cells);
            matrix.drop(heap, xa);
            xa = xa2;
            if code != 0 {
                e = wiredata.code_error(heap, e, code, 0, 0, 0);
                go = false;
            }
        }
        var idt = catmat.empty(heap);
        if go {
            let (idt2, icode) = catwire.take_ids(heap, inp.ids, sel, want, o.max_rows, o.max_cols, o.max_cells);
            catmat.drop(heap, idt);
            idt = idt2;
            if icode != 0 {
                e = wiredata.code_error(heap, e, icode, 0, 0, 0);
                go = false;
            }
        }
        if go {
            var trows = 0;
            borrow idt as &itr in {
                trows = catmat.rows(itr);
            }
            borrow xa as &xr in {
                borrow idt as &itr in {
                    let (x2, u2, f2) = mixed.apply_steps(heap, file.steps_bytes(st.lo), xr, trows, itr, inp.voc, o.max_rows, o.max_cols, o.max_cells);
                    matrix.drop(heap, xs);
                    xs = x2;
                    unknown = u2;
                    if f2.code != 0 {
                        let epl = plan.empty(heap);
                        borrow epl as &eplr in {
                            e = catwire.fault_error(heap, src, e, f2, eplr, inp.voc, false);
                        }
                        plan.drop(heap, epl);
                        go = false;
                    }
                }
            }
        }
        matrix.drop(heap, xa);
        catmat.drop(heap, idt);
    } else {
        let (xa, code) = wiredata.take(heap, inp.x, sel, want, contents(inp.cols), nfeat, o.max_rows, o.max_cols, o.max_cells);
        if code != 0 {
            e = wiredata.code_error(heap, e, code, 0, 0, 0);
            go = false;
        } else {
            borrow xa as &xr in {
                let (x2, u2, f2) = run.apply_steps(heap, file.steps_bytes(st.lo), xr, o.max_rows, o.max_cols, o.max_cells);
                matrix.drop(heap, xs);
                xs = x2;
                unknown = u2;
                if f2.code != 0 {
                    e = wiredata.code_error(heap, e, f2.code, f2.a, f2.b, f2.c);
                    go = false;
                }
            }
        }
        matrix.drop(heap, xa);
    }
    if go {
        // the steps leave nothing empty: the names of the columns after the steps are the features' when no encoding widened them; a message with the count is enough
        var width = 0;
        borrow xs as &xw in {
            width = matrix.cols(xw);
        }
        var onames = names.empty(heap);
        if st.cat {
            let nn = numeric_names(heap, st.sc);
            borrow nn as &nnr in {
                names.drop(heap, onames);
                onames = mixed.output_names(heap, nnr, file.steps_bytes(st.lo));
            }
            names.drop(heap, nn);
        } else {
            names.drop(heap, onames);
            onames = output_names(heap, st.sc, width);
        }
        var mc = 0;
        var mlist = buffer.empty(heap, 1);
        borrow xs as &xq in {
            borrow onames as &onq in {
                let (mc2, ml2) = wiredata.missing_columns(heap, xq, onq);
                buffer.drop(heap, mlist);
                mc = mc2;
                mlist = ml2;
            }
        }
        names.drop(heap, onames);
        if mc > 0 && !est.takes_missing(st.kind) {
            borrow mlist as &lr in {
                e = wiredata.missing_error(heap, src, e, mc, buffer.bytes(lr), false);
            }
            go = false;
        }
        buffer.drop(heap, mlist);
    }
    return (xs, unknown, go, e);
}

// ---------------------------------------------------------------- skew (docs/tracking.md section 3)

// the value of the answer's `out_of_range` member: `null` for a model with no provenance, else {"cells":C,"rows":R,"columns":[{"name":..,"count":..}]} with the columns that have a nonzero count, in schema order
fn range_json[&h, &r, &n](heap: &!h Heap, has_prov: bool, rg: &r prov.Range, nm: &n names.Names, nfeat: int) -> [heap] buffer.Buffer {
    if !has_prov {
        return buffer.append(heap, buffer.empty(heap, 8), "null");
    }
    var w = json.writer(heap, 128);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "cells");
    w = json.put_int(heap, w, rg.cells);
    w = json.put_key(heap, w, "rows");
    w = json.put_int(heap, w, rg.rows);
    w = json.put_key(heap, w, "columns");
    w = json.begin_array(heap, w);
    var k = 0;
    while k < nfeat {
        if contents(rg.counts)[k] > 0 {
            w = json.begin_object(heap, w);
            w = verbs.put_name(heap, w, "name", names.name(nm, k));
            w = json.put_key(heap, w, "count");
            w = json.put_int(heap, w, contents(rg.counts)[k]);
            w = json.end_object(heap, w);
        }
        k = k + 1;
    }
    w = json.end_array(heap, w);
    w = json.end_object(heap, w);
    return json.finish(w);
}

// the target column of the model when the file carries it and --drop did not name it: the column predict ignores
fn ignored_json[&h, &s, &c](heap: &!h Heap, sh: &s csv.Shape, sc: &c schema.Schema) -> [heap] buffer.Buffer {
    var w = json.writer(heap, 64);
    w = json.begin_array(heap, w);
    if schema.has_target(sc) {
        let tname = schema.name(sc, schema.target(sc));
        let j = csv.find(sh, tname);
        if j >= 0 && !csv.dropped(sh, j) {
            w = text.put(heap, w, tname);
        }
    }
    w = json.end_array(heap, w);
    return json.finish(w);
}

// ml.predict.out-of-range: more rows out of range than --max-out-of-range allows; the first column and row are named, no cell is quoted
fn out_of_range_error[&h, &r, &n](heap: &!h Heap, errs: fail.Errors, rg: &r prov.Range, nm: &n names.Names, bound: int) -> [heap] fail.Errors {
    var w = wiredata.open_tag(heap, "ml.predict.out-of-range");
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    w = fail.detail_int(heap, w, "rows", rg.rows);
    w = fail.detail_int(heap, w, "max", bound);
    w = fail.detail_text(heap, w, "column", names.name(nm, rg.first_col));
    w = fail.detail_int(heap, w, "row", rg.first_row);
    return fail.add(heap, errs, w);
}

fn no_provenance_error[&h](heap: &!h Heap, errs: fail.Errors) -> [heap] fail.Errors {
    var w = wiredata.open_tag(heap, "ml.predict.no-provenance");
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    w = fail.detail_str(heap, w, "flag", "--max-out-of-range");
    return fail.add(heap, errs, w);
}

// The range check of the rows `want` selects of the input: (the out_of_range member, the counts, whether the call goes on, the errors: they gain the refusal when --max-out-of-range is exceeded).
// A model with no provenance has no range: the member is null and the counts are empty.
fn range_check[&h, &ii, &ss, &s](heap: &!h Heap, inp: &ii Input, st: &ss Stored, sel: &s [int], want: int, o: verbs.Opts, errs: fail.Errors) -> [heap] (buffer.Buffer, prov.Range, bool, fail.Errors) {
    var e = errs;
    if !file.has_provenance(st.lo) {
        return (buffer.append(heap, buffer.empty(heap, 8), "null"), prov.empty_range(heap), true, e);
    }
    let pv = file.provenance_bytes(st.lo);
    let nf = provsec.features(pv);
    let rg = prov.out_of_range(heap, inp.x, sel, want, contents(inp.cols), nf, pv);
    let nn = numeric_names(heap, st.sc);
    var go = true;
    var frag = buffer.empty(heap, 1);
    borrow rg as &rr in {
        borrow nn as &nr in {
            if o.max_oor_given && rr.rows > o.max_oor {
                e = out_of_range_error(heap, e, rr, nr, o.max_oor);
                go = false;
            }
            buffer.drop(heap, frag);
            frag = range_json(heap, true, rr, nr, nf);
        }
    }
    names.drop(heap, nn);
    return (frag, rg, go, e);
}

// the provenance payload of a stored model, or an empty slice
fn prov_of[&s](st: &s Stored) -> [] &s [byte] {
    if file.has_provenance(st.lo) {
        return file.provenance_bytes(st.lo);
    }
    return file.plan_bytes(st.lo)[0..0];
}

// ---------------------------------------------------------------- predict

// one value of the answer: the double `v` as the shortest decimal that reads back, through the door of verbs.put_float_text. The third member is false when `v` is not finite: nothing
// was written for it. predict_page has refused every such row before it writes the first cell (docs/nonfinite.md section 4), so false cannot happen there; it is checked all the same.
fn put_cell[&h](heap: &!h Heap, w: json.Writer, plain: buffer.Buffer, v: float) -> [heap] (json.Writer, buffer.Buffer, bool) {
    let (b, fin) = verbs.put_float_text(heap, buffer.empty(heap, 32), bits_of(v));
    var o = w;
    var p = plain;
    if fin {
        borrow b as &br in {
            o = json.put_string(heap, o, buffer.bytes(br));
            p = buffer.append(heap, p, buffer.bytes(br));
        }
    }
    buffer.drop(heap, b);
    return (o, p, fin);
}

fn put_label[&h](heap: &!h Heap, w: json.Writer, plain: buffer.Buffer, v: int) -> [heap] (json.Writer, buffer.Buffer) {
    var b = exact.put_scaled(heap, buffer.empty(heap, 24), v, 0);
    var o = w;
    var p = plain;
    borrow b as &br in {
        o = json.put_string(heap, o, buffer.bytes(br));
        p = buffer.append(heap, p, buffer.bytes(br));
    }
    buffer.drop(heap, b);
    return (o, p);
}

// the page of predictions: (the data object, the text, the refusal code of the estimator)
fn predict_page[&h, &x, &w2, &bl, &q, &g](heap: &!h Heap, kind: int, task: int, xs: &x matrix.Matrix, wv: &w2 [float], blob: &bl [byte], c0: int, c1: int, unknown: int, oor: &q [byte], ign: &g [byte], with_proba: bool, with_distance: bool, o: verbs.Opts) -> [heap] (buffer.Buffer, buffer.Buffer, int, int, int) {
    let total = matrix.rows(xs);
    var start = o.from;
    if start > total {
        start = total;
    }
    var end = total;
    if start + o.limit < end {
        end = start + o.limit;
    }
    var pred = box_slice(heap, total + 1, 0.0);
    var prob = box_slice(heap, total + 1, 0.0);
    var code = 0;
    borrow mut pred as &!pw in {
        code = wiredata.predict_into(heap, kind, xs, wv, blob, contents(pw));
    }
    if code == 0 && (task == 2 || task == 4 && with_distance) {
        borrow mut prob as &!qw in {
            code = wiredata.proba_into(heap, kind, xs, wv, blob, contents(qw));
        }
    }
    // docs/nonfinite.md section 4: every value of every row scored (not only the page), before the first byte of the answer
    var badrow = 0 - 1;
    var badcol = 0;
    if code == 0 {
        borrow pred as &pq0 in {
            borrow prob as &qq0 in {
                let (br, bc) = wiredata.first_bad_score(task, contents(pq0), contents(qq0), total, with_distance);
                badrow = br;
                badcol = bc;
            }
        }
        if badrow >= 0 {
            code = refuse.predict_non_finite();
        }
    }
    var w = json.writer(heap, 512);
    var plain = buffer.empty(heap, 64);
    var printed = true;
    borrow pred as &pq in {
        borrow prob as &qq in {
            if code == 0 {
                w = json.begin_object(heap, w);
                w = json.put_key(heap, w, "model");
                w = json.put_string(heap, w, est.name(kind));
                w = json.put_key(heap, w, "task");
                w = json.put_string(heap, w, wiredata.task_word(task));
                w = json.put_key(heap, w, "columns");
                w = json.begin_array(heap, w);
                if task == 1 {
                    w = json.put_string(heap, w, "prediction");
                } else if task == 4 {
                    w = json.put_string(heap, w, "cluster");
                    if with_distance {
                        w = json.put_string(heap, w, "distance");
                    }
                } else {
                    w = json.put_string(heap, w, "label");
                    if with_proba {
                        w = json.put_string(heap, w, "probability");
                    }
                }
                w = json.end_array(heap, w);
                w = json.put_key(heap, w, "rows");
                w = json.begin_array(heap, w);
                var k = start;
                while k < end {
                    w = json.begin_array(heap, w);
                    if task == 1 {
                        let (w2, p2, f2) = put_cell(heap, w, plain, contents(pq)[k]);
                        w = w2;
                        plain = p2;
                        printed = printed && f2;
                    } else if task == 4 {
                        let (w2, p2) = put_label(heap, w, plain, truncate(contents(pq)[k]));
                        w = w2;
                        plain = p2;
                        if with_distance {
                            plain = buffer.push(heap, plain, byte_of(9));
                            let (w3, p3, f3) = put_cell(heap, w, plain, contents(qq)[k]);
                            w = w3;
                            plain = p3;
                            printed = printed && f3;
                        }
                    } else {
                        var label = c0;
                        if contents(pq)[k] > 0.5 {
                            label = c1;
                        }
                        let (w2, p2) = put_label(heap, w, plain, label);
                        w = w2;
                        plain = p2;
                        if with_proba {
                            plain = buffer.push(heap, plain, byte_of(9));
                            let (w3, p3, f3) = put_cell(heap, w, plain, contents(qq)[k]);
                            w = w3;
                            plain = p3;
                            printed = printed && f3;
                        }
                    }
                    w = json.end_array(heap, w);
                    plain = buffer.push(heap, plain, byte_of(10));
                    k = k + 1;
                }
                w = json.end_array(heap, w);
                w = json.put_key(heap, w, "row_count");
                w = json.put_int(heap, w, end - start);
                w = json.put_key(heap, w, "total_rows");
                w = json.put_int(heap, w, total);
                w = json.put_key(heap, w, "truncated");
                w = json.put_bool(heap, w, end < total);
                w = json.put_key(heap, w, "next");
                if end < total {
                    w = json.begin_object(heap, w);
                    w = json.put_key(heap, w, "from");
                    w = json.put_int(heap, w, end);
                    w = json.end_object(heap, w);
                } else {
                    w = json.put_null(heap, w);
                }
                w = json.put_key(heap, w, "unknown_categories");
                w = json.put_int(heap, w, unknown);
                w = json.put_key(heap, w, "out_of_range");
                w = json.put_fragment(heap, w, oor);
                w = json.put_key(heap, w, "ignored_columns");
                w = json.put_fragment(heap, w, ign);
                w = json.end_object(heap, w);
            }
        }
    }
    unbox_slice(heap, pred);
    unbox_slice(heap, prob);
    if code == 0 && !printed {
        // not reachable after the scan; if it were, the answer is the refusal and no cell of it is kept
        code = refuse.predict_non_finite();
    }
    if code != 0 {
        buffer.drop(heap, plain);
        plain = buffer.empty(heap, 1);
        let doc = json.finish(w);
        buffer.drop(heap, doc);
        return (buffer.empty(heap, 1), plain, code, badrow, badcol);
    }
    return (json.finish(w), plain, code, badrow, badcol);
}

fn conflict_out[&h](heap: &!h Heap, errs: fail.Errors, log: buffer.Buffer, flag: &static [byte], message: &static [byte]) -> [heap] verbs.Out {
    return verbs.nothing(heap, wiredata.conflict(heap, errs, flag, message), log);
}

// --positive, --split, --seed, --threads and --proba mean nothing to a model of the constant kinds
fn constant_conflict[&h](heap: &!h Heap, errs: fail.Errors, o: verbs.Opts, verb: int) -> [heap] fail.Errors {
    var e = errs;
    if o.positive_given {
        e = wiredata.conflict(heap, e, "positive", "a constant model has no positive label: its files are those of docs/cli.md");
    }
    if o.split_given {
        e = wiredata.conflict(heap, e, "split", "--split needs a model fitted through the pipeline: linear or logistic");
    }
    if o.threads_given {
        e = wiredata.conflict(heap, e, "threads", "a constant model has no threaded kernel");
    }
    if verb == 2 && o.proba {
        e = wiredata.conflict(heap, e, "proba", "a constant classification always prints its probability, and a constant regression has none");
    }
    if verb == 2 && o.distance {
        e = wiredata.conflict(heap, e, "distance", "only a kmeans model has a distance to a cluster centre");
    }
    return e;
}

// read the model file once to see its kind: (the bytes, whether this module takes it)
fn peek_model[&h, &f, &r, &pm](heap: &!h Heap, fs: &f Fs(""), root: &r [byte], model: &pm paths.Rp, o: verbs.Opts) -> [heap, fs_read(""), dir_read, file_read] (buffer.Buffer, bool) {
    let (data, st, aux) = fsio.read_model(heap, fs, root, model, o.max_bytes);
    if st != 0 {
        return (data, false);
    }
    var mine = false;
    borrow data as &dr in {
        mine = est.wired(peek_kind(buffer.bytes(dr))) || six_sections(buffer.bytes(dr));
    }
    return (data, mine);
}

pub fn predict[&h, &f, &r, &pf, &pm, &cl](heap: &!h Heap, src: &cl [byte], fs: &f Fs(""), root: &r [byte], file: &pf paths.Rp, model: &pm paths.Rp, o: verbs.Opts, errs: fail.Errors, log: buffer.Buffer) -> [heap, fs_read(""), dir_read, file_read] verbs.Out {
    let (data, mine) = peek_model(heap, fs, root, model, o);
    if !mine {
        buffer.drop(heap, data);
        let e0 = constant_conflict(heap, errs, o, 2);
        var none = true;
        borrow e0 as &er in {
            none = fail.count(er) == 0;
        }
        if !none {
            return verbs.nothing(heap, e0, log);
        }
        return verbs.predict(heap, src, fs, root, file, model, o, e0, log);
    }
    var e = errs;
    var st = empty_stored(heap);
    var go = true;
    borrow data as &dr in {
        let (s2, ok2, e2) = load_stored(heap, buffer.bytes(dr), paths.shown(model), e);
        drop_stored(heap, st);
        st = s2;
        e = e2;
        go = ok2;
    }
    buffer.drop(heap, data);
    var result = verbs.nothing(heap, fail.empty(heap), buffer.empty(heap, 1));
    if go {
        borrow st as &sr in {
            verbs.drop_out(heap, result);
            result = predict_loaded(heap, src, fs, root, file, sr, o, e, log);
        }
    } else {
        verbs.drop_out(heap, result);
        result = wiredata.out_of(buffer.empty(heap, 1), buffer.empty(heap, 1), buffer.empty(heap, 1), e, log, false);
    }
    drop_stored(heap, st);
    return result;
}

// `predict` of a model file that has been decoded already (`load_stored`): the checks of the flags, the input and the page of predictions. The server decodes its model once at start and
// calls this for each request, so a request does not decode the file again; `predict` above is `load_stored`, this, and `drop_stored`, so the answer is the same function's.
pub fn predict_loaded[&h, &f, &r, &pf, &ss, &cl](heap: &!h Heap, src: &cl [byte], fs: &f Fs(""), root: &r [byte], file: &pf paths.Rp, stored: &ss Stored, o: verbs.Opts, errs: fail.Errors, log: buffer.Buffer) -> [heap, fs_read(""), dir_read, file_read] verbs.Out {
    var e = errs;
    var lg = log;
    var go = true;
    if o.proba {
        if stored.task == 1 {
            e = wiredata.conflict(heap, e, "proba", "a regression has no probability");
            go = false;
        } else if stored.task == 4 {
            e = wiredata.conflict(heap, e, "proba", "a clustering has no probability: --distance adds the squared distance of a row to the centre of its cluster");
            go = false;
        }
    }
    if go && o.distance {
        if stored.task != 4 {
            e = wiredata.conflict(heap, e, "distance", "only a kmeans model has a distance to a cluster centre");
            go = false;
        }
    }
    if go && o.max_oor_given && !file.has_provenance(stored.lo) {
        e = no_provenance_error(heap, e);
        go = false;
    }
    var inp = empty_input(heap);
    if go {
        let (i2, ok3, e3, lg3) = read_input(heap, src, fs, root, file, stored, o, false, e, lg);
        drop_input(heap, inp);
        inp = i2;
        e = e3;
        lg = lg3;
        go = ok3;
    }
    var payload = buffer.empty(heap, 1);
    var plain = buffer.empty(heap, 1);
    if go {
        let none = box_slice(heap, 1, 0);
        borrow inp as &ir in {
            borrow none as &nr in {
                let (xs, unk, ok4, e4) = through_steps(heap, src, ir, stored, contents(nr), 0 - 1, o, e);
                e = e4;
                if ok4 {
                    let (oor, rg, rok, e5) = range_check(heap, ir, stored, contents(nr), 0 - 1, o, e);
                    e = e5;
                    prov.drop_range(heap, rg);
                    if rok {
                        let ign = ignored_json(heap, ir.sh, stored.sc);
                        borrow oor as &orr in {
                            borrow ign as &igr in {
                                borrow xs as &xq in {
                                    let (p2, t2, code, brow, bcol) = predict_page(heap, stored.kind, stored.task, xq, contents(stored.wv), file.model_bytes(stored.lo), stored.c0, stored.c1, unk, buffer.bytes(orr), buffer.bytes(igr), o.proba, o.distance, o);
                                    buffer.drop(heap, payload);
                                    buffer.drop(heap, plain);
                                    payload = p2;
                                    plain = t2;
                                    if code == refuse.predict_non_finite() {
                                        e = wiredata.non_finite_prediction(heap, e, brow + 1, wiredata.column_word(bcol));
                                    } else if code != 0 {
                                        e = wiredata.code_error(heap, e, code, 0, 0, 0);
                                    }
                                }
                            }
                        }
                        buffer.drop(heap, ign);
                    }
                    buffer.drop(heap, oor);
                }
                matrix.drop(heap, xs);
            }
        }
        unbox_slice(heap, none);
    }
    drop_input(heap, inp);
    return wiredata.out_of(payload, plain, buffer.empty(heap, 1), e, lg, false);
}

// ---------------------------------------------------------------- eval

pub fn eval[&h, &f, &r, &pf, &pm, &pt, &cl](heap: &!h Heap, src: &cl [byte], fs: &f Fs(""), root: &r [byte], file: &pf paths.Rp, model: &pm paths.Rp, trackp: &pt paths.Rp, o: verbs.Opts, sp: splitspec.SplitOpts, errs: fail.Errors, log: buffer.Buffer) -> [heap, fs_read(""), dir_read, dir_write, file_read, file_write] verbs.Out {
    let (data, mine) = peek_model(heap, fs, root, model, o);
    if !mine {
        buffer.drop(heap, data);
        let e0 = constant_conflict(heap, errs, o, 3);
        var none = true;
        borrow e0 as &er in {
            none = fail.count(er) == 0;
        }
        if !none {
            return verbs.nothing(heap, e0, log);
        }
        return cfit.eval(heap, src, fs, root, file, model, trackp, o, e0, log);
    }
    var e = errs;
    var lg = log;
    var st = empty_stored(heap);
    var go = true;
    borrow data as &dr in {
        let (s2, ok2, e2) = load_stored(heap, buffer.bytes(dr), paths.shown(model), e);
        drop_stored(heap, st);
        st = s2;
        e = e2;
        go = ok2;
    }
    buffer.drop(heap, data);
    var inp = empty_input(heap);
    if go {
        borrow st as &sq in {
            let (i2, ok3, e3, lg3) = read_input(heap, src, fs, root, file, sq, o, true, e, lg);
            drop_input(heap, inp);
            inp = i2;
            e = e3;
            lg = lg3;
            go = ok3;
        }
    }
    var payload = buffer.empty(heap, 1);
    var plain = buffer.empty(heap, 1);
    if go {
        var kind = 0;
        var task = 0;
        var c0 = 0;
        var c1 = 0;
        borrow st as &sq0 in {
            kind = sq0.kind;
            task = sq0.task;
            c0 = sq0.c0;
            c1 = sq0.c1;
        }
        var nrows = 0;
        borrow inp as &ir0 in {
            nrows = matrix.rows(ir0.x);
        }
        // the labels the model knows
        var pos = c1;
        if task == 4 && o.positive_given {
            e = wiredata.conflict(heap, e, "positive", "a clustering has no positive label");
            go = false;
        }
        if go && task == 2 && o.positive_given {
            let (pok, pv) = wiredata.parse_label(argv.text(src, "positive"));
            if pv == c0 || pv == c1 {
                pos = pv;
            } else {
                var w = fail.open_in(heap, spec.extra(), "ml.param.out-of-range", "--positive is not one of the two labels of the model", "the labels are in detail");
                w = fail.no_repair(heap, w);
                w = fail.detail_open(heap, w);
                w = fail.detail_str(heap, w, "flag", "--positive");
                w = fail.detail_int(heap, w, "value", pv);
                w = fail.detail_int(heap, w, "label0", c0);
                w = fail.detail_int(heap, w, "label1", c1);
                e = fail.add(heap, e, w);
                go = false;
            }
        }
        var sel = box_slice(heap, nrows + 1, 0);
        var want = 0 - 1;
        var ntest = 0;
        var spec_buf = buffer.empty(heap, 1);
        var assign_buf = buffer.empty(heap, 1);
        if go && o.split_given {
            // the strategy of the split (docs/splits.md): the labels of a classification are read for --stratify
            var yfull = box_slice(heap, 2, 0.0);
            if task == 2 {
                borrow inp as &irs in {
                    let none2 = box_slice(heap, 1, 0);
                    borrow none2 as &n2 in {
                        let (ya, b2) = wiredata.take_col(heap, irs.x, contents(n2), 0 - 1, irs.tj);
                        unbox_slice(heap, yfull);
                        yfull = ya;
                    }
                    unbox_slice(heap, none2);
                }
            }
            var okh = false;
            var nt = 0;
            var sel2 = box_slice(heap, 2, 0);
            borrow yfull as &yfr in {
                let (s3, nt3, ok3, e3) = splitwire.holdout_sel(heap, src, fs, root, file, sp, splitspec.column(src, sp), o, nrows, task, contents(yfr), e);
                unbox_slice(heap, sel2);
                sel2 = s3;
                nt = nt3;
                okh = ok3;
                e = e3;
            }
            unbox_slice(heap, yfull);
            if !okh {
                unbox_slice(heap, sel2);
                go = false;
            } else {
                unbox_slice(heap, sel);
                sel = sel2;
                want = 1;
                ntest = nt;
                buffer.drop(heap, spec_buf);
                spec_buf = splitspec.text_nd(heap, false, o.split_num, o.split_den, 0, 0, splitspec.strategy(sp), splitspec.column(src, sp), o.seed);
                if sp.emit {
                    borrow sel as &sq6 in {
                        buffer.drop(heap, assign_buf);
                        assign_buf = splitwire.json_vector(heap, contents(sq6), 0, nrows);
                    }
                }
            }
        }
        if go {
            var yv = box_slice(heap, 2, 0.0);
            var bad = 0;
            borrow inp as &ir in {
                borrow sel as &sr2 in {
                    // a clustering has no target column to read
                    if ir.tj >= 0 {
                        let (y2, b2) = wiredata.take_col(heap, ir.x, contents(sr2), want, ir.tj);
                        unbox_slice(heap, yv);
                        yv = y2;
                        bad = b2;
                    }
                }
            }
            if bad > 0 {
                borrow st as &sq3 in {
                    e = wiredata.empty_target(heap, e, schema.name(sq3.sc, schema.target(sq3.sc)), bad);
                }
                go = false;
            }
            var rows = 0;
            borrow sel as &sq4 in {
                rows = wiredata.count_rows(contents(sq4), nrows, want);
            }
            if go && task == 2 {
                var i = 0;
                var foreign = 0 - 1;
                borrow yv as &yq in {
                    while i < rows {
                        let lab = truncate(contents(yq)[i]);
                        if lab != c0 && lab != c1 && foreign < 0 {
                            foreign = i;
                        }
                        i = i + 1;
                    }
                }
                if foreign >= 0 {
                    var w = fail.open_in(heap, spec.extra(), "ml.label.not-binary", "a classification target has more than two values", "the file holds a label the model was not fitted on");
                    w = fail.no_repair(heap, w);
                    w = fail.detail_open(heap, w);
                    w = fail.detail_int(heap, w, "row", foreign + 1);
                    borrow yv as &yq2 in {
                        w = fail.detail_int(heap, w, "label", truncate(contents(yq2)[foreign]));
                    }
                    e = fail.add(heap, e, w);
                    go = false;
                }
            }
            if go {
                borrow inp as &ir in {
                    borrow st as &sr in {
                        borrow sel as &sr2 in {
                            let (xs, unk, ok4, e4) = through_steps(heap, src, ir, sr, contents(sr2), want, o, e);
                            e = e4;
                            var oor = buffer.empty(heap, 1);
                            var onw: &static [byte] = "unknown";
                            if ok4 {
                                let (oor2, rg, rok, e5) = range_check(heap, ir, sr, contents(sr2), want, o, e);
                                buffer.drop(heap, oor);
                                oor = oor2;
                                e = e5;
                                prov.drop_range(heap, rg);
                                let (ow, ost, oaux) = prov.on_word(heap, fs, root, file, prov_of(sr));
                                onw = ow;
                                if ost != 0 {
                                    e = fail.io_error(heap, e, oaux, false, paths.shown(file));
                                }
                                if rok && ost == 0 {
                                    borrow yv as &yr in {
                                        borrow xs as &xq in {
                                            let (mobj, mplain, mund, fl) = wiredata.metrics_block(heap, kind, task, xq, contents(yr), contents(sr.wv), file.model_bytes(sr.lo), c0, c1, pos, o.max_rows, true);
                                            if fl.code != 0 {
                                                var fl2 = fl;
                                                if fl.code == refuse.predict_non_finite() {
                                                    // the row of the file, not of the held-out rows
                                                    fl2 = wiredata.Failed { code: fl.code, name: fl.name, row: wiredata.file_row(contents(sr2), nrows, want, fl.row) };
                                                }
                                                e = wiredata.bad_metric(heap, e, fl2);
                                                buffer.drop(heap, mplain);
                                            } else {
                                                var w = json.writer(heap, 256);
                                                w = json.begin_object(heap, w);
                                                w = json.put_key(heap, w, "model");
                                                w = json.put_string(heap, w, est.name(kind));
                                                w = json.put_key(heap, w, "task");
                                                w = json.put_string(heap, w, wiredata.task_word(task));
                                                w = json.put_key(heap, w, "rows");
                                                w = json.put_int(heap, w, rows);
                                                w = json.put_key(heap, w, "on");
                                                w = json.put_string(heap, w, onw);
                                                if task == 4 {
                                                    w = json.put_key(heap, w, "clusters");
                                                    w = json.put_int(heap, w, c0);
                                                }
                                                if task == 2 {
                                                    w = json.put_key(heap, w, "positive");
                                                    w = json.put_int(heap, w, pos);
                                                }
                                                w = json.put_key(heap, w, "metrics");
                                                borrow mobj as &mor in {
                                                    w = json.put_fragment(heap, w, buffer.bytes(mor));
                                                }
                                                w = json.put_key(heap, w, "unknown_categories");
                                                w = json.put_int(heap, w, unk);
                                                w = json.put_key(heap, w, "out_of_range");
                                                borrow oor as &orr in {
                                                    w = json.put_fragment(heap, w, buffer.bytes(orr));
                                                }
                                                if o.split_given {
                                                    w = json.put_key(heap, w, "split");
                                                    w = json.begin_object(heap, w);
                                                    w = json.put_key(heap, w, "train");
                                                    w = json.put_int(heap, w, nrows - ntest);
                                                    w = json.put_key(heap, w, "test");
                                                    w = json.put_int(heap, w, ntest);
                                                    w = json.put_key(heap, w, "seed");
                                                    w = json.put_int(heap, w, o.seed);
                                                    w = json.put_key(heap, w, "spec");
                                                    borrow spec_buf as &spb in {
                                                        w = json.put_string(heap, w, buffer.bytes(spb));
                                                    }
                                                    borrow assign_buf as &asb in {
                                                        if buffer.size(asb) > 0 {
                                                            w = json.put_key(heap, w, "assignment");
                                                            w = json.put_fragment(heap, w, buffer.bytes(asb));
                                                        }
                                                    }
                                                    w = json.end_object(heap, w);
                                                }
                                                w = json.end_object(heap, w);
                                                buffer.drop(heap, payload);
                                                payload = json.finish(w);
                                                buffer.drop(heap, plain);
                                                plain = buffer.append(heap, buffer.empty(heap, 64), "on ");
                                                plain = buffer.append(heap, plain, onw);
                                                plain = buffer.push(heap, plain, byte_of(10));
                                                borrow mplain as &mpr in {
                                                    plain = buffer.append(heap, plain, buffer.bytes(mpr));
                                                }
                                                buffer.drop(heap, mplain);
                                            }
                                            buffer.drop(heap, mobj);
                                            buffer.drop(heap, mund);
                                        }
                                    }
                                }
                            }
                            buffer.drop(heap, oor);
                            matrix.drop(heap, xs);
                        }
                    }
                }
            }
            unbox_slice(heap, yv);
        }
        unbox_slice(heap, sel);
        buffer.drop(heap, spec_buf);
        buffer.drop(heap, assign_buf);
    }
    drop_input(heap, inp);
    drop_stored(heap, st);
    // --track: the eval record beside the run of the model (docs/tracking.md section 5.3), when the eval answered
    if o.track_given && go {
        var answered = false;
        borrow payload as &pyr in {
            answered = buffer.size(pyr) > 0;
            if answered {
                e = track.eval_after(heap, fs, root, trackp, file, model, buffer.bytes(pyr), o, e);
            }
        }
    }
    return wiredata.out_of(payload, plain, buffer.empty(heap, 1), e, lg, false);
}
