edition 5;

// `ml` -- fit, apply and score a model on a CSV file (docs/cli.md). The first operand is the verb (fit, predict, eval), the
// second the CSV file; `ml introspect` and `ml skill` describe the tool from the tables it runs on.
//
// This file parses and checks the command line, resolves the paths, runs the verb (tools/ml/verbs.cho), writes the log and
// answers: one JSON document on one line, the exit code of the first error (cancho docs/agent-toolbox.md D4).

import std.buffer;
import std.bytes;
import std.json;
import ml.fsio;
import ml.logrec;
import ml.paths;
import ml.spec;
import ml.verbs;
import toolbox.built;
import toolbox.cli;
import toolbox.describe;
import toolbox.fail;
import toolbox.out;
import toolbox.path;
import toolbox.text;

fn built() -> [] describe.Built {
    return describe.Built { authority: built.authority(), schema: built.schema(), compiler: built.compiler() };
}

fn version() -> [] &static [byte] {
    return "0.1.0";
}

// no repair, one string of detail
fn flag_problem[&h, &m](heap: &!h Heap, e: fail.Errors, rule: &static [byte], message: &m [byte], hint: &static [byte], key: &static [byte], value: &static [byte]) -> [heap] fail.Errors {
    var w = fail.open_in(heap, spec.extra(), rule, message, hint);
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    if len(key) > 0 {
        w = fail.detail_str(heap, w, key, value);
    }
    return fail.add(heap, e, w);
}

// 1 fit, 2 predict, 3 eval, 0 anything else
fn verb_of[&v](text: &v [byte]) -> [] int {
    if bytes.equal(text, "fit") {
        return 1;
    }
    if bytes.equal(text, "predict") {
        return 2;
    }
    if bytes.equal(text, "eval") {
        return 3;
    }
    return 0;
}

fn verb_name(verb: int) -> [] &static [byte] {
    if verb == 1 {
        return "fit";
    }
    if verb == 2 {
        return "predict";
    }
    return "eval";
}

fn listed[&n](list: &static [byte], name: &n [byte]) -> [] bool {
    var k = 1;
    let count = bytes.count_byte(list, ',') + 1;
    while k <= count {
        if bytes.equal(bytes.field(list, ',', k), name) {
            return true;
        }
        k = k + 1;
    }
    return false;
}

// the flags given that this verb does not take, and the flags it needs and was not given
fn check_flags[&h, &p](heap: &!h Heap, parsed: &p cli.Parsed, errs: fail.Errors, verb: int) -> [heap] fail.Errors {
    var e = errs;
    let table = spec.flag_table();
    var i = 0;
    while i < cli.entries(table) {
        let name = cli.name_of(table, i);
        if cli.has(parsed, table, name) && !listed(spec.allowed(verb), name) {
            var w = fail.open_in(heap, spec.extra(), "args.conflict", "this flag is not one this verb takes", "see the verbs and their flags in introspect usage");
            w = fail.no_repair(heap, w);
            w = fail.detail_open(heap, w);
            w = fail.detail_text(heap, w, "flag", name);
            w = fail.detail_str(heap, w, "verb", verb_name(verb));
            e = fail.add(heap, e, w);
        }
        i = i + 1;
    }
    if verb == 1 {
        if !cli.has(parsed, table, "target") {
            e = flag_problem(heap, e, "args.required-flag", "fit needs --target, the column to predict", "ml fit --target NAME --output MODEL FILE", "flag", "--target");
        }
        if !cli.has(parsed, table, "output") {
            e = flag_problem(heap, e, "args.required-flag", "fit needs --output, where to write the model file", "ml fit --target NAME --output MODEL FILE", "flag", "--output");
        }
    } else if !cli.has(parsed, table, "model-file") {
        e = flag_problem(heap, e, "args.required-flag", "this verb needs --model-file, the model to read", "ml predict --model-file MODEL FILE", "flag", "--model-file");
    }
    return e;
}

// the value of limit `name` in spec.limits(): field 2 is the ceiling's place
fn ceiling_of(name: &static [byte]) -> [] int {
    let table = spec.limits();
    let count = bytes.count_byte(table, ';') + 1;
    var k = 1;
    while k <= count {
        let entry = bytes.field(table, ';', k);
        if bytes.equal(bytes.field(entry, '|', 1), name) {
            return cli.parse_nat(bytes.field(entry, '|', 3));
        }
        k = k + 1;
    }
    return 0 - 1;
}

// a nat flag given must be in 1..ceiling (0..ceiling for --from)
fn check_nat[&h, &g, &p](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, errs: fail.Errors, name: &static [byte], least: int) -> [heap, args] fail.Errors {
    let table = spec.flag_table();
    if !cli.has(parsed, table, name) {
        return errs;
    }
    let v = cli.nat(args, parsed, table, name);
    let top = ceiling_of(name);
    if v >= least && v <= top {
        return errs;
    }
    var w = fail.open_in(heap, spec.extra(), "ml.param.out-of-range", "a numeric flag is outside its range", "the range is in the detail and in introspect limits");
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    w = fail.detail_str(heap, w, "flag", name);
    w = fail.detail_int(heap, w, "value", v);
    w = fail.detail_int(heap, w, "min", least);
    w = fail.detail_int(heap, w, "max", top);
    return fail.add(heap, errs, w);
}

fn check_nats[&h, &g, &p](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, errs: fail.Errors) -> [heap, args] fail.Errors {
    var e = errs;
    e = check_nat(heap, args, parsed, e, "limit", 1);
    e = check_nat(heap, args, parsed, e, "from", 0);
    e = check_nat(heap, args, parsed, e, "max-rows", 1);
    e = check_nat(heap, args, parsed, e, "max-columns", 1);
    e = check_nat(heap, args, parsed, e, "max-cells", 1);
    e = check_nat(heap, args, parsed, e, "max-line-bytes", 1);
    e = check_nat(heap, args, parsed, e, "max-bytes", 1);
    e = check_nat(heap, args, parsed, e, "log-max-bytes", 1);
    return e;
}

// the rule of the first error, as a buffer (empty when there is none)
fn first_rule[&h, &e](heap: &!h Heap, errs: &e fail.Errors) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 32);
    if fail.count(errs) == 0 {
        return out;
    }
    let first = fail.first(errs);
    let key = "\"rule\":\"";
    let at = bytes.find(first, key);
    if at < 0 {
        return out;
    }
    var end = at + len(key);
    while end < len(first) && int_of(first[end]) != '"' {
        end = end + 1;
    }
    return buffer.append(heap, out, first[at + len(key)..end]);
}

// the verb and the checks of the command line that need no file
fn cmdline[&h, &g, &p](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, errs: fail.Errors) -> [heap, args] (int, fail.Errors) {
    var e = errs;
    var verb = 0;
    if cli.operand_count(parsed) == 0 {
        e = flag_problem(heap, e, "args.missing-operand", "ml takes a verb, fit, predict or eval, and the CSV file", "ml fit|predict|eval FILE", "operand", "VERB");
    } else {
        verb = verb_of(cli.operand(args, parsed, 0));
        if verb == 0 {
            var w = fail.open_in(heap, spec.extra(), "args.unknown-command", "the first operand is not fit, predict or eval", "the verbs are fit, predict and eval, and ml introspect and ml skill describe them");
            w = fail.no_repair(heap, w);
            w = fail.detail_open(heap, w);
            w = fail.detail_text(heap, w, "command", cli.operand(args, parsed, 0));
            e = fail.add(heap, e, w);
        } else if cli.operand_count(parsed) == 1 {
            e = flag_problem(heap, e, "args.missing-operand", "ml takes the CSV file after the verb", "ml fit|predict|eval FILE", "operand", "FILE");
        } else if cli.operand_count(parsed) > 2 {
            e = flag_problem(heap, e, "args.too-many-operands", "ml takes one CSV file", "read one file per call", "operand", "FILE");
        }
    }
    if verb != 0 {
        e = check_flags(heap, parsed, e, verb);
    }
    e = check_nats(heap, args, parsed, e);
    return (verb, e);
}

// the four paths a command can name
res struct Paths {
    file: paths.Rp,
    model: paths.Rp,
    out: paths.Rp,
    logp: paths.Rp,
}

fn drop_paths[&h](heap: &!h Heap, ps: Paths) -> [heap] int {
    let Paths { file, model, out, logp } = ps;
    paths.drop(heap, file);
    paths.drop(heap, model);
    paths.drop(heap, out);
    return paths.drop(heap, logp);
}

fn options[&g, &p](args: &g Args, parsed: &p cli.Parsed) -> [args] verbs.Opts {
    let table = spec.flag_table();
    var task = 1;
    if bytes.equal(cli.text(args, parsed, table, "task"), "classification") {
        task = 2;
    }
    return verbs.Opts { cap: cli.nat(args, parsed, table, "max-line-bytes"), max_rows: cli.nat(args, parsed, table, "max-rows"), max_cols: cli.nat(args, parsed, table, "max-columns"), max_cells: cli.nat(args, parsed, table, "max-cells"), max_bytes: cli.nat(args, parsed, table, "max-bytes"), limit: cli.nat(args, parsed, table, "limit"), from: cli.nat(args, parsed, table, "from"), overwrite: cli.has(parsed, table, "overwrite"), dry: cli.has(parsed, table, "dry-run"), drop_given: cli.has(parsed, table, "drop"), task: task, drops: cli.text(args, parsed, table, "drop"), target: cli.text(args, parsed, table, "target") };
}

// the errors, and whether there are none
fn clean(errs: fail.Errors) -> [] (fail.Errors, bool) {
    var none = false;
    borrow errs as &er in {
        none = fail.count(er) == 0;
    }
    return (errs, none);
}

// resolve the paths the command names, unless the command line is already refused
fn resolve_all[&h, &g, &p, &r](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, root: &r [byte], errs: fail.Errors) -> [heap, args] (Paths, fail.Errors) {
    let table = spec.flag_table();
    let (e0, none) = clean(errs);
    if !none {
        return (Paths { file: paths.absent(heap), model: paths.absent(heap), out: paths.absent(heap), logp: paths.absent(heap) }, e0);
    }
    let (f2, e2) = paths.from_operand(heap, args, root, cli.operand_index(parsed, 1), e0);
    let (m2, e3) = paths.from_flag(heap, args, parsed, table, root, "model-file", e2);
    let (o2, e4) = paths.from_flag(heap, args, parsed, table, root, "output", e3);
    let (l2, e5) = paths.from_flag(heap, args, parsed, table, root, "log", e4);
    return (Paths { file: f2, model: m2, out: o2, logp: l2 }, e5);
}

// the log file is not already full (before any work): the errors gain limit.log-full or the reason it could not be read
fn preflight_log[&h, &f, &r, &lp](heap: &!h Heap, fs: &f Fs(""), root: &r [byte], logp: &lp paths.Rp, cap: int, errs: fail.Errors) -> [heap, fs_read(""), dir_read, file_read] fail.Errors {
    let (ls, lsize) = fsio.log_length(fs, root, paths.shown(logp), paths.full(logp));
    if ls != 0 {
        return fail.io_error(heap, errs, lsize, false, paths.shown(logp));
    }
    if lsize >= cap {
        var w = fail.open_in(heap, spec.extra(), "limit.log-full", "the log file is already as long as --log-max-bytes", "move the log away, or raise --log-max-bytes");
        w = fail.no_repair(heap, w);
        w = fail.detail_open(heap, w);
        w = fail.detail_int(heap, w, "size", lsize);
        w = fail.detail_int(heap, w, "max", cap);
        return fail.add(heap, errs, w);
    }
    return errs;
}

// run the verb: its answer, and whether the log can be written
fn execute[&h, &g, &p, &f, &r, &pp](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), root: &r [byte], verb: int, ps: &pp Paths, errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, dir_write, file_read, file_write] (verbs.Out, bool) {
    let table = spec.flag_table();
    let lg = logrec.start(heap, buffer.empty(heap, 256), "ml", version());
    var e = errs;
    var log_ok = false;
    let (e1, none) = clean(e);
    e = e1;
    if none && paths.present(ps.logp) {
        e = preflight_log(heap, fs, root, ps.logp, cli.nat(args, parsed, table, "log-max-bytes"), e);
        let (e2, still) = clean(e);
        e = e2;
        log_ok = still;
    }
    let (e3, go) = clean(e);
    if !go {
        return (verbs.nothing(heap, e3, lg), log_ok);
    }
    let o = options(args, parsed);
    if verb == 1 {
        return (verbs.fit(heap, args, fs, root, ps.file, ps.out, o, e3, lg), log_ok);
    }
    if verb == 2 {
        return (verbs.predict(heap, args, fs, root, ps.file, ps.model, o, e3, lg), log_ok);
    }
    return (verbs.eval(heap, args, fs, root, ps.file, ps.model, o, e3, lg), log_ok);
}

// the end record, the log written, the answer
fn finish[&h, &g, &p, &f, &i, &r, &pp](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), io: &!i Io, root: &r [byte], ps: &pp Paths, result: verbs.Out, log_ok: bool) -> [heap, args, fs_read(""), dir_read, dir_write, file_read, file_write, io_write, err_write] int {
    let table = spec.flag_table();
    let (payload, plain, extra, errs0, log0, dry) = verbs.parts(result);
    var e = errs0;
    var lg = log0;
    var rule = buffer.empty(heap, 1);
    var ok = true;
    var exit = 0;
    borrow e as &er in {
        buffer.drop(heap, rule);
        rule = first_rule(heap, er);
        ok = fail.count(er) == 0;
        if !ok {
            exit = fail.exit_code(er);
        } else if dry {
            exit = 9;
        }
    }
    borrow rule as &ru in {
        lg = logrec.end(heap, lg, ok, exit, buffer.bytes(ru));
    }
    buffer.drop(heap, rule);
    if log_ok {
        borrow lg as &lr in {
            let (ws, wa) = fsio.append_log(fs, root, paths.shown(ps.logp), paths.full(ps.logp), buffer.bytes(lr), cli.nat(args, parsed, table, "log-max-bytes"));
            if ws == 4 {
                var w = fail.open_in(heap, spec.extra(), "limit.log-full", "the log file is already as long as --log-max-bytes", "move the log away, or raise --log-max-bytes");
                w = fail.no_repair(heap, w);
                w = fail.detail_open(heap, w);
                w = fail.detail_int(heap, w, "size", wa);
                e = fail.add(heap, e, w);
            } else if ws != 0 {
                e = fail.io_error(heap, e, wa, true, paths.shown(ps.logp));
            }
        }
    }
    buffer.drop(heap, lg);
    var success = 0;
    if dry {
        success = 9;
    }
    var status = 0;
    borrow e as &er in {
        borrow payload as &d in {
            borrow extra as &x in {
                borrow plain as &t in {
                    status = out.respond(heap, io, "ml", "ml.v1", version(), buffer.bytes(d), buffer.bytes(x), er, bytes.equal(cli.text(args, parsed, table, "format"), "text"), buffer.bytes(t), success);
                }
            }
        }
    }
    buffer.drop(heap, payload);
    buffer.drop(heap, plain);
    buffer.drop(heap, extra);
    fail.drop(heap, e);
    return status;
}

fn body[&h, &g, &p, &f, &i](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), io: &!i Io, errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, dir_write, file_read, file_write, io_write, err_write] int {
    let table = spec.flag_table();
    let (verb, e0) = cmdline(heap, args, parsed, errs);
    let (root, e1) = path.root(heap, args, cli.text(args, parsed, table, "root"), cli.value_index(parsed, table, "root"), e0);
    var status = 0;
    borrow root as &rr in {
        let (ps, e2) = resolve_all(heap, args, parsed, buffer.bytes(rr), e1);
        borrow ps as &pr in {
            let (result, log_ok) = execute(heap, args, parsed, fs, buffer.bytes(rr), verb, pr, e2);
            status = finish(heap, args, parsed, fs, io, buffer.bytes(rr), pr, result, log_ok);
        }
        drop_paths(heap, ps);
    }
    buffer.drop(heap, root);
    return status;
}

fn run[&h, &g, &f, &i](heap: &!h Heap, args: &g Args, fs: &f Fs(""), io: &!i Io) -> [heap, args, fs_read(""), dir_read, dir_write, file_read, file_write, io_write, err_write] int {
    let which = cli.subcommand(args);
    if which != 0 {
        return describe.answer(heap, io, which, spec.tool(), built());
    }
    let (parsed, e) = cli.parse(heap, args, spec.flag_table(), fail.empty_in(heap, spec.extra()));
    var status = 0;
    borrow parsed as &p in {
        status = body(heap, args, p, fs, io, e);
    }
    cli.drop(heap, parsed);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    // No foreign code, no network, no clock.
    release(ffi);
    release(net);
    release(clock);
    var status = 0;
    borrow mut heap as &!h in {
        borrow args as &g in {
            borrow fs as &f in {
                borrow mut io as &!i in {
                    status = run(h, g, f, i);
                }
            }
        }
    }
    release(heap);
    release(args);
    release(fs);
    release(io);
    return status;
}
