edition 5;

// `ml` -- fit, apply and score a model on a CSV file (docs/cli.md). The first operand is the verb (fit, predict, eval), the
// second the CSV file; `ml introspect` and `ml skill` describe the tool from the tables it runs on.
//
// This file parses and checks the command line, resolves the paths, runs the verb (tools/ml/verbs.cho), writes the log and
// answers: one JSON document on one line, the exit code of the first error (cancho docs/agent-toolbox.md D4).

import std.buffer;
import std.bytes;
import std.json;
import ml.app;
import ml.catcli;
import ml.cfit;
import ml.cv;
import ml.est;
import ml.fsio;
import ml.idump;
import ml.logrec;
import ml.mdesc;
import ml.paths;
import ml.perm;
import ml.runs;
import ml.spec;
import ml.splitspec;
import ml.track;
import ml.verbs;
import ml.wire;
import ml.wireio;
import toolbox.built;
import toolbox.cli;
import toolbox.describe;
import toolbox.fail;
import toolbox.out;
import toolbox.path;
import toolbox.text;

fn built() -> [] describe.Built {
    return describe.Built { authority: built.authority(), schema: built.schema(), compiler: built.compiler() };
}

// the log file is not already full (before any work): the errors gain limit.log-full or the reason it could not be read
fn preflight_log[&h, &f, &r, &lp](heap: &!h Heap, fs: &f Fs(""), root: &r [byte], logp: &lp paths.Rp, cap: int, errs: fail.Errors) -> [heap, fs_read(""), dir_read, file_read] fail.Errors {
    let (ls, lsize) = fsio.log_length(fs, root, paths.shown(logp), paths.full(logp));
    if ls != 0 {
        return fail.io_error(heap, errs, lsize, false, paths.shown(logp));
    }
    if lsize >= cap {
        var w = fail.open_in(heap, spec.extra(), "limit.log-full", "the log file is already as long as --log-max-bytes", "move the log away, or raise --log-max-bytes");
        w = fail.no_repair(heap, w);
        w = fail.detail_open(heap, w);
        w = fail.detail_int(heap, w, "size", lsize);
        w = fail.detail_int(heap, w, "max", cap);
        return fail.add(heap, errs, w);
    }
    return errs;
}

// run the verb: its answer, and whether the log can be written
fn execute[&h, &g, &p, &f, &r, &pp](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), root: &r [byte], verb: int, ps: &pp app.Paths, errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, dir_write, file_read, file_write, conc] (verbs.Out, bool) {
    let table = spec.flag_table();
    let lg = logrec.start(heap, buffer.empty(heap, 256), "ml", app.version());
    var e = errs;
    var log_ok = false;
    let (e1, none) = app.clean(e);
    e = e1;
    if none && paths.present(ps.logp) {
        e = preflight_log(heap, fs, root, ps.logp, cli.nat(args, parsed, table, "log-max-bytes"), e);
        let (e2, still) = app.clean(e);
        e = e2;
        log_ok = still;
    }
    let (e3, go) = app.clean(e);
    if !go {
        return (verbs.nothing(heap, e3, lg), log_ok);
    }
    let o = app.options(args, parsed, table);
    let sp = splitspec.from_cli(args, parsed, table);
    if verb == 5 {
        let tokens = wire.model_tokens(heap, args, parsed, est.kind_named(o.model));
        var answer = verbs.nothing(heap, fail.empty_in(heap, spec.extra()), buffer.empty(heap, 1));
        borrow tokens as &tk in {
            verbs.drop_out(heap, answer);
            answer = cv.run(heap, args, fs, root, ps.file, ps.planp, buffer.bytes(tk), o, sp, e3, lg);
        }
        buffer.drop(heap, tokens);
        return (answer, log_ok);
    }
    if verb == 1 {
        if o.cat_given && !wire.planned(o.plan_given, o.model) {
            return (catcli.fit(heap, args, fs, root, ps.file, o, e3, lg), log_ok);
        }
        if wire.planned(o.plan_given, o.model) {
            let tokens = wire.model_tokens(heap, args, parsed, est.kind_named(o.model));
            var answer = verbs.nothing(heap, fail.empty_in(heap, spec.extra()), buffer.empty(heap, 1));
            borrow tokens as &tk in {
                verbs.drop_out(heap, answer);
                answer = wire.fit(heap, args, fs, root, ps.file, ps.out, ps.planp, ps.trackp, buffer.bytes(tk), o, sp, e3, lg);
            }
            buffer.drop(heap, tokens);
            return (answer, log_ok);
        }
        return (cfit.fit(heap, args, fs, root, ps.file, ps.out, ps.trackp, o, e3, lg), log_ok);
    }
    if verb == 2 {
        return (wireio.predict(heap, args, fs, root, ps.file, ps.model, o, e3, lg), log_ok);
    }
    if verb == 4 {
        return (mdesc.describe(heap, fs, root, ps.model, o, e3, lg), log_ok);
    }
    if verb == 6 {
        var id1: &static [byte] = "";
        var id2: &static [byte] = "";
        if cli.operand_count(parsed) > 3 {
            id1 = cli.operand(args, parsed, 3);
        }
        if cli.operand_count(parsed) > 4 {
            id2 = cli.operand(args, parsed, 4);
        }
        return (runs.run(heap, args, fs, root, ps.file, cli.operand(args, parsed, 1), id1, id2, o, e3, lg), log_ok);
    }
    if verb == 7 {
        let rq = perm.request(args, parsed, table);
        return (perm.run(heap, args, fs, root, ps.datap, ps.model, rq, o, e3, lg), log_ok);
    }
    if verb == 8 {
        let rq = perm.request(args, parsed, table);
        return (idump.run(heap, fs, root, ps.model, rq, o, e3, lg), log_ok);
    }
    return (wireio.eval(heap, args, fs, root, ps.file, ps.model, ps.trackp, o, sp, e3, lg), log_ok);
}

// the end record, the log written, the answer
fn finish[&h, &g, &p, &f, &i, &r, &pp](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), io: &!i Io, root: &r [byte], ps: &pp app.Paths, result: verbs.Out, log_ok: bool) -> [heap, args, fs_read(""), dir_read, dir_write, file_read, file_write, io_write, err_write] int {
    let table = spec.flag_table();
    let (payload, plain, extra, errs0, log0, dry) = verbs.parts(result);
    var e = errs0;
    var lg = log0;
    var rule = buffer.empty(heap, 1);
    var ok = true;
    var exit = 0;
    borrow e as &er in {
        let (ok2, exit2, rule2) = app.outcome(heap, er, dry);
        buffer.drop(heap, rule);
        rule = rule2;
        ok = ok2;
        exit = exit2;
    }
    borrow rule as &ru in {
        lg = logrec.end(heap, lg, ok, exit, buffer.bytes(ru));
    }
    buffer.drop(heap, rule);
    if log_ok {
        borrow lg as &lr in {
            let (ws, wa) = fsio.append_log(fs, root, paths.shown(ps.logp), paths.full(ps.logp), buffer.bytes(lr), cli.nat(args, parsed, table, "log-max-bytes"));
            if ws == 4 {
                var w = fail.open_in(heap, spec.extra(), "limit.log-full", "the log file is already as long as --log-max-bytes", "move the log away, or raise --log-max-bytes");
                w = fail.no_repair(heap, w);
                w = fail.detail_open(heap, w);
                w = fail.detail_int(heap, w, "size", wa);
                e = fail.add(heap, e, w);
            } else if ws != 0 {
                e = fail.io_error(heap, e, wa, true, paths.shown(ps.logp));
            }
        }
    }
    buffer.drop(heap, lg);
    var status = 0;
    borrow e as &er in {
        borrow payload as &d in {
            borrow extra as &x in {
                borrow plain as &t in {
                    status = app.respond(heap, args, parsed, table, io, er, buffer.bytes(d), buffer.bytes(x), buffer.bytes(t), dry);
                }
            }
        }
    }
    buffer.drop(heap, payload);
    buffer.drop(heap, plain);
    buffer.drop(heap, extra);
    fail.drop(heap, e);
    return status;
}

fn body[&h, &g, &p, &f, &i](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, fs: &f Fs(""), io: &!i Io, errs: fail.Errors) -> [heap, args, fs_read(""), dir_read, dir_write, file_read, file_write, io_read, io_write, err_write, conc] int {
    let table = spec.flag_table();
    let (verb, e0) = app.cmdline(heap, args, parsed, errs, table, 1);
    let (root, e1a) = path.root(heap, args, cli.text(args, parsed, table, "root"), cli.value_index(parsed, table, "root"), e0);
    var e1 = e1a;
    borrow root as &rb in {
        if paths.has_double_dot(buffer.bytes(rb)) {
            e1 = paths.refuse_double_dot(heap, e1, buffer.bytes(rb), cli.value_index(parsed, table, "root"));
        }
    }
    var status = 0;
    borrow root as &rr in {
        let (ps0, e2a) = app.resolve_all(heap, args, parsed, table, verb, buffer.bytes(rr), e1);
        let (ps, e2) = app.stdin_into(heap, args, parsed, table, io, verb, ps0, e2a);
        borrow ps as &pr in {
            let (result, log_ok) = execute(heap, args, parsed, fs, buffer.bytes(rr), verb, pr, e2);
            status = finish(heap, args, parsed, fs, io, buffer.bytes(rr), pr, result, log_ok);
        }
        app.drop_paths(heap, ps);
    }
    buffer.drop(heap, root);
    return status;
}

fn run[&h, &g, &f, &i](heap: &!h Heap, args: &g Args, fs: &f Fs(""), io: &!i Io) -> [heap, args, fs_read(""), dir_read, dir_write, file_read, file_write, io_read, io_write, err_write, conc] int {
    let which = cli.subcommand(args);
    if which != 0 {
        return describe.answer(heap, io, which, spec.tool(), built());
    }
    let (parsed, e) = cli.parse(heap, args, spec.flag_table(), fail.empty_in(heap, spec.extra()));
    var status = 0;
    borrow parsed as &p in {
        status = body(heap, args, p, fs, io, e);
    }
    cli.drop(heap, parsed);
    return status;
}

fn main(world: World) -> [conc] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    // No foreign code, no network, no clock.
    release(ffi);
    release(net);
    release(clock);
    var status = 0;
    borrow mut heap as &!h in {
        borrow args as &g in {
            borrow fs as &f in {
                borrow mut io as &!i in {
                    status = run(h, g, f, i);
                }
            }
        }
    }
    release(heap);
    release(args);
    release(fs);
    release(io);
    return status;
}
