edition 5;

// `ml` -- fit, apply and score a model on a CSV file (docs/cli.md). The first operand is the verb (fit, predict, eval), the
// second the CSV file; `ml introspect` and `ml skill` describe the tool from the tables it runs on.
//
// This file parses and checks the command line, resolves the paths, runs the verb (tools/ml/verbs.cho), writes the log and
// answers: one JSON document on one line, the exit code of the first error (cancho docs/agent-toolbox.md D4).

import std.buffer;
import std.bytes;
import std.json;
import ml.app;
import ml.argv;
import ml.catcli;
import ml.cfit;
import ml.cv;
import ml.est;
import ml.fsio;
import ml.jsonlcli;
import ml.logrec;
import ml.mdesc;
import ml.mfile;
import ml.paths;
import ml.runs;
import ml.spec;
import ml.splitspec;
import ml.track;
import ml.verbrun;
import ml.verbs;
import ml.wire;
import ml.wireio;
import toolbox.built;
import toolbox.cli;
import toolbox.describe;
import toolbox.fail;
import toolbox.out;
import toolbox.path;
import toolbox.text;

fn built() -> [] describe.Built {
    return describe.Built { authority: built.authority(), schema: built.schema(), compiler: built.compiler() };
}

// the end record, the log written, the answer
fn finish[&h, &f, &i, &r, &pp, &cl](heap: &!h Heap, src: &cl [byte], fs: &f Fs(""), io: &!i Io, root: &r [byte], ps: &pp app.Paths, verb: int, result: verbs.Out, log_ok: bool) -> [heap, fs_read(""), dir_read, dir_write, file_read, file_write, io_write, err_write] int {
    let table = spec.flag_table();
    let (payload0, plain0, extra, errs0, log0, dry) = verbs.parts(result);
    var payload = payload0;
    var plain = plain0;
    var e = errs0;
    // `predict --output FILE` (cancho-ml#101): the rows go to the file, one per line as `--format text` prints them, written atomically (an existing file is
    // refused without --overwrite), and the answer is a summary of the file: its path, rows, bytes and SHA-256. The prediction is already made, so a refusal
    // of the prediction leaves nothing written.
    if verb == 2 && argv.has(src, "output") {
        var clean = false;
        borrow e as &er0 in {
            clean = fail.count(er0) == 0;
        }
        if clean {
            var rows = 0;
            var size = 0;
            var ws = 0;
            var wa = 0;
            var hex = buffer.empty(heap, 1);
            borrow plain as &pt in {
                let data = buffer.bytes(pt);
                size = len(data);
                var k = 0;
                while k < len(data) {
                    if int_of(data[k]) == 10 {
                        rows = rows + 1;
                    }
                    k = k + 1;
                }
                let (ws2, wa2) = fsio.write_atomic(heap, fs, root, paths.shown(ps.out), paths.full(ps.out), data, argv.has(src, "overwrite"), false);
                ws = ws2;
                wa = wa2;
                buffer.drop(heap, hex);
                hex = mfile.sha256_hex(heap, data);
            }
            if ws != 0 {
                e = verbs.write_failure(heap, e, ws, wa, paths.shown(ps.out));
                // nothing was written: the refusal does not carry the rows either
                buffer.drop(heap, payload);
                buffer.drop(heap, plain);
                payload = buffer.empty(heap, 1);
                plain = buffer.empty(heap, 1);
            } else {
                buffer.drop(heap, payload);
                buffer.drop(heap, plain);
                var w = json.writer(heap, 256);
                w = json.begin_object(heap, w);
                w = json.put_key(heap, w, "path");
                w = json.put_string(heap, w, paths.shown(ps.out));
                w = json.put_key(heap, w, "rows");
                w = json.put_int(heap, w, rows);
                w = json.put_key(heap, w, "bytes");
                w = json.put_int(heap, w, size);
                w = json.put_key(heap, w, "sha256");
                borrow hex as &hr in {
                    w = json.put_string(heap, w, buffer.bytes(hr));
                }
                w = json.put_key(heap, w, "written");
                w = json.put_bool(heap, w, true);
                w = json.end_object(heap, w);
                payload = json.finish(w);
                plain = buffer.append(heap, buffer.empty(heap, 64), "wrote ");
                plain = buffer.append(heap, plain, paths.shown(ps.out));
                plain = buffer.push(heap, plain, byte_of(10));
            }
            buffer.drop(heap, hex);
        }
    }
    var lg = log0;
    var rule = buffer.empty(heap, 1);
    var ok = true;
    var exit = 0;
    borrow e as &er in {
        let (ok2, exit2, rule2) = app.outcome(heap, er, dry);
        buffer.drop(heap, rule);
        rule = rule2;
        ok = ok2;
        exit = exit2;
    }
    borrow rule as &ru in {
        lg = logrec.end(heap, lg, ok, exit, buffer.bytes(ru));
    }
    buffer.drop(heap, rule);
    if log_ok {
        borrow lg as &lr in {
            let (ws, wa) = fsio.append_log(fs, root, paths.shown(ps.logp), paths.full(ps.logp), buffer.bytes(lr), argv.nat(src, "log-max-bytes"));
            if ws == 4 {
                var w = fail.open_in(heap, spec.extra(), "limit.log-full", "the log file is already as long as --log-max-bytes", "move the log away, or raise --log-max-bytes");
                w = fail.no_repair(heap, w);
                w = fail.detail_open(heap, w);
                w = fail.detail_int(heap, w, "size", wa);
                e = fail.add(heap, e, w);
            } else if ws != 0 {
                e = fail.io_error(heap, e, wa, true, paths.shown(ps.logp));
            }
        }
    }
    buffer.drop(heap, lg);
    var status = 0;
    borrow e as &er in {
        borrow payload as &d in {
            borrow extra as &x in {
                borrow plain as &t in {
                    status = app.respond(heap, src, table, io, er, buffer.bytes(d), buffer.bytes(x), buffer.bytes(t), dry);
                }
            }
        }
    }
    buffer.drop(heap, payload);
    buffer.drop(heap, plain);
    buffer.drop(heap, extra);
    fail.drop(heap, e);
    return status;
}

fn body[&h, &f, &i, &cl](heap: &!h Heap, src: &cl [byte], fs: &f Fs(""), io: &!i Io, errs: fail.Errors) -> [heap, fs_read(""), dir_read, dir_write, file_read, file_write, io_read, io_write, err_write, conc] int {
    let table = spec.flag_table();
    let (verb, e0a) = app.cmdline(heap, src, errs, table, 1);
    let e0 = jsonlcli.check_flags(heap, src, e0a, table, verb);
    let (root, e1a) = paths.root(heap, src, argv.text(src, "root"), argv.value_index(src, "root"), e0);
    var e1 = e1a;
    borrow root as &rb in {
        if paths.has_double_dot(buffer.bytes(rb)) {
            e1 = paths.refuse_double_dot(heap, e1, buffer.bytes(rb), argv.value_index(src, "root"));
        }
    }
    var status = 0;
    borrow root as &rr in {
        let (ps0, e2a) = app.resolve_all(heap, src, table, verb, buffer.bytes(rr), e1);
        let (ps1, e2b) = app.stdin_into(heap, src, table, io, verb, ps0, e2a);
        let (ps, e2) = jsonlcli.input_into(heap, src, table, fs, buffer.bytes(rr), verb, ps1, e2b);
        borrow ps as &pr in {
            let (result, log_ok) = verbrun.execute(heap, src, fs, buffer.bytes(rr), verb, pr, e2);
            status = finish(heap, src, fs, io, buffer.bytes(rr), pr, verb, result, log_ok);
        }
        app.drop_paths(heap, ps);
    }
    buffer.drop(heap, root);
    return status;
}

fn run[&h, &f, &i, &g](heap: &!h Heap, args: &g Args, fs: &f Fs(""), io: &!i Io) -> [heap, args, fs_read(""), dir_read, dir_write, file_read, file_write, io_read, io_write, err_write, conc] int {
    let which = cli.subcommand(args);
    if which != 0 {
        return describe.answer(heap, io, which, spec.tool(), built());
    }
    let (parsed, e) = cli.parse(heap, args, spec.flag_table(), fail.empty_in(heap, spec.extra()));
    var status = 0;
    borrow parsed as &p in {
        let packed = argv.from_cli(heap, args, p, spec.flag_table());
        borrow packed as &pk in {
            status = body(heap, buffer.bytes(pk), fs, io, e);
        }
        buffer.drop(heap, packed);
    }
    cli.drop(heap, parsed);
    return status;
}

fn main(world: World) -> [conc] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    // No foreign code, no network, no clock.
    release(ffi);
    release(net);
    release(clock);
    var status = 0;
    borrow mut heap as &!h in {
        borrow args as &g in {
            borrow fs as &f in {
                borrow mut io as &!i in {
                    status = run(h, g, f, i);
                }
            }
        }
    }
    release(heap);
    release(args);
    release(fs);
    release(io);
    return status;
}
