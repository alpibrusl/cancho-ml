edition 6;

module ml.wiredata;

// The pieces of the planned models' verbs that do not depend on a verb (docs/wiring.md section 3): errors from the numeric codes of the libraries, the
// matrices a fit or a prediction is made of (a copy of some rows and some columns), the schema of a CSV, the grammar of `--split`, and the metrics.
// Nothing here reads a file or writes one.

import std.buffer;
import std.bytes;
import std.json;
import ml.argv;
import ml.csv;
import ml.csvcell;
import ml.est;
import ml.mfile;
import ml.matrix;
import ml.refuse;
import ml.spec;
import ml.verbs;
import models.common;
import metrics.classify;
import metrics.logloss;
import metrics.rank;
import metrics.regress;
import metrics.rules;
import metrics.sums;
import pipeline.names;
import pipeline.schema;
import transforms.codes;
import transforms.strtab;
import tree.deny;
import tree.params;
import flt;
import toolbox.fail;
import toolbox.text;

// ---------------------------------------------------------------- errors from the codes of the libraries

// the summary of a rule of spec.extra(): `message. Hint: text. Repair: ...`
fn summary_of(tag: &static [byte]) -> [] &static [byte] {
    let table = spec.extra();
    let count = bytes.count_byte(table, ';') + 1;
    var k = 1;
    while k <= count {
        let entry = bytes.field(table, ';', k);
        if bytes.equal(bytes.field(entry, '|', 1), tag) {
            return bytes.field(entry, '|', 4);
        }
        k = k + 1;
    }
    return "";
}

pub fn message_of(tag: &static [byte]) -> [] &static [byte] {
    let s = summary_of(tag);
    let i = bytes.find(s, " Hint: ");
    if i < 0 {
        return s;
    }
    return s[0..i];
}

pub fn hint_of(tag: &static [byte]) -> [] &static [byte] {
    let s = summary_of(tag);
    let i = bytes.find(s, " Hint: ");
    if i < 0 {
        return "see introspect";
    }
    let j = bytes.find(s, " Repair:");
    if j < i {
        return s[i + 7..len(s)];
    }
    return s[i + 7..j];
}

// an error of `tag` (a rule of spec.extra()) with the message and the hint of its summary
pub fn open_tag[&h](heap: &!h Heap, tag: &static [byte]) -> [heap] json.Writer {
    return fail.open_in(heap, spec.extra(), tag, message_of(tag), hint_of(tag));
}

// the tag of a code of any of the libraries: ml.refuse 1 to 99, tree.deny 101 to 108, metrics.rules 201 to 211, transforms.codes 301 to 325 (docs/design.md section 8.1)
pub fn tag_of(code: int) -> [] &static [byte] {
    if code >= 1 && code <= 99 {
        return refuse.tag(code);
    }
    if code >= 101 && code <= deny.last() {
        return deny.tag(code);
    }
    if code >= rules.first() && code <= rules.last() {
        return rules.tag(code);
    }
    return codes.tag(code);
}

// an error for a code of a library, with the integers of a Fault as the detail its tag gives them (transforms.codes header)
pub fn code_error[&h](heap: &!h Heap, errs: fail.Errors, code: int, a: int, b: int, c: int) -> [heap] fail.Errors {
    let tag = tag_of(code);
    var w = open_tag(heap, tag);
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    if code >= codes.plan_syntax() && code <= codes.plan_model_line() {
        w = fail.detail_int(heap, w, "line", a);
        if b > 0 {
            w = fail.detail_int(heap, w, "column", b);
        }
    } else if code == codes.plan_unknown_column() {
        w = fail.detail_int(heap, w, "step", a);
    } else if code == codes.plan_limit() {
        w = fail.detail_int(heap, w, "limit", a);
    } else if code == codes.input_non_finite() || code == codes.unknown_category() {
        w = fail.detail_int(heap, w, "step", a);
        w = fail.detail_int(heap, w, "column", b);
        w = fail.detail_int(heap, w, "row", c);
    } else if code == codes.fit_non_finite() || code == codes.all_missing() || code == codes.categories() || code == codes.too_many_columns() || code == codes.out_of_range() {
        if a > 0 {
            w = fail.detail_int(heap, w, "step", a);
            w = fail.detail_int(heap, w, "column", b);
        }
    } else if code == codes.malformed() {
        w = fail.detail_int(heap, w, "section", a);
        if a == 3 {
            w = fail.detail_int(heap, w, "step", b);
        }
    } else if code == codes.string_table() {
        w = fail.detail_str(heap, w, "reason", strtab.reason_word(a));
        w = fail.detail_int(heap, w, "section", 6);
        if b > 0 {
            w = fail.detail_int(heap, w, "step", b);
        }
    } else if code == codes.limit_string_table() {
        var what: &static [byte] = "bytes";
        if a == 1 {
            what = "strings";
        } else if a == 2 {
            what = "pool_bytes";
        }
        w = fail.detail_str(heap, w, "what", what);
        w = fail.detail_int(heap, w, "size", b);
        w = fail.detail_int(heap, w, "max", c);
    }
    return fail.add(heap, errs, w);
}

// ---------------------------------------------------------------- matrices

// A copy of x: the rows r with sel[r] == want (all rows when want < 0) and the columns cols[0 .. nc) of x, in that order. (matrix, 0) or (empty, a code of ml.refuse)
pub fn take[&h, &m, &s, &c](heap: &!h Heap, x: &m matrix.Matrix, sel: &s [int], want: int, cols: &c [int], nc: int, rows_cap: int, cols_cap: int, cells_cap: int) -> [heap] (matrix.Matrix, int) {
    var n = 0;
    var r = 0;
    while r < matrix.rows(x) {
        if want < 0 || sel[r] == want {
            n = n + 1;
        }
        r = r + 1;
    }
    let (out, code) = matrix.make(heap, n, nc, rows_cap, cols_cap, cells_cap);
    if code != 0 {
        return (out, code);
    }
    let (t, data, miss, rows, ncols, wpc) = matrix.parts(out);
    var d = data;
    var b = miss;
    borrow mut d as &!dw in {
        borrow mut b as &!bw in {
            var at = 0;
            r = 0;
            while r < matrix.rows(x) {
                if want < 0 || sel[r] == want {
                    var j = 0;
                    while j < nc {
                        if matrix.is_missing(x, r, cols[j]) {
                            matrix.mark_missing(contents(bw), wpc, at, j);
                        } else {
                            matrix.put(contents(dw), ncols, at, j, matrix.value(x, r, cols[j]));
                        }
                        j = j + 1;
                    }
                    at = at + 1;
                }
                r = r + 1;
            }
        }
    }
    return (matrix.assemble(t, d, b, rows, ncols, wpc), 0);
}

// The column `col` of x for the selected rows (as take) as doubles, and the 1-based place among them of the first missing cell (0 if none)
pub fn take_col[&h, &m, &s](heap: &!h Heap, x: &m matrix.Matrix, sel: &s [int], want: int, col: int) -> [heap] (Box[[float]], int) {
    var n = 0;
    var r = 0;
    while r < matrix.rows(x) {
        if want < 0 || sel[r] == want {
            n = n + 1;
        }
        r = r + 1;
    }
    var out = box_slice(heap, n + 1, 0.0);
    var bad = 0;
    borrow mut out as &!ow in {
        var at = 0;
        r = 0;
        while r < matrix.rows(x) {
            if want < 0 || sel[r] == want {
                if matrix.is_missing(x, r, col) {
                    if bad == 0 {
                        bad = at + 1;
                    }
                } else {
                    contents(ow)[at] = matrix.value(x, r, col);
                }
                at = at + 1;
            }
            r = r + 1;
        }
    }
    return (out, bad);
}

// the number of selected rows
pub fn count_rows[&s](sel: &s [int], n: int, want: int) -> [] int {
    if want < 0 {
        return n;
    }
    var k = 0;
    var r = 0;
    while r < n {
        if sel[r] == want {
            k = k + 1;
        }
        r = r + 1;
    }
    return k;
}

// The columns of x that still hold a missing cell: how many, and their names (comma separated) in `list`. `nm` are the names of the columns of x.
pub fn missing_columns[&h, &m, &n](heap: &!h Heap, x: &m matrix.Matrix, nm: &n names.Names) -> [heap] (int, buffer.Buffer) {
    var list = buffer.empty(heap, 32);
    var found = 0;
    var c = 0;
    while c < matrix.cols(x) {
        if matrix.missing_count(x, c) > 0 {
            if found > 0 {
                list = buffer.push(heap, list, byte_of(','));
            }
            list = buffer.append(heap, list, names.name(nm, c));
            found = found + 1;
        }
        c = c + 1;
    }
    return (found, list);
}

// ---------------------------------------------------------------- the schema of a CSV

// The schema section of a fit: the kept columns of the shape in file order, the target marked; a column of no cell (all missing) is a float. The types: [2 i] 0 int,
// 1 dec, 2 float, [2 i + 1] the scale. The target is the column of that name (tname), which must be kept.
pub fn schema_of_shape[&h, &s, &t](heap: &!h Heap, sh: &s csv.Shape, tname: &t [byte]) -> [heap] schema.Schema {
    var nm = names.empty(heap);
    var kept = 0;
    var i = 0;
    while i < csv.cols(sh) {
        if !csv.dropped(sh, i) {
            kept = kept + 1;
        }
        i = i + 1;
    }
    var types = box_slice(heap, 2 * kept + 2, 0);
    // no column is called `tname` for a model with no target: the target index is then the number of columns (pipeline.schema)
    var target = kept;
    borrow mut types as &!tw in {
        var at = 0;
        i = 0;
        while i < csv.cols(sh) {
            if !csv.dropped(sh, i) {
                nm = names.add(heap, nm, csv.name(sh, i));
                let k = csv.kind(sh, i);
                if k == 1 {
                    contents(tw)[2 * at] = 0;
                } else if k == 2 {
                    contents(tw)[2 * at] = 1;
                    contents(tw)[2 * at + 1] = csv.scale(sh, i);
                } else {
                    contents(tw)[2 * at] = 2;
                }
                if bytes.equal(csv.name(sh, i), tname) {
                    target = at;
                }
                at = at + 1;
            }
            i = i + 1;
        }
    }
    return schema.make(nm, types, target);
}

// the index among the kept columns of the shape of the column named `name`, or -1
pub fn kept_index[&s, &n](sh: &s csv.Shape, name: &n [byte]) -> [] int {
    var at = 0;
    var i = 0;
    while i < csv.cols(sh) {
        if !csv.dropped(sh, i) {
            if bytes.equal(csv.name(sh, i), name) {
                return at;
            }
            at = at + 1;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// ---------------------------------------------------------------- --split

// `train=F`: F a decimal with 0 < F < 1 and at most 6 digits after the point (`0.8`, `.75`, `0.125`). (ok, test numerator, denominator): the test side is
// (den - F * den) / den of the rows, rounded up (metrics.splits.n_test_for)
pub fn parse_split[&t](text: &t [byte]) -> [] (bool, int, int) {
    if len(text) < 8 || !bytes.equal(text[0..6], "train=") {
        return (false, 0, 0);
    }
    let f = text[6..len(text)];
    var i = 0;
    var whole = 0;
    while i < len(f) && int_of(f[i]) >= '0' && int_of(f[i]) <= '9' {
        whole = whole * 10 + int_of(f[i]) - '0';
        i = i + 1;
        if whole > 1 {
            return (false, 0, 0);
        }
    }
    if i >= len(f) || int_of(f[i]) != '.' {
        return (false, 0, 0);
    }
    i = i + 1;
    var digits = 0;
    var frac = 0;
    var den = 1;
    while i < len(f) && int_of(f[i]) >= '0' && int_of(f[i]) <= '9' {
        digits = digits + 1;
        if digits > 6 {
            return (false, 0, 0);
        }
        frac = frac * 10 + int_of(f[i]) - '0';
        den = den * 10;
        i = i + 1;
    }
    if i != len(f) || digits == 0 || whole != 0 || frac == 0 || frac >= den {
        return (false, 0, 0);
    }
    return (true, den - frac, den);
}

// ---------------------------------------------------------------- a prediction that is not a finite number (docs/nonfinite.md)

// the index of the first of v[0 .. n) that is NaN or infinite, -1 when every one is finite
pub fn first_non_finite[&v](v: &v [float], n: int) -> [] int {
    var i = 0;
    while i < n {
        if !common.is_finite(v[i]) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// the column of the answer a value of a task belongs to: 0 prediction (a regression), 1 label (the class a classification chose), 2 probability, 3 distance
pub fn column_word(c: int) -> [] &static [byte] {
    if c == 1 {
        return "label";
    }
    if c == 2 {
        return "probability";
    }
    if c == 3 {
        return "distance";
    }
    return "prediction";
}

// The first row, in file order, of the scores of `n` rows whose value is not finite, and the column that holds it: (row, column) with row -1 when every value is finite.
// task 1 (regression) reads `pred`; task 2 (classification) reads `pred` (the label is chosen from it) and `prob`; task 4 (clustering) reads `prob`, the squared distance, when
// `dist` says the distance is computed (predict without --distance does not compute it). This is the one place that decides what is finite: predict and eval both call it.
pub fn first_bad_score[&p, &q](task: int, pred: &p [float], prob: &q [float], n: int, dist: bool) -> [] (int, int) {
    var row = 0 - 1;
    var col = 0;
    if task == 1 {
        row = first_non_finite(pred, n);
        return (row, 0);
    }
    if task == 4 {
        if dist {
            row = first_non_finite(prob, n);
            col = 3;
        }
        return (row, col);
    }
    let a = first_non_finite(pred, n);
    let b = first_non_finite(prob, n);
    if a >= 0 && (b < 0 || a <= b) {
        return (a, 1);
    }
    return (b, 2);
}

// the refusal of a row (1-based) whose value in the column named is not finite
pub fn non_finite_prediction[&h](heap: &!h Heap, errs: fail.Errors, row: int, column: &static [byte]) -> [heap] fail.Errors {
    var w = open_tag(heap, "ml.predict.non-finite");
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    w = fail.detail_int(heap, w, "row", row);
    w = fail.detail_str(heap, w, "column", column);
    return fail.add(heap, errs, w);
}

// the row of the file that is the k-th (0-based) of the rows selected with `want` (every row when want < 0): the row an eval over a split names
pub fn file_row[&s](sel: &s [int], total: int, want: int, k: int) -> [] int {
    if want < 0 {
        return k;
    }
    var i = 0;
    var seen = 0;
    while i < total {
        if sel[i] == want {
            if seen == k {
                return i;
            }
            seen = seen + 1;
        }
        i = i + 1;
    }
    return k;
}

// ---------------------------------------------------------------- metrics

// a metric that was refused: its name and the code
pub struct Failed {
    code: int,
    name: &static [byte],
    // the 0-based index, among the rows scored, of the row a refusal of ml.predict.non-finite names; 0 for the other refusals
    row: int,
}

pub fn fine() -> [] Failed {
    return Failed { code: 0, name: "", row: 0 };
}

// One metric: its value as the member `key` of the object and a line of the text, or null and `undefined` when the library says it has no value
// (metrics.rules.undefined: a zero denominator, a constant target for R-squared, a non-finite result). Any other refusal stops the eval.
// (writer, text, the names of the undefined metrics so far, the refusal code or 0)
fn member[&h, &u](heap: &!h Heap, w: json.Writer, plain: buffer.Buffer, key: &static [byte], label: &static [byte], sc: rules.Scored, undefined: buffer.Buffer) -> [heap] (json.Writer, buffer.Buffer, buffer.Buffer, int) {
    var o = w;
    var t = plain;
    var u = undefined;
    if sc.code == 0 {
        o = json.put_key(heap, o, key);
        o = verbs.put_double(heap, o, bits_of(sc.v));
        t = verbs.line_double(heap, t, label, bits_of(sc.v));
        return (o, t, u, 0);
    }
    if sc.code == rules.undefined() {
        o = json.put_key(heap, o, key);
        o = json.put_null(heap, o);
        t = buffer.append(heap, t, key);
        t = buffer.append(heap, t, " undefined\n");
        u = buffer.append(heap, u, key);
        u = buffer.push(heap, u, byte_of(','));
        return (o, t, u, 0);
    }
    return (o, t, u, sc.code);
}

// The metrics of a regression: rmse, mae, r2 (lib/metrics), as the members of an object into `w` and lines into `plain`; the names of the undefined ones,
// comma separated, in `undefined`
pub fn regression_metrics[&h, &y, &p](heap: &!h Heap, w: json.Writer, plain: buffer.Buffer, undefined: buffer.Buffer, yv: &y [float], pv: &p [float], cap: int) -> [heap] (json.Writer, buffer.Buffer, buffer.Buffer, Failed) {
    var o = w;
    var t = plain;
    var u = undefined;
    var code = 0;
    let a = regress.rmse(heap, yv, pv, cap);
    let (o1, t1, u1, c1) = member(heap, o, t, "rmse", "rmse ", a, u);
    o = o1;
    t = t1;
    u = u1;
    if c1 != 0 {
        return (o, t, u, Failed { code: c1, name: "rmse", row: 0 });
    }
    let b = regress.mae(heap, yv, pv, cap);
    let (o2, t2, u2, c2) = member(heap, o, t, "mae", "mae ", b, u);
    o = o2;
    t = t2;
    u = u2;
    if c2 != 0 {
        return (o, t, u, Failed { code: c2, name: "mae", row: 0 });
    }
    let c = regress.r2(heap, yv, pv, cap);
    let (o3, t3, u3, c3) = member(heap, o, t, "r2", "r2 ", c, u);
    o = o3;
    t = t3;
    u = u3;
    if c3 != 0 {
        return (o, t, u, Failed { code: c3, name: "r2", row: 0 });
    }
    return (o, t, u, fine());
}

// The metrics of a binary classification (lib/metrics): accuracy, precision, recall, F1, ROC-AUC, log-loss. yt and yp are labels, `score` is the probability of
// the label `pos`, which is one of the two labels.
pub fn classification_metrics[&h, &y, &p, &s](heap: &!h Heap, w: json.Writer, plain: buffer.Buffer, undefined: buffer.Buffer, yt: &y [int], yp: &p [int], score: &s [float], pos: int, cap: int) -> [heap] (json.Writer, buffer.Buffer, buffer.Buffer, Failed) {
    var o = w;
    var t = plain;
    var u = undefined;
    let a = classify.accuracy(yt, yp, cap);
    let (o1, t1, u1, c1) = member(heap, o, t, "accuracy", "accuracy ", a, u);
    o = o1;
    t = t1;
    u = u1;
    if c1 != 0 {
        return (o, t, u, Failed { code: c1, name: "accuracy", row: 0 });
    }
    let pr = classify.precision(yt, yp, pos, cap);
    let (o2, t2, u2, c2) = member(heap, o, t, "precision", "precision ", pr, u);
    o = o2;
    t = t2;
    u = u2;
    if c2 != 0 {
        return (o, t, u, Failed { code: c2, name: "precision", row: 0 });
    }
    let rc = classify.recall(yt, yp, pos, cap);
    let (o3, t3, u3, c3) = member(heap, o, t, "recall", "recall ", rc, u);
    o = o3;
    t = t3;
    u = u3;
    if c3 != 0 {
        return (o, t, u, Failed { code: c3, name: "recall", row: 0 });
    }
    let f1 = classify.f1(yt, yp, pos, cap);
    let (o4, t4, u4, c4) = member(heap, o, t, "f1", "f1 ", f1, u);
    o = o4;
    t = t4;
    u = u4;
    if c4 != 0 {
        return (o, t, u, Failed { code: c4, name: "f1", row: 0 });
    }
    let au = rank.auc(heap, yt, score, pos, cap);
    let (o5, t5, u5, c5) = member(heap, o, t, "roc_auc", "roc_auc ", au, u);
    o = o5;
    t = t5;
    u = u5;
    if c5 != 0 {
        return (o, t, u, Failed { code: c5, name: "roc_auc", row: 0 });
    }
    let ll = logloss.logloss(heap, yt, score, pos, cap);
    let (o6, t6, u6, c6) = member(heap, o, t, "log_loss", "log_loss ", ll, u);
    o = o6;
    t = t6;
    u = u6;
    if c6 != 0 {
        return (o, t, u, Failed { code: c6, name: "log_loss", row: 0 });
    }
    return (o, t, u, fine());
}

// ---------------------------------------------------------------- answers shared by the verbs of the planned models

// ---------------------------------------------------------------- the command line

pub fn conflict[&h, &n](heap: &!h Heap, errs: fail.Errors, flag: &n [byte], message: &static [byte]) -> [heap] fail.Errors {
    var w = fail.open_in(heap, spec.extra(), "args.conflict", message, "see the verbs and their flags in introspect usage");
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    w = fail.detail_text(heap, w, "flag", flag);
    return fail.add(heap, errs, w);
}

pub fn bad_value[&h, &n, &v](heap: &!h Heap, errs: fail.Errors, flag: &n [byte], value: &v [byte], expected: &static [byte]) -> [heap] fail.Errors {
    var w = fail.open_in(heap, spec.extra(), "args.bad-value", "a flag has a value it cannot take", "see the flag in introspect");
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    w = fail.detail_text(heap, w, "flag", flag);
    w = fail.detail_text(heap, w, "value", value);
    w = fail.detail_str(heap, w, "expected", expected);
    return fail.add(heap, errs, w);
}

// a label: an optional minus sign and 1 to 12 digits. (ok, value)
pub fn parse_label[&t](text: &t [byte]) -> [] (bool, int) {
    var i = 0;
    var neg = false;
    if len(text) > 0 && int_of(text[0]) == '-' {
        neg = true;
        i = 1;
    }
    if i >= len(text) || len(text) - i > 12 {
        return (false, 0);
    }
    var v = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c < '0' || c > '9' {
            return (false, 0);
        }
        v = v * 10 + c - '0';
        i = i + 1;
    }
    if neg {
        return (true, 0 - v);
    }
    return (true, v);
}

// ---------------------------------------------------------------- answers

pub fn out_of(payload: buffer.Buffer, plain: buffer.Buffer, extra: buffer.Buffer, errs: fail.Errors, log: buffer.Buffer, dry: bool) -> [] verbs.Out {
    return verbs.Out { payload: payload, plain: plain, extra: extra, errs: errs, log: log, dry: dry };
}

// the problem of a model file read by pipeline.file.decode: the same tags and details as verbs.model_error
pub fn file_fault[&h, &p](heap: &!h Heap, errs: fail.Errors, f: codes.Fault, shown: &p [byte]) -> [heap] fail.Errors {
    var rule: &static [byte] = codes.tag(f.code);
    var message: &static [byte] = message_of(rule);
    var hint: &static [byte] = hint_of(rule);
    if f.code == codes.bad_version() && f.b == 1 {
        message = "the model was made with a summation order this reader does not implement";
        hint = "refit the model with this version of ml";
    }
    var w = fail.open_in(heap, spec.extra(), rule, message, hint);
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    w = fail.detail_text(heap, w, "path", shown);
    if f.code == codes.bad_version() {
        if f.b == 1 {
            w = fail.detail_int(heap, w, "sum_order", f.a);
            w = fail.detail_int(heap, w, "known", f.c);
        } else {
            w = fail.detail_int(heap, w, "version", f.a);
            w = fail.detail_int(heap, w, "known", mfile.version());
        }
    }
    if f.code == codes.malformed() {
        w = fail.detail_int(heap, w, "section", f.a);
    }
    if f.code == codes.string_table() {
        w = fail.detail_str(heap, w, "reason", strtab.reason_word(f.a));
        w = fail.detail_int(heap, w, "section", 6);
        if f.b > 0 {
            w = fail.detail_int(heap, w, "step", f.b);
        }
    }
    return fail.add(heap, errs, w);
}

// `ml.input.missing-value`: some feature cells are still empty after the steps. The repair appends an impute step when the plan came from no flag at all
pub fn missing_error[&h, &l, &cl](heap: &!h Heap, src: &cl [byte], errs: fail.Errors, count: int, list: &l [byte], retry_ok: bool) -> [heap] fail.Errors {
    var w = open_tag(heap, "ml.input.missing-value");
    let plain_names = len(list) > 0 && bytes.count_byte(list, ' ') == 0 && bytes.count_byte(list, '=') == 0 && bytes.count_byte(list, '#') == 0 && text.is_utf8(list);
    if retry_ok && plain_names {
        var step = buffer.empty(heap, 64);
        step = buffer.append(heap, step, "impute column=");
        step = buffer.append(heap, step, list);
        step = buffer.append(heap, step, " strategy=mean");
        var rw = fail.retry_open(heap, w);
        var i = 0;
        while i < argv.argc(src) {
            rw = json.put_string(heap, rw, argv.at(src, i));
            i = i + 1;
        }
        rw = json.put_string(heap, rw, "--step");
        borrow step as &sr in {
            rw = json.put_string(heap, rw, buffer.bytes(sr));
        }
        buffer.drop(heap, step);
        w = fail.retry_close(heap, rw);
    } else {
        w = fail.repair_none(heap, w, "add a step that imputes these columns before the model, for example impute column=NAMES strategy=mean in the plan, or drop the columns with --drop");
    }
    w = fail.detail_open(heap, w);
    w = fail.detail_int(heap, w, "columns", count);
    w = fail.detail_text(heap, w, "names", list);
    return fail.add(heap, errs, w);
}

// a plan whose model line names a model that is not wired
pub fn not_built[&h, &n](heap: &!h Heap, errs: fail.Errors, name: &n [byte]) -> [heap] fail.Errors {
    var w = open_tag(heap, "ml.plan.model-not-built");
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    w = fail.detail_text(heap, w, "model", name);
    return fail.add(heap, errs, w);
}

// a tree or forest fit on more training rows than the exact comparison of its Gini criterion allows (docs/models-tree.md section 3.1), refused before the rows are copied
pub fn tree_rows[&h](heap: &!h Heap, errs: fail.Errors, rows: int) -> [heap] fail.Errors {
    var w = fail.open_in(heap, spec.extra(), "ml.input.too-many-rows", "a tree or forest fit takes at most 1048576 training rows (the bound of its exact Gini comparison)", "fit on a sample of the rows, or hold rows out with --split train=F so that the train side has at most 1048576 rows");
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    w = fail.detail_int(heap, w, "rows", rows);
    w = fail.detail_int(heap, w, "max", params.rows_max());
    return fail.add(heap, errs, w);
}

pub fn too_wide[&h](heap: &!h Heap, errs: fail.Errors, d: int) -> [heap] fail.Errors {
    var w = fail.open_in(heap, spec.extra(), "ml.input.too-many-columns", "the steps leave more feature columns than the model takes", "drop columns, bucket them, or encode fewer categories: the linear models take at most 256 feature columns");
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    w = fail.detail_int(heap, w, "columns", d);
    w = fail.detail_int(heap, w, "max", common.max_features());
    return fail.add(heap, errs, w);
}

pub fn bad_metric[&h](heap: &!h Heap, errs: fail.Errors, f: Failed) -> [heap] fail.Errors {
    if f.code == refuse.predict_non_finite() {
        return non_finite_prediction(heap, errs, f.row + 1, f.name);
    }
    var w = open_tag(heap, tag_of(f.code));
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    w = fail.detail_str(heap, w, "metric", f.name);
    return fail.add(heap, errs, w);
}

// ---------------------------------------------------------------- the scores of a model on a matrix

// The class (or the value) of each row of xs for the model of `kind`: the vector models' weights `wv`, or the payload `blob` of a model of the blob interface.
// xs is a matrix the stored steps produced; its bitmap of missing cells goes to a model that takes missing cells (the tree and the forest). 0, or a refusal code.
pub fn predict_into[&h, &x, &w, &b, &o](heap: &!h Heap, kind: int, xs: &x matrix.Matrix, wv: &w [float], blob: &b [byte], out: &!o [float]) -> [heap] int {
    if est.is_blob(kind) {
        return est.predict_blob(heap, kind, blob, matrix.shape(xs), contents(xs.data), contents(xs.miss), matrix.wpc(xs), out);
    }
    return est.predict(kind, matrix.shape(xs), contents(xs.data), wv, out);
}

// the probability of the positive class of each row (a classification only)
pub fn proba_into[&h, &x, &w, &b, &o](heap: &!h Heap, kind: int, xs: &x matrix.Matrix, wv: &w [float], blob: &b [byte], out: &!o [float]) -> [heap] int {
    if est.is_blob(kind) {
        return est.proba_blob(heap, kind, blob, matrix.shape(xs), contents(xs.data), contents(xs.miss), matrix.wpc(xs), out);
    }
    return est.proba(kind, matrix.shape(xs), contents(xs.data), wv, out);
}

// the name of the initialisation of the model line: the index in the manifest (0 random, 1 kmeans++)
pub fn init_word(i: int) -> [] &static [byte] {
    if i == 0 {
        return "random";
    }
    return "kmeans++";
}

// Which bound of a k-means fit the data break, 0 when none: 1 k above the training rows, 2 k * features + k + 1 above 131072, 3 the diagnostics of the fit above 2^24 floats.
// Compared before the fit allocates anything; the products are made after the divisions that keep them inside an int.
pub fn cluster_bound(k: int, iterations: int, rows: int, d: int) -> [] int {
    if k > rows {
        return 1;
    }
    if d < 1 || d > common.max_slot() || k > common.max_slot() / d || k * d + k + 1 > common.max_slot() {
        return 2;
    }
    if iterations + 1 > 16777216 / (k * d + k + 1) {
        return 3;
    }
    return 0;
}

// ml.param.out-of-range for a k-means fit that breaks a bound of cluster_bound, with the numbers
pub fn cluster_error[&h](heap: &!h Heap, errs: fail.Errors, which: int, k: int, iterations: int, rows: int, d: int) -> [heap] fail.Errors {
    var msg: &static [byte] = "k is above the number of training rows";
    var hint: &static [byte] = "give a k of at most the number of rows the model is fitted on";
    if which == 2 {
        msg = "k times the features plus k plus 1 is above 131072";
        hint = "fewer clusters or fewer feature columns (bucket or drop columns, encode fewer categories)";
    } else if which == 3 {
        msg = "the diagnostics of the iterations need more than 16777216 floats";
        hint = "fewer iterations, fewer clusters or fewer feature columns";
    }
    var w = fail.open_in(heap, spec.extra(), "ml.param.out-of-range", msg, hint);
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    w = fail.detail_int(heap, w, "k", k);
    w = fail.detail_int(heap, w, "iterations", iterations);
    w = fail.detail_int(heap, w, "rows", rows);
    w = fail.detail_int(heap, w, "features", d);
    return fail.add(heap, errs, w);
}

// One double of a list of the plain text: the shortest decimal that reads back, or `null` for a value that is not a number
fn list_double[&h](heap: &!h Heap, plain: buffer.Buffer, v: float, ok: bool) -> [heap] buffer.Buffer {
    if !ok {
        return buffer.append(heap, plain, "null");
    }
    let (p, fin) = verbs.put_float_text(heap, plain, bits_of(v));
    if !fin {
        return buffer.append(heap, p, "null");
    }
    return p;
}

// The metrics of a clustering of the rows of xs by the model (payload `blob`, `k` clusters): the inertia, the rows of each cluster and the mean distance of each cluster
// (docs/wiring-kmeans.md section 3), as members of the object `w` and lines of `plain`. The inertia is the sum of the squared distances of the rows to the centres of their
// clusters in row order, and the mean distance of a cluster the sum of the Euclidean distances of its rows in the order of those rows divided by their number: both through
// metrics.sums, the one order of the package (blocks of 256 terms, four lanes, the fixed tree). A value that is not a number (an overflow) and the mean of an empty cluster are `null`.
pub fn cluster_metrics[&h, &x, &w, &b](heap: &!h Heap, w0: json.Writer, plain: buffer.Buffer, undefined: buffer.Buffer, kind: int, xs: &x matrix.Matrix, wv: &w [float], blob: &b [byte], k: int, strict: bool) -> [heap] (json.Writer, buffer.Buffer, buffer.Buffer, Failed) {
    var o = w0;
    var t = plain;
    var u = undefined;
    let n = matrix.rows(xs);
    var lab = box_slice(heap, n + 1, 0.0);
    var d2 = box_slice(heap, n + 1, 0.0);
    var code = 0;
    borrow mut lab as &!lw in {
        code = predict_into(heap, kind, xs, wv, blob, contents(lw));
    }
    var which: &static [byte] = "predict";
    if code == 0 {
        which = "distance";
        borrow mut d2 as &!dw in {
            code = proba_into(heap, kind, xs, wv, blob, contents(dw));
        }
    }
    // a squared distance of one row that is not finite is the refusal of docs/nonfinite.md; a sum of finite ones that overflows stays `null` below
    var bad = 0 - 1;
    if code == 0 && strict && n >= 1 {
        borrow d2 as &dq in {
            bad = first_non_finite(contents(dq), n);
        }
    }
    if bad >= 0 {
        unbox_slice(heap, lab);
        unbox_slice(heap, d2);
        return (o, t, u, Failed { code: refuse.predict_non_finite(), name: column_word(3), row: bad });
    }
    if code != 0 || n < 1 || k < 1 {
        unbox_slice(heap, lab);
        unbox_slice(heap, d2);
        if code == 0 {
            code = rules.input_empty();
        }
        return (o, t, u, Failed { code: code, name: which, row: 0 });
    }
    // the rows of each cluster, and the position where the rows of a cluster start in the array of distances grouped by cluster, in row order within a cluster
    var sizes = box_slice(heap, k + 1, 0);
    var start = box_slice(heap, k + 2, 0);
    var fill = box_slice(heap, k + 1, 0);
    var grouped = box_slice(heap, n + 1, 0.0);
    var buf = box_slice(heap, 257, 0.0);
    var stk = box_slice(heap, 41, 0.0);
    var lvl = box_slice(heap, 41, 0);
    var inertia = 0.0;
    var means = box_slice(heap, k + 1, 0.0);
    borrow lab as &lr in {
        borrow d2 as &dr in {
            borrow mut sizes as &!sw in {
                var i = 0;
                while i < n {
                    let c = truncate(contents(lr)[i]);
                    if c >= 0 && c < k {
                        contents(sw)[c] = contents(sw)[c] + 1;
                    }
                    i = i + 1;
                }
            }
            borrow sizes as &sr in {
                borrow mut start as &!tw in {
                    var c = 0;
                    while c < k {
                        contents(tw)[c + 1] = contents(tw)[c] + contents(sr)[c];
                        c = c + 1;
                    }
                }
            }
            borrow start as &tr in {
                borrow mut fill as &!fw in {
                    borrow mut grouped as &!gw in {
                        var i = 0;
                        while i < n {
                            let c = truncate(contents(lr)[i]);
                            if c >= 0 && c < k {
                                contents(gw)[contents(tr)[c] + contents(fw)[c]] = sqrt(contents(dr)[i]);
                                contents(fw)[c] = contents(fw)[c] + 1;
                            }
                            i = i + 1;
                        }
                    }
                }
            }
            borrow mut buf as &!bw in {
                borrow mut stk as &!kw in {
                    borrow mut lvl as &!vw in {
                        inertia = sums.reduce(sums.kind_val(), contents(dr)[0..n], contents(dr)[0..n], 0.0, n, contents(bw), contents(kw), contents(vw));
                        borrow sizes as &sr in {
                            borrow start as &tr in {
                                borrow grouped as &gr in {
                                    borrow mut means as &!mw in {
                                        var c = 0;
                                        while c < k {
                                            let cnt = contents(sr)[c];
                                            if cnt > 0 {
                                                let a = contents(tr)[c];
                                                let total = sums.reduce(sums.kind_val(), contents(gr)[a..a + cnt], contents(gr)[a..a + cnt], 0.0, cnt, contents(bw), contents(kw), contents(vw));
                                                contents(mw)[c] = total / float_of(cnt);
                                            }
                                            c = c + 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    let inertia_ok = common.is_finite(inertia);
    o = json.put_key(heap, o, "inertia");
    if inertia_ok {
        o = verbs.put_double(heap, o, bits_of(inertia));
    } else {
        o = json.put_null(heap, o);
        u = buffer.append(heap, u, "inertia,");
    }
    t = buffer.append(heap, t, "inertia ");
    t = list_double(heap, t, inertia, inertia_ok);
    t = buffer.push(heap, t, byte_of(10));
    o = json.put_key(heap, o, "sizes");
    o = json.begin_array(heap, o);
    t = buffer.append(heap, t, "sizes");
    borrow sizes as &sr in {
        var c = 0;
        while c < k {
            o = json.put_int(heap, o, contents(sr)[c]);
            t = buffer.push(heap, t, byte_of(' '));
            t = buffer.push_nat(heap, t, contents(sr)[c]);
            c = c + 1;
        }
    }
    o = json.end_array(heap, o);
    t = buffer.push(heap, t, byte_of(10));
    o = json.put_key(heap, o, "mean_distance");
    o = json.begin_array(heap, o);
    t = buffer.append(heap, t, "mean_distance");
    borrow sizes as &sr in {
        borrow means as &mr in {
            var c = 0;
            while c < k {
                let ok = contents(sr)[c] > 0 && common.is_finite(contents(mr)[c]);
                if ok {
                    o = verbs.put_double(heap, o, bits_of(contents(mr)[c]));
                } else {
                    o = json.put_null(heap, o);
                }
                t = buffer.push(heap, t, byte_of(' '));
                t = list_double(heap, t, contents(mr)[c], ok);
                c = c + 1;
            }
        }
    }
    o = json.end_array(heap, o);
    t = buffer.push(heap, t, byte_of(10));
    unbox_slice(heap, lab);
    unbox_slice(heap, d2);
    unbox_slice(heap, sizes);
    unbox_slice(heap, start);
    unbox_slice(heap, fill);
    unbox_slice(heap, grouped);
    unbox_slice(heap, buf);
    unbox_slice(heap, stk);
    unbox_slice(heap, lvl);
    unbox_slice(heap, means);
    return (o, t, u, fine());
}

// The predictions of the model (weights `wv` or payload `blob`, labels c0 and c1, task 1 regression or 2 classification) on xs, a matrix the stored steps produced,
// and the metrics against `yv` (the targets as doubles). (the object of the metrics as JSON, the lines for --format text, the refusal, if any). `pos` is the label
// precision and the rest are about.
pub fn metrics_block[&h, &x, &y, &w, &b](heap: &!h Heap, kind: int, task: int, xs: &x matrix.Matrix, yv: &y [float], wv: &w [float], blob: &b [byte], c0: int, c1: int, pos: int, cap: int, strict: bool) -> [heap] (buffer.Buffer, buffer.Buffer, buffer.Buffer, Failed) {
    let n = matrix.rows(xs);
    var pred = box_slice(heap, n + 1, 0.0);
    var obj = json.writer(heap, 256);
    obj = json.begin_object(heap, obj);
    var plain = buffer.empty(heap, 64);
    var und = buffer.empty(heap, 16);
    var fl = fine();
    var code = 0;
    borrow mut pred as &!pw in {
        code = predict_into(heap, kind, xs, wv, blob, contents(pw));
    }
    if code != 0 {
        fl = Failed { code: code, name: "predict", row: 0 };
    } else if task == 4 {
        // a clustering has no target: yv is not read; the number of clusters is in c0
        let (o2, p2, u2, f2) = cluster_metrics(heap, obj, plain, und, kind, xs, wv, blob, c0, strict);
        obj = o2;
        plain = p2;
        und = u2;
        fl = f2;
    } else if task == 1 {
        borrow pred as &pr in {
            var bad = 0 - 1;
            if strict {
                bad = first_non_finite(contents(pr), n);
            }
            if bad >= 0 {
                fl = Failed { code: refuse.predict_non_finite(), name: column_word(0), row: bad };
            } else {
                let (o2, p2, u2, f2) = regression_metrics(heap, obj, plain, und, yv[0..n], contents(pr)[0..n], cap);
                obj = o2;
                plain = p2;
                und = u2;
                fl = f2;
            }
        }
    } else {
        var prob = box_slice(heap, n + 1, 0.0);
        borrow mut prob as &!qw in {
            code = proba_into(heap, kind, xs, wv, blob, contents(qw));
        }
        var bad = 0 - 1;
        var badc = 0;
        if code == 0 && strict {
            borrow pred as &pr0 in {
                borrow prob as &qr0 in {
                    let (br, bc) = first_bad_score(2, contents(pr0), contents(qr0), n, false);
                    bad = br;
                    badc = bc;
                }
            }
        }
        if code != 0 {
            fl = Failed { code: code, name: "proba", row: 0 };
        } else if bad >= 0 {
            fl = Failed { code: refuse.predict_non_finite(), name: column_word(badc), row: bad };
        } else {
            var yt = box_slice(heap, n + 1, 0);
            var yp = box_slice(heap, n + 1, 0);
            var score = box_slice(heap, n + 1, 0.0);
            borrow mut yt as &!tw in {
                borrow mut yp as &!pw2 in {
                    borrow mut score as &!sw in {
                        borrow pred as &pr in {
                            borrow prob as &qr in {
                                var i = 0;
                                while i < n {
                                    contents(tw)[i] = truncate(yv[i]);
                                    if contents(pr)[i] > 0.5 {
                                        contents(pw2)[i] = c1;
                                    } else {
                                        contents(pw2)[i] = c0;
                                    }
                                    if pos == c1 {
                                        contents(sw)[i] = contents(qr)[i];
                                    } else {
                                        contents(sw)[i] = 1.0 - contents(qr)[i];
                                    }
                                    i = i + 1;
                                }
                            }
                        }
                    }
                }
            }
            borrow yt as &tr in {
                borrow yp as &pr2 in {
                    borrow score as &sr in {
                        let (o2, p2, u2, f2) = classification_metrics(heap, obj, plain, und, contents(tr)[0..n], contents(pr2)[0..n], contents(sr)[0..n], pos, cap);
                        obj = o2;
                        plain = p2;
                        und = u2;
                        fl = f2;
                    }
                }
            }
            unbox_slice(heap, yt);
            unbox_slice(heap, yp);
            unbox_slice(heap, score);
        }
        unbox_slice(heap, prob);
    }
    unbox_slice(heap, pred);
    obj = json.end_object(heap, obj);
    return (json.finish(obj), plain, und, fl);
}

pub fn feature_names[&h, &s](heap: &!h Heap, sc: &s schema.Schema) -> [heap] names.Names {
    var nm = names.empty(heap);
    var i = 0;
    while i < schema.columns(sc) {
        if i != schema.target(sc) {
            nm = names.add(heap, nm, schema.name(sc, i));
        }
        i = i + 1;
    }
    return nm;
}

// a refusal for a target cell that is empty (row is 1-based among the rows taken)
pub fn empty_target[&h, &n](heap: &!h Heap, errs: fail.Errors, name: &n [byte], row: int) -> [heap] fail.Errors {
    var w = fail.open_in(heap, spec.extra(), "ml.input.non-numeric", "a cell of a kept column is not a number, or is empty", "the target must have a value in every row: remove the row");
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    w = fail.detail_int(heap, w, "row", row);
    w = fail.detail_text(heap, w, "name", name);
    w = fail.detail_str(heap, w, "reason", "empty");
    return fail.add(heap, errs, w);
}

pub fn task_word(task: int) -> [] &static [byte] {
    if task == 2 {
        return "classification";
    }
    if task == 4 {
        return "clustering";
    }
    return "regression";
}
