edition 5;

module ml.est;

// GENERATED by scripts/gen_models.py from lib/models/*/model.toml -- do not edit (docs/modules.md section 3).
// The dispatch of ml over the models wired: one chain of `if kind == N` per operation, one branch per model. Function values and traits are not used
// (docs/modules.md section 1). `kind` is the dispatch key of a model: its kind number, plus 100 for the second of a pair that shares a kind (kind_of gives the
// number a file has). The adapters are the two fixed interfaces of docs/modules.md sections 4 (vector models) and 4b (blob models).

import std.bytes;
import linalg.tensor;
import ml.csvcell;
import models.adapter_forest;
import models.adapter_linear;
import models.adapter_logistic;
import models.adapter_tree;
import models.record;

// whether a file whose model section opens with this kind is one `ml` builds
pub fn wired(kind: int) -> [] bool {
    return kind == 4 || kind == 5 || kind == 7;
}

// the kind a file has for the dispatch key of a model (0 if there is none)
pub fn kind_of(kind: int) -> [] int {
    if kind == 4 {
        return 4;
    }
    if kind == 5 {
        return 5;
    }
    if kind == 7 {
        return 7;
    }
    if kind == 107 {
        return 7;
    }
    return 0;
}

// the dispatch key of the wired model called `name` (0 if there is none)
pub fn kind_named[&n](name: &n [byte]) -> [] int {
    if bytes.equal(name, "linear") {
        return 4;
    }
    if bytes.equal(name, "logistic") {
        return 5;
    }
    if bytes.equal(name, "tree") {
        return 7;
    }
    if bytes.equal(name, "forest") {
        return 107;
    }
    return 0;
}

pub fn name(kind: int) -> [] &static [byte] {
    if kind == 4 {
        return "linear";
    }
    if kind == 5 {
        return "logistic";
    }
    if kind == 7 {
        return "tree";
    }
    if kind == 107 {
        return "forest";
    }
    return "";
}

pub fn tier(kind: int) -> [] &static [byte] {
    if kind == 4 {
        return "supported";
    }
    if kind == 5 {
        return "supported";
    }
    if kind == 7 {
        return "experimental";
    }
    if kind == 107 {
        return "experimental";
    }
    return "";
}

// 1 regression, 2 classification, 3 either (the `task` of the model line, task_of), 0 not a wired model
pub fn task(kind: int) -> [] int {
    if kind == 4 {
        return 1;
    }
    if kind == 5 {
        return 2;
    }
    if kind == 7 {
        return 3;
    }
    if kind == 107 {
        return 3;
    }
    return 0;
}

pub fn nints(kind: int) -> [] int {
    if kind == 4 {
        return 0;
    }
    if kind == 5 {
        return 1;
    }
    if kind == 7 {
        return 5;
    }
    if kind == 107 {
        return 8;
    }
    return 0;
}

pub fn nfloats(kind: int) -> [] int {
    if kind == 4 {
        return 1;
    }
    if kind == 5 {
        return 1;
    }
    if kind == 7 {
        return 0;
    }
    if kind == 107 {
        return 0;
    }
    return 0;
}

// 1 regression or 2 classification: the task of the model whose integer hyperparameters are `ip` (a model of both tasks has it in `task`)
pub fn task_of[&i](kind: int, ip: &i [int]) -> [] int {
    if kind == 7 {
        if ip[0] == 0 {
            return 2;
        }
        return 1;
    }
    if kind == 107 {
        if ip[0] == 0 {
            return 2;
        }
        return 1;
    }
    return task(kind);
}

// whether the model has a hyperparameter called `flag` (the `task` of a model of both tasks is the --task flag, not a hyperparameter flag)
pub fn takes[&f](kind: int, flag: &f [byte]) -> [] bool {
    if kind == 4 {
        if bytes.equal(flag, "l2") {
            return true;
        }
    }
    if kind == 5 {
        if bytes.equal(flag, "iterations") {
            return true;
        }
        if bytes.equal(flag, "l2") {
            return true;
        }
    }
    if kind == 7 {
        if bytes.equal(flag, "max-depth") {
            return true;
        }
        if bytes.equal(flag, "min-leaf") {
            return true;
        }
        if bytes.equal(flag, "bins") {
            return true;
        }
        if bytes.equal(flag, "max-nodes") {
            return true;
        }
    }
    if kind == 107 {
        if bytes.equal(flag, "trees") {
            return true;
        }
        if bytes.equal(flag, "max-depth") {
            return true;
        }
        if bytes.equal(flag, "min-leaf") {
            return true;
        }
        if bytes.equal(flag, "bins") {
            return true;
        }
        if bytes.equal(flag, "mtry") {
            return true;
        }
        if bytes.equal(flag, "bootstrap") {
            return true;
        }
        if bytes.equal(flag, "max-nodes") {
            return true;
        }
    }
    return false;
}

// whether `flag` is a hyperparameter of some wired model (its flag is then a flag of fit)
pub fn hparam_flag[&f](flag: &f [byte]) -> [] bool {
    if bytes.equal(flag, "bins") {
        return true;
    }
    if bytes.equal(flag, "bootstrap") {
        return true;
    }
    if bytes.equal(flag, "iterations") {
        return true;
    }
    if bytes.equal(flag, "l2") {
        return true;
    }
    if bytes.equal(flag, "max-depth") {
        return true;
    }
    if bytes.equal(flag, "max-nodes") {
        return true;
    }
    if bytes.equal(flag, "min-leaf") {
        return true;
    }
    if bytes.equal(flag, "mtry") {
        return true;
    }
    if bytes.equal(flag, "trees") {
        return true;
    }
    return false;
}

// whether the model keeps its fitted state as a byte payload that its adapter builds and reads (the blob interface), not as a vector of floats
pub fn is_blob(kind: int) -> [] bool {
    return kind == 7 || kind == 107;
}

// the least value the command line accepts for the integer hyperparameter flag `name` (the ceiling is in spec.limits())
pub fn hparam_min[&n](name: &n [byte]) -> [] int {
    if bytes.equal(name, "bins") {
        return 2;
    }
    if bytes.equal(name, "bootstrap") {
        return 0;
    }
    if bytes.equal(name, "mtry") {
        return 0;
    }
    return 1;
}

// the value of the token `key=value` after its `=`
fn value_of[&t](tok: &t [byte]) -> [] &t [byte] {
    var i = 0;
    while i < len(tok) && int_of(tok[i]) != '=' {
        i = i + 1;
    }
    if i >= len(tok) {
        return tok[len(tok)..len(tok)];
    }
    return tok[i + 1..len(tok)];
}

// a plan integer (1 to 9 digits, as the plan parser wrote it), or -1
fn int_value[&t](v: &t [byte]) -> [] int {
    if len(v) < 1 || len(v) > 9 {
        return 0 - 1;
    }
    var n = 0;
    var i = 0;
    while i < len(v) {
        let c = int_of(v[i]);
        if c < '0' || c > '9' {
            return 0 - 1;
        }
        n = n * 10 + c - '0';
        i = i + 1;
    }
    return n;
}

// a plan float, as flt.put_float wrote it and ml.csvcell reads it; -1.0 when it is not one (a plan float is never negative)
fn float_value[&t](v: &t [byte]) -> [] float {
    let (st, kind, m, frac, idig, key) = csvcell.read(v);
    if st != 0 {
        return 0.0 - 1.0;
    }
    return csvcell.double(kind, m, frac, key);
}

// whether `value` is a value of the hyperparameter `name`: an integer inside its range, or a finite float of 0 or more
pub fn hparam_ok[&n, &v](name: &n [byte], value: &v [byte]) -> [] bool {
    if bytes.equal(name, "l2") {
        return float_value(value) >= 0.0;
    }
    if bytes.equal(name, "iterations") {
        // the range of an integer is checked by the nat check of the command line (ml.param.out-of-range)
        return true;
    }
    if bytes.equal(name, "max-depth") {
        // the range of an integer is checked by the nat check of the command line (ml.param.out-of-range)
        return true;
    }
    if bytes.equal(name, "min-leaf") {
        // the range of an integer is checked by the nat check of the command line (ml.param.out-of-range)
        return true;
    }
    if bytes.equal(name, "bins") {
        // the range of an integer is checked by the nat check of the command line (ml.param.out-of-range)
        return true;
    }
    if bytes.equal(name, "max-nodes") {
        // the range of an integer is checked by the nat check of the command line (ml.param.out-of-range)
        return true;
    }
    if bytes.equal(name, "trees") {
        // the range of an integer is checked by the nat check of the command line (ml.param.out-of-range)
        return true;
    }
    if bytes.equal(name, "mtry") {
        // the range of an integer is checked by the nat check of the command line (ml.param.out-of-range)
        return true;
    }
    if bytes.equal(name, "bootstrap") {
        // the range of an integer is checked by the nat check of the command line (ml.param.out-of-range)
        return true;
    }
    return false;
}

pub fn diag_len[&i](kind: int, d: int, ip: &i [int]) -> [] int {
    if kind == 4 {
        return adapter_linear.diag_len(d, ip);
    }
    if kind == 5 {
        return adapter_logistic.diag_len(d, ip);
    }
    return 0 - 1;
}

pub fn out_len(kind: int, d: int) -> [] int {
    if kind == 4 {
        return adapter_linear.out_len(d);
    }
    if kind == 5 {
        return adapter_logistic.out_len(d);
    }
    return 0 - 1;
}

pub fn payload_size(kind: int, d: int) -> [] int {
    if kind == 4 {
        return adapter_linear.payload_size(d);
    }
    if kind == 5 {
        return adapter_logistic.payload_size(d);
    }
    return 0 - 1;
}

// 0, or a code of ml.refuse (ml.param.out-of-range for a kind that is not wired)
pub fn fit[&h, &x, &y, &i, &f, &q, &g](heap: &!h Heap, kind: int, threads: int, xt: tensor.Tensor, xd: &x [float], yd: &y [float], ip: &i [int], fp: &f [float], seed: int, out: &!q [float], diag: &!g [float]) -> [heap, conc] int {
    if kind == 4 {
        return adapter_linear.fit(heap, threads, xt, xd, yd, ip, fp, seed, out, diag);
    }
    if kind == 5 {
        return adapter_logistic.fit(heap, threads, xt, xd, yd, ip, fp, seed, out, diag);
    }
    return 8;
}

pub fn predict[&x, &w, &q](kind: int, xt: tensor.Tensor, xd: &x [float], wv: &w [float], out: &!q [float]) -> [] int {
    if kind == 4 {
        return adapter_linear.predict(xt, xd, wv, out);
    }
    if kind == 5 {
        return adapter_logistic.predict(xt, xd, wv, out);
    }
    return 8;
}

pub fn proba[&x, &w, &q](kind: int, xt: tensor.Tensor, xd: &x [float], wv: &w [float], out: &!q [float]) -> [] int {
    if kind == 4 {
        return adapter_linear.proba(xt, xd, wv, out);
    }
    if kind == 5 {
        return adapter_logistic.proba(xt, xd, wv, out);
    }
    return 8;
}

pub fn encode[&b, &w](kind: int, dst: &!b [byte], at: int, d: int, wv: &w [float], c0: int, c1: int) -> [] int {
    if kind == 4 {
        return adapter_linear.encode(dst, at, d, wv, c0, c1);
    }
    if kind == 5 {
        return adapter_logistic.encode(dst, at, d, wv, c0, c1);
    }
    return 0 - 1;
}

pub fn decode[&s, &q](kind: int, src: &s [byte], d: int, out: &!q [float]) -> [] record.Decoded {
    if kind == 4 {
        return adapter_linear.decode(src, d, out);
    }
    if kind == 5 {
        return adapter_logistic.decode(src, d, out);
    }
    return record.decoded(1, 0, 0, 0);
}

// 0, or a code of ml.refuse or of the library (the payload is then empty; ml.param.out-of-range for a kind that has no blob adapter)
pub fn fit_blob[&h, &x, &m, &y, &i, &f](heap: &!h Heap, kind: int, threads: int, xt: tensor.Tensor, xd: &x [float], miss: &m [int], wpc: int, yd: &y [float], ip: &i [int], fp: &f [float], seed: int, c0: int, c1: int, rows_cap: int, cols_cap: int, cells_cap: int) -> [heap, conc] (Box[[byte]], int) {
    if kind == 7 {
        return adapter_tree.fit_blob(heap, threads, xt, xd, miss, wpc, yd, ip, fp, seed, c0, c1, rows_cap, cols_cap, cells_cap);
    }
    if kind == 107 {
        return adapter_forest.fit_blob(heap, threads, xt, xd, miss, wpc, yd, ip, fp, seed, c0, c1, rows_cap, cols_cap, cells_cap);
    }
    return (box_slice(heap, 1, byte_of(0)), 8);
}

pub fn predict_blob[&h, &b, &x, &m, &q](heap: &!h Heap, kind: int, blob: &b [byte], xt: tensor.Tensor, xd: &x [float], miss: &m [int], wpc: int, out: &!q [float]) -> [heap] int {
    if kind == 7 {
        return adapter_tree.predict_blob(heap, blob, xt, xd, miss, wpc, out);
    }
    if kind == 107 {
        return adapter_forest.predict_blob(heap, blob, xt, xd, miss, wpc, out);
    }
    return 8;
}

pub fn proba_blob[&h, &b, &x, &m, &q](heap: &!h Heap, kind: int, blob: &b [byte], xt: tensor.Tensor, xd: &x [float], miss: &m [int], wpc: int, out: &!q [float]) -> [heap] int {
    if kind == 7 {
        return adapter_tree.proba_blob(heap, blob, xt, xd, miss, wpc, out);
    }
    if kind == 107 {
        return adapter_forest.proba_blob(heap, blob, xt, xd, miss, wpc, out);
    }
    return 8;
}

// the payload read and checked: the code, the two labels and in `end` the task (1 regression, 2 classification)
pub fn decode_blob[&h, &s](heap: &!h Heap, kind: int, src: &s [byte], d: int) -> [heap] record.Decoded {
    if kind == 7 {
        return adapter_tree.decode_blob(heap, src, d);
    }
    if kind == 107 {
        return adapter_forest.decode_blob(heap, src, d);
    }
    return record.decoded(1, 0, 0, 0);
}

// The integer and float hyperparameters of the model line, in the order of the manifest, into ip and fp (an enum as the index of its value, in ip). 0, or the place
// (from 1) of the token that is not a value of its kind. `line` is the canonical model line without its LF.
pub fn hparams[&l, &i, &f](kind: int, line: &l [byte], ip: &!i [int], fp: &!f [float]) -> [] int {
    if kind == 4 {
        fp[0] = float_value(value_of(bytes.field(line, ' ', 3)));
        if fp[0] < 0.0 {
            return 1;
        }
        return 0;
    }
    if kind == 5 {
        ip[0] = int_value(value_of(bytes.field(line, ' ', 3)));
        if ip[0] < 0 {
            return 1;
        }
        fp[0] = float_value(value_of(bytes.field(line, ' ', 4)));
        if fp[0] < 0.0 {
            return 2;
        }
        return 0;
    }
    if kind == 7 {
        if bytes.equal(value_of(bytes.field(line, ' ', 3)), "classification") {
            ip[0] = 0;
        } else if bytes.equal(value_of(bytes.field(line, ' ', 3)), "regression") {
            ip[0] = 1;
        } else {
            return 1;
        }
        ip[1] = int_value(value_of(bytes.field(line, ' ', 4)));
        if ip[1] < 0 {
            return 2;
        }
        ip[2] = int_value(value_of(bytes.field(line, ' ', 5)));
        if ip[2] < 0 {
            return 3;
        }
        ip[3] = int_value(value_of(bytes.field(line, ' ', 6)));
        if ip[3] < 0 {
            return 4;
        }
        ip[4] = int_value(value_of(bytes.field(line, ' ', 7)));
        if ip[4] < 0 {
            return 5;
        }
        return 0;
    }
    if kind == 107 {
        if bytes.equal(value_of(bytes.field(line, ' ', 3)), "classification") {
            ip[0] = 0;
        } else if bytes.equal(value_of(bytes.field(line, ' ', 3)), "regression") {
            ip[0] = 1;
        } else {
            return 1;
        }
        ip[1] = int_value(value_of(bytes.field(line, ' ', 4)));
        if ip[1] < 0 {
            return 2;
        }
        ip[2] = int_value(value_of(bytes.field(line, ' ', 5)));
        if ip[2] < 0 {
            return 3;
        }
        ip[3] = int_value(value_of(bytes.field(line, ' ', 6)));
        if ip[3] < 0 {
            return 4;
        }
        ip[4] = int_value(value_of(bytes.field(line, ' ', 7)));
        if ip[4] < 0 {
            return 5;
        }
        ip[5] = int_value(value_of(bytes.field(line, ' ', 8)));
        if ip[5] < 0 {
            return 6;
        }
        ip[6] = int_value(value_of(bytes.field(line, ' ', 9)));
        if ip[6] < 0 {
            return 7;
        }
        ip[7] = int_value(value_of(bytes.field(line, ' ', 10)));
        if ip[7] < 0 {
            return 8;
        }
        return 0;
    }
    return 0 - 1;
}
