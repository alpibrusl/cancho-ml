edition 5;

module ml.app;

// What `ml` and `ml-predict` share (docs/serving.md section 3): the checks of the command line, the paths, the options and the first rule of an
// answer. Each binary has its own `main` (tools/ml/main.cho, tools/ml-predict/main.cho) because the authority of a program is what its `main`
// reaches: `fit` and the log are reached from the first and not from the second. `tool` is 1 for `ml` and 2 for `ml-predict`; `table` is the flag
// table of the binary (spec.flag_table() or spec.predict_flag_table()), the one the command line was parsed with.

import std.buffer;
import std.bytes;
import std.json;
import ml.argv;
import ml.est;
import ml.paths;
import ml.spec;
import ml.splitspec;
import ml.verbs;
import ml.wiredata;
import ml.wire;
import toolbox.cli;
import toolbox.fail;
import toolbox.out;
import toolbox.path;
import toolbox.text;

pub fn version() -> [] &static [byte] {
    return "0.1.0";
}

// no repair, one string of detail
pub fn flag_problem[&h, &m](heap: &!h Heap, e: fail.Errors, rule: &static [byte], message: &m [byte], hint: &static [byte], key: &static [byte], value: &static [byte]) -> [heap] fail.Errors {
    var w = fail.open_in(heap, spec.extra(), rule, message, hint);
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    if len(key) > 0 {
        w = fail.detail_str(heap, w, key, value);
    }
    return fail.add(heap, e, w);
}

// 1 fit, 2 predict, 3 eval, 4 describe, 0 anything else; `ml-predict` (tool 2) knows predict and describe only
pub fn verb_of[&v](text: &v [byte], tool: int) -> [] int {
    if bytes.equal(text, "predict") {
        return 2;
    }
    if bytes.equal(text, "describe") {
        return 4;
    }
    if tool == 1 && bytes.equal(text, "fit") {
        return 1;
    }
    if tool == 1 && bytes.equal(text, "eval") {
        return 3;
    }
    if tool == 1 && bytes.equal(text, "cv") {
        return 5;
    }
    if tool == 1 && bytes.equal(text, "runs") {
        return 6;
    }
    if tool == 1 && bytes.equal(text, "importance") {
        return 7;
    }
    if tool == 1 && bytes.equal(text, "dump") {
        return 8;
    }
    return 0;
}

pub fn verb_name(verb: int) -> [] &static [byte] {
    if verb == 1 {
        return "fit";
    }
    if verb == 2 {
        return "predict";
    }
    if verb == 4 {
        return "describe";
    }
    if verb == 5 {
        return "cv";
    }
    if verb == 6 {
        return "runs";
    }
    if verb == 7 {
        return "importance";
    }
    if verb == 8 {
        return "dump";
    }
    return "eval";
}

pub fn listed[&n](list: &static [byte], name: &n [byte]) -> [] bool {
    var k = 1;
    let count = bytes.count_byte(list, ',') + 1;
    while k <= count {
        if bytes.equal(bytes.field(list, ',', k), name) {
            return true;
        }
        k = k + 1;
    }
    return false;
}

// the flags given that this verb does not take, and the flags it needs and was not given
pub fn check_flags[&h, &cl](heap: &!h Heap, src: &cl [byte], errs: fail.Errors, verb: int, table: &static [byte], tool: int) -> [heap] fail.Errors {
    var e = errs;
    var i = 0;
    while i < cli.entries(table) {
        let name = cli.name_of(table, i);
        if argv.has(src, name) && !listed(spec.allowed(verb), name) {
            var w = fail.open_in(heap, spec.extra(), "args.conflict", "this flag is not one this verb takes", "see the verbs and their flags in introspect usage");
            w = fail.no_repair(heap, w);
            w = fail.detail_open(heap, w);
            w = fail.detail_text(heap, w, "flag", name);
            w = fail.detail_str(heap, w, "verb", verb_name(verb));
            e = fail.add(heap, e, w);
        }
        i = i + 1;
    }
    if verb == 1 || verb == 5 {
        // every model but k-means needs a target; with --plan the model is the plan's and the fit checks the target once the plan is read (wire.fit)
        if !argv.has(src, "target") && !argv.has(src, "plan") && est.task(est.kind_named(argv.text(src, "model"))) != 4 {
            e = flag_problem(heap, e, "args.required-flag", "fit needs --target, the column to predict", "ml fit --target NAME --output MODEL FILE", "flag", "--target");
        }
        if verb == 1 && !argv.has(src, "output") {
            e = flag_problem(heap, e, "args.required-flag", "fit needs --output, where to write the model file", "ml fit --target NAME --output MODEL FILE", "flag", "--output");
        }
        if verb == 5 && !wire.planned(argv.has(src, "plan"), argv.text(src, "model")) {
            e = flag_problem(heap, e, "args.conflict", "cv scores a model fitted through the pipeline: the constant model is not cross-validated", "give --model linear, logistic, tree, forest or kmeans, or --plan", "flag", "--model");
        }
    } else if verb != 5 && verb != 6 && !argv.has(src, "model-file") {
        e = flag_problem(heap, e, "args.required-flag", "this verb needs --model-file, the model to read", "ml predict --model-file MODEL FILE", "flag", "--model-file");
    }
    if verb == 1 || verb == 5 {
        e = cat_flags(heap, src, e, table);
    }
    if tool == 1 && (verb == 1 || verb == 3 || verb == 5) {
        e = splitspec.check_flags(heap, src, e, verb, table);
    }
    if tool == 1 && verb == 7 {
        e = importance_flags(heap, src, e, table);
    }
    if tool == 2 {
        // `ml-predict` has no fit flag to check (wire.check_flags judges the flags of fit and eval)
        return e;
    }
    // cv is judged by the rules of a fit for everything but its own flags (splitspec.check_flags)
    if verb == 5 {
        return wire.check_flags(heap, src, e, 1);
    }
    return wire.check_flags(heap, src, e, verb);
}

// the flags of `importance` that mean something only with --data, and the range of --repeats (docs/interpret.md section 4.1)
pub fn importance_flags[&h, &cl](heap: &!h Heap, src: &cl [byte], errs: fail.Errors, table: &static [byte]) -> [heap] fail.Errors {
    var e = errs;
    if !argv.has(src, "data") {
        if argv.has(src, "metric") {
            e = flag_problem(heap, e, "args.conflict", "this flag needs --data, the file on which the permutation importance is measured", "give --data FILE", "flag", "--metric");
        }
        if argv.has(src, "repeats") {
            e = flag_problem(heap, e, "args.conflict", "this flag needs --data, the file on which the permutation importance is measured", "give --data FILE", "flag", "--repeats");
        }
        if argv.has(src, "seed") {
            e = flag_problem(heap, e, "args.conflict", "this flag needs --data, the file on which the permutation importance is measured", "give --data FILE", "flag", "--seed");
        }
        if argv.has(src, "drop") {
            e = flag_problem(heap, e, "args.conflict", "this flag needs --data, the file on which the permutation importance is measured", "give --data FILE", "flag", "--drop");
        }
        if argv.has(src, "max-work") {
            e = flag_problem(heap, e, "args.conflict", "this flag needs --data, the file on which the permutation importance is measured", "give --data FILE", "flag", "--max-work");
        }
    }
    if argv.has(src, "repeats") {
        let v = argv.nat(src, "repeats");
        if v < 1 || v > 100 {
            var w = fail.open_in(heap, spec.extra(), "ml.param.out-of-range", "a numeric flag is outside its range", "the range is in the detail and in introspect limits");
            w = fail.no_repair(heap, w);
            w = fail.detail_open(heap, w);
            w = fail.detail_str(heap, w, "flag", "repeats");
            w = fail.detail_int(heap, w, "value", v);
            w = fail.detail_int(heap, w, "min", 1);
            w = fail.detail_int(heap, w, "max", 100);
            e = fail.add(heap, e, w);
        }
    }
    return e;
}

// the flags of the categorical columns that fit takes (docs/categorical.md section 2): the limits and --na-values mean something only with --cat, --cat names a column,
// and a marker list holds 1 to 64 markers of 1 to 255 bytes
pub fn cat_flags[&h, &cl](heap: &!h Heap, src: &cl [byte], errs: fail.Errors, table: &static [byte]) -> [heap] fail.Errors {
    var e = errs;
    if argv.has(src, "cat") {
        if len(argv.text(src, "cat")) == 0 {
            e = flag_problem(heap, e, "args.bad-value", "--cat names no column", "give the header names of the text columns, separated by commas", "flag", "--cat");
        }
        if argv.has(src, "na-values") {
            let list = argv.text(src, "na-values");
            let count = bytes.count_byte(list, ',') + 1;
            var k = 1;
            var bad = len(list) == 0 || count > 64;
            while k <= count && !bad {
                let m = bytes.field(list, ',', k);
                if len(m) == 0 || len(m) > 255 {
                    bad = true;
                }
                k = k + 1;
            }
            if bad {
                e = flag_problem(heap, e, "args.bad-value", "--na-values is a list of 1 to 64 markers of 1 to 255 bytes, separated by commas", "a marker holds no comma and is not empty", "flag", "--na-values");
            }
        }
        return e;
    }
    if argv.has(src, "na-values") {
        e = flag_problem(heap, e, "args.conflict", "this flag needs --cat", "name the categorical columns with --cat", "flag", "--na-values");
    }
    if argv.has(src, "max-categories") {
        e = flag_problem(heap, e, "args.conflict", "this flag needs --cat", "name the categorical columns with --cat", "flag", "--max-categories");
    }
    if argv.has(src, "max-string-bytes") {
        e = flag_problem(heap, e, "args.conflict", "this flag needs --cat", "name the categorical columns with --cat", "flag", "--max-string-bytes");
    }
    if argv.has(src, "max-pool-bytes") {
        e = flag_problem(heap, e, "args.conflict", "this flag needs --cat", "name the categorical columns with --cat", "flag", "--max-pool-bytes");
    }
    if argv.has(src, "max-cat-columns") {
        e = flag_problem(heap, e, "args.conflict", "this flag needs --cat", "name the categorical columns with --cat", "flag", "--max-cat-columns");
    }
    return e;
}

// the value of limit `name` in spec.limits(): field 2 is the ceiling's place
pub fn ceiling_of(name: &static [byte]) -> [] int {
    let table = spec.limits();
    let count = bytes.count_byte(table, ';') + 1;
    var k = 1;
    while k <= count {
        let entry = bytes.field(table, ';', k);
        if bytes.equal(bytes.field(entry, '|', 1), name) {
            return cli.parse_nat(bytes.field(entry, '|', 3));
        }
        k = k + 1;
    }
    return 0 - 1;
}

// a nat flag given must be in 1..ceiling (0..ceiling for --from)
pub fn check_nat[&h, &cl](heap: &!h Heap, src: &cl [byte], errs: fail.Errors, table: &static [byte], name: &static [byte], least: int) -> [heap] fail.Errors {
    if !argv.has(src, name) {
        return errs;
    }
    let v = argv.nat(src, name);
    let top = ceiling_of(name);
    if v >= least && v <= top {
        return errs;
    }
    var w = fail.open_in(heap, spec.extra(), "ml.param.out-of-range", "a numeric flag is outside its range", "the range is in the detail and in introspect limits");
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    w = fail.detail_str(heap, w, "flag", name);
    w = fail.detail_int(heap, w, "value", v);
    w = fail.detail_int(heap, w, "min", least);
    w = fail.detail_int(heap, w, "max", top);
    return fail.add(heap, errs, w);
}

pub fn check_nats[&h, &cl](heap: &!h Heap, src: &cl [byte], errs: fail.Errors, flags: &static [byte]) -> [heap] fail.Errors {
    var e = errs;
    let table = spec.limits();
    let count = bytes.count_byte(table, ';') + 1;
    var k = 1;
    while k <= count {
        let name = bytes.field(bytes.field(table, ';', k), '|', 1);
        var least = 1;
        if bytes.equal(name, "from") || bytes.equal(name, "max-out-of-range") || bytes.equal(name, "tree") {
            least = 0;
        }
        if est.hparam_flag(name) {
            least = est.hparam_min(name);
        }
        e = check_nat(heap, src, e, flags, name, least);
        k = k + 1;
    }
    return e;
}

// the rule of the first error, as a buffer (empty when there is none)
pub fn first_rule[&h, &e](heap: &!h Heap, errs: &e fail.Errors) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 32);
    if fail.count(errs) == 0 {
        return out;
    }
    let first = fail.first(errs);
    let key = "\"rule\":\"";
    let at = bytes.find(first, key);
    if at < 0 {
        return out;
    }
    var end = at + len(key);
    while end < len(first) && int_of(first[end]) != '"' {
        end = end + 1;
    }
    return buffer.append(heap, out, first[at + len(key)..end]);
}

// whether the command reads standard input: `predict` with `-` or with no file operand (docs/serving.md section 2); `fit` and `eval` with `-` (docs/jsonl.md section 2)
pub fn stdin_wanted[&cl](src: &cl [byte], verb: int) -> [] bool {
    if verb == 1 || verb == 3 {
        return argv.operand_count(src) == 2 && bytes.equal(argv.operand(src, 1), "-");
    }
    if verb != 2 {
        return false;
    }
    return argv.operand_count(src) == 1 || argv.operand_count(src) == 2 && bytes.equal(argv.operand(src, 1), "-");
}

// the operands of `ml runs`: list DIR, show DIR ID, compare DIR ID ID, verify DIR ID; an id is 64 lowercase hex digits
pub fn runs_operands[&h, &cl](heap: &!h Heap, src: &cl [byte], errs: fail.Errors) -> [heap] fail.Errors {
    var e = errs;
    let n = argv.operand_count(src);
    if n < 2 {
        return flag_problem(heap, e, "args.missing-operand", "runs takes list, show, compare or verify", "ml runs list DIR, ml runs show DIR ID, ml runs compare DIR ID ID, ml runs verify DIR ID", "operand", "SUBCOMMAND");
    }
    let sub = argv.operand(src, 1);
    var want = 0 - 1;
    if bytes.equal(sub, "list") {
        want = 3;
    } else if bytes.equal(sub, "show") || bytes.equal(sub, "verify") {
        want = 4;
    } else if bytes.equal(sub, "compare") {
        want = 5;
    }
    if want < 0 {
        var w = fail.open_in(heap, spec.extra(), "args.unknown-command", "the second operand of runs is not list, show, compare or verify", "ml runs list DIR, ml runs show DIR ID, ml runs compare DIR ID ID, ml runs verify DIR ID");
        w = fail.no_repair(heap, w);
        w = fail.detail_open(heap, w);
        w = fail.detail_text(heap, w, "command", sub);
        return fail.add(heap, e, w);
    }
    if n < want {
        return flag_problem(heap, e, "args.missing-operand", "this runs command needs the directory of the run records and the run ids", "ml runs list DIR, ml runs show DIR ID, ml runs compare DIR ID ID, ml runs verify DIR ID", "operand", "DIR");
    }
    if n > want {
        return flag_problem(heap, e, "args.too-many-operands", "this runs command takes fewer operands", "ml runs list DIR, ml runs show DIR ID, ml runs compare DIR ID ID, ml runs verify DIR ID", "operand", "ID");
    }
    var k = 3;
    while k < want {
        let id = argv.operand(src, k);
        var ok = len(id) == 64;
        var i = 0;
        while ok && i < len(id) {
            let c = int_of(id[i]);
            if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
                ok = false;
            }
            i = i + 1;
        }
        if !ok {
            var w = fail.open_in(heap, spec.extra(), "args.bad-value", "a run id is 64 lowercase hexadecimal digits", "ml runs list DIR names the ids");
            w = fail.no_repair(heap, w);
            w = fail.detail_open(heap, w);
            w = fail.detail_text(heap, w, "id", id);
            e = fail.add(heap, e, w);
        }
        k = k + 1;
    }
    return e;
}

// the verb and the checks of the command line that need no file
pub fn cmdline[&h, &cl](heap: &!h Heap, src: &cl [byte], errs: fail.Errors, table: &static [byte], tool: int) -> [heap] (int, fail.Errors) {
    var e = errs;
    var verb = 0;
    if argv.operand_count(src) == 0 {
        e = flag_problem(heap, e, "args.missing-operand", "ml takes a verb, fit, predict, eval or describe, and the CSV file", "ml fit|predict|eval FILE, ml predict -, ml describe --model-file MODEL", "operand", "VERB");
    } else {
        verb = verb_of(argv.operand(src, 0), tool);
        if verb == 0 {
            var message: &static [byte] = "the first operand is not fit, predict, eval or describe";
            var hint: &static [byte] = "the verbs are fit, predict, eval and describe, and ml introspect and ml skill describe them";
            if tool == 2 {
                message = "the first operand is not predict or describe";
                hint = "ml-predict has the verbs predict and describe, and introspect and skill describe it";
            }
            var w = fail.open_in(heap, spec.extra(), "args.unknown-command", message, hint);
            w = fail.no_repair(heap, w);
            w = fail.detail_open(heap, w);
            w = fail.detail_text(heap, w, "command", argv.operand(src, 0));
            e = fail.add(heap, e, w);
        } else if verb == 4 || verb == 7 || verb == 8 {
            if argv.operand_count(src) > 1 {
                e = flag_problem(heap, e, "args.too-many-operands", "this verb takes no file: it reads the model file named by --model-file", "ml describe|importance|dump --model-file MODEL", "operand", "FILE");
            }
        } else if verb == 6 {
            e = runs_operands(heap, src, e);
        } else if verb == 2 {
            if argv.operand_count(src) > 2 {
                e = flag_problem(heap, e, "args.too-many-operands", "predict takes one CSV file, or - for standard input", "read one file per call", "operand", "FILE");
            }
        } else if argv.operand_count(src) == 1 {
            e = flag_problem(heap, e, "args.missing-operand", "ml takes the CSV file after the verb", "ml fit|predict|eval FILE", "operand", "FILE");
        } else if argv.operand_count(src) > 2 {
            e = flag_problem(heap, e, "args.too-many-operands", "ml takes one CSV file", "read one file per call", "operand", "FILE");
        }
    }
    if verb != 0 {
        e = check_flags(heap, src, e, verb, table, tool);
    }
    e = check_nats(heap, src, e, table);
    return (verb, e);
}

// the four paths a command can name
pub res struct Paths {
    file: paths.Rp,
    model: paths.Rp,
    out: paths.Rp,
    logp: paths.Rp,
    planp: paths.Rp,
    trackp: paths.Rp,
    datap: paths.Rp,
}

// the paths with the data file replaced (the old one is dropped): the CSV of an MCP call that carries its rows
pub fn with_file[&h](heap: &!h Heap, ps: Paths, fresh: paths.Rp) -> [heap] Paths {
    let Paths { file, model, out, logp, planp, trackp, datap } = ps;
    paths.drop(heap, file);
    return Paths { file: fresh, model: model, out: out, logp: logp, planp: planp, trackp: trackp, datap: datap };
}

pub fn drop_paths[&h](heap: &!h Heap, ps: Paths) -> [heap] int {
    let Paths { file, model, out, logp, planp, trackp, datap } = ps;
    paths.drop(heap, file);
    paths.drop(heap, model);
    paths.drop(heap, out);
    paths.drop(heap, planp);
    paths.drop(heap, trackp);
    paths.drop(heap, datap);
    return paths.drop(heap, logp);
}

// the value of --positive (an integer label), 0 when it is not given or not a label
fn positive_value[&cl](src: &cl [byte], table: &static [byte]) -> [] int {
    if !argv.has(src, "positive") {
        return 0;
    }
    let (ok, v) = wiredata.parse_label(argv.text(src, "positive"));
    return v;
}

// the numerator (part 0) or the denominator (part 1) of --split train=F, 0 when it is not given or malformed
fn split_part[&cl](src: &cl [byte], table: &static [byte], part: int) -> [] int {
    if !argv.has(src, "split") {
        return 0;
    }
    let (ok, num, den) = wiredata.parse_split(argv.text(src, "split"));
    if !ok {
        return 0;
    }
    if part == 0 {
        return num;
    }
    return den;
}

// the most rows one `predict` answers with: --limit, or with --output (which writes the file) every row unless --limit was given
fn row_limit[&cl](src: &cl [byte]) -> [] int {
    if argv.has(src, "output") && !argv.has(src, "limit") {
        return 1000000000;
    }
    return argv.nat(src, "limit");
}

pub fn options[&cl](src: &cl [byte], table: &static [byte]) -> [] verbs.Opts {
    var task = 1;
    if bytes.equal(argv.text(src, "task"), "classification") {
        task = 2;
    }
    return verbs.Opts { cap: argv.nat(src, "max-line-bytes"), max_rows: argv.nat(src, "max-rows"), max_cols: argv.nat(src, "max-columns"), max_cells: argv.nat(src, "max-cells"), max_bytes: argv.nat(src, "max-bytes"), limit: row_limit(src), from: argv.nat(src, "from"), overwrite: argv.has(src, "overwrite"), dry: argv.has(src, "dry-run"), drop_given: argv.has(src, "drop"), task: task, plan_given: argv.has(src, "plan"), step_given: argv.has(src, "step"), positive_given: argv.has(src, "positive"), split_given: argv.has(src, "split"), seed: argv.nat(src, "seed"), threads: argv.nat(src, "threads"), threads_given: argv.has(src, "threads"), proba: argv.has(src, "proba"), distance: argv.has(src, "distance"), target_given: argv.has(src, "target"), task_given: argv.has(src, "task"), cat_given: argv.has(src, "cat"), max_cats: argv.nat(src, "max-categories"), max_str: argv.nat(src, "max-string-bytes"), max_pool: argv.nat(src, "max-pool-bytes"), max_catcols: argv.nat(src, "max-cat-columns"), max_oor: argv.nat(src, "max-out-of-range"), max_oor_given: argv.has(src, "max-out-of-range"), drop_mask: 0, float_mask: 0, cat_mask: 0, positive_v: positive_value(src, table), split_num: split_part(src, table, 0), split_den: split_part(src, table, 1), track_given: argv.has(src, "track"), absent_empty: bytes.equal(argv.text(src, "absent"), "empty"), one_group: false };
}

// the errors, and whether there are none
pub fn clean(errs: fail.Errors) -> [] (fail.Errors, bool) {
    var none = false;
    borrow errs as &er in {
        none = fail.count(er) == 0;
    }
    return (errs, none);
}

// resolve the paths the command names, unless the command line is already refused
pub fn resolve_all[&h, &r, &cl](heap: &!h Heap, src: &cl [byte], table: &static [byte], verb: int, root: &r [byte], errs: fail.Errors) -> [heap] (Paths, fail.Errors) {
    let (e0, none) = clean(errs);
    if !none {
        return (Paths { file: paths.absent(heap), model: paths.absent(heap), out: paths.absent(heap), logp: paths.absent(heap), planp: paths.absent(heap), trackp: paths.absent(heap), datap: paths.absent(heap) }, e0);
    }
    // describe has no file operand, and predict reads standard input for `-` or for no operand
    var f2 = paths.absent(heap);
    var e2 = e0;
    if verb != 4 && verb != 7 && verb != 8 && !stdin_wanted(src, verb) {
        var at = 1;
        if verb == 6 {
            at = 2;
        }
        let (fa, ea) = paths.from_operand(heap, src, root, argv.operand_index(src, at), e2);
        paths.drop(heap, f2);
        f2 = fa;
        e2 = ea;
    }
    let (m2, e3) = paths.from_flag(heap, src, table, root, "model-file", e2);
    let (o2, e4) = paths.from_flag(heap, src, table, root, "output", e3);
    let (l2, e5) = paths.from_flag(heap, src, table, root, "log", e4);
    let (p2, e6) = paths.from_flag(heap, src, table, root, "plan", e5);
    let (t2, e7) = paths.from_flag(heap, src, table, root, "track", e6);
    let (d2, e8) = paths.from_flag(heap, src, table, root, "data", e7);
    return (Paths { file: f2, model: m2, out: o2, logp: l2, planp: p2, trackp: t2, datap: d2 }, e8);
}

// whether the first error is none, the exit code of the answer and the rule of the first error as a buffer (empty when there is none). A dry run exits 9.
pub fn outcome[&h, &e](heap: &!h Heap, errs: &e fail.Errors, dry: bool) -> [heap] (bool, int, buffer.Buffer) {
    let rule = first_rule(heap, errs);
    if fail.count(errs) != 0 {
        return (false, fail.exit_code(errs), rule);
    }
    if dry {
        return (true, 9, rule);
    }
    return (true, 0, rule);
}

// the answer: one JSON document on one line, or the plain text with --format text (the envelope names `ml` and `ml.v1` whichever binary writes it)
pub fn respond[&h, &i, &e, &d, &x, &t, &cl](heap: &!h Heap, src: &cl [byte], table: &static [byte], io: &!i Io, errs: &e fail.Errors, payload: &d [byte], extra: &x [byte], plain: &t [byte], dry: bool) -> [heap, io_write, err_write] int {
    var success = 0;
    if dry {
        success = 9;
    }
    return out.respond(heap, io, "ml", "ml.v1", version(), payload, extra, errs, bytes.equal(argv.text(src, "format"), "text"), plain, success);
}

// Standard input for `predict ... -` and `predict ...`: when the command line is clean and the verb reads it, the bytes are read (up to --max-bytes) and take the place of the file operand
pub fn stdin_into[&h, &i, &cl](heap: &!h Heap, src: &cl [byte], table: &static [byte], io: &!i Io, verb: int, ps: Paths, errs: fail.Errors) -> [heap, io_read] (Paths, fail.Errors) {
    let (e0, none) = clean(errs);
    if !none || !stdin_wanted(src, verb) {
        return (ps, e0);
    }
    let Paths { file, model, out, logp, planp, trackp, datap } = ps;
    paths.drop(heap, file);
    let cap = argv.nat(src, "max-bytes");
    let (f2, over) = paths.read_stdin(heap, io, cap);
    var e1 = e0;
    if over {
        var w = fail.open_in(heap, spec.extra(), "limit.input-too-large", "standard input is longer than --max-bytes", "raise --max-bytes, up to the ceiling introspect names, or read a file");
        w = fail.no_repair(heap, w);
        w = fail.detail_open(heap, w);
        w = fail.detail_int(heap, w, "size", cap + 1);
        w = fail.detail_int(heap, w, "max", cap);
        e1 = fail.add(heap, e1, w);
    }
    return (Paths { file: f2, model: model, out: out, logp: logp, planp: planp, trackp: trackp, datap: datap }, e1);
}
