edition 6;

module ml.catcli;

// `ml fit --cat` (docs/categorical.md section 8): the file is read with the loader of categorical columns, so every refusal of the reader and of the limits
// (UTF-8, bytes, categories, pool, columns) is reached from the command line, in the order of the file; and when the read succeeds the fit is refused with
// ml.input.categorical-not-encoded, because no step reads a text column yet (stage 2 of issue 21) and fitting without the column would drop it silently.

import std.buffer;
import std.bytes;
import ml.catmat;
import ml.csv;
import ml.csvload;
import ml.dict;
import ml.logrec;
import ml.matrix;
import ml.mfile;
import ml.paths;
import ml.spec;
import ml.verbs;
import ml.wiredata;
import toolbox.fail;

// the error for a vocabulary that was built and has no consumer: the names, the number of categories of each and the digest of the canonical dump
fn not_encoded[&h, &v](heap: &!h Heap, errs: fail.Errors, voc: &v dict.Vocab) -> [heap] fail.Errors {
    var names = buffer.empty(heap, 32);
    var counts = buffer.empty(heap, 32);
    var c = 0;
    while c < dict.ncols(voc) {
        if c > 0 {
            names = buffer.push(heap, names, byte_of(44));
            counts = buffer.push(heap, counts, byte_of(44));
        }
        names = buffer.append(heap, names, dict.name(voc, c));
        counts = buffer.push_nat(heap, counts, dict.count(voc, c));
        c = c + 1;
    }
    var dumped = dict.dump(heap, voc);
    var hex = buffer.empty(heap, 1);
    borrow dumped as &dr in {
        buffer.drop(heap, hex);
        hex = mfile.sha256_hex(heap, buffer.bytes(dr));
    }
    buffer.drop(heap, dumped);
    var q = fail.open_in(heap, spec.extra(), "ml.input.categorical-not-encoded", "a column named by --cat was read and no step reads text columns yet", "name the column in an encode step (encode column=NAME kind=onehot), which reads text columns from stage 2 of issue 21, or remove it from --cat and drop it with --drop");
    q = fail.no_repair(heap, q);
    q = fail.detail_open(heap, q);
    borrow names as &nr in {
        q = fail.detail_text(heap, q, "columns", buffer.bytes(nr));
    }
    borrow counts as &kr in {
        q = fail.detail_text(heap, q, "categories", buffer.bytes(kr));
    }
    borrow hex as &xr in {
        q = fail.detail_text(heap, q, "vocabulary_sha256", buffer.bytes(xr));
    }
    buffer.drop(heap, names);
    buffer.drop(heap, counts);
    buffer.drop(heap, hex);
    return fail.add(heap, errs, q);
}

pub fn fit[&h, &g, &f, &r, &pf](heap: &!h Heap, args: &g Args, fs: &f Fs(""), root: &r [byte], file: &pf paths.Rp, o: verbs.Opts, errs: fail.Errors, log: buffer.Buffer) -> [heap, args, fs_read(""), dir_read, file_read] verbs.Out {
    var e = errs;
    var lg = log;
    let l = csvload.load_cat(heap, fs, root, paths.shown(file), paths.full(file), verbs.config(o, 0, 0, 0), verbs.cat_config(o), o.target, false, dict.empty_vocab(heap), false);
    let (mx, ids, voc, sh, rep, code) = csvload.cat_load_parts(l);
    borrow sh as &sr in {
        if rep.status == 99 {
            e = fail.io_error(heap, e, rep.aux, false, paths.shown(file));
        } else if rep.status != 0 {
            e = verbs.explain(heap, args, e, rep, sr, o, paths.shown(file));
        } else if code != 0 {
            e = wiredata.code_error(heap, e, code, 0, 0, 0);
        } else if csv.tcol(sr) < 0 {
            var w = fail.open_in(heap, spec.extra(), "ml.input.unknown-column", "--target names a column that is not in the header", "names are compared exactly, byte for byte");
            w = fail.no_repair(heap, w);
            w = fail.detail_open(heap, w);
            w = fail.detail_str(heap, w, "flag", "--target");
            w = fail.detail_text(heap, w, "name", o.target);
            e = fail.add(heap, e, w);
        } else {
            lg = logrec.read(heap, lg, csv.rows(sr), csv.cols(sr), csv.bytes_read(sr));
            borrow voc as &vr in {
                e = not_encoded(heap, e, vr);
            }
        }
    }
    matrix.drop(heap, mx);
    catmat.drop(heap, ids);
    dict.drop_vocab(heap, voc);
    csv.drop_shape(heap, sh);
    return verbs.nothing(heap, e, lg);
}
