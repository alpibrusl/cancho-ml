edition 6;

module ml.catcli;

// `ml fit --cat` (docs/categorical.md section 8): the file is read with the loader of categorical columns, so every refusal of the reader and of the limits
// (UTF-8, bytes, categories, pool, columns) is reached from the command line, in the order of the file; and when the read succeeds the fit is refused with
// ml.input.categorical-not-encoded, because a model without steps (constant) reads no text column and fitting without the column would drop it silently. A planned
// model (linear, logistic) goes through ml.wire, whose steps read the columns (stage 2 of issue 21, docs/categorical-encoders.md).

import std.buffer;
import std.bytes;
import ml.argv;
import ml.catmat;
import ml.catwire;
import pipeline.names;
import ml.csv;
import ml.csvload;
import ml.dict;
import ml.logrec;
import ml.matrix;
import ml.mfile;
import ml.paths;
import ml.spec;
import ml.verbs;
import ml.wiredata;
import toolbox.fail;

// the error for a vocabulary that was built and has no consumer (a model that has no steps: constant): all the declared columns, with the shared text of ml.catwire
fn not_encoded[&h, &v](heap: &!h Heap, errs: fail.Errors, voc: &v dict.Vocab) -> [heap] fail.Errors {
    var nm = catwire.vocab_names(heap, voc);
    var out = errs;
    borrow nm as &nr in {
        out = catwire.not_encoded(heap, out, voc, nr);
    }
    names.drop(heap, nm);
    return out;
}

pub fn fit[&h, &f, &r, &pf, &cl](heap: &!h Heap, src: &cl [byte], fs: &f Fs(""), root: &r [byte], file: &pf paths.Rp, o: verbs.Opts, errs: fail.Errors, log: buffer.Buffer) -> [heap, fs_read(""), dir_read, file_read] verbs.Out {
    var e = errs;
    var lg = log;
    let l = csvload.load_cat_with(heap, src, fs, root, file, verbs.config(o, 0, 0, 0), verbs.cat_config(o), argv.text(src, "target"), false, dict.empty_vocab(heap), false, "");
    let (mx, ids, voc, sh, rep, code) = csvload.cat_load_parts(l);
    borrow sh as &sr in {
        if rep.status == 99 {
            e = fail.io_error(heap, e, rep.aux, false, paths.shown(file));
        } else if rep.status != 0 {
            e = verbs.explain(heap, src, e, rep, sr, o, paths.shown(file));
        } else if code != 0 {
            e = wiredata.code_error(heap, e, code, 0, 0, 0);
        } else if csv.tcol(sr) < 0 {
            var w = fail.open_in(heap, spec.extra(), "ml.input.unknown-column", "--target names a column that is not in the header", "names are compared exactly, byte for byte");
            w = fail.no_repair(heap, w);
            w = fail.detail_open(heap, w);
            w = fail.detail_str(heap, w, "flag", "--target");
            w = fail.detail_text(heap, w, "name", argv.text(src, "target"));
            e = fail.add(heap, e, w);
        } else {
            lg = logrec.read(heap, lg, csv.rows(sr), csv.cols(sr), csv.bytes_read(sr));
            borrow voc as &vr in {
                e = not_encoded(heap, e, vr);
            }
        }
    }
    matrix.drop(heap, mx);
    catmat.drop(heap, ids);
    dict.drop_vocab(heap, voc);
    csv.drop_shape(heap, sh);
    return verbs.nothing(heap, e, lg);
}
