edition 5;

module ml.paths;

// The paths `ml` is given, checked before any builtin sees one (cancho docs/agent-toolbox.md D9): the CSV operand, and the
// values of --model-file, --output and --log. toolbox.path does the lexical checks on an argument by its index, so a path-valued
// flag must be written with its value as an argument of its own (`--output FILE`, not `--output=FILE`): with `=` the value is
// part of the flag's argument and toolbox.path cannot be handed it. `--root` is the exception (toolbox.path.root takes text).
// A path that fails is a rule (path.*), never a trap: spike F found `..` and a missing argument trapping in the builtins.

import std.buffer;
import std.json;
import std.bytes;
import toolbox.cli;
import toolbox.fail;
import toolbox.path;
import ml.argv;
import ml.pathcheck;

// a checked path: the whole path to open, and where the part below --root starts in it. The CSV of `predict` can also be standard input
// (docs/serving.md section 2): `stdin` is then true, `mem` holds the bytes that were read, and the path is shown as `-`.
pub res struct Rp {
    full: buffer.Buffer,
    shown: int,
    present: bool,
    mem: buffer.Buffer,
    stdin: bool,
}

pub fn absent[&h](heap: &!h Heap) -> [heap] Rp {
    return Rp { full: buffer.empty(heap, 1), shown: 0, present: false, mem: buffer.empty(heap, 1), stdin: false };
}

pub fn drop[&h](heap: &!h Heap, r: Rp) -> [heap] int {
    let Rp { full, shown, present, mem, stdin } = r;
    buffer.drop(heap, mem);
    return buffer.drop(heap, full);
}

// an Rp for a path given as text: `full` is what to open, `rel` the part to show (the tail of it); the test drivers and the fits name their file this way
pub fn of_path[&h, &f, &s](heap: &!h Heap, rel: &s [byte], full: &f [byte]) -> [heap] Rp {
    var copy = buffer.empty(heap, len(full) + 1);
    copy = buffer.append(heap, copy, full);
    return Rp { full: copy, shown: len(full) - len(rel), present: true, mem: buffer.empty(heap, 1), stdin: false };
}

// (child) The path of the file `name` in the directory `dir`: the directory's whole path, a slash, the name; shown from the same place as the directory is. A directory named `.` under --root is the
// root itself, and its files are then shown by their names alone.
pub fn child[&h, &r, &n](heap: &!h Heap, dir: &r Rp, name: &n [byte]) -> [heap] Rp {
    let whole = buffer.bytes(dir.full);
    var full = buffer.empty(heap, len(whole) + len(name) + 2);
    full = buffer.append(heap, full, whole);
    var at = dir.shown;
    if len(whole) > 0 && int_of(whole[len(whole) - 1]) != '/' {
        full = buffer.push(heap, full, byte_of('/'));
    }
    let leaf = whole[dir.shown..len(whole)];
    if len(leaf) == 1 && int_of(leaf[0]) == '.' {
        at = len(whole);
        if len(whole) > 0 && int_of(whole[len(whole) - 1]) != '/' {
            at = at + 1;
        }
    }
    full = buffer.append(heap, full, name);
    return Rp { full: full, shown: at, present: true, mem: buffer.empty(heap, 1), stdin: false };
}

pub fn is_stdin[&r](r: &r Rp) -> [] bool {
    return r.stdin;
}

// the bytes read from standard input (empty for a path)
pub fn mem[&r](r: &r Rp) -> [] &r [byte] {
    return buffer.bytes(r.mem);
}

// Read standard input up to `cap` bytes, one `getchar` at a time (the compiler of the pin has no bulk read, docs/serving.md section 2.3). More than `cap` bytes
// is reported to the caller (limit.input-too-large), found as soon as byte cap + 1 arrives, so nothing is kept past the bound. The end of the input, and a read that fails, both end it.
pub fn read_stdin[&h, &i](heap: &!h Heap, io: &!i Io, cap: int) -> [heap, io_read] (Rp, bool) {
    var data = buffer.empty(heap, 65536);
    var n = 0;
    var going = true;
    var over = false;
    while going {
        let c = getchar(io);
        if c < 0 {
            going = false;
        } else if n >= cap {
            over = true;
            going = false;
        } else {
            data = buffer.push(heap, data, byte_of(c));
            n = n + 1;
        }
    }
    var shown = buffer.empty(heap, 2);
    shown = buffer.push(heap, shown, byte_of('-'));
    return (Rp { full: shown, shown: 0, present: true, mem: data, stdin: true }, over);
}

// An Rp over bytes the caller already holds (the server's model file and the CSV text of a request): the representation `predict -` gives standard input, built from a
// slice. `shown` is the name an error shows.
pub fn of_mem[&h, &b, &s](heap: &!h Heap, data: &b [byte], shown: &s [byte]) -> [heap] Rp {
    var copy = buffer.empty(heap, len(data) + 1);
    copy = buffer.append(heap, copy, data);
    var name = buffer.empty(heap, len(shown) + 1);
    name = buffer.append(heap, name, shown);
    return Rp { full: name, shown: 0, present: true, mem: copy, stdin: true };
}

pub fn present[&r](r: &r Rp) -> [] bool {
    return r.present;
}

pub fn full[&r](r: &r Rp) -> [] &r [byte] {
    return buffer.bytes(r.full);
}

pub fn shown[&r](r: &r Rp) -> [] &r [byte] {
    let b = buffer.bytes(r.full);
    return b[r.shown..len(b)];
}

// Whether `p` holds two dots in a row anywhere, `a..b` included. The builtins that take a whole path (open_read, open_dir) trap
// on that, not only on a `..` component, and toolbox.path.has_dotdot looks for the component alone: a path the tool lets through
// would end the process with SIGILL (found by the fuzz, tests/conformance/test_fuzz_args.py). Under --root the tool opens each
// name by itself (toolbox.place), which refuses exactly `..`, so only the root, and a path with no root, need this.
pub fn has_double_dot[&p](p: &p [byte]) -> [] bool {
    return pathcheck.has_double_dot(p);
}

pub fn refuse_double_dot[&h, &p](heap: &!h Heap, errs: fail.Errors, shown: &p [byte], at: int) -> [heap] fail.Errors {
    var w = fail.open(heap, "path.dotdot", "the path holds two dots in a row, which the file builtins refuse", "rename the file so that no name holds two dots in a row, or use --root: under --root only a name that is exactly two dots is refused");
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    w = fail.detail_text(heap, w, "path", shown);
    w = fail.detail_int(heap, w, "position", at);
    return fail.add(heap, errs, w);
}

// A path error as toolbox.path writes it (module toolbox.path, `path_error`): the rule, the message and the hint, a repair that repeats the command line with argument `at`
// replaced when there is a suggestion, the path as it was written and its position. The pinned function reads the process's `Args`; this one reads the packed command line, so that
// a command line that arrives as data is judged by the same rules (docs/mcp.md section 4.1). tests/conformance/test_paths_equal.py compares it with the pinned one over a corpus.
fn path_error[&h, &r, &c, &q](heap: &!h Heap, e: fail.Errors, src: &c [byte], rule: &static [byte], message: &static [byte], hint: &static [byte], at: int, given: &q [byte], repair: &r [byte]) -> [heap] fail.Errors {
    var w = fail.open(heap, rule, message, hint);
    if len(repair) > 0 {
        var rw = fail.retry_open(heap, w);
        var i = 0;
        while i < argv.argc(src) {
            if i == at {
                rw = json.put_string(heap, rw, repair);
            } else {
                rw = json.put_string(heap, rw, argv.at(src, i));
            }
            i = i + 1;
        }
        w = fail.retry_close(heap, rw);
    } else {
        w = fail.no_repair(heap, w);
    }
    w = fail.detail_open(heap, w);
    w = json.put_key(heap, w, "path");
    w = json.put_string(heap, w, given);
    w = json.put_key(heap, w, "position");
    w = json.put_int(heap, w, at);
    return fail.add(heap, e, w);
}

// Check a `--root` value: not empty, no `..`, not too long. Answers the normalised root, empty when there was none or it was refused (toolbox.path.root over text).
pub fn root[&h, &c, &g](heap: &!h Heap, src: &c [byte], given: &g [byte], at: int, errs: fail.Errors) -> [heap] (buffer.Buffer, fail.Errors) {
    var e = errs;
    if at < 0 {
        return (buffer.empty(heap, 1), e);
    }
    if len(given) == 0 {
        e = path_error(heap, e, src, "path.empty", "--root is empty", "", at, given, "");
        return (buffer.empty(heap, 1), e);
    }
    if len(given) > path.longest() {
        e = path_error(heap, e, src, "path.too-long", "--root is longer than 4096 bytes", "", at, given, "");
        return (buffer.empty(heap, 1), e);
    }
    if path.has_dotdot(given) {
        e = path_error(heap, e, src, "path.dotdot", "--root has a `..` component", "name the root without `..`", at, given, "");
        return (buffer.empty(heap, 1), e);
    }
    // no `..` is present, so applying them (path.lexical) changes nothing: this is the normal form of the pinned module
    let (norm, flagged) = path.lexical(heap, given);
    var out = norm;
    var count = 0;
    borrow out as &o in {
        count = buffer.size(o);
    }
    if count == 0 {
        out = buffer.push(heap, out, byte_of('.'));
    }
    return (out, e);
}

// operand `at` (an argument index) under `root`: toolbox.path.operand over the packed command line
pub fn from_operand[&h, &c, &r](heap: &!h Heap, src: &c [byte], root: &r [byte], at: int, errs: fail.Errors) -> [heap] (Rp, fail.Errors) {
    var e = errs;
    let given = argv.at(src, at);
    if len(given) == 0 {
        e = path_error(heap, e, src, "path.empty", "the path is empty", "", at, given, "");
        return (absent(heap), e);
    }
    if len(given) > path.longest() {
        e = path_error(heap, e, src, "path.too-long", "the path is longer than 4096 bytes", "", at, given, "");
        return (absent(heap), e);
    }
    let absolute = int_of(given[0]) == '/';
    if path.has_dotdot(given) {
        let (resolved, climbed) = path.lexical(heap, given);
        var suggestion = buffer.empty(heap, 1);
        borrow resolved as &r2 in {
            let text = buffer.bytes(r2);
            var good = !climbed && len(text) > 0;
            if good && len(root) > 0 && absolute {
                good = false;
            }
            if good {
                suggestion = buffer.append(heap, suggestion, text);
            }
        }
        buffer.drop(heap, resolved);
        borrow suggestion as &s in {
            e = path_error(heap, e, src, "path.dotdot", "the path has a `..` component", "name the file without `..`; the tool does not resolve it, because a symlink makes `a/link/../b` something other than `a/b`", at, given, buffer.bytes(s));
        }
        buffer.drop(heap, suggestion);
        return (absent(heap), e);
    }
    let (norm, flagged) = path.lexical(heap, given);
    if len(root) == 0 {
        var count = 0;
        borrow norm as &n in {
            count = buffer.size(n);
        }
        var out = norm;
        if count == 0 {
            out = buffer.push(heap, out, byte_of('.'));
        }
        return finish(heap, out, 0, true, at, e);
    }
    if absolute {
        var below = 0 - 1;
        var suggestion = buffer.empty(heap, 1);
        borrow norm as &n in {
            let text = buffer.bytes(n);
            below = path.under(root, text);
            if below >= 0 {
                if below < len(text) {
                    suggestion = buffer.append(heap, suggestion, text[below..len(text)]);
                } else {
                    suggestion = buffer.push(heap, suggestion, byte_of('.'));
                }
            }
        }
        buffer.drop(heap, norm);
        if below >= 0 {
            borrow suggestion as &s in {
                e = path_error(heap, e, src, "path.absolute", "the path is absolute, and paths are relative to --root", "write it relative to --root", at, given, buffer.bytes(s));
            }
        } else {
            e = path_error(heap, e, src, "path.outside-root", "the path is not under --root", "name a path inside --root", at, given, "");
        }
        buffer.drop(heap, suggestion);
        return (absent(heap), e);
    }
    var full = buffer.empty(heap, len(root) + len(given) + 2);
    full = buffer.append(heap, full, root);
    if !bytes.equal(root, "/") {
        full = buffer.push(heap, full, byte_of('/'));
    }
    var shown = 0;
    borrow full as &f in {
        shown = buffer.size(f);
    }
    var count = 0;
    borrow norm as &n in {
        count = buffer.size(n);
        full = buffer.append(heap, full, buffer.bytes(n));
    }
    buffer.drop(heap, norm);
    if count == 0 {
        full = buffer.push(heap, full, byte_of('.'));
    }
    return finish(heap, full, shown, false, at, e);
}

// the checked path as an Rp; with no root, two dots in a row anywhere are refused (see has_double_dot)
fn finish[&h](heap: &!h Heap, full: buffer.Buffer, shown: int, root_empty: bool, at: int, errs: fail.Errors) -> [heap] (Rp, fail.Errors) {
    var e = errs;
    var bad = false;
    borrow full as &f in {
        if root_empty && has_double_dot(buffer.bytes(f)) {
            e = refuse_double_dot(heap, e, buffer.bytes(f)[shown..len(buffer.bytes(f))], at);
            bad = true;
        }
    }
    if bad {
        buffer.drop(heap, full);
        return (absent(heap), e);
    }
    return (Rp { full: full, shown: shown, present: true, mem: buffer.empty(heap, 1), stdin: false }, e);
}

// the value of flag `name`, if it was given, as a path under `root`
pub fn from_flag[&h, &r, &cl](heap: &!h Heap, src: &cl [byte], table: &static [byte], root: &r [byte], name: &static [byte], errs: fail.Errors) -> [heap] (Rp, fail.Errors) {
    if !argv.has(src, name) {
        return (absent(heap), errs);
    }
    if !argv.value_is_whole(src, name) {
        var w = fail.open(heap, "args.bad-value", "a path-valued flag takes its value as a separate argument", "write the flag and its value as two arguments");
        w = fail.no_repair(heap, w);
        w = fail.detail_open(heap, w);
        w = fail.detail_str(heap, w, "flag", name);
        w = fail.detail_str(heap, w, "expected", "the value as the next argument, not after an equals sign");
        return (absent(heap), fail.add(heap, errs, w));
    }
    return from_operand(heap, src, root, argv.value_index(src, name), errs);
}
