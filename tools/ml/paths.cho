edition 5;

module ml.paths;

// The paths `ml` is given, checked before any builtin sees one (cancho docs/agent-toolbox.md D9): the CSV operand, and the
// values of --model-file, --output and --log. toolbox.path does the lexical checks on an argument by its index, so a path-valued
// flag must be written with its value as an argument of its own (`--output FILE`, not `--output=FILE`): with `=` the value is
// part of the flag's argument and toolbox.path cannot be handed it. `--root` is the exception (toolbox.path.root takes text).
// A path that fails is a rule (path.*), never a trap: spike F found `..` and a missing argument trapping in the builtins.

import std.buffer;
import std.json;
import toolbox.cli;
import toolbox.fail;
import toolbox.path;
import ml.pathcheck;

// a checked path: the whole path to open, and where the part below --root starts in it. The CSV of `predict` can also be standard input
// (docs/serving.md section 2): `stdin` is then true, `mem` holds the bytes that were read, and the path is shown as `-`.
pub res struct Rp {
    full: buffer.Buffer,
    shown: int,
    present: bool,
    mem: buffer.Buffer,
    stdin: bool,
    raw: buffer.Buffer,
    rawsize: int,
}

pub fn absent[&h](heap: &!h Heap) -> [heap] Rp {
    return Rp { full: buffer.empty(heap, 1), shown: 0, present: false, mem: buffer.empty(heap, 1), stdin: false, raw: buffer.empty(heap, 1), rawsize: 0 };
}

pub fn drop[&h](heap: &!h Heap, r: Rp) -> [heap] int {
    let Rp { full, shown, present, mem, stdin, raw, rawsize } = r;
    buffer.drop(heap, mem);
    buffer.drop(heap, raw);
    return buffer.drop(heap, full);
}

// an Rp for a path given as text: `full` is what to open, `rel` the part to show (the tail of it); the test drivers and the fits name their file this way
pub fn of_path[&h, &f, &s](heap: &!h Heap, rel: &s [byte], full: &f [byte]) -> [heap] Rp {
    var copy = buffer.empty(heap, len(full) + 1);
    copy = buffer.append(heap, copy, full);
    return Rp { full: copy, shown: len(full) - len(rel), present: true, mem: buffer.empty(heap, 1), stdin: false, raw: buffer.empty(heap, 1), rawsize: 0 };
}

// (child) The path of the file `name` in the directory `dir`: the directory's whole path, a slash, the name; shown from the same place as the directory is. A directory named `.` under --root is the
// root itself, and its files are then shown by their names alone.
pub fn child[&h, &r, &n](heap: &!h Heap, dir: &r Rp, name: &n [byte]) -> [heap] Rp {
    let whole = buffer.bytes(dir.full);
    var full = buffer.empty(heap, len(whole) + len(name) + 2);
    full = buffer.append(heap, full, whole);
    var at = dir.shown;
    if len(whole) > 0 && int_of(whole[len(whole) - 1]) != '/' {
        full = buffer.push(heap, full, byte_of('/'));
    }
    let leaf = whole[dir.shown..len(whole)];
    if len(leaf) == 1 && int_of(leaf[0]) == '.' {
        at = len(whole);
        if len(whole) > 0 && int_of(whole[len(whole) - 1]) != '/' {
            at = at + 1;
        }
    }
    full = buffer.append(heap, full, name);
    return Rp { full: full, shown: at, present: true, mem: buffer.empty(heap, 1), stdin: false, raw: buffer.empty(heap, 1), rawsize: 0 };
}

pub fn is_stdin[&r](r: &r Rp) -> [] bool {
    return r.stdin;
}

// the bytes read from standard input (empty for a path)
pub fn mem[&r](r: &r Rp) -> [] &r [byte] {
    return buffer.bytes(r.mem);
}

// Read standard input up to `cap` bytes, one `getchar` at a time (the compiler of the pin has no bulk read, docs/serving.md section 2.3). More than `cap` bytes
// is reported to the caller (limit.input-too-large), found as soon as byte cap + 1 arrives, so nothing is kept past the bound. The end of the input, and a read that fails, both end it.
pub fn read_stdin[&h, &i](heap: &!h Heap, io: &!i Io, cap: int) -> [heap, io_read] (Rp, bool) {
    var data = buffer.empty(heap, 65536);
    var n = 0;
    var going = true;
    var over = false;
    while going {
        let c = getchar(io);
        if c < 0 {
            going = false;
        } else if n >= cap {
            over = true;
            going = false;
        } else {
            data = buffer.push(heap, data, byte_of(c));
            n = n + 1;
        }
    }
    var shown = buffer.empty(heap, 2);
    shown = buffer.push(heap, shown, byte_of('-'));
    return (Rp { full: shown, shown: 0, present: true, mem: data, stdin: true, raw: buffer.empty(heap, 1), rawsize: 0 }, over);
}

// An Rp over bytes the caller already holds (the server's model file and the CSV text of a request): the representation `predict -` gives standard input, built from a
// slice. `shown` is the name an error shows.
pub fn of_mem[&h, &b, &s](heap: &!h Heap, data: &b [byte], shown: &s [byte]) -> [heap] Rp {
    var copy = buffer.empty(heap, len(data) + 1);
    copy = buffer.append(heap, copy, data);
    var name = buffer.empty(heap, len(shown) + 1);
    name = buffer.append(heap, name, shown);
    return Rp { full: name, shown: 0, present: true, mem: copy, stdin: true, raw: buffer.empty(heap, 1), rawsize: 0 };
}

// `file` with the SHA-256 (32 raw bytes) and the size of the bytes the user gave: for an input that was converted to the CSV in `mem` (JSON lines), what the identity of the
// input is, since the run record and the provenance of a model name the file or the standard input and not the CSV made of it (docs/jsonl.md section 4)
pub fn with_raw[&h, &d](heap: &!h Heap, file: Rp, digest: &d [byte], size: int) -> [heap] Rp {
    let Rp { full, shown, present, mem, stdin, raw, rawsize } = file;
    buffer.drop(heap, raw);
    var copy = buffer.empty(heap, len(digest) + 1);
    copy = buffer.append(heap, copy, digest);
    return Rp { full: full, shown: shown, present: present, mem: mem, stdin: stdin, raw: copy, rawsize: size };
}

// the digest set by with_raw (empty when none) and the size it stands for
pub fn raw_digest[&r](r: &r Rp) -> [] &r [byte] {
    return buffer.bytes(r.raw);
}

pub fn raw_size[&r](r: &r Rp) -> [] int {
    return r.rawsize;
}

pub fn present[&r](r: &r Rp) -> [] bool {
    return r.present;
}

pub fn full[&r](r: &r Rp) -> [] &r [byte] {
    return buffer.bytes(r.full);
}

pub fn shown[&r](r: &r Rp) -> [] &r [byte] {
    let b = buffer.bytes(r.full);
    return b[r.shown..len(b)];
}

// Whether `p` holds two dots in a row anywhere, `a..b` included. The builtins that take a whole path (open_read, open_dir) trap
// on that, not only on a `..` component, and toolbox.path.has_dotdot looks for the component alone: a path the tool lets through
// would end the process with SIGILL (found by the fuzz, tests/conformance/test_fuzz_args.py). Under --root the tool opens each
// name by itself (toolbox.place), which refuses exactly `..`, so only the root, and a path with no root, need this.
pub fn has_double_dot[&p](p: &p [byte]) -> [] bool {
    return pathcheck.has_double_dot(p);
}

pub fn refuse_double_dot[&h, &p](heap: &!h Heap, errs: fail.Errors, shown: &p [byte], at: int) -> [heap] fail.Errors {
    var w = fail.open(heap, "path.dotdot", "the path holds two dots in a row, which the file builtins refuse", "rename the file so that no name holds two dots in a row, or use --root: under --root only a name that is exactly two dots is refused");
    w = fail.no_repair(heap, w);
    w = fail.detail_open(heap, w);
    w = fail.detail_text(heap, w, "path", shown);
    w = fail.detail_int(heap, w, "position", at);
    return fail.add(heap, errs, w);
}

// operand `at` (an argument index) under `root`
pub fn from_operand[&h, &g, &r](heap: &!h Heap, args: &g Args, root: &r [byte], at: int, errs: fail.Errors) -> [heap, args] (Rp, fail.Errors) {
    let (resolved, e) = path.operand(heap, args, root, at, errs);
    var out = absent(heap);
    var e2 = e;
    borrow resolved as &rr in {
        if path.ok(rr) {
            let f = path.full(rr);
            let s = path.shown(rr);
            if len(root) == 0 && has_double_dot(f) {
                e2 = refuse_double_dot(heap, e2, s, at);
            } else {
                drop(heap, out);
                var copy = buffer.empty(heap, len(f) + 1);
                copy = buffer.append(heap, copy, f);
                out = Rp { full: copy, shown: len(f) - len(s), present: true, mem: buffer.empty(heap, 1), stdin: false, raw: buffer.empty(heap, 1), rawsize: 0 };
            }
        }
    }
    path.drop(heap, resolved);
    return (out, e2);
}

// the value of flag `name`, if it was given, as a path under `root`
pub fn from_flag[&h, &g, &p, &r](heap: &!h Heap, args: &g Args, parsed: &p cli.Parsed, table: &static [byte], root: &r [byte], name: &static [byte], errs: fail.Errors) -> [heap, args] (Rp, fail.Errors) {
    if !cli.has(parsed, table, name) {
        return (absent(heap), errs);
    }
    if !cli.value_is_whole(parsed, table, name) {
        var w = fail.open(heap, "args.bad-value", "a path-valued flag takes its value as a separate argument", "write the flag and its value as two arguments");
        w = fail.no_repair(heap, w);
        w = fail.detail_open(heap, w);
        w = fail.detail_str(heap, w, "flag", name);
        w = fail.detail_str(heap, w, "expected", "the value as the next argument, not after an equals sign");
        return (absent(heap), fail.add(heap, errs, w));
    }
    return from_operand(heap, args, root, cli.value_index(parsed, table, name), errs);
}
