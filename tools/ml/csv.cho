edition 5;

module ml.csv;

// The CSV reader (docs/reader.md section 2). Cells are read by ml.csvcell (the CLI slice's exact grammar for ints and short decimals,
// cancho-table's `flt.parse_float` for everything else: a pinned package dependency, not copied); records are RFC 4180, split by cancho-table's
// `reader` module:
//
// * the first non-blank record is the header; a UTF-8 byte order mark on the first line is dropped; a CR before the LF is dropped; a
//   blank line outside a quote is not a record; a quoted field may hold commas, doubled quotes and line breaks, and a record that spans
//   lines is assembled in a buffer bounded by the line cap;
// * one function, `scan`, reads the file one record at a time in bounded memory (the line cap, the header, the field offsets of a
//   record, four ints per column) and, in the modes of `Cfg`, folds the target column into exact accumulators or writes every kept cell
//   into a matrix while it reads. Every limit is checked on the way, before the thing it limits is built.

import std.buffer;
import std.bytes;
import std.vec;
import ml.bucket;
import ml.catmat;
import ml.csvcell;
import ml.dict;
import ml.exact;
import ml.refuse;
import ml.fsq;
import ml.matrix;
import facc;
import reader;
import toolbox.lines;

// A column holds 12 digits at most as an exact int or dec: its mantissa is below 10^12. A column that needs more is a float.
pub fn digits_max() -> [] int {
    return 12;
}

// what `scan` does besides inferring the shape: 0 nothing (fit pass 1; the loader's pass 1), 1 fit a regression of an int or dec target
// (sum it at scale `tscale`), 2 fit a classification (count the target's values), 3 eval a regression of an int or dec target (sum the
// squared errors against `pred`, a prediction at scale `tscale` + 6), 4 eval a classification (count the rows whose target is `pred`),
// 5 predict (the target column, if present, is skipped: its cells are not read), 6 fit a regression of a float target (the exact
// sum of the doubles in `fv`, the count in acc[2]), 7 eval a regression of a float target (the exact sum of (y - P)^2 in `acc`, P the
// double whose bits are `pred`), 8 load every kept cell into the matrix of the sinks (rows `mrows`, words per column `wpc`), 9 the same
// but the target column (if the file has one) is neither read nor loaded: it is not a column of the matrix (predict of a planned model, docs/wiring.md).
// `missing`: an empty cell is a missing value (the loader), else it is ml.input.non-numeric. `floats`: columns read as float whatever
// their cells are (--float).
pub struct Cfg {
    cap: int,
    max_rows: int,
    max_cols: int,
    max_cells: int,
    mode: int,
    tscale: int,
    pred: int,
    // the columns of the header, by position, that --drop and --float name: bit j for column j below 62. A runtime list cannot be a field of this structure (it holds `static` text), so a replay of
    // a recorded fit (ml runs verify) turns the names of the record into positions of the header before it reads, and the reader ORs them in
    drop_mask: int,
    float_mask: int,
    missing: bool,
    mrows: int,
    mcols: int,
    wpc: int,
}

// what stopped the scan: 0 nothing, 1 no header, 2 line too long (aux: its length; a record that spans lines counts as one line),
// 3 ragged row, 5 a name twice or empty (col: the second), 6 too many columns (aux: the count), 7 too many rows, 8 a cell that is not
// a number (aux: 1 empty, 2 not a number, 3 non-zero and would read as zero, 4 longer than 1,100 bytes), 9 non-finite (aux: 0 nan or
// inf, 1 past the range of a double), 11 read failed (aux: errno), 12 --drop names a column that is not there (aux: its place in the
// list, from 1), 13 too many cells, 14 the target is dropped, 15 the file is not what the first pass saw (a cell does not fit the
// scale, or there are more rows than the matrix has), 16 a classification target with a third value, 17 a quote closed and followed
// by something that is not a comma (line), 18 a quote still open at the end of the file (line: where the record began), 19 --float
// names a column that is not there (aux: its place in the list), 20 a cell of a categorical column is not UTF-8 (aux: the offset of the first bad
// byte in the cell), 21 a cell of one is longer than the limit (aux: its length), 22 a categorical column has more strings than the limit (aux: the limit),
// 23 the pool of all the categories would pass its limit (aux: the size it would have), 24 more categorical columns than the limit (aux: how many), 25 --cat
// names a column that is not there (aux: its place in the list), 26 a categorical column is dropped (col), 27 it is the target (col), 28 it is also in
// --float (col), 29 a column of the stored vocabulary is not in the file (aux: its place, from 1), 30 the parameters of the dictionary are out of range
// (aux: the code of ml.refuse). docs/categorical.md section 5
pub struct Report {
    status: int,
    line: int,
    col: int,
    aux: int,
}

// The categorical part of a scan (docs/categorical.md): `cols` the names given to --cat (fit; ignored when a vocabulary is given), `na` the
// markers of --na-values (comma separated, none empty), the four limits, and `lenient`: with a stored vocabulary, a column of the vocabulary that the file lacks (or drops) is
// not a refusal of the reader (status 29) but of the caller's schema check, which names it with the other missing and extra columns (docs/stringtable.md section 5).
// `no_cats()` is the numeric-only reader.
pub struct CatCfg {
    // the categorical columns by position in the header (bit j for column j below 62), as drop_mask of Cfg
    cat_mask: int,
    max_cats: int,
    max_str: int,
    max_pool: int,
    max_catcols: int,
    lenient: bool,
}

// The texts of the command line that a scan reads, in one slice (docs/mcp.md section 4.1): the target, --drop, --float, --cat and --na-values, each NUL-terminated, in this order.
// A text is not a field of Cfg or CatCfg: those hold no reference, and a command line that arrives as data has no `static` text to give.
pub fn text_of[&x](tx: &x [byte], k: int) -> [] &x [byte] {
    var from = 0;
    var seen = 0;
    while seen < k && from < len(tx) {
        if int_of(tx[from]) == 0 {
            seen = seen + 1;
        }
        from = from + 1;
    }
    var to = from;
    while to < len(tx) && int_of(tx[to]) != 0 {
        to = to + 1;
    }
    return tx[from..to];
}

// the slice of those texts: the target, then the lists of --drop, --float, --cat and --na-values
pub fn texts[&h, &t, &d, &f, &c, &n](heap: &!h Heap, target: &t [byte], drops: &d [byte], floats: &f [byte], cats: &c [byte], na: &n [byte]) -> [heap] buffer.Buffer {
    var b = buffer.empty(heap, len(target) + len(drops) + len(floats) + len(cats) + len(na) + 8);
    b = buffer.append(heap, b, target);
    b = buffer.push(heap, b, byte_of(0));
    b = buffer.append(heap, b, drops);
    b = buffer.push(heap, b, byte_of(0));
    b = buffer.append(heap, b, floats);
    b = buffer.push(heap, b, byte_of(0));
    b = buffer.append(heap, b, cats);
    b = buffer.push(heap, b, byte_of(0));
    b = buffer.append(heap, b, na);
    return buffer.push(heap, b, byte_of(0));
}

pub fn no_cats() -> [] CatCfg {
    return CatCfg { cat_mask: 0, max_cats: dict.default_categories(), max_str: dict.default_string_bytes(), max_pool: dict.default_pool_bytes(), max_catcols: dict.default_columns(), lenient: false };
}

// What the categorical part of a scan holds. kind: 0 none (the numeric reader), 1 BUILD (pass 1 of a fit: the strings go into `bld`), 2 LOOKUP (pass 2
// of a fit: the ids are looked up in `voc`, a string not found means the file changed), 3 PREDICT (every pass of a predict: looked up in the stored `voc`,
// a string it does not hold is -2 and counted in `unseen` by the pass that writes). Pass 2 writes `ids` (crows x ncat) and the bitmap `cmiss` (cwpc words a column).
pub res struct CatState {
    kind: int,
    bld: dict.Dict,
    voc: dict.Vocab,
    ids: Box[[int]],
    cmiss: Box[[int]],
    unseen: Box[[int]],
    ncat: int,
    crows: int,
    cwpc: int,
    // the markers of a stored model (docs/stringtable.md section 2) beside cc.na, and the scratch of the digest a hashed column is read with (section 5)
    nab: Box[[byte]],
    hst: Box[[int]],
    hdg: Box[[byte]],
}

pub fn off_state[&h](heap: &!h Heap) -> [heap] CatState {
    return CatState { kind: 0, bld: dict.empty_dict(heap), voc: dict.empty_vocab(heap), ids: box_slice(heap, 1, 0), cmiss: box_slice(heap, 1, 0), unseen: box_slice(heap, 1, 0), ncat: 0, crows: 0, cwpc: 0, nab: box_slice(heap, 1, byte_of(0)), hst: box_slice(heap, bucket.state_len(), 0), hdg: box_slice(heap, 32, byte_of(0)) };
}

// pass 1 of a fit: the strings of the columns named in cfg are interned
pub fn build_state[&h](heap: &!h Heap) -> [heap] CatState {
    return CatState { kind: 1, bld: dict.empty_dict(heap), voc: dict.empty_vocab(heap), ids: box_slice(heap, 1, 0), cmiss: box_slice(heap, 1, 0), unseen: box_slice(heap, 1, 0), ncat: 0, crows: 0, cwpc: 0, nab: box_slice(heap, 1, byte_of(0)), hst: box_slice(heap, bucket.state_len(), 0), hdg: box_slice(heap, 32, byte_of(0)) };
}

// a lookup state over the vocabulary `v` (consumed). kind 2 or 3. `ids` etc. are those of ml.catmat.parts (empty boxes for a pass that writes nothing)
pub fn lookup_state[&h](heap: &!h Heap, kind: int, v: dict.Vocab, ids: Box[[int]], cmiss: Box[[int]], unseen: Box[[int]], ncat: int, crows: int, cwpc: int) -> [heap] CatState {
    return CatState { kind: kind, bld: dict.empty_dict(heap), voc: v, ids: ids, cmiss: cmiss, unseen: unseen, ncat: ncat, crows: crows, cwpc: cwpc, nab: box_slice(heap, 1, byte_of(0)), hst: box_slice(heap, bucket.state_len(), 0), hdg: box_slice(heap, 32, byte_of(0)) };
}

// the state with the markers of a stored model (the bytes of the --na-values list; the state keeps its own copy)
pub fn set_markers[&h, &n](heap: &!h Heap, k: CatState, na: &n [byte]) -> [heap] CatState {
    let CatState { kind, bld, voc, ids, cmiss, unseen, ncat, crows, cwpc, nab, hst, hdg } = k;
    unbox_slice(heap, nab);
    var copy = box_slice(heap, len(na) + 1, byte_of(0));
    borrow mut copy as &!cw in {
        var i = 0;
        while i < len(na) {
            contents(cw)[i] = na[i];
            i = i + 1;
        }
    }
    return CatState { kind: kind, bld: bld, voc: voc, ids: ids, cmiss: cmiss, unseen: unseen, ncat: ncat, crows: crows, cwpc: cwpc, nab: copy, hst: hst, hdg: hdg };
}

pub fn drop_state[&h](heap: &!h Heap, k: CatState) -> [heap] int {
    let CatState { kind, bld, voc, ids, cmiss, unseen, ncat, crows, cwpc, nab, hst, hdg } = k;
    dict.drop(heap, bld);
    dict.drop_vocab(heap, voc);
    unbox_slice(heap, ids);
    unbox_slice(heap, cmiss);
    unbox_slice(heap, unseen);
    unbox_slice(heap, nab);
    unbox_slice(heap, hst);
    unbox_slice(heap, hdg);
    return kind;
}

// the pieces: (kind, builder, vocabulary, ids, bitmap, unseen counts)
pub fn state_parts[&h](heap: &!h Heap, k: CatState) -> [heap] (int, dict.Dict, dict.Vocab, Box[[int]], Box[[int]], Box[[int]]) {
    let CatState { kind, bld, voc, ids, cmiss, unseen, ncat, crows, cwpc, nab, hst, hdg } = k;
    unbox_slice(heap, nab);
    unbox_slice(heap, hst);
    unbox_slice(heap, hdg);
    return (kind, bld, voc, ids, cmiss, unseen);
}

// What a scan writes into besides the shape: `acc` (8 ints, or `fsq.size()` for mode 7), `fv` (the 73 ints of a facc sum, for mode 6),
// and the matrix pieces of ml.matrix (`data`, `miss`, for mode 8). Boxes of one element when a mode needs none.
pub res struct Sinks {
    acc: Box[[int]],
    fv: vec.Vec[int],
    data: Box[[float]],
    miss: Box[[int]],
}

pub fn sinks[&h](heap: &!h Heap, acc_len: int, wide: bool, data: Box[[float]], miss: Box[[int]]) -> [heap] Sinks {
    var fv = vec.empty(heap, facc.width() + 1, 0);
    if wide {
        var i = 0;
        while i < facc.width() {
            fv = vec.push(heap, fv, 0);
            i = i + 1;
        }
    }
    return Sinks { acc: box_slice(heap, acc_len, 0), fv: fv, data: data, miss: miss };
}

// sinks that hold nothing but an `acc_len` accumulator (and the 73 ints of a float sum when `wide`)
pub fn plain_sinks[&h](heap: &!h Heap, acc_len: int, wide: bool) -> [heap] Sinks {
    return sinks(heap, acc_len, wide, box_slice(heap, 1, 0.0), box_slice(heap, 1, 0));
}

pub fn drop_sinks[&h](heap: &!h Heap, k: Sinks) -> [heap] int {
    let Sinks { acc, fv, data, miss } = k;
    unbox_slice(heap, acc);
    vec.drop(heap, fv);
    unbox_slice(heap, data);
    unbox_slice(heap, miss);
    return 0;
}

// accumulator slot i of sinks (read-only)
pub fn acc_at[&s](k: &s Sinks, i: int) -> [] int {
    return contents(k.acc)[i];
}

// the pieces of sinks, and back
pub fn sink_parts(k: Sinks) -> [] (Box[[int]], vec.Vec[int], Box[[float]], Box[[int]]) {
    let Sinks { acc, fv, data, miss } = k;
    return (acc, fv, data, miss);
}

pub fn sink_join(acc: Box[[int]], fv: vec.Vec[int], data: Box[[float]], miss: Box[[int]]) -> [] Sinks {
    return Sinks { acc: acc, fv: fv, data: data, miss: miss };
}

// per column i of `cols`: cells[i] kind (0 no cell yet, 1 int, 2 dec, 3 float, 4 categorical), cells[cols + i] scale, cells[2 cols + i] the most
// integer digits, cells[3 cols + i] 1 if dropped, cells[4 cols + i] 0, or 1 + the place of the column among the categorical ones (file order)
pub res struct Shape {
    names: buffer.Buffer,
    ends: vec.Vec[int],
    cells: Box[[int]],
    cols: int,
    rows: int,
    // the column of cfg.target, -1 if there is none
    tcol: int,
    bytes: int,
}

pub fn drop_shape[&h](heap: &!h Heap, s: Shape) -> [heap] int {
    let Shape { names, ends, cells, cols, rows, tcol, bytes } = s;
    buffer.drop(heap, names);
    vec.drop(heap, ends);
    unbox_slice(heap, cells);
    return rows;
}

pub fn empty_shape[&h](heap: &!h Heap) -> [heap] Shape {
    return Shape { names: buffer.empty(heap, 1), ends: vec.empty(heap, 1, 0), cells: box_slice(heap, 1, 0), cols: 0, rows: 0, tcol: 0 - 1, bytes: 0 };
}

pub fn cols[&s](sh: &s Shape) -> [] int {
    return sh.cols;
}

pub fn rows[&s](sh: &s Shape) -> [] int {
    return sh.rows;
}

pub fn tcol[&s](sh: &s Shape) -> [] int {
    return sh.tcol;
}

pub fn bytes_read[&s](sh: &s Shape) -> [] int {
    return sh.bytes;
}

pub fn name[&s](sh: &s Shape, i: int) -> [] &s [byte] {
    let b = buffer.bytes(sh.names);
    var from = 0;
    if i > 0 {
        from = vec.get(sh.ends, i - 1);
    }
    return b[from..vec.get(sh.ends, i)];
}

pub fn kind[&s](sh: &s Shape, i: int) -> [] int {
    return contents(sh.cells)[i];
}

pub fn scale[&s](sh: &s Shape, i: int) -> [] int {
    return contents(sh.cells)[sh.cols + i];
}

pub fn intd[&s](sh: &s Shape, i: int) -> [] int {
    return contents(sh.cells)[2 * sh.cols + i];
}

pub fn dropped[&s](sh: &s Shape, i: int) -> [] bool {
    return contents(sh.cells)[3 * sh.cols + i] != 0;
}

// 0 if column i is not categorical, else 1 + its place among the categorical columns
pub fn catplace[&s](sh: &s Shape, i: int) -> [] int {
    return contents(sh.cells)[4 * sh.cols + i];
}

// the index of the column named `want`, -1 if there is none
pub fn find[&s, &w](sh: &s Shape, want: &w [byte]) -> [] int {
    var i = 0;
    while i < sh.cols {
        if bytes.equal(name(sh, i), want) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// ---------------------------------------------------------------- the header

// (5, i) if name i is empty or equals an earlier one, else (0, 0)
pub fn check_names[&n, &e](names: &n [byte], ends: &e vec.Vec[int], cols: int) -> [] (int, int) {
    var i = 0;
    while i < cols {
        var from = 0;
        if i > 0 {
            from = vec.get(ends, i - 1);
        }
        let to = vec.get(ends, i);
        if to == from {
            return (5, i);
        }
        var j = 0;
        while j < i {
            var jf = 0;
            if j > 0 {
                jf = vec.get(ends, j - 1);
            }
            let jt = vec.get(ends, j);
            if jt - jf == to - from && bytes.equal(names[jf..jt], names[from..to]) {
                return (5, i);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return (0, 0);
}

// --drop and --float: set flags[slot * cols + j] to `value` for the columns named in the comma list. (0, 0), or (code, k) when the k-th
// name (from 1) is no column
fn apply_list[&s, &n, &e, &ls](flags: &!s [int], names: &n [byte], ends: &e vec.Vec[int], cols: int, list: &ls [byte], slot: int, value: int, code: int) -> [] (int, int) {
    if len(list) == 0 {
        return (0, 0);
    }
    var k = 0;
    var p = 0;
    while p <= len(list) {
        var q = p;
        while q < len(list) && int_of(list[q]) != ',' {
            q = q + 1;
        }
        k = k + 1;
        let want = list[p..q];
        var found = 0 - 1;
        var j = 0;
        while j < cols && found < 0 {
            var from = 0;
            if j > 0 {
                from = vec.get(ends, j - 1);
            }
            if bytes.equal(names[from..vec.get(ends, j)], want) {
                found = j;
            }
            j = j + 1;
        }
        if found < 0 {
            return (code, k);
        }
        flags[slot * cols + found] = value;
        p = q + 1;
    }
    return (0, 0);
}

// the columns whose bit is set in `mask`: flags[slot * cols + j] = value (the columns past the 62nd have no bit)
fn apply_mask[&s](flags: &!s [int], cols: int, mask: int, slot: int, value: int) -> [] int {
    var j = 0;
    while j < cols && j < 62 {
        if mask >> j & 1 == 1 {
            flags[slot * cols + j] = value;
        }
        j = j + 1;
    }
    return 0;
}

// the column named `want`, -1 if none
fn column_of[&n, &e, &w](names: &n [byte], ends: &e vec.Vec[int], cols: int, want: &w [byte]) -> [] int {
    if len(want) == 0 {
        return 0 - 1;
    }
    var j = 0;
    while j < cols {
        var from = 0;
        if j > 0 {
            from = vec.get(ends, j - 1);
        }
        if bytes.equal(names[from..vec.get(ends, j)], want) {
            return j;
        }
        j = j + 1;
    }
    return 0 - 1;
}

// ---------------------------------------------------------------- the target column, folded while reading

// 0, or 15 (a cell does not fit the kind or the scale the first pass chose), 16 (a third label). The layout of `acc` per mode is in the
// comment of `Cfg` and of the callers in verbs.
fn fold[&a, &v](mode: int, tscale: int, pred: int, kind: int, m: int, frac: int, idig: int, key: int, acc: &!a [int], fv: &!v vec.Vec[int]) -> [] int {
    if mode == 1 {
        if kind == 3 || frac > tscale || idig + tscale > 12 {
            return 15;
        }
        exact.sum_add(acc, 0, m * exact.pow10(tscale - frac));
        acc[2] = acc[2] + 1;
        return 0;
    }
    if mode == 2 {
        if kind != 1 {
            return 15;
        }
        if acc[4] == 0 {
            acc[0] = m;
            acc[2] = 1;
            acc[4] = 1;
        } else if m == acc[0] {
            acc[2] = acc[2] + 1;
        } else if acc[4] == 1 {
            acc[1] = m;
            acc[3] = 1;
            acc[4] = 2;
        } else if m == acc[1] {
            acc[3] = acc[3] + 1;
        } else {
            return 16;
        }
        acc[5] = acc[5] + 1;
        return 0;
    }
    if mode == 3 {
        if kind == 3 || frac > tscale || idig + tscale > 12 {
            acc[7] = 1;
            return 0;
        }
        let y = m * exact.pow10(tscale - frac);
        exact.square_add(acc, 0, y * 1000000 - pred);
        acc[6] = acc[6] + 1;
        return 0;
    }
    if mode == 4 {
        if kind != 1 {
            acc[7] = 1;
            return 0;
        }
        if m == pred {
            acc[0] = acc[0] + 1;
        }
        acc[1] = acc[1] + 1;
        return 0;
    }
    if mode == 6 {
        facc.add_bits(fv, 0, csvcell.bits_of_key(csvcell.key_of(kind, m, frac, key)));
        acc[2] = acc[2] + 1;
        return 0;
    }
    if mode == 7 {
        fsq.add_square(acc, csvcell.bits_of_key(csvcell.key_of(kind, m, frac, key)), pred);
        return 0;
    }
    return 0;
}

// ---------------------------------------------------------------- a cell of a categorical column

// `cell` with each doubled quote written once, into dst; the length written, or -1 if dst is too small. A quoted field's text reaches here with `""` still
// doubled (reader.fields), so a quote in it is always one of a pair.
fn unquote[&d, &c](dst: &!d [byte], cell: &c [byte]) -> [] int {
    if len(cell) > len(dst) {
        return 0 - 1;
    }
    var n = 0;
    var i = 0;
    while i < len(cell) {
        dst[n] = cell[i];
        n = n + 1;
        if int_of(cell[i]) == 34 && i + 1 < len(cell) && int_of(cell[i + 1]) == 34 {
            i = i + 2;
        } else {
            i = i + 1;
        }
    }
    return n;
}

// whether the cell is one of the markers of `list` (comma separated; an empty list has none)
fn is_marker[&c, &l](cell: &c [byte], list: &l [byte]) -> [] bool {
    if len(list) == 0 {
        return false;
    }
    let count = bytes.count_byte(list, ',') + 1;
    var k = 1;
    while k <= count {
        if bytes.equal(cell, bytes.field(list, ',', k)) {
            return true;
        }
        k = k + 1;
    }
    return false;
}

// One cell of categorical column `cj` (0-based among the categorical columns) of row `row`, its text unquoted (docs/categorical.md section 5.1).
// (0, 0), or (status, aux) as in Report. `writes`: this is the pass that fills the ids.
fn cat_cell[&k, &c, &na](cs: &!k CatState, cc: CatCfg, markers: &na [byte], cell: &c [byte], cj: int, row: int, writes: bool) -> [] (int, int) {
    var id = catmat.missing_id();
    if len(cell) > 0 && !is_marker(cell, markers) && !is_marker(cell, contents(cs.nab)[0..len(contents(cs.nab)) - 1]) {
        if len(cell) > cc.max_str {
            return (21, len(cell));
        }
        let off = dict.utf8_offset(cell);
        if off >= 0 {
            return (20, off);
        }
        if cs.kind == 3 && dict.hash_buckets(cs.voc, cj) > 0 {
            // a hashed column of a stored model: the bucket of the cell is the id; nothing is interned, looked up or counted as unseen (docs/stringtable.md section 5)
            id = bucket.bucket_of(contents(cs.hst), contents(cs.hdg), cell, dict.hash_buckets(cs.voc, cj));
        } else {
            if cs.kind == 1 {
                let code = dict.intern(cs.bld, cj, cell);
                if code == refuse.limit_categories() {
                    return (22, cc.max_cats);
                }
                if code == refuse.limit_string_pool() {
                    return (23, dict.dict_pool_used(cs.bld) + len(cell));
                }
                if code != 0 {
                    return (30, code);
                }
                return (0, 0);
            }
            id = dict.find(cs.voc, cj, cell);
            if id < 0 {
                if cs.kind == 2 {
                    return (15, 0);
                }
                id = catmat.unseen_id();
                if writes {
                    contents(cs.unseen)[cj] = contents(cs.unseen)[cj] + 1;
                }
            }
        }
    }
    if writes && cs.kind >= 2 {
        if row >= cs.crows {
            return (15, 0);
        }
        catmat.put(contents(cs.ids), cs.ncat, row, cj, id);
        if id == catmat.missing_id() {
            catmat.mark_missing(contents(cs.cmiss), cs.cwpc, row, cj);
        }
    }
    return (0, 0);
}

// The header part of the categorical columns (docs/categorical.md section 5): which columns are categorical, in file order. cells plane 4 gets 1 + the
// place, plane 0 the kind 4. Consumes the state and answers it again with (status, column, aux) as in Report. Fit (kind 1): the columns named in cc.cols, each
// checked against --drop, the target and --float, their number against the limit, and only then the dictionary is allocated. Predict (kind 2 or 3): the columns of
// the stored vocabulary, found by name.
fn cat_header[&h, &s, &n, &e, &cl](heap: &!h Heap, flags: &!s [int], cat_list: &cl [byte], names: &n [byte], ends: &e vec.Vec[int], cols: int, tcol: int, cc: CatCfg, cs: CatState) -> [heap] (CatState, int, int, int) {
    var kind = 0;
    borrow cs as &cr in {
        kind = cr.kind;
    }
    if kind == 0 {
        return (cs, 0, 0, 0);
    }
    if kind == 1 {
        apply_mask(flags, cols, cc.cat_mask, 4, 1);
        let (st, k) = apply_list(flags, names, ends, cols, cat_list, 4, 1, 25);
        if st != 0 {
            return (cs, st, 0, k);
        }
        var count = 0;
        var j = 0;
        while j < cols {
            if flags[4 * cols + j] == 1 {
                if flags[3 * cols + j] != 0 {
                    return (cs, 26, j, 0);
                }
                if j == tcol {
                    return (cs, 27, j, 0);
                }
                if flags[j] == 3 {
                    return (cs, 28, j, 0);
                }
                count = count + 1;
                flags[4 * cols + j] = count;
                flags[j] = 4;
            }
            j = j + 1;
        }
        if count > cc.max_catcols {
            return (cs, 24, 0, count);
        }
        // the names of the categorical columns, one after another
        var nm = buffer.empty(heap, 16);
        let ne = box_slice(heap, count + 1, 0);
        var nee = ne;
        borrow mut nee as &!ew in {
            var at = 0;
            j = 0;
            while j < cols {
                if flags[4 * cols + j] > 0 {
                    var from = 0;
                    if j > 0 {
                        from = vec.get(ends, j - 1);
                    }
                    nm = buffer.append(heap, nm, names[from..vec.get(ends, j)]);
                    var sz = 0;
                    borrow nm as &nb in {
                        sz = buffer.size(nb);
                    }
                    contents(ew)[at] = sz;
                    at = at + 1;
                }
                j = j + 1;
            }
        }
        var made = cs;
        var code = 0;
        borrow nm as &nr in {
            borrow nee as &er in {
                let (d, c) = dict.make(heap, count, cc.max_catcols, cc.max_cats, cc.max_str, cc.max_pool, buffer.bytes(nr), contents(er));
                let (k2, b2, v2, i2, m2, u2) = state_parts(heap, made);
                dict.drop(heap, b2);
                made = CatState { kind: k2, bld: d, voc: v2, ids: i2, cmiss: m2, unseen: u2, ncat: count, crows: 0, cwpc: 0, nab: box_slice(heap, 1, byte_of(0)), hst: box_slice(heap, 1, 0), hdg: box_slice(heap, 1, byte_of(0)) };
                code = c;
            }
        }
        buffer.drop(heap, nm);
        unbox_slice(heap, nee);
        if code == refuse.limit_categorical_columns() {
            return (made, 24, 0, count);
        }
        if code != 0 {
            return (made, 30, 0, code);
        }
        return (made, 0, 0, 0);
    }
    // a stored vocabulary
    var nv = 0;
    borrow cs as &cr in {
        nv = dict.ncols(cr.voc);
    }
    var c = 0;
    while c < nv {
        var j = 0 - 1;
        borrow cs as &cr in {
            j = column_of(names, ends, cols, dict.name(cr.voc, c));
        }
        let absent = j < 0 || flags[3 * cols + j] != 0;
        if absent && !cc.lenient {
            return (cs, 29, 0, c + 1);
        }
        if !absent {
            if j == tcol {
                return (cs, 27, j, 0);
            }
            flags[4 * cols + j] = c + 1;
            flags[j] = 4;
        }
        c = c + 1;
    }
    return (cs, 0, 0, 0);
}

// ---------------------------------------------------------------- a data row

// (status, column, aux) as in Report. `row` is the 0-based row of the file, `quoted` whether the record holds a quote (then `fb` has
// the offsets of its fields, from reader.fields)
fn read_row[&l, &s, &a, &v, &d, &b, &f, &k, &z, &na](line: &l [byte], markers: &na [byte], cols: int, tcol: int, cfg: Cfg, row: int, quoted: bool, flags: &!s [int], acc: &!a [int], fv: &!v vec.Vec[int], data: &!d [float], miss: &!b [int], fb: &!f [int], cc: CatCfg, cs: &!k CatState, sc: &!z [byte]) -> [] (int, int, int) {
    if quoted {
        let (n, inside, bad) = reader.fields(line, 44, fb, cols);
        if inside || bad || n != cols {
            return (3, 0, 0);
        }
    }
    var p = 0;
    var i = 0;
    var mj = 0;
    while i < cols {
        var first = p;
        var last = p;
        if quoted {
            first = fb[3 * i];
            last = fb[3 * i + 1];
        } else {
            var q = p;
            while q < len(line) && int_of(line[q]) != ',' {
                q = q + 1;
            }
            last = q;
            p = q + 1;
        }
        let dropped = flags[3 * cols + i] != 0;
        let skipped = (cfg.mode == 5 || cfg.mode == 9) && i == tcol;
        let place = flags[4 * cols + i];
        if !dropped && !skipped && place > 0 {
            // a categorical column: its cell is a string (docs/categorical.md section 5.1)
            let raw = line[first..last];
            var cst = 0;
            var caux = 0;
            let writes = cfg.mode == 8 || cfg.mode == 9;
            if quoted && fb[3 * i + 2] == 1 && index_of_byte(raw, byte_of(34)) >= 0 {
                let n = unquote(sc, raw);
                if n < 0 {
                    cst = 21;
                    caux = len(raw);
                } else {
                    let (s2, a2) = cat_cell(cs, cc, markers, sc[0..n], place - 1, row, writes);
                    cst = s2;
                    caux = a2;
                }
            } else {
                let (s2, a2) = cat_cell(cs, cc, markers, raw, place - 1, row, writes);
                cst = s2;
                caux = a2;
            }
            if cst != 0 {
                return (cst, i, caux);
            }
        } else if !dropped && !skipped {
            let (st, kind, m, frac, idig, key) = csvcell.read(line[first..last]);
            if st == 1 && cfg.missing {
                if cfg.mode == 8 || cfg.mode == 9 {
                    if row >= cfg.mrows {
                        return (15, i, 0);
                    }
                    matrix.mark_missing(miss, cfg.wpc, row, mj);
                }
            } else if st != 0 {
                if st == 1 {
                    return (8, i, 1);
                }
                if st == 2 {
                    return (8, i, 2);
                }
                if st == 3 {
                    return (9, i, 0);
                }
                if st == 4 {
                    return (9, i, 1);
                }
                if st == 5 {
                    return (8, i, 3);
                }
                return (8, i, 4);
            } else {
                if flags[i] < kind {
                    flags[i] = kind;
                }
                if kind < 3 {
                    if flags[cols + i] < frac {
                        flags[cols + i] = frac;
                    }
                    if flags[2 * cols + i] < idig {
                        flags[2 * cols + i] = idig;
                    }
                    if flags[cols + i] + flags[2 * cols + i] > 12 {
                        flags[i] = 3;
                    }
                }
                if i == tcol && cfg.mode >= 1 && cfg.mode <= 7 {
                    let f = fold(cfg.mode, cfg.tscale, cfg.pred, kind, m, frac, idig, key, acc, fv);
                    if f != 0 {
                        return (f, i, 0);
                    }
                }
                if cfg.mode == 8 || cfg.mode == 9 {
                    if row >= cfg.mrows {
                        return (15, i, 0);
                    }
                    data[row * cfg.mcols + mj] = csvcell.double(kind, m, frac, key);
                }
            }
        }
        if !dropped && !skipped && place == 0 {
            mj = mj + 1;
        }
        i = i + 1;
    }
    return (0, 0, 0);
}

// ---------------------------------------------------------------- the scan

fn report(status: int, line: int, col: int, aux: int) -> [] Report {
    return Report { status: status, line: line, col: col, aux: aux };
}

// Read the whole file once. Memory: one 64 KiB chunk, the record being read (at most cfg.cap bytes), the header, the offsets of one
// record's fields and four ints a column. Stops at the first problem (a cell that is not a number is not followed by more cells that
// are not). The sinks come back with what the mode wrote into them.
pub fn scan[&h, &m, &t](heap: &!h Heap, src: Source, mem: &m [byte], cfg: Cfg, tx: &t [byte], sk: Sinks) -> [heap, file_read] (Source, Shape, Report, Sinks) {
    let (s2, sh, rep, k2, cs) = scan_cat(heap, src, mem, cfg, no_cats(), tx, sk, off_state(heap));
    drop_state(heap, cs);
    return (s2, sh, rep, k2);
}

// ---------------------------------------------------------------- the source of the chunks

// Where the 64 KiB chunks of the scan come from (docs/serving.md section 2.2): an open file, or the bytes of standard input kept in memory (a pipe cannot be read
// twice, the scan makes two passes). `Mem` holds the offset of the next chunk; the bytes are given beside it (`mem`, empty for a file).
pub res enum Source {
    Disk(File),
    Mem(int),
}

// close what a source holds: the file, or nothing
pub fn drop_source(src: Source) -> [] int {
    match src {
        Source::Disk(f) => {
            file_close(f);
            return 0;
        }
        Source::Mem(at) => {
            return at;
        }
    }
}

// the next chunk of `src` into the reader `r`: the one step of `lines.fill_file`, from a file or from memory
fn fill_source[&h, &m](heap: &!h Heap, r: lines.Lines, src: Source, mem: &m [byte]) -> [heap, file_read] (lines.Lines, Source) {
    match src {
        Source::Disk(f) => {
            var handle = f;
            var r2 = r;
            borrow mut handle as &!fh in {
                r2 = lines.fill_file(r2, fh);
            }
            return (r2, Source::Disk(handle));
        }
        Source::Mem(at) => {
            let lines.Lines { chunk, pos, held, cap, seen, begin, count, over, ended, newline, ready, read, nul, failed, viewing, view_from, view_to } = r;
            var c = chunk;
            borrow mut c as &!cw in {
                buffer.clear(cw);
            }
            var n = len(mem) - at;
            if n > lines.chunk_size() {
                n = lines.chunk_size();
            }
            var e = ended;
            var z = nul;
            if n <= 0 {
                e = true;
                n = 0;
            } else {
                c = buffer.append(heap, c, mem[at..at + n]);
                if index_of_byte(mem[at..at + n], byte_of(0)) >= 0 {
                    z = true;
                }
            }
            return (lines.Lines { chunk: c, pos: 0, held: held, cap: cap, seen: seen, begin: begin, count: count, over: over, ended: e, newline: newline, ready: ready, read: read + n, nul: z, failed: failed, viewing: false, view_from: 0, view_to: 0 }, Source::Mem(at + n));
        }
    }
}

// the number of categorical columns the state holds
fn cat_columns[&k](cs: &k CatState) -> [] int {
    if cs.kind == 1 {
        return dict.dict_columns(cs.bld);
    }
    return dict.ncols(cs.voc);
}

// `scan_cat` with the texts in an owned buffer, which is consumed (the caller built it from the command line)
pub fn scan_cat_tx[&h, &m](heap: &!h Heap, src0: Source, mem: &m [byte], cfg: Cfg, cc: CatCfg, tx: buffer.Buffer, sk: Sinks, cs0: CatState) -> [heap, file_read] (Source, Shape, Report, Sinks, CatState) {
    var o_src = Source::Mem(0);
    var o_sh = empty_shape(heap);
    var o_rep = Report { status: 0, line: 0, col: 0, aux: 0 };
    var o_k = plain_sinks(heap, 8, false);
    var o_cs = off_state(heap);
    borrow tx as &t in {
        let (s2, sh2, rep2, k2, c2) = scan_cat(heap, src0, mem, cfg, cc, buffer.bytes(t), sk, cs0);
        drop_source(o_src);
        o_src = s2;
        drop_shape(heap, o_sh);
        o_sh = sh2;
        o_rep = rep2;
        drop_sinks(heap, o_k);
        o_k = k2;
        drop_state(heap, o_cs);
        o_cs = c2;
    }
    buffer.drop(heap, tx);
    return (o_src, o_sh, o_rep, o_k, o_cs);
}

// `scan` with the texts in an owned buffer, which is consumed
pub fn scan_tx[&h, &m](heap: &!h Heap, src0: Source, mem: &m [byte], cfg: Cfg, tx: buffer.Buffer, sk: Sinks) -> [heap, file_read] (Source, Shape, Report, Sinks) {
    let (s2, sh2, rep2, k2, c2) = scan_cat_tx(heap, src0, mem, cfg, no_cats(), tx, sk, off_state(heap));
    drop_state(heap, c2);
    return (s2, sh2, rep2, k2);
}

// `scan` with categorical columns (docs/categorical.md): the state says what is done with them (CatState), `cc` how. With the state off and `no_cats()` this is
// the numeric scan, the same steps in the same order.
pub fn scan_cat[&h, &m, &t](heap: &!h Heap, src0: Source, mem: &m [byte], cfg: Cfg, cc: CatCfg, tx: &t [byte], sk: Sinks, cs0: CatState) -> [heap, file_read] (Source, Shape, Report, Sinks, CatState) {
    var src = src0;
    var cs = cs0;
    var sc = box_slice(heap, 1, byte_of(0));
    let (acc0, fv0, data0, miss0) = sink_parts(sk);
    var acc = acc0;
    var fv = fv0;
    var data = data0;
    var miss = miss0;
    var names = buffer.empty(heap, 1);
    var ends = vec.empty(heap, 1, 0);
    var cells = box_slice(heap, 1, 0);
    var fb = box_slice(heap, 1, 0);
    var rec = buffer.empty(heap, 256);
    var cols = 0;
    var rows = 0;
    var tcol = 0 - 1;
    var have_header = false;
    var have_rec = false;
    var open = false;
    var rec_quote = false;
    var seps = 0;
    var rec_line = 0;
    var rep = report(0, 0, 0, 0);
    var total = 0;
    var r = lines.start(heap, cfg.cap);
    var going = true;
    while going {
        let (stepped, answer) = lines.next(heap, r);
        r = stepped;
        var complete = false;
        if answer == lines.need() {
            let (r2, s2) = fill_source(heap, r, src, mem);
            r = r2;
            src = s2;
        } else if answer == lines.done() {
            going = false;
            borrow r as &rr in {
                total = lines.bytes_read(rr);
                if lines.failed(rr) != 0 {
                    rep = report(11, 0, 0, lines.failed(rr));
                }
            }
            if have_rec && rep.status == 0 {
                rep = report(18, rec_line, 0, 0);
            }
        } else if answer == lines.long() {
            going = false;
            borrow r as &rr in {
                total = lines.bytes_read(rr);
                rep = report(2, lines.number(rr), 0, lines.length(rr));
            }
        } else {
            borrow r as &rr in {
                var line = lines.text(rr);
                let number = lines.number(rr);
                if number == 1 && len(line) >= 3 && int_of(line[0]) == 239 && int_of(line[1]) == 187 && int_of(line[2]) == 191 {
                    line = line[3..len(line)];
                }
                if len(line) > 0 && int_of(line[len(line) - 1]) == 13 {
                    line = line[0..len(line) - 1];
                }
                if len(line) == 0 && !have_rec {
                    // a blank line is not a record
                } else {
                    var held = 0;
                    borrow rec as &br in {
                        held = buffer.size(br);
                    }
                    if have_rec && held + 1 + len(line) > cfg.cap {
                        rep = report(2, rec_line, 0, held + 1 + len(line));
                        going = false;
                    } else {
                        let quote = index_of_byte(line, byte_of(34)) >= 0;
                        if !have_rec {
                            rec_line = number;
                            seps = 0;
                            open = false;
                            rec_quote = false;
                            borrow mut rec as &!bw in {
                                buffer.clear(bw);
                            }
                        } else {
                            rec = buffer.push(heap, rec, byte_of(10));
                        }
                        have_rec = true;
                        if quote {
                            rec_quote = true;
                        }
                        rec = buffer.append(heap, rec, line);
                        if !quote && !open {
                            seps = bytes.count_byte(line, ',');
                        } else {
                            let (o2, s2, bad) = reader.scan(line, 44, open, seps);
                            open = o2;
                            seps = s2;
                            if bad {
                                rep = report(17, number, 0, 0);
                                going = false;
                            }
                        }
                        if going && !open {
                            complete = true;
                        }
                    }
                }
            }
        }
        if complete {
            have_rec = false;
            if !have_header {
                have_header = true;
                let c = seps + 1;
                if c > cfg.max_cols {
                    rep = report(6, rec_line, 0, c);
                    going = false;
                } else {
                    var nm = buffer.empty(heap, 1);
                    var en = vec.empty(heap, 1, 0);
                    borrow rec as &rr in {
                        let (n2, e2) = reader.split_header(heap, buffer.bytes(rr), 44);
                        buffer.drop(heap, nm);
                        vec.drop(heap, en);
                        nm = n2;
                        en = e2;
                    }
                    buffer.drop(heap, names);
                    vec.drop(heap, ends);
                    names = nm;
                    ends = en;
                    var st = 0;
                    var bad = 0;
                    borrow names as &nr in {
                        borrow ends as &er in {
                            let (st2, at2) = check_names(buffer.bytes(nr), er, c);
                            st = st2;
                            bad = at2;
                        }
                    }
                    if st != 0 {
                        rep = report(st, rec_line, bad, c);
                        going = false;
                    } else {
                        cols = c;
                        unbox_slice(heap, cells);
                        cells = box_slice(heap, 5 * cols + 1, 0);
                        unbox_slice(heap, fb);
                        fb = box_slice(heap, 3 * cols + 3, 0);
                        borrow mut cells as &!cw in {
                            borrow names as &nr in {
                                borrow ends as &er in {
                                    apply_mask(contents(cw), cols, cfg.drop_mask, 3, 1);
                                    apply_mask(contents(cw), cols, cfg.float_mask, 0, 3);
                                    let (ds, k) = apply_list(contents(cw), buffer.bytes(nr), er, cols, text_of(tx, 1), 3, 1, 12);
                                    if ds != 0 {
                                        rep = report(ds, rec_line, 0, k);
                                        going = false;
                                    }
                                    if ds == 0 {
                                        let (fs, k2) = apply_list(contents(cw), buffer.bytes(nr), er, cols, text_of(tx, 2), 0, 3, 19);
                                        if fs != 0 {
                                            rep = report(fs, rec_line, 0, k2);
                                            going = false;
                                        }
                                    }
                                    tcol = column_of(buffer.bytes(nr), er, cols, text_of(tx, 0));
                                    if tcol >= 0 && cfg.mode != 5 && cfg.mode != 9 && contents(cw)[3 * cols + tcol] != 0 && going {
                                        rep = report(14, rec_line, tcol, 0);
                                        going = false;
                                    }
                                    if going {
                                        let (c2, hs, hcol, haux) = cat_header(heap, contents(cw), text_of(tx, 3), buffer.bytes(nr), er, cols, tcol, cc, cs);
                                        cs = c2;
                                        if hs != 0 {
                                            rep = report(hs, rec_line, hcol, haux);
                                            going = false;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    var ncat = 0;
                    borrow cs as &cr in {
                        ncat = cat_columns(cr);
                    }
                    if going && ncat > 0 {
                        unbox_slice(heap, sc);
                        sc = box_slice(heap, cfg.cap + 1, byte_of(0));
                    }
                }
            } else {
                rows = rows + 1;
                if rows > cfg.max_rows {
                    rep = report(7, rec_line, 0, rows);
                    going = false;
                } else if rows > cfg.max_cells / cols {
                    rep = report(13, rec_line, 0, rows);
                    going = false;
                } else if seps + 1 != cols {
                    rep = report(3, rec_line, 0, 0);
                    going = false;
                } else {
                    borrow rec as &rr in {
                        let record = buffer.bytes(rr);
                        let quoted = rec_quote;
                        borrow mut cells as &!cw in {
                            borrow mut fb as &!fw in {
                                borrow mut acc as &!aw in {
                                    borrow mut fv as &!vw in {
                                        borrow mut data as &!dw in {
                                            borrow mut miss as &!mw in {
                                                borrow mut cs as &!kw in {
                                                    borrow mut sc as &!sw in {
                                                        let (st, col, aux) = read_row(record, text_of(tx, 4), cols, tcol, cfg, rows - 1, quoted, contents(cw), contents(aw), vw, contents(dw), contents(mw), contents(fw), cc, kw, contents(sw));
                                                        if st != 0 {
                                                            rep = report(st, rec_line, col, aux);
                                                            going = false;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    lines.drop(heap, r);
    buffer.drop(heap, rec);
    unbox_slice(heap, fb);
    unbox_slice(heap, sc);
    if rep.status == 0 && !have_header {
        rep = report(1, 0, 0, 0);
    }
    return (src, Shape { names: names, ends: ends, cells: cells, cols: cols, rows: rows, tcol: tcol, bytes: total }, rep, sink_join(acc, fv, data, miss), cs);
}
