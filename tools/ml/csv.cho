edition 5;

module ml.csv;

// The CSV reader of this slice (docs/cli.md section 2.3). It is NOT cancho-table's reader: cancho-table is a binary, not a
// package, and its float reader (tools/table/flt.cho) is on an unmerged branch, so nothing of it can be pinned (the contract
// package is pinned, never copied; neither is this copied from table). It reads what the constant model needs and refuses the
// rest with a rule tag:
//
// * the first non-blank line is the header; a line is cut at commas; no quoting (a double quote is ml.input.unsupported-csv);
// * a cell is `[+-]digits[.digits]` with at most 12 digits in all, read exactly as an integer mantissa and a count of
//   fractional digits (the column's type is int, or dec(S) with S the most fractional digits seen); an exponent is
//   ml.input.unsupported-type, nan and inf are ml.input.non-finite, anything else ml.input.non-numeric;
// * one function, `scan`, reads the file one line at a time in bounded memory (the line cap, the header, four ints per
//   column) and, in the modes below, folds the target column into exact accumulators while it reads.

import std.buffer;
import std.bytes;
import std.vec;
import ml.exact;
import toolbox.lines;

// a column holds 12 digits at most: its mantissa is below 10^12
pub fn digits_max() -> [] int {
    return 12;
}

// what `scan` does besides inferring the shape: 0 nothing (fit pass 1), 1 fit a regression (sum the target at scale
// `tscale`), 2 fit a classification (count the target's values), 3 eval a regression (sum the squared errors against `pred`,
// a prediction at scale `tscale` + 6), 4 eval a classification (count the rows whose target is `pred`), 5 predict (the
// target column, if present, is skipped: its cells are not read)
pub struct Cfg {
    cap: int,
    max_rows: int,
    max_cols: int,
    max_cells: int,
    mode: int,
    tscale: int,
    pred: int,
    drops: &static [byte],
}

// what stopped the scan: 0 nothing, 1 no header, 2 line too long (aux: its length), 3 ragged row, 4 a quote, 5 a name twice
// or empty (col: the second), 6 too many columns (aux: the count), 7 too many rows, 8 non-numeric cell (aux: 1 empty, 2 not a
// number), 9 non-finite, 10 unsupported type (aux: 1 exponent, 2 more than 12 digits in a cell, 3 more than 12 digits in a
// column), 11 read failed (aux: errno), 12 --drop names a column that is not there (aux: its place in the list, from 1),
// 13 too many cells, 14 the target is dropped, 15 the file is not what the first pass saw (a cell does not fit the scale),
// 16 a classification target with a third value
pub struct Report {
    status: int,
    line: int,
    col: int,
    aux: int,
}

// per column i of `cols`: cells[i] kind (0 no cell yet, 1 int, 2 dec), cells[cols + i] scale, cells[2 cols + i] the most
// integer digits, cells[3 cols + i] 1 if dropped
pub res struct Shape {
    names: buffer.Buffer,
    ends: vec.Vec[int],
    cells: Box[[int]],
    cols: int,
    rows: int,
    // the column of cfg.target, -1 if there is none
    tcol: int,
    bytes: int,
}

pub fn drop_shape[&h](heap: &!h Heap, s: Shape) -> [heap] int {
    let Shape { names, ends, cells, cols, rows, tcol, bytes } = s;
    buffer.drop(heap, names);
    vec.drop(heap, ends);
    unbox_slice(heap, cells);
    return rows;
}

pub fn empty_shape[&h](heap: &!h Heap) -> [heap] Shape {
    return Shape { names: buffer.empty(heap, 1), ends: vec.empty(heap, 1, 0), cells: box_slice(heap, 1, 0), cols: 0, rows: 0, tcol: 0 - 1, bytes: 0 };
}

pub fn cols[&s](sh: &s Shape) -> [] int {
    return sh.cols;
}

pub fn rows[&s](sh: &s Shape) -> [] int {
    return sh.rows;
}

pub fn tcol[&s](sh: &s Shape) -> [] int {
    return sh.tcol;
}

pub fn bytes_read[&s](sh: &s Shape) -> [] int {
    return sh.bytes;
}

pub fn name[&s](sh: &s Shape, i: int) -> [] &s [byte] {
    let b = buffer.bytes(sh.names);
    var from = 0;
    if i > 0 {
        from = vec.get(sh.ends, i - 1);
    }
    return b[from..vec.get(sh.ends, i)];
}

pub fn kind[&s](sh: &s Shape, i: int) -> [] int {
    return contents(sh.cells)[i];
}

pub fn scale[&s](sh: &s Shape, i: int) -> [] int {
    return contents(sh.cells)[sh.cols + i];
}

pub fn intd[&s](sh: &s Shape, i: int) -> [] int {
    return contents(sh.cells)[2 * sh.cols + i];
}

pub fn dropped[&s](sh: &s Shape, i: int) -> [] bool {
    return contents(sh.cells)[3 * sh.cols + i] != 0;
}

// the index of the column named `want`, -1 if there is none
pub fn find[&s, &w](sh: &s Shape, want: &w [byte]) -> [] int {
    var i = 0;
    while i < sh.cols {
        if bytes.equal(name(sh, i), want) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// ---------------------------------------------------------------- a cell

fn is_digit(c: int) -> [] bool {
    return c >= '0' && c <= '9';
}

fn lower(c: int) -> [] int {
    if c >= 'A' && c <= 'Z' {
        return c + 32;
    }
    return c;
}

fn same_ignoring_case[&c](cell: &c [byte], word: &static [byte]) -> [] bool {
    if len(cell) != len(word) {
        return false;
    }
    var i = 0;
    while i < len(cell) {
        if lower(int_of(cell[i])) != int_of(word[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// (status, mantissa, fractional digits, integer digits without leading zeros). status: 0 a number, 1 empty, 2 not a number,
// 3 nan or inf, 4 an exponent, 5 more than 12 digits. The mantissa is signed and below 10^12 in size.
pub fn parse_cell[&c](cell: &c [byte]) -> [] (int, int, int, int) {
    let n = len(cell);
    if n == 0 {
        return (1, 0, 0, 0);
    }
    var at = 0;
    var neg = false;
    let first = int_of(cell[0]);
    if first == '-' || first == '+' {
        neg = first == '-';
        at = 1;
    }
    let rest = cell[at..n];
    if same_ignoring_case(rest, "nan") || same_ignoring_case(rest, "inf") || same_ignoring_case(rest, "infinity") {
        return (3, 0, 0, 0);
    }
    // integer part
    var p = at;
    var lead = true;
    var idig = 0;
    var ndig = 0;
    while p < n && is_digit(int_of(cell[p])) {
        if int_of(cell[p]) != '0' {
            lead = false;
        }
        if !lead {
            idig = idig + 1;
        }
        ndig = ndig + 1;
        p = p + 1;
    }
    if ndig == 0 {
        return (2, 0, 0, 0);
    }
    var frac = 0;
    var tail = p;
    if p < n && int_of(cell[p]) == '.' {
        p = p + 1;
        tail = p;
        while p < n && is_digit(int_of(cell[p])) {
            frac = frac + 1;
            p = p + 1;
        }
        if frac == 0 {
            return (2, 0, 0, 0);
        }
    }
    if p < n {
        let c = int_of(cell[p]);
        if (c == 'e' || c == 'E') && p + 1 < n {
            return (4, 0, 0, 0);
        }
        return (2, 0, 0, 0);
    }
    if idig + frac > 12 {
        return (5, 0, 0, 0);
    }
    // the mantissa: every digit, the point skipped
    var m = 0;
    var q = at;
    while q < n {
        let c = int_of(cell[q]);
        if is_digit(c) {
            m = m * 10 + (c - '0');
        }
        q = q + 1;
    }
    if neg {
        m = 0 - m;
    }
    return (0, m, frac, idig);
}

// ---------------------------------------------------------------- the header

fn count_commas[&l](line: &l [byte]) -> [] int {
    return bytes.count_byte(line, ',');
}

// (5, i) if name i is empty or equals an earlier one, else (0, 0)
pub fn check_names[&n, &e](names: &n [byte], ends: &e vec.Vec[int], cols: int) -> [] (int, int) {
    var i = 0;
    while i < cols {
        var from = 0;
        if i > 0 {
            from = vec.get(ends, i - 1);
        }
        let to = vec.get(ends, i);
        if to == from {
            return (5, i);
        }
        var j = 0;
        while j < i {
            var jf = 0;
            if j > 0 {
                jf = vec.get(ends, j - 1);
            }
            let jt = vec.get(ends, j);
            if jt - jf == to - from && bytes.equal(names[jf..jt], names[from..to]) {
                return (5, i);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return (0, 0);
}

// the header's names, their ends, and (status, column): 0, or 4 a quote, 5 a name twice or empty, 6 too many columns
fn read_header[&h, &l](heap: &!h Heap, line: &l [byte], max_cols: int) -> [heap] (buffer.Buffer, vec.Vec[int], int, int, int) {
    var names = buffer.empty(heap, len(line) + 1);
    var ends = vec.empty(heap, 16, 0);
    if index_of_byte(line, byte_of(34)) >= 0 {
        return (names, ends, 0, 4, 0);
    }
    let cols = count_commas(line) + 1;
    if cols > max_cols {
        return (names, ends, cols, 6, cols);
    }
    var p = 0;
    var i = 0;
    var status = 0;
    var bad = 0;
    while i < cols {
        var q = p;
        while q < len(line) && int_of(line[q]) != ',' {
            q = q + 1;
        }
        names = buffer.append(heap, names, line[p..q]);
        var size = 0;
        borrow names as &nr in {
            size = buffer.size(nr);
        }
        ends = vec.push(heap, ends, size);
        p = q + 1;
        i = i + 1;
    }
    // a name twice, or empty
    borrow names as &nr in {
        borrow ends as &er in {
            let (st, at) = check_names(buffer.bytes(nr), er, cols);
            status = st;
            bad = at;
        }
    }
    return (names, ends, cols, status, bad);
}

// --drop: mark the columns named in the comma list. (0, 0), or (12, k) when the k-th name (from 1) is no column
fn apply_drops[&s, &n, &e](flags: &!s [int], names: &n [byte], ends: &e vec.Vec[int], cols: int, list: &static [byte]) -> [] (int, int) {
    if len(list) == 0 {
        return (0, 0);
    }
    var k = 0;
    var p = 0;
    while p <= len(list) {
        var q = p;
        while q < len(list) && int_of(list[q]) != ',' {
            q = q + 1;
        }
        k = k + 1;
        let want = list[p..q];
        var found = 0 - 1;
        var j = 0;
        while j < cols && found < 0 {
            var from = 0;
            if j > 0 {
                from = vec.get(ends, j - 1);
            }
            if bytes.equal(names[from..vec.get(ends, j)], want) {
                found = j;
            }
            j = j + 1;
        }
        if found < 0 {
            return (12, k);
        }
        flags[3 * cols + found] = 1;
        p = q + 1;
    }
    return (0, 0);
}

// the column named `want`, -1 if none
fn column_of[&n, &e, &w](names: &n [byte], ends: &e vec.Vec[int], cols: int, want: &w [byte]) -> [] int {
    if len(want) == 0 {
        return 0 - 1;
    }
    var j = 0;
    while j < cols {
        var from = 0;
        if j > 0 {
            from = vec.get(ends, j - 1);
        }
        if bytes.equal(names[from..vec.get(ends, j)], want) {
            return j;
        }
        j = j + 1;
    }
    return 0 - 1;
}

// ---------------------------------------------------------------- the target column, folded while reading

// 0, or 15 (a cell does not fit the scale the first pass chose), 16 (a third label). The layout of `acc` per mode is in the
// comment of `Cfg` and of the callers in main.
fn fold[&a](mode: int, tscale: int, pred: int, m: int, frac: int, idig: int, acc: &!a [int]) -> [] int {
    if mode == 1 {
        if frac > tscale || idig + tscale > 12 {
            return 15;
        }
        exact.sum_add(acc, 0, m * exact.pow10(tscale - frac));
        acc[2] = acc[2] + 1;
        return 0;
    }
    if mode == 2 {
        if frac != 0 {
            return 15;
        }
        if acc[4] == 0 {
            acc[0] = m;
            acc[2] = 1;
            acc[4] = 1;
        } else if m == acc[0] {
            acc[2] = acc[2] + 1;
        } else if acc[4] == 1 {
            acc[1] = m;
            acc[3] = 1;
            acc[4] = 2;
        } else if m == acc[1] {
            acc[3] = acc[3] + 1;
        } else {
            return 16;
        }
        acc[5] = acc[5] + 1;
        return 0;
    }
    if mode == 3 {
        if frac > tscale || idig + tscale > 12 {
            acc[7] = 1;
            return 0;
        }
        let y = m * exact.pow10(tscale - frac);
        exact.square_add(acc, 0, y * 1000000 - pred);
        acc[6] = acc[6] + 1;
        return 0;
    }
    if mode == 4 {
        if frac != 0 {
            acc[7] = 1;
            return 0;
        }
        if m == pred {
            acc[0] = acc[0] + 1;
        }
        acc[1] = acc[1] + 1;
        return 0;
    }
    return 0;
}

// ---------------------------------------------------------------- a data row

// (status, column, aux) as in Report
fn read_row[&l, &s, &a](line: &l [byte], cols: int, tcol: int, cfg: Cfg, flags: &!s [int], acc: &!a [int]) -> [] (int, int, int) {
    if index_of_byte(line, byte_of(34)) >= 0 {
        return (4, 0, 0);
    }
    if count_commas(line) + 1 != cols {
        return (3, 0, 0);
    }
    var p = 0;
    var i = 0;
    while i < cols {
        var q = p;
        while q < len(line) && int_of(line[q]) != ',' {
            q = q + 1;
        }
        let skipped = flags[3 * cols + i] != 0 || cfg.mode == 5 && i == tcol;
        if !skipped {
            let (st, m, frac, idig) = parse_cell(line[p..q]);
            if st == 1 || st == 2 {
                return (8, i, st);
            }
            if st == 3 {
                return (9, i, 0);
            }
            if st == 4 {
                return (10, i, 1);
            }
            if st == 5 {
                return (10, i, 2);
            }
            var k = 1;
            if frac > 0 {
                k = 2;
            }
            if flags[i] < k {
                flags[i] = k;
            }
            if flags[cols + i] < frac {
                flags[cols + i] = frac;
            }
            if flags[2 * cols + i] < idig {
                flags[2 * cols + i] = idig;
            }
            if flags[cols + i] + flags[2 * cols + i] > 12 {
                return (10, i, 3);
            }
            if i == tcol && cfg.mode >= 1 && cfg.mode <= 4 {
                let f = fold(cfg.mode, cfg.tscale, cfg.pred, m, frac, idig, acc);
                if f != 0 {
                    return (f, i, 0);
                }
            }
        }
        p = q + 1;
        i = i + 1;
    }
    return (0, 0, 0);
}

// ---------------------------------------------------------------- the scan

fn report(status: int, line: int, col: int, aux: int) -> [] Report {
    return Report { status: status, line: line, col: col, aux: aux };
}

// Read the whole file once. Memory: one 64 KiB chunk, the longest line (at most cfg.cap), the header and four ints a column.
// Stops at the first problem (a cell that is not a number is not followed by more cells that are not).
pub fn scan[&h, &f, &a, &t](heap: &!h Heap, file: &!f File, cfg: Cfg, target: &t [byte], acc: &!a [int]) -> [heap, file_read] (Shape, Report) {
    var names = buffer.empty(heap, 1);
    var ends = vec.empty(heap, 1, 0);
    var cells = box_slice(heap, 1, 0);
    var cols = 0;
    var rows = 0;
    var tcol = 0 - 1;
    var have_header = false;
    var rep = report(0, 0, 0, 0);
    var total = 0;
    var r = lines.start(heap, cfg.cap);
    var going = true;
    while going {
        let (stepped, answer) = lines.next(heap, r);
        r = stepped;
        if answer == lines.need() {
            r = lines.fill_file(r, file);
        } else if answer == lines.done() {
            going = false;
            borrow r as &rr in {
                total = lines.bytes_read(rr);
                if lines.failed(rr) != 0 {
                    rep = report(11, 0, 0, lines.failed(rr));
                }
            }
        } else if answer == lines.long() {
            going = false;
            borrow r as &rr in {
                total = lines.bytes_read(rr);
                rep = report(2, lines.number(rr), 0, lines.length(rr));
            }
        } else {
            borrow r as &rr in {
                var line = lines.text(rr);
                let number = lines.number(rr);
                if number == 1 && len(line) >= 3 && int_of(line[0]) == 239 && int_of(line[1]) == 187 && int_of(line[2]) == 191 {
                    line = line[3..len(line)];
                }
                if len(line) > 0 && int_of(line[len(line) - 1]) == 13 {
                    line = line[0..len(line) - 1];
                }
                if len(line) == 0 {
                    // a blank line is not a record
                } else if !have_header {
                    have_header = true;
                    let (nm, en, c, st, bad) = read_header(heap, line, cfg.max_cols);
                    buffer.drop(heap, names);
                    vec.drop(heap, ends);
                    names = nm;
                    ends = en;
                    if st != 0 {
                        rep = report(st, number, bad, c);
                        going = false;
                    } else {
                        cols = c;
                        unbox_slice(heap, cells);
                        cells = box_slice(heap, 4 * cols + 1, 0);
                        borrow mut cells as &!cw in {
                            borrow names as &nr in {
                                borrow ends as &er in {
                                    let (ds, k) = apply_drops(contents(cw), buffer.bytes(nr), er, cols, cfg.drops);
                                    if ds != 0 {
                                        rep = report(ds, number, 0, k);
                                        going = false;
                                    }
                                    tcol = column_of(buffer.bytes(nr), er, cols, target);
                                    if tcol >= 0 && cfg.mode != 5 && contents(cw)[3 * cols + tcol] != 0 && ds == 0 {
                                        rep = report(14, number, tcol, 0);
                                        going = false;
                                    }
                                }
                            }
                        }
                    }
                } else {
                    rows = rows + 1;
                    if rows > cfg.max_rows {
                        rep = report(7, number, 0, rows);
                        going = false;
                    } else if rows > cfg.max_cells / cols {
                        rep = report(13, number, 0, rows);
                        going = false;
                    } else {
                        borrow mut cells as &!cw in {
                            let (st, col, aux) = read_row(line, cols, tcol, cfg, contents(cw), acc);
                            if st != 0 {
                                rep = report(st, number, col, aux);
                                going = false;
                            }
                        }
                    }
                }
            }
        }
    }
    lines.drop(heap, r);
    if rep.status == 0 && !have_header {
        rep = report(1, 0, 0, 0);
    }
    return (Shape { names: names, ends: ends, cells: cells, cols: cols, rows: rows, tcol: tcol, bytes: total }, rep);
}
