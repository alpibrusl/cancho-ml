// whether `--plan` or a model other than constant makes this fit a planned one
pub fn planned[&n](plan_given: bool, model: &n [byte]) -> [] bool {
    return plan_given || est.kind_named(model) != 0;
}

// the checks of the flags of the planned models that need no file (docs/wiring.md section 2)
pub fn check_flags[&h, &cl](heap: &!h Heap, src: &cl [byte], errs: fail.Errors, verb: int) -> [heap] fail.Errors {
    let table = spec.flag_table();
    var e = errs;
    let plan_given = argv.has(src, "plan");
    let model = argv.text(src, "model");
    let kind = est.kind_named(model);
    var i = 0;
    if verb == 1 {
        if !planned(plan_given, model) {
            if argv.has(src, "weight") {
                e = weightcol.unsupported(heap, e);
            }
            let needing = "step,positive,split,seed,threads";
            var k = 1;
            while k <= 5 {
                let f = bytes.field(needing, ',', k);
                if argv.has(src, f) {
                    e = wiredata.conflict(heap, e, f, "this flag needs a model other than constant: --model linear, logistic, kmeans, tree or forest, or --plan");
                }
                k = k + 1;
            }
            i = 0;
            while i < cli.entries(table) {
                if est.hparam_flag(cli.name_of(table, i)) && argv.has(src, cli.name_of(table, i)) {
                    e = wiredata.conflict(heap, e, cli.name_of(table, i), "this flag is a hyperparameter of a model other than constant: give --model");
                }
                i = i + 1;
            }
        } else if plan_given {
            let describing = "model,step,task";
            var k = 1;
            while k <= 3 {
                let f = bytes.field(describing, ',', k);
                if argv.has(src, f) {
                    e = wiredata.conflict(heap, e, f, "--plan describes the whole fit: its model line is the model, and no other flag may also describe it");
                }
                k = k + 1;
            }
            i = 0;
            while i < cli.entries(table) {
                if est.hparam_flag(cli.name_of(table, i)) && argv.has(src, cli.name_of(table, i)) {
                    e = wiredata.conflict(heap, e, cli.name_of(table, i), "--plan describes the whole fit: its model line holds the hyperparameters");
                }
                i = i + 1;
            }
        } else {
            i = 0;
            while i < cli.entries(table) {
                let name = cli.name_of(table, i);
                if est.hparam_flag(name) && argv.has(src, name) {
                    if !est.takes(kind, name) {
                        e = wiredata.conflict(heap, e, name, "this model has no such hyperparameter");
                    } else if !est.hparam_ok(name, argv.text(src, name)) {
                        e = wiredata.bad_value(heap, e, name, argv.text(src, name), "a number in the range introspect gives for the hyperparameter");
                    }
                }
                i = i + 1;
            }
            if est.task(kind) == 4 {
                if argv.has(src, "target") {
                    e = wiredata.conflict(heap, e, "target", "kmeans has no target: it clusters the rows by their features, so a label column is dropped with --drop");
                }
                if argv.has(src, "task") {
                    e = wiredata.conflict(heap, e, "task", "kmeans is a clustering: its task is fixed and no flag changes it");
                }
            }
            if argv.has(src, "task") && est.task(kind) != 3 && est.task(kind) != 4 {
                var want: &static [byte] = "regression";
                if est.task(kind) == 2 {
                    want = "classification";
                }
                if !bytes.equal(argv.text(src, "task"), want) {
                    e = wiredata.conflict(heap, e, "task", "this model's task is the other one: linear is a regression and logistic a classification");
                }
            }
            // a model of both tasks (tree, forest) has the task the flag gives, regression by default
            var ptask = est.task(kind);
            if ptask == 3 {
                ptask = 1;
                if bytes.equal(argv.text(src, "task"), "classification") {
                    ptask = 2;
                }
            }
            if ptask == 1 && argv.has(src, "positive") {
                e = wiredata.conflict(heap, e, "positive", "a regression has no positive label");
            }
            if ptask == 4 && argv.has(src, "positive") {
                e = wiredata.conflict(heap, e, "positive", "a clustering has no positive label");
            }
        }
    }
    if verb == 1 || verb == 5 {
        e = weightcol.check_columns(heap, src, e);
    }
    if verb == 1 || verb == 3 || verb == 5 {
        e = rankcol.check_columns(heap, src, e);
    }
    // --task ranking and --group go together (docs/ranking.md section 2); a plan names its task on its model line, checked where the plan is read
    if (verb == 1 || verb == 5) && !argv.has(src, "plan") {
        let ranks = bytes.equal(argv.text(src, "task"), "ranking");
        if ranks && !est.has_ranking(est.kind_named(argv.text(src, "model"))) {
            e = wiredata.conflict(heap, e, "task", "only --model boost has a ranking task");
        } else if ranks && !argv.has(src, "group") {
            e = rankcol.needs_group(heap, e);
        } else if !ranks && argv.has(src, "group") {
            e = rankcol.unsupported(heap, e);
        }
    }
    if verb == 1 || verb == 3 || verb == 5 || verb == 7 {
        if argv.has(src, "threads") {
            let t = argv.nat(src, "threads");
            if t < 1 || t > 64 {
                var w = open_threads(heap);
                w = fail.detail_int(heap, w, "value", t);
                w = fail.detail_int(heap, w, "min", 1);
                w = fail.detail_int(heap, w, "max", 64);
                e = fail.add(heap, e, w);
            }
        }
        if argv.has(src, "split") {
            let (ok, num, den) = wiredata.parse_split(argv.text(src, "split"));
            if !ok {
                e = wiredata.bad_value(heap, e, "split", argv.text(src, "split"), "train=F with 0 < F < 1 and at most 6 digits after the point, for example train=0.8");
            }
        }
        if argv.has(src, "positive") {
            let (ok, v) = wiredata.parse_label(argv.text(src, "positive"));
            if !ok {
                e = wiredata.bad_value(heap, e, "positive", argv.text(src, "positive"), "an integer label");
            }
        }
    }
    return e;
}

fn open_threads[&h](heap: &!h Heap) -> [heap] json.Writer {
    var w = wiredata.open_tag(heap, "ml.param.threads");
    w = fail.no_repair(heap, w);
    return fail.detail_open(heap, w);
}

// ` name=value` for every hyperparameter flag the command line gave: the end of the model line a fit builds from its flags
pub fn model_tokens[&h, &cl](heap: &!h Heap, src: &cl [byte], kind: int) -> [heap] buffer.Buffer {
    let table = spec.flag_table();
    var b = buffer.empty(heap, 32);
    var i = 0;
    while i < cli.entries(table) {
        let name = cli.name_of(table, i);
        if est.hparam_flag(name) && est.takes(kind, name) && argv.has(src, name) {
            b = buffer.push(heap, b, byte_of(' '));
            b = buffer.append(heap, b, name);
            b = buffer.push(heap, b, byte_of('='));
            b = buffer.append(heap, b, argv.text(src, name));
        }
        i = i + 1;
    }
    // the task of a model that serves both is a key of its model line, from --task
    if est.task(kind) == 3 {
        b = buffer.append(heap, b, " task=");
        b = buffer.append(heap, b, argv.text(src, "task"));
    }
    return b;
}

// ---------------------------------------------------------------- fit

// the plan, parsed, the wired model it names and that model's hyperparameters (integers and floats, in manifest order)
pub res struct Planned {
    pl: plan.Plan,
    kind: int,
    ip: Box[[int]],
    fp: Box[[float]],
}

pub fn drop_planned[&h](heap: &!h Heap, p: Planned) -> [heap] int {
    let Planned { pl, kind, ip, fp } = p;
    plan.drop(heap, pl);
    unbox_slice(heap, ip);
    unbox_slice(heap, fp);
    return kind;
}

// the text of the plan: the file of --plan, or the steps of --step (semicolons are line ends) and the model line the flags give
fn plan_source[&h, &f, &r, &pp, &t, &cl](heap: &!h Heap, src: &cl [byte], fs: &f Fs(""), root: &r [byte], planp: &pp paths.Rp, o: verbs.Opts, model_tokens: &t [byte], errs: fail.Errors) -> [heap, fs_read(""), dir_read, file_read] (buffer.Buffer, bool, fail.Errors) {
    let e = errs;
    if o.plan_given {
        let (data, st, aux) = fsio.read_whole(heap, fs, root, paths.shown(planp), paths.full(planp), plan.max_bytes() + 1);
        if st == 1 || st == 2 {
            buffer.drop(heap, data);
            return (buffer.empty(heap, 1), false, fail.io_error(heap, e, aux, false, paths.shown(planp)));
        }
        if st == 3 {
            buffer.drop(heap, data);
            return (buffer.empty(heap, 1), false, wiredata.code_error(heap, e, codes.plan_limit(), 1, 0, 0));
        }
        return (data, true, e);
    }
    var b = buffer.empty(heap, 128);
    var i = 0;
    while i < len(argv.text(src, "step")) {
        if int_of(argv.text(src, "step")[i]) == ';' {
            b = buffer.push(heap, b, byte_of(10));
        } else {
            b = buffer.push(heap, b, argv.text(src, "step")[i]);
        }
        i = i + 1;
    }
    if len(argv.text(src, "step")) > 0 {
        b = buffer.push(heap, b, byte_of(10));
    }
    b = buffer.append(heap, b, "model kind=");
    b = buffer.append(heap, b, argv.text(src, "model"));
    b = buffer.append(heap, b, model_tokens);
    b = buffer.push(heap, b, byte_of(10));
    return (b, true, e);
}

// The plan of the command line, parsed (the text from --plan or from --step and the model)
pub fn make_plan[&h, &f, &r, &pp, &t, &cl](heap: &!h Heap, src: &cl [byte], fs: &f Fs(""), root: &r [byte], planp: &pp paths.Rp, tokens: &t [byte], o: verbs.Opts, errs: fail.Errors) -> [heap, fs_read(""), dir_read, file_read] (Planned, bool, fail.Errors) {
    let (ptxt, ok0, e0) = plan_source(heap, src, fs, root, planp, o, tokens, errs);
    return build_plan(heap, ptxt, ok0, o, e0);
}

// The plan parsed from its text (`ptxt`, consumed; `ok` false when the text could not be had: nothing is parsed), and the wired model it names with its hyperparameters
fn build_plan[&h](heap: &!h Heap, ptxt: buffer.Buffer, ok: bool, o: verbs.Opts, errs: fail.Errors) -> [heap] (Planned, bool, fail.Errors) {
    var e = errs;
    var go = ok;
    var pl = plan.empty(heap);
    var kind = 0;
    var ip = box_slice(heap, 8, 0);
    var fp = box_slice(heap, 8, 0.0);
    if go {
        borrow ptxt as &tr in {
            let (p2, pf2) = plan.parse(heap, buffer.bytes(tr));
            plan.drop(heap, pl);
            pl = p2;
            if pf2.code != 0 {
                e = wiredata.code_error(heap, e, pf2.code, pf2.a, pf2.b, pf2.c);
                go = false;
            }
        }
    }
    buffer.drop(heap, ptxt);
    if go {
        borrow pl as &pr in {
            let nm = plan.model_name(plan.model_kind(pr));
            kind = est.kind_named(nm);
            if kind == 0 {
                e = wiredata.not_built(heap, e, nm);
                go = false;
            } else {
                var bad = 0;
                borrow mut ip as &!iw in {
                    borrow mut fp as &!fw in {
                        bad = est.hparams(kind, plan.model_line(pr), contents(iw), contents(fw));
                    }
                }
                if bad != 0 {
                    e = wiredata.code_error(heap, e, codes.plan_bad_value(), 0, 0, 0);
                    go = false;
                }
            }
        }
    }
    return (Planned { pl: pl, kind: kind, ip: ip, fp: fp }, go, e);
}

// the CSV as a matrix of all its kept columns, the schema, the target's place and, for a classification, the two labels (c0 the negative, c1 the positive)
pub res struct Data {
    x: matrix.Matrix,
    sh: csv.Shape,
    sc: schema.Schema,
    tj: int,
    nrows: int,
    ncols: int,
    c0: int,
    c1: int,
    // the number of classes of a multiclass target (docs/multiclass.md), 2 for a binary one, 0 when there is no classification target; c0 and c1 are then the smallest and the largest label
    ncls: int,
    yall: Box[[float]],
    // the weight of every row (docs/weights.md section 2.4), empty without --weight; the column itself is dropped from the matrix
    wall: Box[[float]],
    // the group number of every row (docs/ranking.md section 2) and the number of groups, empty without --group; the column itself is dropped from the matrix
    gall: Box[[int]],
    ngroups: int,
    // whether the file was read with the categorical columns of --cat (docs/categorical-encoders.md): x and sc then hold the NUMERIC columns only, and the ids and
    // the vocabulary they refer to travel beside the Data (load_data answers them; a field cannot be borrowed by itself)
    cat: bool,
}

pub fn drop_data[&h](heap: &!h Heap, d: Data) -> [heap] int {
    let Data { x, sh, sc, tj, nrows, ncols, c0, c1, ncls, yall, wall, gall, ngroups, cat } = d;
    matrix.drop(heap, x);
    csv.drop_shape(heap, sh);
    schema.drop(heap, sc);
    unbox_slice(heap, yall);
    unbox_slice(heap, wall);
    unbox_slice(heap, gall);
    return nrows;
}

pub fn empty_data[&h](heap: &!h Heap) -> [heap] Data {
    return Data { x: matrix.empty(heap), sh: csv.empty_shape(heap), sc: schema.empty(heap), tj: 0, nrows: 0, ncols: 0, c0: 0, c1: 0, ncls: 0, yall: box_slice(heap, 2, 0.0), wall: box_slice(heap, 1, 0.0), gall: box_slice(heap, 1, 0), ngroups: 0, cat: false };
}

pub fn load_data[&h, &f, &r, &pf, &tn, &nn, &wp, &gq, &cl](heap: &!h Heap, src: &cl [byte], fs: &f Fs(""), root: &r [byte], file: &pf paths.Rp, o: verbs.Opts, tg: &tn [byte], na: &nn [byte], wn: &wp [byte], gn: &gq [byte], mixed_plan: bool, task: int, kind: int, errs: fail.Errors, log: buffer.Buffer) -> [heap, fs_read(""), dir_read, file_read] (Data, catmat.Ids, dict.Vocab, bool, fail.Errors, buffer.Buffer) {
    var e = errs;
    var lg = log;
    var go = true;
    var x = matrix.empty(heap);
    var sh = csv.empty_shape(heap);
    var rep = csv.Report { status: 0, line: 0, col: 0, aux: 0 };
    var code = 0;
    var ids = catmat.empty(heap);
    var voc = dict.empty_vocab(heap);
    if o.cat_given || mixed_plan {
        let l = csvload.load_cat_with(heap, src, fs, root, file, verbs.config(o, 0, 0, 0), verbs.cat_config(o), tg, false, dict.empty_vocab(heap), false, na);
        let (x2, ids2, voc2, sh2, rep2, code2) = csvload.cat_load_parts(l);
        matrix.drop(heap, x);
        csv.drop_shape(heap, sh);
        catmat.drop(heap, ids);
        dict.drop_vocab(heap, voc);
        x = x2;
        ids = ids2;
        voc = voc2;
        sh = sh2;
        rep = rep2;
        code = code2;
    } else {
        let (x2, sh2, rep2, code2) = csvload.load_t_rp(heap, src, fs, root, file, verbs.config(o, 0, 0, 0), tg, false);
        matrix.drop(heap, x);
        csv.drop_shape(heap, sh);
        x = x2;
        sh = sh2;
        rep = rep2;
        code = code2;
    }
    var tcol = 0 - 1;
    var tkind = 0;
    borrow sh as &sr in {
        tcol = csv.tcol(sr);
        if rep.status == 99 {
            e = fail.io_error(heap, e, rep.aux, false, paths.shown(file));
            go = false;
        } else if rep.status != 0 {
            e = verbs.explain(heap, src, e, rep, sr, o, paths.shown(file));
            go = false;
        } else if code != 0 {
            e = wiredata.code_error(heap, e, code, 0, 0, 0);
            go = false;
        } else if tcol < 0 && task != 4 {
            var w = fail.open_in(heap, spec.extra(), "ml.input.unknown-column", "--target names a column that is not in the header", "names are compared exactly, byte for byte");
            w = fail.no_repair(heap, w);
            w = fail.detail_open(heap, w);
            w = fail.detail_str(heap, w, "flag", "--target");
            w = fail.detail_text(heap, w, "name", tg);
            e = fail.add(heap, e, w);
            go = false;
        } else {
            if tcol >= 0 {
                tkind = csv.kind(sr, tcol);
            }
            lg = logrec.read(heap, lg, csv.rows(sr), csv.cols(sr), csv.bytes_read(sr));
        }
    }
    if !go {
        csv.drop_shape(heap, sh);
        matrix.drop(heap, x);
        catmat.drop(heap, ids);
        dict.drop_vocab(heap, voc);
        return (empty_data(heap), catmat.empty(heap), dict.empty_vocab(heap), false, e, lg);
    }
    var nrows = 0;
    var ncols = 0;
    borrow x as &xr in {
        nrows = matrix.rows(xr);
        ncols = matrix.cols(xr);
    }
    var tj = 0 - 1;
    var sc = schema.empty(heap);
    borrow sh as &sr in {
        schema.drop(heap, sc);
        if o.cat_given || mixed_plan {
            tj = catwire.numeric_index(sr, tg);
            sc = catwire.numeric_schema(heap, sr, tg);
        } else {
            tj = wiredata.kept_index(sr, tg);
            sc = wiredata.schema_of_shape(heap, sr, tg);
        }
    }
    var ncat = 0;
    borrow voc as &vcr in {
        ncat = dict.ncols(vcr);
    }
    if task == 2 && tkind != 1 {
        e = verbs.problem(heap, e, "ml.label.not-integer", "a classification target must be an integer column", "label the classes with integers", "", "");
        go = false;
    } else if task == 4 && ncols + ncat < 1 {
        e = verbs.problem(heap, e, "ml.input.empty", "the file has no column to cluster", "give a file with at least one column that is not dropped", "", "");
        go = false;
    } else if task != 4 && ncols + ncat < 2 {
        e = verbs.problem(heap, e, "ml.input.empty", "the file has no feature column besides the target", "give a file with at least one more column", "", "");
        go = false;
    }
    var yall = box_slice(heap, 2, 0.0);
    var c0 = 0;
    var c1 = 0;
    var ncls = 0;
    if go && task != 4 {
        let none = box_slice(heap, 1, 0);
        var bad = 0;
        borrow x as &xr in {
            borrow none as &nr in {
                let (ya, b2) = wiredata.take_col(heap, xr, contents(nr), 0 - 1, tj);
                unbox_slice(heap, yall);
                yall = ya;
                bad = b2;
            }
        }
        unbox_slice(heap, none);
        if bad > 0 {
            e = wiredata.empty_target(heap, e, tg, bad);
            go = false;
        } else if task == 2 && kind == 9 {
            // a multiclass target (docs/multiclass.md section 2): the classes are the distinct labels, ascending
            var labs = box_slice(heap, 2, 0);
            var kk = 0;
            borrow yall as &yq in {
                let (labs2, kk2) = mcdata.distinct(heap, contents(yq), nrows);
                unbox_slice(heap, labs);
                labs = labs2;
                kk = kk2;
            }
            if kk < 2 {
                e = verbs.problem(heap, e, "ml.label.single-class", "a classification target has one value", "a model needs both classes in the training rows", "", "");
                go = false;
            } else if kk > mcdata.max_classes() {
                var w = wiredata.open_tag(heap, "ml.limit.classes");
                w = fail.no_repair(heap, w);
                w = fail.detail_open(heap, w);
                w = fail.detail_int(heap, w, "max", mcdata.max_classes());
                e = fail.add(heap, e, w);
                go = false;
            } else if kk == 2 {
                var w = fail.open_in(heap, spec.extra(), "ml.param.out-of-range", "softmax is for a target with three to 64 classes", "a two-class target is fitted with --model logistic");
                w = fail.no_repair(heap, w);
                w = fail.detail_open(heap, w);
                w = fail.detail_str(heap, w, "flag", "--model");
                w = fail.detail_int(heap, w, "classes", 2);
                e = fail.add(heap, e, w);
                go = false;
            } else if o.positive_given {
                e = wiredata.conflict(heap, e, "positive", "a model of more than two classes has no positive label: its metrics are those of every class");
                go = false;
            } else {
                ncls = kk;
                borrow labs as &lr in {
                    c0 = contents(lr)[0];
                    c1 = contents(lr)[kk - 1];
                }
            }
            unbox_slice(heap, labs);
        } else if task == 2 {
            var cnt = 0;
            var a = 0;
            var b = 0;
            borrow yall as &yq in {
                let (c3, a3, b3) = distinct_labels(contents(yq), nrows);
                cnt = c3;
                a = a3;
                b = b3;
            }
            if cnt < 2 {
                e = verbs.problem(heap, e, "ml.label.single-class", "a classification target has one value", "a model needs both classes in the training rows", "", "");
                go = false;
            } else if cnt > 2 {
                if kind == 5 {
                    e = verbs.problem(heap, e, "ml.label.not-binary", "a classification target has more than two values", "a target of three or more classes is fitted with --model softmax", "", "");
                } else {
                    e = verbs.problem(heap, e, "ml.label.not-binary", "a classification target has more than two values", "only two-class targets are built", "", "");
                }
                go = false;
            } else {
                var hi = a;
                var lo = b;
                if b > a {
                    hi = b;
                    lo = a;
                }
                c1 = hi;
                c0 = lo;
                ncls = 2;
                if o.positive_given {
                    let pv = o.positive_v;
                    if pv == lo {
                        c1 = lo;
                        c0 = hi;
                    } else if pv != hi {
                        var w = fail.open_in(heap, spec.extra(), "ml.param.out-of-range", "--positive is not one of the two labels of the target", "the labels are in detail");
                        w = fail.no_repair(heap, w);
                        w = fail.detail_open(heap, w);
                        w = fail.detail_str(heap, w, "flag", "--positive");
                        w = fail.detail_int(heap, w, "value", pv);
                        w = fail.detail_int(heap, w, "label0", lo);
                        w = fail.detail_int(heap, w, "label1", hi);
                        e = fail.add(heap, e, w);
                        go = false;
                    }
                }
            }
        }
    }
    // the weights of --weight, read from the file again (the column is not in the matrix)
    var wall = box_slice(heap, 1, 0.0);
    if go && len(wn) > 0 {
        unbox_slice(heap, wall);
        let (w2, ok2, e2) = weightcol.read(heap, wn, fs, root, file, o, nrows, e);
        wall = w2;
        e = e2;
        go = ok2;
    }
    // the groups of --group, read from the file again (the column is not in the matrix), and the relevance (the target) checked (docs/ranking.md section 2)
    var gall = box_slice(heap, 1, 0);
    var ngroups = 0;
    if go && len(gn) > 0 {
        var rel_ok = true;
        borrow yall as &yq3 in {
            let (ok3, e3) = rankcol.check_relevance(heap, contents(yq3), nrows, tg, e);
            rel_ok = ok3;
            e = e3;
        }
        if !rel_ok {
            go = false;
        } else {
            unbox_slice(heap, gall);
            let (g2, ng2, ok4, e4) = rankcol.read(heap, gn, fs, root, file, o, nrows, e);
            gall = g2;
            ngroups = ng2;
            e = e4;
            go = ok4;
        }
    }
    return (Data { x: x, sh: sh, sc: sc, tj: tj, nrows: nrows, ncols: ncols, c0: c0, c1: c1, ncls: ncls, yall: yall, wall: wall, gall: gall, ngroups: ngroups, cat: o.cat_given || mixed_plan }, ids, voc, go, e, lg);
}

fn distinct_labels[&y](yv: &y [float], n: int) -> [] (int, int, int) {
    var count = 0;
    var a = 0;
    var b = 0;
    var i = 0;
    while i < n && count < 3 {
        let v = truncate(yv[i]);
        if count == 0 {
            a = v;
            count = 1;
        } else if v != a {
            if count == 1 {
                b = v;
                count = 2;
            } else if v != b {
                count = 3;
            }
        }
        i = i + 1;
    }
    return (count, a, b);
}

// the indices 0 .. cols - 1 but `skip`, in order
fn indices_but[&h](heap: &!h Heap, cols: int, skip: int) -> [heap] Box[[int]] {
    var out = box_slice(heap, cols + 1, 0);
    borrow mut out as &!ow in {
        var at = 0;
        var j = 0;
        while j < cols {
            if j != skip {
                contents(ow)[at] = j;
                at = at + 1;
            }
            j = j + 1;
        }
    }
    return out;
}

// the fitted steps and the estimator's parameters
pub res struct Trained {
    fitted: run.Fitted,
    wv: Box[[float]],
    // the payload of the model section of a model of the blob interface (the tree and the forest), else one byte
    blob: Box[[byte]],
    d: int,
    rows: int,
    // a clustering: the metrics of the training rows as a JSON object (docs/wiring-kmeans.md section 3), else empty
    report: buffer.Buffer,
}

pub fn drop_trained[&h](heap: &!h Heap, t: Trained) -> [heap] int {
    let Trained { fitted, wv, blob, d, rows, report } = t;
    run.drop_fitted(heap, fitted);
    unbox_slice(heap, wv);
    unbox_slice(heap, blob);
    buffer.drop(heap, report);
    return rows;
}

pub fn empty_trained[&h](heap: &!h Heap) -> [heap] Trained {
    return Trained { fitted: run.empty_fitted(heap), wv: box_slice(heap, 2, 0.0), blob: box_slice(heap, 1, byte_of(0)), d: 0, rows: 0, report: buffer.empty(heap, 1) };
}

// the feature columns of a table read for a fit: all of them, but the target when there is one
pub fn feature_count[&d](ds: &d Data) -> [] int {
    if ds.tj >= 0 {
        return ds.ncols - 1;
    }
    return ds.ncols;
}

// Fit the steps on the training rows (those of `sel` equal to `want`, all when want < 0), then the estimator on what the steps leave
pub fn train[&h, &dd, &ci, &cv, &pp, &s, &cl](heap: &!h Heap, src: &cl [byte], ds: &dd Data, cids: &ci catmat.Ids, cvoc: &cv dict.Vocab, pls: &pp Planned, sel: &s [int], want: int, o: verbs.Opts, retry_ok: bool, rep: int, fold: int, errs: fail.Errors) -> [heap, conc] (Trained, bool, fail.Errors) {
    var e = errs;
    var go = true;
    let nfeat = feature_count(ds);
    let featcols = indices_but(heap, ds.ncols, ds.tj);
    var xtr = matrix.empty(heap);
    var ytr = box_slice(heap, 2, 0.0);
    if nfeat > 0 {
        borrow featcols as &fr in {
            let (m2, code) = wiredata.take(heap, ds.x, sel, want, contents(fr), nfeat, o.max_rows, o.max_cols, o.max_cells);
            matrix.drop(heap, xtr);
            xtr = m2;
            if code != 0 {
                e = wiredata.code_error(heap, e, code, 0, 0, 0);
                go = false;
            }
        }
    }
    if go && ds.tj >= 0 {
        let (y2, bad) = wiredata.take_col(heap, ds.x, sel, want, ds.tj);
        unbox_slice(heap, ytr);
        ytr = y2;
    }
    var fitted = run.empty_fitted(heap);
    var xt = matrix.empty(heap);
    var fnames = names.empty(heap);
    if go {
        names.drop(heap, fnames);
        fnames = wiredata.feature_names(heap, ds.sc);
        if ds.cat {
            // categorical columns: the plan is fitted over the numeric features and the ids of the same training rows (docs/categorical-encoders.md section 6)
            let (idt, icode) = catwire.take_ids(heap, cids, sel, want, o.max_rows, o.max_cols, o.max_cells);
            if icode != 0 {
                e = wiredata.code_error(heap, e, icode, 0, 0, 0);
                go = false;
            } else {
                var trows = 0;
                borrow idt as &itr in {
                    trows = catmat.rows(itr);
                }
                borrow fnames as &nr in {
                    borrow xtr as &xr in {
                        borrow idt as &itr in {
                            let (f2, xt2, rem, flt) = mixed.fit(heap, pls.pl, nr, xr, trows, itr, cvoc, o.max_rows, o.max_cols, o.max_cells);
                            run.drop_fitted(heap, fitted);
                            matrix.drop(heap, xt);
                            fitted = f2;
                            xt = xt2;
                            if flt.code != 0 {
                                e = catwire.fault_error(heap, src, e, flt, pls.pl, cvoc, o.step_given && !o.plan_given);
                                go = false;
                            } else {
                                borrow rem as &remr in {
                                    if names.count(remr) > 0 {
                                        e = catwire.not_encoded(heap, e, cvoc, remr);
                                        go = false;
                                    }
                                }
                            }
                            names.drop(heap, rem);
                        }
                    }
                }
            }
            catmat.drop(heap, idt);
        } else {
            borrow fnames as &nr in {
                borrow xtr as &xr in {
                    let (f2, xt2, flt) = run.fit(heap, pls.pl, nr, xr, o.max_rows, o.max_cols, o.max_cells);
                    run.drop_fitted(heap, fitted);
                    matrix.drop(heap, xt);
                    fitted = f2;
                    xt = xt2;
                    if flt.code != 0 {
                        e = wiredata.code_error(heap, e, flt.code, flt.a, flt.b, flt.c);
                        go = false;
                    }
                }
            }
        }
    }
    if go {
        borrow xt as &xq in {
            borrow fitted as &fq in {
                let (mc, mlist) = wiredata.missing_columns(heap, xq, fq.nm);
                if mc > 0 && !est.takes_missing(pls.kind) {
                    borrow mlist as &lr in {
                        e = wiredata.missing_error(heap, src, e, mc, buffer.bytes(lr), retry_ok);
                    }
                    go = false;
                }
                buffer.drop(heap, mlist);
            }
        }
    }
    var d = 0;
    var rows = 0;
    var wv = box_slice(heap, 2, 0.0);
    var blob = box_slice(heap, 1, byte_of(0));
    var report = buffer.empty(heap, 1);
    if go && pls.kind == 9 {
        // a multiclass model (docs/multiclass.md section 3): the labels are the classes of the whole file; a class with no training row is refused
        let (labs, kk) = mcdata.distinct(heap, contents(ds.yall), ds.nrows);
        var fcode = 0;
        var fempty = 0 - 1;
        var fdiag = box_slice(heap, 8, 0.0);
        borrow xt as &xq in {
            borrow ytr as &yr in {
                borrow labs as &lbr in {
                    d = matrix.cols(xq);
                    rows = matrix.rows(xq);
                    let (fblob, fc, fd, fe) = mcwire.fit(heap, o.threads, xq, contents(yr), contents(lbr)[0..kk], kk, contents(pls.ip)[0], contents(pls.fp)[0]);
                    unbox_slice(heap, blob);
                    blob = fblob;
                    unbox_slice(heap, fdiag);
                    fdiag = fd;
                    fcode = fc;
                    fempty = fe;
                }
            }
        }
        if fcode == refuse.fit_collinear() {
            borrow fdiag as &dgr in {
                borrow fitted as &fq2 in {
                    e = fitfail.collinear(heap, src, e, pls.kind, contents(dgr), fq2.nm, contents(pls.fp)[0], o, rep, fold);
                }
            }
            go = false;
        } else if fcode == refuse.fit_separable() {
            borrow fdiag as &dgr in {
                e = fitfail.separable(heap, src, e, contents(dgr), contents(pls.ip)[0], contents(pls.fp)[0], o, rep, fold);
            }
            go = false;
        } else if fcode == rules.unseen_label() {
            borrow labs as &lbr2 in {
                e = mcwire.class_absent(heap, e, contents(lbr2)[fempty]);
            }
            go = false;
        } else if fcode != 0 {
            e = wiredata.code_error(heap, e, fcode, 0, 0, 0);
            go = false;
        }
        unbox_slice(heap, fdiag);
        unbox_slice(heap, labs);
    }
    if go && est.is_blob(pls.kind) && pls.kind != 9 {
        // the tree and the forest: the fitted model is a payload; missing cells go to the library with their bitmap (docs/wiring-trees.md section 5)
        borrow xt as &xq in {
            d = matrix.cols(xq);
            rows = matrix.rows(xq);
            var yfit = box_slice(heap, rows + 1, 0.0);
            let ptask = est.task_of(pls.kind, contents(pls.ip));
            if ptask == 4 {
                // k-means: the bounds on k, the features and the diagnostics are compared with the data before anything is allocated (docs/wiring-kmeans.md section 7)
                let which = wiredata.cluster_bound(contents(pls.ip)[0], contents(pls.ip)[1], rows, d);
                if which != 0 {
                    e = wiredata.cluster_error(heap, e, which, contents(pls.ip)[0], contents(pls.ip)[1], rows, d);
                    go = false;
                }
            }
            borrow mut yfit as &!yw in {
                borrow ytr as &yr in {
                    var i = 0;
                    while i < rows && ptask != 4 && go {
                        if ptask == 2 {
                            if truncate(contents(yr)[i]) == ds.c1 {
                                contents(yw)[i] = 1.0;
                            }
                        } else {
                            contents(yw)[i] = contents(yr)[i];
                        }
                        i = i + 1;
                    }
                }
            }
            if go && est.ranking(pls.kind, contents(pls.ip)) {
                // the pairwise ranking fit of the groups of the training rows (docs/ranking.md section 4)
                borrow yfit as &yfr in {
                    let (b2, ok2, e2) = rankcol.fit_blob(heap, pls.kind, o.threads, matrix.shape(xq), contents(xq.data), contents(xq.miss), matrix.wpc(xq), contents(yfr)[0..rows], contents(ds.wall), contents(ds.gall), ds.ngroups, sel, want, ds.nrows, contents(pls.ip), contents(pls.fp), o.seed, ds.c0, ds.c1, o.max_rows, o.max_cols, o.max_cells, e);
                    unbox_slice(heap, blob);
                    blob = b2;
                    e = e2;
                    go = ok2;
                }
            } else if go && len(contents(ds.wall)) > 1 {
                // a weight per training row (docs/weights.md section 2.5): the same rows as the labels
                let (wtr, any) = weightcol.gather(heap, contents(ds.wall), sel, want, ds.nrows);
                if !any {
                    var side: &static [byte] = "train";
                    if want < 0 {
                        side = "all";
                    }
                    e = weightcol.zero_total(heap, e, side);
                    go = false;
                } else {
                    borrow yfit as &yfr in {
                        borrow wtr as &wtr2 in {
                            let (b2, code) = est.fit_blob_weighted(heap, pls.kind, o.threads, matrix.shape(xq), contents(xq.data), contents(xq.miss), matrix.wpc(xq), contents(yfr)[0..rows], contents(wtr2)[0..rows], contents(pls.ip), contents(pls.fp), o.seed, ds.c0, ds.c1, o.max_rows, o.max_cols, o.max_cells);
                            unbox_slice(heap, blob);
                            blob = b2;
                            if code != 0 {
                                e = wiredata.code_error(heap, e, code, 0, 0, 0);
                                go = false;
                            }
                        }
                    }
                }
                unbox_slice(heap, wtr);
            } else if go {
                borrow yfit as &yfr in {
                    let (b2, code) = est.fit_blob(heap, pls.kind, o.threads, matrix.shape(xq), contents(xq.data), contents(xq.miss), matrix.wpc(xq), contents(yfr)[0..rows], contents(pls.ip), contents(pls.fp), o.seed, ds.c0, ds.c1, o.max_rows, o.max_cols, o.max_cells);
                    unbox_slice(heap, blob);
                    blob = b2;
                    if code != 0 {
                        e = wiredata.code_error(heap, e, code, 0, 0, 0);
                        go = false;
                    }
                }
            }
            if go && ptask == 4 {
                // the metrics of the training rows, through the same code as eval (the inertia is the library's final inertia: docs/wiring-kmeans.md section 3)
                borrow yfit as &yfr in {
                    borrow wv as &wr in {
                        borrow blob as &bq in {
                            let (mo, mplain, mund, fl) = wiredata.metrics_block(heap, pls.kind, 4, xq, contents(yfr)[0..rows], contents(wr), contents(bq), contents(pls.ip)[0], 0, 0, o.max_rows, false);
                            buffer.drop(heap, report);
                            report = mo;
                            buffer.drop(heap, mplain);
                            buffer.drop(heap, mund);
                            if fl.code != 0 {
                                e = wiredata.bad_metric(heap, e, fl);
                                go = false;
                            }
                        }
                    }
                }
            }
            unbox_slice(heap, yfit);
        }
    }
    if go && !est.is_blob(pls.kind) {
        borrow xt as &xq in {
            d = matrix.cols(xq);
            rows = matrix.rows(xq);
        }
        let kind = pls.kind;
        let outn = est.out_len(kind, d);
        var diagn = 0 - 1;
        diagn = est.diag_len(kind, d, contents(pls.ip));
        if d > common.max_features() {
            e = wiredata.too_wide(heap, e, d);
            go = false;
        } else if diagn < 0 {
            var w = fail.open_in(heap, spec.extra(), "ml.param.out-of-range", "iterations times features need more diagnostic space than a fit may take", "fewer iterations or fewer features");
            w = fail.no_repair(heap, w);
            w = fail.detail_open(heap, w);
            w = fail.detail_int(heap, w, "features", d);
            e = fail.add(heap, e, w);
            go = false;
        } else {
            unbox_slice(heap, wv);
            wv = box_slice(heap, outn + 1, 0.0);
            var diag = box_slice(heap, diagn + 1, 0.0);
            var yfit = box_slice(heap, rows + 1, 0.0);
            borrow mut yfit as &!yw in {
                borrow ytr as &yr in {
                    var i = 0;
                    while i < rows {
                        if est.task(kind) == 2 {
                            if truncate(contents(yr)[i]) == ds.c1 {
                                contents(yw)[i] = 1.0;
                            }
                        } else {
                            contents(yw)[i] = contents(yr)[i];
                        }
                        i = i + 1;
                    }
                }
            }
            var code = 0;
            if len(contents(ds.wall)) > 1 {
                // a weight per training row (docs/weights.md section 2.4): the same rows as the labels
                let (wtr, any) = weightcol.gather(heap, contents(ds.wall), sel, want, ds.nrows);
                if !any {
                    var side: &static [byte] = "train";
                    if want < 0 {
                        side = "all";
                    }
                    e = weightcol.zero_total(heap, e, side);
                    go = false;
                } else {
                    borrow xt as &xr in {
                        borrow yfit as &yfr in {
                            borrow wtr as &wtr2 in {
                                borrow mut wv as &!ww in {
                                    borrow mut diag as &!dw in {
                                        code = est.fit_weighted(heap, kind, o.threads, matrix.shape(xr), contents(xr.data), contents(yfr), contents(wtr2)[0..rows], contents(pls.ip), contents(pls.fp), o.seed, contents(ww), contents(dw));
                                    }
                                }
                            }
                        }
                    }
                }
                unbox_slice(heap, wtr);
            } else {
                borrow xt as &xr in {
                    borrow yfit as &yfr in {
                        borrow mut wv as &!ww in {
                            borrow mut diag as &!dw in {
                                code = est.fit(heap, kind, o.threads, matrix.shape(xr), contents(xr.data), contents(yfr), contents(pls.ip), contents(pls.fp), o.seed, contents(ww), contents(dw));
                            }
                        }
                    }
                }
            }
            if code == refuse.fit_collinear() {
                borrow diag as &dgr in {
                    borrow fitted as &fq2 in {
                        e = fitfail.collinear(heap, src, e, kind, contents(dgr), fq2.nm, contents(pls.fp)[0], o, rep, fold);
                    }
                }
            } else if code == refuse.fit_separable() {
                borrow diag as &dgr in {
                    e = fitfail.separable(heap, src, e, contents(dgr), contents(pls.ip)[0], contents(pls.fp)[0], o, rep, fold);
                }
            }
            unbox_slice(heap, diag);
            unbox_slice(heap, yfit);
            if code == refuse.fit_collinear() || code == refuse.fit_separable() {
                go = false;
            } else if code != 0 {
                e = wiredata.code_error(heap, e, code, 0, 0, 0);
                go = false;
            }
        }
    }
    matrix.drop(heap, xtr);
    matrix.drop(heap, xt);
    unbox_slice(heap, ytr);
    unbox_slice(heap, featcols);
    names.drop(heap, fnames);
    return (Trained { fitted: fitted, wv: wv, blob: blob, d: d, rows: rows, report: report }, go, e);
}

// the answer of a fit that wrote (or planned) the file `data`
fn answer_fit[&h, &f, &r, &po, &pt, &d, &s, &rj, &ac, &rn, &rt](heap: &!h Heap, fs: &f Fs(""), root: &r [byte], out: &po paths.Rp, trackp: &pt paths.Rp, o: verbs.Opts, name: &static [byte], task: &static [byte], rows: int, cols: int, tname: &s [byte], data: &d [byte], summary: buffer.Buffer, runjson: &rj [byte], action: &ac [byte], rec_name: &rn [byte], rec_text: &rt [byte], write_rec: bool, errs: fail.Errors, log: buffer.Buffer) -> [heap, fs_read(""), dir_read, dir_write, file_write] verbs.Out {
    var e = errs;
    var lg = log;
    var payload = buffer.empty(heap, 1);
    var plain = buffer.empty(heap, 1);
    var extra = buffer.empty(heap, 1);
    let hex = mfile.sha256_hex(heap, data);
    let big = len(data) > o.max_bytes;
    var ws = 0;
    var wa = 0;
    if big {
        e = verbs.model_too_large(heap, e, len(data), o.max_bytes);
    } else {
        let (ws2, wa2) = fsio.write_atomic(heap, fs, root, paths.shown(out), paths.full(out), data, o.overwrite, o.dry);
        ws = ws2;
        wa = wa2;
    }
    if big {
        ws = 0;
    } else if ws != 0 {
        e = verbs.write_failure(heap, e, ws, wa, paths.shown(out));
    } else {
        borrow hex as &hr in {
            let digest = buffer.bytes(hr);
            var w = json.writer(heap, 512);
            w = json.begin_object(heap, w);
            w = json.put_key(heap, w, "model");
            w = json.put_string(heap, w, name);
            w = json.put_key(heap, w, "task");
            w = json.put_string(heap, w, task);
            w = json.put_key(heap, w, "rows");
            w = json.put_int(heap, w, rows);
            w = json.put_key(heap, w, "columns");
            w = json.put_int(heap, w, cols);
            if len(tname) == 0 {
                // a clustering has no target
                w = json.put_key(heap, w, "target");
                w = json.put_null(heap, w);
            } else {
                w = verbs.put_name(heap, w, "target", tname);
            }
            w = verbs.put_name(heap, w, "path", paths.shown(out));
            w = json.put_key(heap, w, "bytes");
            w = json.put_int(heap, w, len(data));
            w = json.put_key(heap, w, "sha256");
            w = json.put_string(heap, w, digest);
            w = json.put_key(heap, w, "written");
            w = json.put_bool(heap, w, !o.dry);
            w = json.put_key(heap, w, "summary");
            borrow summary as &sr in {
                w = json.put_fragment(heap, w, buffer.bytes(sr));
            }
            if len(runjson) > 0 {
                w = json.put_key(heap, w, "run");
                w = json.put_fragment(heap, w, runjson);
            }
            w = json.end_object(heap, w);
            buffer.drop(heap, payload);
            payload = json.finish(w);
            if o.dry {
                var a = json.writer(heap, 256);
                a = json.begin_array(heap, a);
                a = json.begin_object(heap, a);
                a = json.put_key(heap, a, "op");
                if wa == 1 {
                    a = json.put_string(heap, a, "replace");
                } else {
                    a = json.put_string(heap, a, "create");
                }
                a = verbs.put_name(heap, a, "path", paths.shown(out));
                a = json.put_key(heap, a, "bytes");
                a = json.put_int(heap, a, len(data));
                a = json.put_key(heap, a, "sha256");
                a = json.put_string(heap, a, digest);
                a = json.end_object(heap, a);
                if len(action) > 0 {
                    a = json.put_fragment(heap, a, action);
                }
                a = json.end_array(heap, a);
                let arr = json.finish(a);
                buffer.drop(heap, extra);
                extra = buffer.append(heap, buffer.empty(heap, 64), ",\"dry_run\":true,\"planned_actions\":");
                borrow arr as &ar in {
                    extra = buffer.append(heap, extra, buffer.bytes(ar));
                }
                buffer.drop(heap, arr);
            }
            plain = buffer.append(heap, plain, "fit: ");
            plain = buffer.append(heap, plain, name);
            plain = buffer.push(heap, plain, byte_of(' '));
            plain = buffer.append(heap, plain, task);
            plain = buffer.append(heap, plain, ", ");
            plain = buffer.push_nat(heap, plain, rows);
            plain = buffer.append(heap, plain, " rows, ");
            if o.dry {
                plain = buffer.append(heap, plain, "would write ");
            } else {
                plain = buffer.append(heap, plain, "wrote ");
            }
            plain = buffer.append(heap, plain, paths.shown(out));
            plain = buffer.append(heap, plain, " (");
            plain = buffer.push_nat(heap, plain, len(data));
            plain = buffer.append(heap, plain, " bytes, sha256 ");
            plain = buffer.append(heap, plain, digest);
            plain = buffer.append(heap, plain, ")\n");
            if !o.dry {
                lg = logrec.write(heap, lg, len(data), digest);
                // the model is written: now the run record (nothing in the directory is replaced)
                if write_rec {
                    let (rs, ra) = track.write_in(heap, fs, root, trackp, rec_name, rec_text, false);
                    if rs != 0 {
                        e = verbs.write_failure(heap, e, rs, ra, paths.shown(trackp));
                    }
                }
            }
        }
    }
    buffer.drop(heap, hex);
    buffer.drop(heap, summary);
    return wiredata.out_of(payload, plain, extra, e, lg, o.dry);
}

// the summary of a fit as JSON: the plan, the coefficients, the labels, the split and the held-out metrics
// the coefficients and the intercept of a vector model
pub fn put_coefficients[&h, &pp](heap: &!h Heap, w0: json.Writer, tr: &pp Trained) -> [heap] json.Writer {
    var w = w0;
    w = json.put_key(heap, w, "coefficients");
    w = json.begin_array(heap, w);
    var j = 0;
    while j < tr.d {
        w = json.begin_object(heap, w);
        w = verbs.put_name(heap, w, "name", names.name(tr.fitted.nm, j));
        w = json.put_key(heap, w, "value");
        w = verbs.put_double(heap, w, bits_of(contents(tr.wv)[j]));
        w = json.end_object(heap, w);
        j = j + 1;
    }
    w = json.end_array(heap, w);
    w = json.put_key(heap, w, "intercept");
    return verbs.put_double(heap, w, bits_of(contents(tr.wv)[tr.d]));
}

// what the header of the payload of a tree or forest says (docs/models-tree.md section 7): the trees, their nodes and the parameters that shaped them
fn put_forest[&h, &b](heap: &!h Heap, w0: json.Writer, blob: &b [byte]) -> [heap] json.Writer {
    var w = w0;
    w = json.put_key(heap, w, "forest");
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "trees");
    w = json.put_int(heap, w, fbits.get64(blob, 28));
    w = json.put_key(heap, w, "nodes");
    w = json.put_int(heap, w, fbits.get64(blob, 52));
    w = json.put_key(heap, w, "bins");
    w = json.put_int(heap, w, fbits.get64(blob, 44));
    w = json.put_key(heap, w, "max_depth");
    w = json.put_int(heap, w, fbits.get64(blob, 60));
    w = json.put_key(heap, w, "min_leaf");
    w = json.put_int(heap, w, fbits.get64(blob, 68));
    w = json.put_key(heap, w, "mtry");
    w = json.put_int(heap, w, fbits.get64(blob, 76));
    w = json.end_object(heap, w);
    return w;
}

// what the header of the payload of a boosted model says (docs/models-boost.md section 5): the rounds kept and requested, the nodes, the learning rate and the base score;
// `best_round` is the round early stopping kept, present when early stopping ran
fn put_boost[&h, &b](heap: &!h Heap, w0: json.Writer, blob: &b [byte]) -> [heap] json.Writer {
    var w = w0;
    w = json.put_key(heap, w, "boost");
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "rounds");
    w = json.put_int(heap, w, fbits.get64(blob, 28));
    w = json.put_key(heap, w, "rounds_requested");
    w = json.put_int(heap, w, fbits.get64(blob, 84));
    w = json.put_key(heap, w, "nodes");
    w = json.put_int(heap, w, fbits.get64(blob, 52));
    w = json.put_key(heap, w, "bins");
    w = json.put_int(heap, w, fbits.get64(blob, 44));
    w = json.put_key(heap, w, "max_depth");
    w = json.put_int(heap, w, fbits.get64(blob, 60));
    w = json.put_key(heap, w, "min_leaf");
    w = json.put_int(heap, w, fbits.get64(blob, 68));
    w = json.put_key(heap, w, "learning_rate");
    w = verbs.put_double(heap, w, fbits.get64(blob, 124));
    w = json.put_key(heap, w, "base_score");
    w = verbs.put_double(heap, w, fbits.get64(blob, 116));
    if fbits.get64(blob, 76) > 0 {
        w = json.put_key(heap, w, "best_round");
        w = json.put_int(heap, w, fbits.get64(blob, 28));
    }
    w = json.end_object(heap, w);
    return w;
}

// what the fit of a clustering says about itself: the hyperparameters (k, the iterations, the initialisation) and the metrics of the training rows
fn put_clusters[&h, &pp, &ip](heap: &!h Heap, w0: json.Writer, tr: &pp Trained, ip: &ip [int]) -> [heap] json.Writer {
    var w = w0;
    w = json.put_key(heap, w, "clusters");
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "k");
    w = json.put_int(heap, w, ip[0]);
    w = json.put_key(heap, w, "iterations");
    w = json.put_int(heap, w, ip[1]);
    w = json.put_key(heap, w, "init");
    w = json.put_string(heap, w, wiredata.init_word(ip[2]));
    w = json.put_key(heap, w, "rows");
    w = json.put_int(heap, w, tr.rows);
    w = json.put_key(heap, w, "metrics");
    w = json.put_fragment(heap, w, buffer.bytes(tr.report));
    w = json.end_object(heap, w);
    return w;
}

fn fit_summary[&h, &pp, &dd, &sp, &tb, &ii, &xs, &xa](heap: &!h Heap, tr: &pp Trained, pl: &dd plan.Plan, kind: int, task: int, c0: int, c1: int, split: &sp buffer.Buffer, ntest: int, o: verbs.Opts, cat: bool, table: &tb [byte], ip: &ii [int], spec_text: &xs [byte], assign_json: &xa [byte]) -> [heap] buffer.Buffer {
    var w = json.writer(heap, 512);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "plan");
    w = json.put_string(heap, w, plan.text(pl));
    w = json.put_key(heap, w, "steps");
    w = json.put_int(heap, w, tr.fitted.n);
    if cat {
        w = catwire.put_categorical(heap, w, buffer.bytes(tr.fitted.payload));
        w = catwire.put_table(heap, w, table);
    }
    w = json.put_key(heap, w, "features");
    w = json.put_int(heap, w, tr.d);
    if task == 4 {
        w = put_clusters(heap, w, tr, ip);
    } else if kind == 9 {
        w = mcwire.put_summary(heap, w, contents(tr.blob), tr.d, tr.fitted.nm);
    } else if est.is_blob(kind) && record.get32(contents(tr.blob), 0) == kinds.model_boost() {
        w = put_boost(heap, w, contents(tr.blob));
    } else if est.is_blob(kind) {
        w = put_forest(heap, w, contents(tr.blob));
    } else {
        w = put_coefficients(heap, w, tr);
    }
    if task == 2 && kind != 9 {
        w = json.put_key(heap, w, "classes");
        w = json.begin_array(heap, w);
        w = json.put_int(heap, w, c0);
        w = json.put_int(heap, w, c1);
        w = json.end_array(heap, w);
        w = json.put_key(heap, w, "positive");
        w = json.put_int(heap, w, c1);
    }
    if o.split_given {
        w = json.put_key(heap, w, "split");
        w = json.begin_object(heap, w);
        w = json.put_key(heap, w, "train");
        w = json.put_int(heap, w, tr.rows);
        w = json.put_key(heap, w, "test");
        w = json.put_int(heap, w, ntest);
        w = json.put_key(heap, w, "seed");
        w = json.put_int(heap, w, o.seed);
        w = json.put_key(heap, w, "spec");
        w = json.put_string(heap, w, spec_text);
        if len(assign_json) > 0 {
            w = json.put_key(heap, w, "assignment");
            w = json.put_fragment(heap, w, assign_json);
        }
        w = json.end_object(heap, w);
        w = json.put_key(heap, w, "holdout");
        w = json.put_fragment(heap, w, buffer.bytes(split));
    }
    w = json.end_object(heap, w);
    return json.finish(w);
}

// the stored steps applied to a table: the numeric pipeline's when the file has no categorical column, else the mixed pipeline's
fn apply_any[&h, &p, &m, &i, &v](heap: &!h Heap, cat: bool, payload: &p [byte], x: &m matrix.Matrix, nrows: int, ids: &i catmat.Ids, voc: &v dict.Vocab, o: verbs.Opts) -> [heap] (matrix.Matrix, int, codes.Fault) {
    if cat {
        return mixed.apply_steps(heap, payload, x, nrows, ids, voc, o.max_rows, o.max_cols, o.max_cells);
    }
    return run.apply_steps(heap, payload, x, o.max_rows, o.max_cols, o.max_cells);
}

// ,"split":{...},"holdout":{...} for the rows --split held out, scored through the STORED steps and the fitted model
pub fn holdout[&h, &dd, &ci, &cv, &pp, &tt, &s, &cl](heap: &!h Heap, src: &cl [byte], ds: &dd Data, cids: &ci catmat.Ids, cvoc: &cv dict.Vocab, pls: &pp Planned, tr: &tt Trained, sel: &s [int], which: int, ntest: int, on: &static [byte], o: verbs.Opts, errs: fail.Errors) -> [heap] (buffer.Buffer, bool, fail.Errors) {
    var e = errs;
    var go = true;
    var w = json.writer(heap, 256);
    let nfeat = feature_count(ds);
    let featcols = indices_but(heap, ds.ncols, ds.tj);
    var xte = matrix.empty(heap);
    if nfeat > 0 {
        borrow featcols as &fr in {
            let (m3, code3) = wiredata.take(heap, ds.x, sel, which, contents(fr), nfeat, o.max_rows, o.max_cols, o.max_cells);
            matrix.drop(heap, xte);
            xte = m3;
            if code3 != 0 {
                e = wiredata.code_error(heap, e, code3, 0, 0, 0);
                go = false;
            }
        }
    }
    var idte = catmat.empty(heap);
    if go && ds.cat {
        let (idt, icode) = catwire.take_ids(heap, cids, sel, which, o.max_rows, o.max_cols, o.max_cells);
        catmat.drop(heap, idte);
        idte = idt;
        if icode != 0 {
            e = wiredata.code_error(heap, e, icode, 0, 0, 0);
            go = false;
        }
    }
    var mobj = buffer.empty(heap, 1);
    if go {
        if true {
            borrow xte as &xr in {
                borrow idte as &itr in {
                    let (xs, unk, f4) = apply_any(heap, ds.cat, buffer.bytes(tr.fitted.payload), xr, ntest, itr, cvoc, o);
                    if f4.code != 0 {
                        if ds.cat {
                            e = catwire.fault_error(heap, src, e, f4, pls.pl, cvoc, false);
                        } else {
                            e = wiredata.code_error(heap, e, f4.code, f4.a, f4.b, f4.c);
                        }
                        go = false;
                    } else {
                        borrow xs as &xq in {
                            let (mc, mlist) = wiredata.missing_columns(heap, xq, tr.fitted.nm);
                            if mc > 0 && !est.takes_missing(pls.kind) {
                                borrow mlist as &lr in {
                                    e = wiredata.missing_error(heap, src, e, mc, buffer.bytes(lr), false);
                                }
                                go = false;
                            }
                            buffer.drop(heap, mlist);
                        }
                    }
                    if go {
                        // a clustering has no target: the scores read no y, and c0 carries k
                        var yte = box_slice(heap, ntest + 1, 0.0);
                        var hc0 = ds.c0;
                        if ds.tj >= 0 {
                            let (y2, bad) = wiredata.take_col(heap, ds.x, sel, which, ds.tj);
                            unbox_slice(heap, yte);
                            yte = y2;
                        } else {
                            hc0 = contents(pls.ip)[0];
                        }
                        // a ranking model is scored by group (docs/ranking.md section 3): the groups of the held-out rows, renumbered
                        let (gte, gk) = rankcol.gather(heap, contents(ds.gall), ds.ngroups, sel, which, ds.nrows);
                        borrow yte as &yr in {
                            borrow xs as &xq2 in {
                                borrow gte as &gtr in {
                                    let (mo, mplain, mund, fl) = rankcol.block(heap, ds.ngroups > 0 && est.ranking(pls.kind, contents(pls.ip)), pls.kind, est.task_of(pls.kind, contents(pls.ip)), xq2, contents(yr), contents(tr.wv), contents(tr.blob), hc0, ds.c1, o.max_rows, false, contents(gtr), gk, argv.nat(src, "rank-k"), bytes.equal(argv.text(src, "gain"), "linear"));
                                    buffer.drop(heap, mobj);
                                    mobj = mo;
                                    buffer.drop(heap, mplain);
                                    buffer.drop(heap, mund);
                                    if fl.code != 0 {
                                        e = wiredata.bad_metric(heap, e, fl);
                                        go = false;
                                    }
                                }
                            }
                        }
                        unbox_slice(heap, yte);
                        unbox_slice(heap, gte);
                    }
                    matrix.drop(heap, xs);
                }
            }
        }
    }
    matrix.drop(heap, xte);
    catmat.drop(heap, idte);
    unbox_slice(heap, featcols);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "rows");
    w = json.put_int(heap, w, ntest);
    w = json.put_key(heap, w, "on");
    w = json.put_string(heap, w, on);
    w = json.put_key(heap, w, "metrics");
    borrow mobj as &mor in {
        if buffer.size(mor) > 0 {
            w = json.put_fragment(heap, w, buffer.bytes(mor));
        } else {
            w = json.put_null(heap, w);
        }
    }
    w = json.end_object(heap, w);
    buffer.drop(heap, mobj);
    let inner = json.finish(w);
    return (inner, go, e);
}

// the model file's bytes and the summary of the answer
fn assemble[&h, &dd, &ci, &cv, &pp, &tt, &s, &pv, &tn, &nn, &xs, &xa, &cl](heap: &!h Heap, src: &cl [byte], ds: &dd Data, cids: &ci catmat.Ids, cvoc: &cv dict.Vocab, pls: &pp Planned, tr: &tt Trained, sel: &s [int], ntest: int, pv: &pv [byte], want_rec: bool, o: verbs.Opts, tg: &tn [byte], na: &nn [byte], spec_text: &xs [byte], assign_json: &xa [byte], errs: fail.Errors) -> [heap] (buffer.Buffer, buffer.Buffer, buffer.Buffer, bool, fail.Errors) {
    var e = errs;
    let kind = pls.kind;
    var mp = box_slice(heap, 8, byte_of(0));
    var end = 0;
    if est.is_blob(kind) {
        // the payload was built by the fit: the library's, then the labels of a classification
        unbox_slice(heap, mp);
        mp = box_slice(heap, len(contents(tr.blob)) + 8, byte_of(0));
        end = len(contents(tr.blob));
        borrow mut mp as &!mw in {
            copy_into(contents(mw)[0..end], contents(tr.blob));
        }
    } else {
        unbox_slice(heap, mp);
        mp = box_slice(heap, est.payload_size(kind, tr.d) + 8, byte_of(0));
        borrow mut mp as &!mw in {
            end = est.encode(kind, contents(mw), 0, tr.d, contents(tr.wv), ds.c0, ds.c1);
        }
    }
    var fbytes = buffer.empty(heap, 1);
    var table = buffer.empty(heap, 1);
    var go = true;
    if ds.cat {
        // the schema of every column the model reads, the categorical ones with type 3; the steps become stubs and the vocabularies the string table (docs/stringtable.md)
        let fsc = catwire.full_schema(heap, ds.sh, tg);
        var spf = buffer.empty(heap, 1);
        var fcols = 0;
        borrow fsc as &fsr in {
            buffer.drop(heap, spf);
            spf = schema.encode(heap, fsr);
            fcols = schema.columns(fsr);
        }
        let (section, tbl, pf) = strtab.pack(heap, buffer.bytes(tr.fitted.payload), na, o.max_cats, o.max_str, o.max_pool, o.max_catcols);
        if pf.code != 0 {
            e = wiredata.code_error(heap, e, pf.code, pf.a, pf.b, pf.c);
            go = false;
        } else {
            borrow spf as &spr in {
                borrow section as &sr in {
                    borrow tbl as &tr2 in {
                        borrow mp as &mr in {
                            buffer.drop(heap, fbytes);
                            fbytes = file.encode_full(heap, plan.text(pls.pl), buffer.bytes(spr), buffer.bytes(sr), buffer.bytes(tr2), pv, contents(mr)[0..end], tr.rows, fcols, o.seed, built.compiler());
                        }
                    }
                }
            }
        }
        buffer.drop(heap, section);
        buffer.drop(heap, table);
        table = tbl;
        buffer.drop(heap, spf);
        schema.drop(heap, fsc);
    } else {
        let sp = schema.encode(heap, ds.sc);
        borrow sp as &spr in {
            borrow mp as &mr in {
                buffer.drop(heap, fbytes);
                fbytes = file.encode_full(heap, plan.text(pls.pl), buffer.bytes(spr), buffer.bytes(tr.fitted.payload), "", pv, contents(mr)[0..end], tr.rows, schema.columns(ds.sc), o.seed, built.compiler());
            }
        }
        buffer.drop(heap, sp);
    }
    unbox_slice(heap, mp);
    var split = buffer.empty(heap, 1);
    if go && o.split_given {
        let (sp2, ok6, e6) = holdout(heap, src, ds, cids, cvoc, pls, tr, sel, 1, ntest, "held-out", o, e);
        buffer.drop(heap, split);
        split = sp2;
        e = e6;
        go = ok6;
    }
    // the metrics of a run record (docs/tracking.md section 5.3): the held-out rows when there is a split, else the training rows, scored through the stored steps by the code of eval
    var rec = buffer.empty(heap, 1);
    if go && want_rec {
        if o.split_given {
            buffer.drop(heap, rec);
            borrow split as &spr in {
                rec = buffer.append(heap, buffer.empty(heap, buffer.size(spr) + 1), buffer.bytes(spr));
            }
        } else {
            let (rc2, ok8, e8) = holdout(heap, src, ds, cids, cvoc, pls, tr, sel, 0 - 1, ds.nrows, "train", o, e);
            buffer.drop(heap, rec);
            rec = rc2;
            e = e8;
            go = ok8;
        }
    }
    var summary = buffer.empty(heap, 1);
    if go {
        buffer.drop(heap, summary);
        borrow split as &spq in {
            borrow table as &tbr in {
                summary = fit_summary(heap, tr, pls.pl, kind, est.task_of(kind, contents(pls.ip)), ds.c0, ds.c1, spq, ntest, o, ds.cat, buffer.bytes(tbr), contents(pls.ip), spec_text, assign_json);
            }
        }
    }
    buffer.drop(heap, split);
    buffer.drop(heap, table);
    return (fbytes, summary, rec, go, e);
}

// What a fit makes before anything is written: the model file's bytes, the summary of the answer, the metrics of a run record, and the numbers the record holds. `make` is `fit` without the
// writing, so that `ml runs verify` refits in memory with the same code (docs/tracking.md section 5.4).
pub res struct Made {
    fbytes: buffer.Buffer,
    summary: buffer.Buffer,
    // the metrics object of the run record, empty when none was asked for
    rec: buffer.Buffer,
    // the canonical plan text
    ptext: buffer.Buffer,
    // the canonical text of the split (docs/splits.md section 2): none, or holdout ...
    splt: buffer.Buffer,
    // the SHA-256 of the training file, 32 raw bytes
    sha: buffer.Buffer,
    errs: fail.Errors,
    log: buffer.Buffer,
    ok: bool,
    kind: int,
    task: int,
    trows: int,
    cols: int,
    ntest: int,
    file_rows: int,
    file_bytes: int,
    features: int,
    steps: int,
}

pub fn drop_made[&h](heap: &!h Heap, m: Made) -> [heap] int {
    let Made { fbytes, summary, rec, ptext, splt, sha, errs, log, ok, kind, task, trows, cols, ntest, file_rows, file_bytes, features, steps } = m;
    buffer.drop(heap, fbytes);
    buffer.drop(heap, summary);
    buffer.drop(heap, rec);
    buffer.drop(heap, ptext);
    buffer.drop(heap, splt);
    buffer.drop(heap, sha);
    buffer.drop(heap, log);
    return fail.drop(heap, errs);
}

// The model file, the errors, the log and whether the file was made; the other products are dropped (a replay wants the bytes only)
pub fn made_file[&h](heap: &!h Heap, m: Made) -> [heap] (buffer.Buffer, fail.Errors, buffer.Buffer, bool) {
    let Made { fbytes, summary, rec, ptext, splt, sha, errs, log, ok, kind, task, trows, cols, ntest, file_rows, file_bytes, features, steps } = m;
    buffer.drop(heap, summary);
    buffer.drop(heap, rec);
    buffer.drop(heap, ptext);
    buffer.drop(heap, splt);
    buffer.drop(heap, sha);
    return (fbytes, errs, log, ok);
}

fn failed_made[&h](heap: &!h Heap, errs: fail.Errors, log: buffer.Buffer) -> [heap] Made {
    return Made { fbytes: buffer.empty(heap, 1), summary: buffer.empty(heap, 1), rec: buffer.empty(heap, 1), ptext: buffer.empty(heap, 1), splt: buffer.empty(heap, 1), sha: buffer.empty(heap, 1), errs: errs, log: log, ok: false, kind: 0, task: 0, trows: 0, cols: 0, ntest: 0, file_rows: 0, file_bytes: 0, features: 0, steps: 0 };
}

// Fit the model of the plan text `ptxt` (consumed; `ok` false when the text could not be had) on the file `file`, as `fit` does, and make its file. `tg` is the target's name and `na` the
// missing-value markers: they come from the command line, or from a record (a runtime text cannot be a field of Opts). `want_rec`: also score the rows for the run record.
pub fn make[&h, &f, &r, &pf, &tn, &nn, &wp, &gq, &sk, &cl](heap: &!h Heap, src: &cl [byte], fs: &f Fs(""), root: &r [byte], file: &pf paths.Rp, ptxt: buffer.Buffer, ok0: bool, tg: &tn [byte], na: &nn [byte], wn: &wp [byte], gn: &gq [byte], o: verbs.Opts, sp: splitspec.SplitOpts, spcol: &sk [byte], want_rec: bool, errs: fail.Errors, log: buffer.Buffer) -> [heap, fs_read(""), dir_read, file_read, conc] Made {
    var e = errs;
    var lg = log;
    let (pls, ok1, e1) = build_plan(heap, ptxt, ok0, o, e);
    e = e1;
    var go = ok1;
    var kind = 0;
    borrow pls as &pq in {
        kind = pq.kind;
    }
    var task = est.task(kind);
    borrow pls as &pq2 in {
        task = est.task_of(kind, contents(pq2.ip));
    }
    // --weight: only the models with a weighted fit (docs/weights.md section 2.4)
    if go && len(wn) > 0 && !est.weighted(kind) {
        e = weightcol.unsupported(heap, e);
        go = false;
    }
    // --target: a clustering has none and every other model needs one. The flag check of a command line with --model knows the model; with --plan it is the plan's
    if go && o.plan_given {
        if task == 4 && o.target_given {
            e = wiredata.conflict(heap, e, "target", "kmeans has no target: it clusters the rows by their features, so a label column is dropped with --drop");
            go = false;
        } else if task != 4 && !o.target_given {
            e = verbs.problem(heap, e, "args.required-flag", "fit needs --target, the column to predict", "ml fit --target NAME --output MODEL FILE", "flag", "--target");
            go = false;
        }
    }
    // a ranking task and --group go together, with a plan as with flags (docs/ranking.md section 2)
    if go {
        var rk = false;
        borrow pls as &rkq in {
            rk = est.ranking(kind, contents(rkq.ip));
        }
        if rk && len(gn) == 0 {
            e = rankcol.needs_group(heap, e);
            go = false;
        } else if !rk && len(gn) > 0 {
            e = rankcol.unsupported(heap, e);
            go = false;
        }
    }
    // early stopping keeps rows out of the fit: it is refused unless a held-out part is declared (docs/models-boost.md section 2.7)
    if go && !o.split_given {
        borrow pls as &npq in {
            if est.needs_split(kind, contents(npq.ip)) {
                e = wiredata.conflict(heap, e, "early-stopping", "early stopping keeps held-out rows: declare them with --split train=F");
                go = false;
            }
        }
    }
    // ... and its validation rows are a random tenth of the training rows: under a group or a time split that tenth would not respect the strategy, so the pair is refused
    if go && o.split_given && splitspec.strategy(sp) >= 2 {
        borrow pls as &npq2 in {
            if est.needs_split(kind, contents(npq2.ip)) {
                e = splitspec.early_stopping_combination(heap, e, src, splitspec.strategy(sp));
                go = false;
            }
        }
    }
    var mixed_plan = false;
    borrow pls as &mpq in {
        mixed_plan = plan.needs_mixed(mpq.pl);
    }
    var ds = empty_data(heap);
    var cids = catmat.empty(heap);
    var cvoc = dict.empty_vocab(heap);
    // the SHA-256 of the training file before it is read (docs/tracking.md section 6); a file that cannot be opened is reported by the read, which names the reason
    var h1 = buffer.empty(heap, 1);
    var size1 = 0;
    var hashed = false;
    if go {
        let (dg1, sz1, st1, ax1) = fsio.sha_rp(heap, fs, root, file);
        buffer.drop(heap, h1);
        h1 = dg1;
        size1 = sz1;
        hashed = st1 == 0;
    }
    if go {
        let (d2, ids2, voc2, ok2, e2, lg2) = load_data(heap, src, fs, root, file, o, tg, na, wn, gn, mixed_plan, task, kind, e, lg);
        drop_data(heap, ds);
        catmat.drop(heap, cids);
        dict.drop_vocab(heap, cvoc);
        ds = d2;
        cids = ids2;
        cvoc = voc2;
        e = e2;
        lg = lg2;
        go = ok2;
    }
    var dn = 0;
    borrow ds as &dq in {
        dn = dq.nrows;
    }
    var sel = box_slice(heap, dn + 1, 0);
    var want = 0 - 1;
    var ntest = 0;
    var spec_buf = buffer.empty(heap, 1);
    var assign_buf = buffer.empty(heap, 1);
    if go && o.split_given {
        var okh = false;
        var nt = 0;
        var sel2 = box_slice(heap, 2, 0);
        borrow ds as &dq1 in {
            let (s3, nt3, ok3, e3) = splitwire.holdout_sel(heap, src, fs, root, file, sp, spcol, o, dn, task, contents(dq1.yall), e);
            unbox_slice(heap, sel2);
            sel2 = s3;
            nt = nt3;
            okh = ok3;
            e = e3;
        }
        if !okh {
            unbox_slice(heap, sel2);
            go = false;
        } else {
            unbox_slice(heap, sel);
            sel = sel2;
            want = 0;
            ntest = nt;
            buffer.drop(heap, spec_buf);
            spec_buf = splitspec.text_nd(heap, false, o.split_num, o.split_den, 0, 0, splitspec.strategy(sp), spcol, o.seed);
            if sp.emit {
                borrow sel as &sq5 in {
                    buffer.drop(heap, assign_buf);
                    assign_buf = splitwire.json_vector(heap, contents(sq5), 0, dn);
                }
            }
        }
    }
    // a tree or forest fit takes at most params.rows_max() training rows (docs/wiring-trees.md section 6): counted here, before any copy of the rows is made
    if go && est.is_blob(kind) && task != 4 && kind != 9 {
        var ntrain = 0;
        borrow sel as &sq0 in {
            ntrain = wiredata.count_rows(contents(sq0), dn, want);
        }
        if ntrain > params.rows_max() {
            e = wiredata.tree_rows(heap, e, ntrain);
            go = false;
        }
    }
    var tr = empty_trained(heap);
    if go {
        var retry_ok = !o.plan_given && !o.step_given;
        var t2 = empty_trained(heap);
        var ok3 = false;
        borrow ds as &dr in {
            borrow cids as &cir in {
                borrow cvoc as &cvr in {
                    borrow pls as &pr in {
                        borrow sel as &sr in {
                            let (t3, ok4, e4) = train(heap, src, dr, cir, cvr, pr, contents(sr), want, o, retry_ok, 0, 0 - 1, e);
                            drop_trained(heap, t2);
                            t2 = t3;
                            ok3 = ok4;
                            e = e4;
                        }
                    }
                }
            }
        }
        drop_trained(heap, tr);
        tr = t2;
        go = ok3;
    }
    // the provenance section: the training file's identity and the range of each numeric feature over the training rows (docs/tracking.md section 2)
    var pv = buffer.empty(heap, 1);
    if go && !hashed {
        e = fail.io_error(heap, e, 0, false, paths.shown(file));
        go = false;
    }
    if go {
        borrow ds as &dr in {
            borrow sel as &sr in {
                borrow tr as &tq in {
                    let nf = feature_count(dr);
                    let fc = indices_but(heap, dr.ncols, dr.tj);
                    borrow fc as &fr in {
                        let (st, bad) = prov.stats(heap, dr.x, contents(sr), want, contents(fr), nf);
                        if bad != 0 {
                            e = wiredata.code_error(heap, e, refuse.fit_non_finite(), 0, 0, 0);
                            go = false;
                        } else {
                            borrow h1 as &hr in {
                                borrow st as &str in {
                                    buffer.drop(heap, pv);
                                    pv = provsec.pack(heap, size1, buffer.bytes(hr), dr.nrows, tq.rows, nf, contents(str));
                                }
                            }
                        }
                        unbox_slice(heap, st);
                    }
                    unbox_slice(heap, fc);
                }
            }
        }
    }
    var fbytes = buffer.empty(heap, 1);
    var summary = buffer.empty(heap, 1);
    var rec = buffer.empty(heap, 1);
    if go {
        borrow ds as &dr in {
            borrow cids as &cir in {
                borrow cvoc as &cvr in {
                    borrow pls as &pr in {
                        borrow tr as &tq in {
                            borrow sel as &sq in {
                                borrow spec_buf as &spb in {
                                    borrow assign_buf as &asb in {
                                        borrow pv as &pvr in {
                                            let (fb2, sm2, rc2, ok7, e7) = assemble(heap, src, dr, cir, cvr, pr, tq, contents(sq), ntest, buffer.bytes(pvr), want_rec, o, tg, na, buffer.bytes(spb), buffer.bytes(asb), e);
                                            buffer.drop(heap, fbytes);
                                            buffer.drop(heap, summary);
                                            buffer.drop(heap, rec);
                                            fbytes = fb2;
                                            summary = sm2;
                                            rec = rc2;
                                            e = e7;
                                            go = ok7;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    // the file must be the one that was read: hashed again after the fit, the digest must be the first one
    if go {
        let (dg2, sz2, st2, ax2) = fsio.sha_rp(heap, fs, root, file);
        var same = st2 == 0 && sz2 == size1;
        if same {
            borrow h1 as &hr1 in {
                borrow dg2 as &hr2 in {
                    same = bytes.equal(buffer.bytes(hr1), buffer.bytes(hr2));
                }
            }
        }
        buffer.drop(heap, dg2);
        if !same {
            e = verbs.problem(heap, e, "io.read-failed", "the training file changed while the fit read it: its SHA-256 before and after the fit differ", "fit again once the file is no longer being written", "", "");
            go = false;
        }
    }
    buffer.drop(heap, pv);
    var made = failed_made(heap, fail.empty_in(heap, spec.extra()), buffer.empty(heap, 1));
    if go {
        drop_made(heap, made);
        var cols = 0;
        var trows = 0;
        var is_cat = false;
        var nfeat = 0;
        var nsteps = 0;
        var file_rows = 0;
        borrow ds as &dr in {
            cols = schema.columns(dr.sc);
            is_cat = dr.cat;
            nfeat = feature_count(dr);
            file_rows = dr.nrows;
        }
        borrow tr as &tq in {
            trows = tq.rows;
            nsteps = tq.fitted.n;
        }
        if is_cat {
            // every column of the table, the categorical ones too
            borrow cvoc as &cvr in {
                cols = cols + dict.ncols(cvr);
            }
        }
        var ptext = buffer.empty(heap, 1);
        borrow pls as &pr in {
            buffer.drop(heap, ptext);
            ptext = buffer.append(heap, buffer.empty(heap, len(plan.text(pr.pl)) + 1), plan.text(pr.pl));
        }
        // the canonical text of the split the record holds: `none` without --split
        var spec_final = buffer.append(heap, buffer.empty(heap, 8), "none");
        if o.split_given {
            borrow spec_buf as &spf in {
                buffer.drop(heap, spec_final);
                spec_final = buffer.append(heap, buffer.empty(heap, buffer.size(spf) + 1), buffer.bytes(spf));
            }
        }
        made = Made { fbytes: fbytes, summary: summary, rec: rec, ptext: ptext, splt: spec_final, sha: h1, errs: e, log: lg, ok: true, kind: kind, task: task, trows: trows, cols: cols, ntest: ntest, file_rows: file_rows, file_bytes: size1, features: nfeat, steps: nsteps };
    } else {
        buffer.drop(heap, h1);
        buffer.drop(heap, summary);
        buffer.drop(heap, rec);
        buffer.drop(heap, fbytes);
        drop_made(heap, made);
        made = failed_made(heap, e, lg);
    }
    buffer.drop(heap, spec_buf);
    buffer.drop(heap, assign_buf);
    unbox_slice(heap, sel);
    drop_trained(heap, tr);
    drop_data(heap, ds);
    catmat.drop(heap, cids);
    dict.drop_vocab(heap, cvoc);
    drop_planned(heap, pls);
    return made;
}

pub fn fit[&h, &f, &r, &pf, &po, &pp, &t, &pt, &cl](heap: &!h Heap, src: &cl [byte], fs: &f Fs(""), root: &r [byte], file: &pf paths.Rp, out: &po paths.Rp, planp: &pp paths.Rp, trackp: &pt paths.Rp, tokens: &t [byte], o: verbs.Opts, sp: splitspec.SplitOpts, errs: fail.Errors, log: buffer.Buffer) -> [heap, fs_read(""), dir_read, dir_write, file_read, file_write, conc] verbs.Out {
    let (ptxt, ok0, e0) = plan_source(heap, src, fs, root, planp, o, tokens, errs);
    let m = make(heap, src, fs, root, file, ptxt, ok0, argv.text(src, "target"), argv.text(src, "na-values"), argv.text(src, "weight"), argv.text(src, "group"), o, sp, splitspec.column(src, sp), o.track_given, e0, log);
    var made_ok = false;
    var kind = 0;
    var task = 0;
    var trows = 0;
    var cols = 0;
    borrow m as &mq in {
        made_ok = mq.ok;
        kind = mq.kind;
        task = mq.task;
        trows = mq.trows;
        cols = mq.cols;
    }
    var result = verbs.nothing(heap, fail.empty_in(heap, spec.extra()), buffer.empty(heap, 1));
    if !made_ok {
        let Made { fbytes, summary, rec, ptext, splt, sha, errs, log, ok, kind, task, trows, cols, ntest, file_rows, file_bytes, features, steps } = m;
        buffer.drop(heap, fbytes);
        buffer.drop(heap, summary);
        buffer.drop(heap, rec);
        buffer.drop(heap, ptext);
        buffer.drop(heap, splt);
        buffer.drop(heap, sha);
        verbs.drop_out(heap, result);
        return verbs.nothing(heap, errs, log);
    }
    // the run record, when --track was given: every check is made before the model file or the record is written
    var recbuf = buffer.empty(heap, 1);
    var idbuf = buffer.empty(heap, 1);
    var write_rec = false;
    var track_ok = true;
    var terrs = fail.empty_in(heap, spec.extra());
    if o.track_given {
        borrow m as &mq in {
            var sum_order = 0 - 1;
            if est.kind_of(mq.kind) >= kinds.first_ordered_model() {
                sum_order = kinds.sum_order_for(est.kind_of(mq.kind));
            }
            let (rb, ib, wr, te) = track.plan(heap, fs, root, trackp, paths.shown(file), paths.shown(out), buffer.bytes(mq.fbytes), buffer.bytes(mq.sha), mq.file_bytes, mq.file_rows, mq.trows, mq.ntest, mq.features, mq.steps, argv.text(src, "target"), mq.task != 4, rankcol.word(mq.task, len(argv.text(src, "group")) > 0), buffer.bytes(mq.ptext), buffer.bytes(mq.splt), buffer.bytes(mq.rec), sum_order, argv.text(src, "na-values"), src, o, fail.empty_in(heap, spec.extra()));
            buffer.drop(heap, recbuf);
            buffer.drop(heap, idbuf);
            recbuf = rb;
            idbuf = ib;
            write_rec = wr;
            fail.drop(heap, terrs);
            terrs = te;
        }
        borrow terrs as &ter in {
            track_ok = fail.count(ter) == 0;
        }
    }
    let Made { fbytes, summary, rec, ptext, splt, sha, errs, log, ok, kind, task, trows, cols, ntest, file_rows, file_bytes, features, steps } = m;
    buffer.drop(heap, rec);
    buffer.drop(heap, ptext);
    buffer.drop(heap, splt);
    buffer.drop(heap, sha);
    if !track_ok {
        // the errors of the record (the fit itself had none: it was made)
        fail.drop(heap, errs);
        buffer.drop(heap, summary);
        verbs.drop_out(heap, result);
        result = verbs.nothing(heap, terrs, log);
    } else {
        fail.drop(heap, terrs);
        let e = errs;
        var runjson = buffer.empty(heap, 1);
        var action = buffer.empty(heap, 1);
        var rname = buffer.empty(heap, 1);
        if o.track_given {
            borrow idbuf as &idr in {
                borrow recbuf as &rcr in {
                    let (nm, rj, ac) = track.answer_parts(heap, buffer.bytes(idr), paths.shown(trackp), buffer.bytes(rcr), write_rec, o.dry);
                    buffer.drop(heap, rname);
                    buffer.drop(heap, runjson);
                    buffer.drop(heap, action);
                    rname = nm;
                    runjson = rj;
                    action = ac;
                }
            }
        }
        verbs.drop_out(heap, result);
        borrow fbytes as &fb in {
            borrow runjson as &rjr in {
                borrow action as &acr in {
                    borrow rname as &rnr in {
                        borrow recbuf as &rcr in {
                            result = answer_fit(heap, fs, root, out, trackp, o, est.name(kind), rankcol.word(task, len(argv.text(src, "group")) > 0), trows, cols, argv.text(src, "target"), buffer.bytes(fb), summary, buffer.bytes(rjr), buffer.bytes(acr), buffer.bytes(rnr), buffer.bytes(rcr), write_rec, e, log);
                        }
                    }
                }
            }
        }
        buffer.drop(heap, runjson);
        buffer.drop(heap, action);
        buffer.drop(heap, rname);
    }
    buffer.drop(heap, recbuf);
    buffer.drop(heap, idbuf);
    buffer.drop(heap, fbytes);
    return result;
}
