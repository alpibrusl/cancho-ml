edition 5;

module serve.sspec;

// What `ml-serve` says about itself (docs/serving-http.md section 2): the flag table that drives the parser, `introspect` and `skill`, the rules of its own beside
// the shared catalogue, and the limits. Written by hand (the tables of `ml` and `ml-predict` are generated from the model manifests; the flags of the server are
// not a model's). Format as spec.cho: entries separated by `;`, fields by `|`, so no help text holds either character.

import toolbox.describe;

// name|short|kind|role|default|help
pub fn flag_table() -> [] &static [byte] {
    return "root||path|root||resolve --model-file and --token-file beneath this directory, following no symbolic link, and refuse paths outside it;model-file||path|path-read||the model file to serve, read once at start;port||nat|none|8080|the TCP port to listen on, 1 to 65535. The server listens on every address of the host (the pinned compiler has no way to bind one address);token-file||path|path-read||a file holding the bearer token every request but GET /health must carry, read once at start. One of --token-file and --no-token is required;no-token||bool|none||serve with no token: every host that can reach the port can call the model. One of --token-file and --no-token is required;max-body-bytes||nat|none|1048576|the largest request body, in bytes. A request whose head and body do not fit are answered 413 by the server loop;max-batch-rows||nat|none|100|the most records in one POST /predict/batch, 1 to 1000. More is 413;idle-seconds||nat|none|10|a connection that makes no progress for this many seconds is closed;max-bytes||nat|none|16777216|the largest model file, in bytes;max-out-of-range||nat|none||refuse a request with ml.predict.out-of-range (HTTP 422) when more of its rows than this hold a numeric feature outside the range of the training rows stored in the model file (0 refuses any). Absent, the answer reports the counts and no bound applies";
}

// tag|exit|repairable|summary: the tags `toolbox.rules` does not have. The ml.* ones are the tags of ml's own table that a start-up can reach (the model file is read and
// described exactly as `ml describe` does), with the same text.
pub fn extra() -> [] &static [byte] {
    return "ml.predict.out-of-range|8|never|more rows of the request hold a numeric feature outside the range the model was fitted on than --max-out-of-range allows. The number of rows, the bound, the first column and the first row are in detail. Hint: check where the data comes from, or restart the server with a larger --max-out-of-range. Repair: none.;ml.param.out-of-range|2|never|a numeric flag is below its minimum or above its ceiling. Hint: the range is in detail and in introspect limits. Repair: none.;ml.model.bad-magic|8|never|the file does not start with CML1. Hint: this is not a cancho-ml model file. Repair: none.;ml.model.version|8|never|the file has a format version this reader does not know, or a model of kind 4 to 7 made with a summation order this reader does not implement (sum_order and known in detail). Hint: refit with this version of ml. Repair: none.;ml.model.truncated|8|never|the file ends before the end the header and the section lengths promise, or a length runs past the end. Hint: copy the file again. Repair: none.;ml.model.checksum|8|never|the SHA-256 at the end of the file is not the hash of the bytes before it. Hint: the file changed after it was written. Repair: none.;ml.model.malformed|8|never|the file passes the checksum but a section is not what the format allows. The section is in detail. Hint: refit. Repair: none.;ml.model.string-table|8|never|the string table of a model file (the fitted vocabulary of its categorical steps) is damaged, passes a bound, or disagrees with the steps, the plan or the schema of its own file. The reason, the step and the section are in detail. Hint: refit the model, or copy the file again. Repair: none.;serve.no-token|2|never|ml-serve was started with neither --token-file nor --no-token. Hint: the pinned compiler listens on every address of the host, so a token is required unless --no-token says that every host that can reach the port may call the model. Repair: none.;serve.token|8|never|the token file is empty, longer than 4096 bytes, or holds a byte outside ! to ~ after one trailing line break is removed. Hint: write the token alone in the file, printable ASCII without spaces. Repair: none.;serve.column-name|8|never|a column name of the model is not UTF-8 text, so it cannot be a JSON key. Hint: refit the model with a column named in UTF-8. Repair: none.;serve.document-too-large|8|never|the OpenAPI document or the model description of this model is larger than 60000 bytes even without the category lists, so no answer could be sent safely. Hint: fit the model on fewer columns. Repair: none.;serve.listen|5|never|the port cannot be bound: it is in use, or needs a privilege. Hint: give another --port. Repair: none.;ml.predict.non-finite|8|never|a prediction, a probability or a squared distance of a row is NaN or infinite, which no answer can write as a number. The row of the file (1-based) and the column of the answer are in detail. Hint: scale the inputs, or check or drop the row. Repair: none.;serve.internal|1|never|the server could not build an answer it must be able to build. Hint: this is a bug of ml-serve; the model file and the request are not the cause. Repair: none.";
}

// the rules ml-serve can emit at start-up (a request is answered with `rule` in a problem+json, docs/serving-http.md section 5.3)
pub fn rules() -> [] &static [byte] {
    return "args.unknown-flag;args.missing-value;args.bad-value;args.unexpected-value;args.duplicate-flag;args.conflict;args.unknown-command;args.too-many-operands;args.required-flag;path.empty;path.dotdot;path.absolute;path.outside-root;path.too-long;path.symlink;path.bad-name;io.not-found;io.not-a-directory;io.is-a-directory;io.permission-denied;io.read-failed;limit.input-too-large;ml.param.out-of-range;ml.model.bad-magic;ml.model.version;ml.model.truncated;ml.model.checksum;ml.model.malformed;ml.model.string-table;serve.no-token;serve.token;serve.column-name;serve.document-too-large;serve.listen;ml.predict.non-finite;serve.internal;ml.predict.out-of-range";
}

// name|default|ceiling
pub fn limits() -> [] &static [byte] {
    return "port|8080|65535;max-body-bytes|1048576|4194304;max-batch-rows|100|1000;idle-seconds|10|3600;max-bytes|16777216|268435456;max-out-of-range|0|1000000000";
}

pub fn tool() -> [] describe.Tool {
    return describe.Tool { name: "ml-serve", version: "0.1.0", summary: "Serve one trained model file over HTTP with cancho-web. POST /predict takes one record (a JSON object with one member per column of the model) and POST /predict/batch takes {\"rows\": [record, ...]}; GET /model is what the model file requires of a caller, GET /openapi.json the OpenAPI 3.1 document generated from the model's columns, GET /health a liveness answer. Every answer carries the SHA-256 of the model file. The model file is read once at start; reload is a restart. The server is one thread, bounds the body, the rows and the idle time, answers refusals as application/problem+json with the rule tag in a rule field, listens on every address of the host (the pinned compiler cannot bind one) and so requires --token-file (a bearer token) or --no-token. Its authority row has the sockets, the clock and the model file, and no write, no exec and no foreign code.", usage: "ml-serve [--root DIR] --model-file MODEL (--token-file FILE | --no-token) [--port N] [--max-body-bytes N] [--max-batch-rows N] [--idle-seconds N] [--max-bytes N] [--max-out-of-range N]\nml-serve introspect|skill\n\nGET /health, GET /model, GET /openapi.json, POST /predict, POST /predict/batch. Paths are relative to --root when given (absolute paths, .. and symbolic links are refused). The server runs until it is killed.", output: "document", schema: "ml.v1", flags: flag_table(), operands: "", rules: rules(), extra_rules: extra(), limits: limits(), reversibility: "reversible-cheap", stdin: "", guarantees: "deterministic;idempotent" };
}
