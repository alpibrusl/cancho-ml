{
  "openapi": "3.1.0",
  "info": {
    "title": "ml-serve",
    "version": "0.1.0",
    "summary": "Serve one trained model",
    "description": "Serves the model file with SHA-256 625863a5ae5ab9dd4596a3cdc0940196b0704d75a9c460f0fd2fc20b30e5c65e. The record schema is built from the columns of the file."
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Liveness, and the digest of the model being served",
        "responses": {
          "200": {
            "description": "alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "model_sha256": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "model_sha256"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/model": {
      "get": {
        "operationId": "getModel",
        "summary": "What the model file requires of a caller",
        "description": "The answer of `ml describe` for the served file: the model, the plan, the columns, the vocabularies and the answer's columns.",
        "responses": {
          "200": {
            "description": "the description",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "model": {
                      "type": "string"
                    },
                    "task": {
                      "type": "string"
                    },
                    "plan": {
                      "type": "string"
                    },
                    "file": {
                      "type": "object",
                      "properties": {
                        "sha256": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "sha256"
                      ]
                    }
                  },
                  "required": [
                    "model",
                    "task",
                    "plan",
                    "file"
                  ]
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenapi",
        "summary": "This document",
        "responses": {
          "200": {
            "description": "the OpenAPI document",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/predict": {
      "post": {
        "operationId": "predictOne",
        "summary": "Predict from one record",
        "description": "One JSON object with a member for every column of the model. A column the model fills in itself is not a member. The answer holds the model's prediction and the digest of the model file.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Record"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "the prediction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Prediction"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/predict/batch": {
      "post": {
        "operationId": "predictBatch",
        "summary": "Predict from a batch of records",
        "description": "A JSON object with the member rows, a list of records as POST /predict takes them. The answer has a row for each record, in the order sent.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Batch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "the predictions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Prediction"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Problem": {
        "description": "a problem",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Record": {
        "type": "object",
        "properties": {
          "c0": {
            "type": [
              "string",
              "null"
            ]
          },
          "c1": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "NA",
              "w",
              "x",
              "y",
              "z",
              null
            ]
          },
          "n": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": -999999999999,
            "maximum": 999999999999
          },
          "y": {}
        },
        "required": [
          "c0",
          "c1",
          "n"
        ],
        "additionalProperties": false
      },
      "Batch": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "c0": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "c1": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "NA",
                    "w",
                    "x",
                    "y",
                    "z",
                    null
                  ]
                },
                "n": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": -999999999999,
                  "maximum": 999999999999
                },
                "y": {}
              },
              "required": [
                "c0",
                "c1",
                "n"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 100
          }
        },
        "required": [
          "rows"
        ],
        "additionalProperties": false
      },
      "Prediction": {
        "type": "object",
        "properties": {
          "model_sha256": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "row_count": {
            "type": "integer",
            "minimum": 0
          },
          "unknown_categories": {
            "type": "integer",
            "minimum": 0
          },
          "out_of_range": {}
        },
        "required": [
          "model_sha256",
          "model",
          "task",
          "columns",
          "rows",
          "row_count",
          "unknown_categories",
          "out_of_range"
        ],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "rule": {
            "type": "string"
          },
          "model_sha256": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pointer": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "pointer",
                "code",
                "detail"
              ],
              "additionalProperties": false
            }
          },
          "error": {}
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "additionalProperties": false
      }
    }
  }
}
