module ml.fbits;

import std.math;

// Exact float <-> bit pattern, for model bytes (design.md sections 3 and 4.1). cancho has bits_of and no inverse
// (floating-point.md 4.1), so a stored double is rebuilt from integers: the significand as float_of (below 2^53, exact), times
// an exact power of two from a table computed at compile time. Zero and subnormals go through ldexp. Inf and NaN are refused
// (decode answers NaN and `load` counts it). Code of the spikes (spike_l.cho), the table now a `static`.

// 2^(e - 1075) for e = 1..2046 (index 0 unused): the scale of a normal number's 53-bit significand
static scale: [float] {
    let t = alloc_slice[static](2047, 0.0);
    var e = 1;
    while e < 2047 {
        t[e] = math.ldexp(1.0, e - 1075);
        e = e + 1;
    }
    return t;
}

// the 8 bytes at `at`, little-endian, as an int (the bit pattern)
pub fn get64[&s](src: &s [byte], at: int) -> [] int {
    var v = 0;
    var k = 7;
    while k >= 0 {
        v = v << 8 | int_of(src[at + k]);
        k = k - 1;
    }
    return v;
}

// write the bit pattern little-endian at `at`
pub fn put64[&d](dst: &!d [byte], at: int, bits: int) -> [] int {
    var k = 0;
    while k < 8 {
        dst[at + k] = byte_of(bits >> 8 * k & 255);
        k = k + 1;
    }
    return 0;
}

// the binary64 whose bits are `bits`; inf and NaN answer NaN
pub fn decode(bits: int) -> [] float {
    let e = bits >> 52 & 2047;
    let m = bits & 4503599627370495;
    var v = 0.0;
    if e == 2047 {
        return 0.0 / 0.0;
    }
    if e == 0 {
        v = math.ldexp(float_of(m), 0 - 1074);
    } else {
        v = float_of(m + 4503599627370496) * scale[e];
    }
    if bits < 0 {
        v = v * (0.0 - 1.0);
    }
    return v;
}

// decode `count` doubles from src into out; answers the number refused (inf, NaN) or not reproduced bit for bit
pub fn load[&s, &o](src: &s [byte], at: int, out: &!o [float], count: int) -> [] int {
    var bad = 0;
    var i = 0;
    while i < count {
        let bits = get64(src, at + i * 8);
        let v = decode(bits);
        if v != v {
            bad = bad + 1;
        } else if bits_of(v) != bits {
            bad = bad + 1;
        }
        out[i] = v;
        i = i + 1;
    }
    return bad;
}

// encode `count` doubles into dst, little-endian, row-major as given
pub fn store[&s, &d](src: &s [float], dst: &!d [byte], at: int, count: int) -> [] int {
    var i = 0;
    while i < count {
        put64(dst, at + i * 8, bits_of(src[i]));
        i = i + 1;
    }
    return 0;
}
