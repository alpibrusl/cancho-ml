import std.test;
import ml.rng;
import ml.refuse;
import linalg.tensor;
import linalg.chol;
import lref;

fn mat(off: int, rows: int, cols: int, rs: int, cs: int) -> [] tensor.Tensor {
    match tensor.matrix_strided(off, rows, cols, rs, cs) {
        tensor.Made::Ok(t) => {
            return t;
        }
        tensor.Made::Err(c) => {
            return tensor.Tensor { off: 0, rank: 0, s0: 0, s1: 0, s2: 0, s3: 0, t0: 0, t1: 0, t2: 0, t3: 0 };
        }
    }
}

fn vec1(off: int, n: int, stride: int) -> [] tensor.Tensor {
    match tensor.vector(off, n, stride) {
        tensor.Made::Ok(t) => {
            return t;
        }
        tensor.Made::Err(c) => {
            return tensor.Tensor { off: 0, rank: 0, s0: 0, s1: 0, s2: 0, s3: 0, t0: 0, t1: 0, t2: 0, t3: 0 };
        }
    }
}

// lower-triangle bits equal; the strict upper triangle keeps its sentinel
fn lower_same[&a, &b](x: &a [float], y: &b [float], d: int) -> [] int {
    var bad = 0;
    var i = 0;
    while i < d {
        var j = 0;
        while j < d {
            if bits_of(x[i * d + j]) != bits_of(y[i * d + j]) {
                bad = bad + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return bad;
}

fn one[&h](heap: &!h Heap, d: int, seed: int, mode: int) -> [heap] int {
    var bad = 0;
    let a = box_slice(heap, d * d + 1, 0.0);
    let ac = box_slice(heap, d * d + 1, 0.0);
    let want = box_slice(heap, d * d + 1, 9.0);
    let got = box_slice(heap, d * d + 1, 9.0);
    let gotc = box_slice(heap, d * d + 1, 9.0);
    let b = box_slice(heap, d + 1, 0.0);
    let xw = box_slice(heap, d + 1, 0.0);
    let xg = box_slice(heap, d + 1, 0.0);
    let xwt = box_slice(heap, d + 1, 0.0);
    let xgt = box_slice(heap, d + 1, 0.0);
    borrow mut a as &!aw in {
        lref.gen_spd(contents(aw), d, seed, mode);
    }
    borrow a as &ar in {
        borrow mut ac as &!acw in {
            var i = 0;
            while i < d {
                var j = 0;
                while j < d {
                    contents(acw)[j * d + i] = contents(ar)[i * d + j];
                    j = j + 1;
                }
                i = i + 1;
            }
        }
    }
    borrow mut b as &!bw in {
        lref.gen(contents(bw), d, seed + 5, 0);
    }
    borrow a as &ar in {
        borrow ac as &acr in {
            borrow mut want as &!ww in {
                if lref.chol(contents(ar), 0, d, 1, contents(ww), 0, d, 1, d) != 0 {
                    bad = bad + 1;
                }
            }
            borrow mut got as &!gw in {
                bad = bad + chol.cholesky(mat(0, d, d, d, 1), contents(ar), mat(0, d, d, d, 1), contents(gw));
            }
            // column-major A (the lower triangle of the transpose is the same symmetric matrix) and column-major L output
            borrow mut gotc as &!gw in {
                bad = bad + chol.cholesky(mat(0, d, d, 1, d), contents(acr), mat(0, d, d, d, 1), contents(gw));
            }
        }
    }
    borrow want as &x in {
        borrow got as &y in {
            borrow gotc as &z in {
                bad = bad + lower_same(contents(x), contents(y), d) + lower_same(contents(x), contents(z), d);
            }
        }
    }
    // the solves with the factor
    borrow want as &lr in {
        borrow b as &br in {
            borrow mut xw as &!w1 in {
                lref.solve(0, contents(lr), 0, d, 1, contents(br), contents(w1), d);
            }
            borrow mut xwt as &!w2 in {
                lref.solve(1, contents(lr), 0, d, 1, contents(br), contents(w2), d);
            }
            borrow mut xg as &!g1 in {
                bad = bad + chol.solve(0, mat(0, d, d, d, 1), contents(lr), vec1(0, d, 1), contents(br), vec1(0, d, 1), contents(g1));
            }
            borrow mut xgt as &!g2 in {
                bad = bad + chol.solve(1, mat(0, d, d, d, 1), contents(lr), vec1(0, d, 1), contents(br), vec1(0, d, 1), contents(g2));
            }
        }
    }
    borrow xw as &x in {
        borrow xg as &y in {
            bad = bad + lref.same_bits(contents(x), contents(y), d);
        }
    }
    borrow xwt as &x in {
        borrow xgt as &y in {
            bad = bad + lref.same_bits(contents(x), contents(y), d);
        }
    }
    unbox_slice(heap, a);
    unbox_slice(heap, ac);
    unbox_slice(heap, want);
    unbox_slice(heap, got);
    unbox_slice(heap, gotc);
    unbox_slice(heap, b);
    unbox_slice(heap, xw);
    unbox_slice(heap, xg);
    unbox_slice(heap, xwt);
    unbox_slice(heap, xgt);
    return bad;
}

fn test_chol_and_solves_every_small_d[&h](heap: &!h Heap) -> [heap] int {
    var bad = 0;
    var d = 1;
    while d <= 40 {
        bad = bad + one(heap, d, 100 + d, 0);
        bad = bad + one(heap, d, 300 + d, 1);
        d = d + 1;
    }
    return bad;
}

fn test_chol_larger[&h](heap: &!h Heap) -> [heap] int {
    var bad = 0;
    bad = bad + one(heap, 63, 7, 0);
    bad = bad + one(heap, 64, 8, 1);
    bad = bad + one(heap, 65, 9, 0);
    bad = bad + one(heap, 100, 10, 1);
    bad = bad + one(heap, 129, 11, 0);
    return bad;
}

fn test_chol_refusals[&h](heap: &!h Heap) -> [heap] int {
    var bad = 0;
    let a = box_slice(heap, 16, 0.0);
    let l = box_slice(heap, 16, 3.0);
    let b = box_slice(heap, 4, 1.0);
    let x = box_slice(heap, 4, 3.0);
    borrow mut a as &!aw in {
        let s = contents(aw);
        // [[1, 2], [2, 1]]: second pivot 1 - 4 < 0
        s[0] = 1.0;
        s[1] = 2.0;
        s[4] = 2.0;
        s[5] = 1.0;
    }
    borrow a as &ar in {
        borrow mut l as &!lw in {
            if chol.cholesky(mat(0, 2, 2, 4, 1), contents(ar), mat(0, 2, 2, 4, 1), contents(lw)) != refuse.not_positive_definite() {
                bad = bad + 1;
            }
            // a zero first pivot, and NaN
            if chol.cholesky(mat(10, 1, 1, 4, 1), contents(ar), mat(0, 1, 1, 4, 1), contents(lw)) != refuse.not_positive_definite() {
                bad = bad + 1;
            }
            contents(lw)[0] = 0.0 / 0.0;
            // shape and bounds
            if chol.cholesky(mat(0, 2, 3, 4, 1), contents(ar), mat(0, 2, 3, 4, 1), contents(lw)) != refuse.tensor_shape() {
                bad = bad + 1;
            }
            if chol.cholesky(mat(0, 5, 5, 5, 1), contents(ar), mat(0, 5, 5, 5, 1), contents(lw)) != refuse.tensor_bounds() {
                bad = bad + 1;
            }
            if chol.cholesky(mat(0, 4, 4, 4, 1), contents(ar), mat(0, 4, 4, 0, 1), contents(lw)) != refuse.tensor_shape() {
                bad = bad + 1;
            }
            // solves: zero diagonal is singular, and nothing is written
            contents(lw)[0] = 2.0;
            contents(lw)[5] = 0.0;
            borrow b as &br in {
                borrow mut x as &!xw in {
                    if chol.solve(0, mat(0, 2, 2, 4, 1), contents(lw), vec1(0, 2, 1), contents(br), vec1(0, 2, 1), contents(xw)) != refuse.singular() {
                        bad = bad + 1;
                    }
                    if contents(xw)[0] != 3.0 {
                        bad = bad + 1;
                    }
                    contents(lw)[5] = 0.0 / 0.0;
                    if chol.solve(1, mat(0, 2, 2, 4, 1), contents(lw), vec1(0, 2, 1), contents(br), vec1(0, 2, 1), contents(xw)) != 0 {
                        bad = bad + 1;
                    }
                    if chol.solve(0, mat(0, 2, 3, 4, 1), contents(lw), vec1(0, 2, 1), contents(br), vec1(0, 2, 1), contents(xw)) != refuse.tensor_shape() {
                        bad = bad + 1;
                    }
                    if chol.solve(0, mat(0, 2, 2, 4, 1), contents(lw), vec1(0, 3, 1), contents(br), vec1(0, 2, 1), contents(xw)) != refuse.tensor_shape() {
                        bad = bad + 1;
                    }
                }
            }
        }
    }
    unbox_slice(heap, a);
    unbox_slice(heap, l);
    unbox_slice(heap, b);
    unbox_slice(heap, x);
    return bad;
}
