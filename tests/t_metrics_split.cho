import std.test;
import ml.rng;
import metrics.rules;
import metrics.splits;
import mt;

// properties of the splits (docs/metrics.md gates S2 and S3). The equality with an independent implementation of the spec is
// scripts/oracle_metrics.py --splits; these tests hold what must be true whatever the draws are. A test answers 0 to pass.

fn same_ints[&a, &b](x: &a [int], y: &b [int], n: int) -> [] bool {
    var i = 0;
    while i < n {
        if x[i] != y[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// every row in exactly one fold; fold f has n div k + (1 if f < n mod k) rows (so the larger folds come first)
fn kfold_ok[&h](heap: &!h Heap, n: int, k: int, seed: int, rep: int) -> [heap] int {
    var bad = 0;
    var out = box_slice(heap, n + 1, 0 - 1);
    var again = box_slice(heap, n + 1, 0 - 1);
    borrow mut out as &!ow in {
        borrow mut again as &!aw in {
            if splits.kfold(heap, n, k, seed, rep, 1000000, contents(ow)[0..n]) != 0 {
                bad = bad + 1;
            }
            if splits.kfold(heap, n, k, seed, rep, 1000000, contents(aw)[0..n]) != 0 {
                bad = bad + 1;
            }
            if same_ints(contents(ow), contents(aw), n) == false {
                bad = bad + 1;
            }
            var cnt = box_slice(heap, k + 1, 0);
            borrow mut cnt as &!cw in {
                var i = 0;
                while i < n {
                    let f = contents(ow)[i];
                    if f < 0 || f >= k {
                        bad = bad + 1;
                    } else {
                        contents(cw)[f] = contents(cw)[f] + 1;
                    }
                    i = i + 1;
                }
                var f = 0;
                while f < k {
                    var want = n / k;
                    if f < n % k {
                        want = want + 1;
                    }
                    if contents(cw)[f] != want {
                        bad = bad + 1;
                    }
                    f = f + 1;
                }
            }
            unbox_slice(heap, cnt);
        }
    }
    unbox_slice(heap, out);
    unbox_slice(heap, again);
    return bad;
}

fn test_kfold_sizes_and_membership[&h](heap: &!h Heap) -> [heap] int {
    var bad = 0;
    var n = 2;
    while n < 70 {
        var k = 2;
        while k <= n {
            bad = bad + kfold_ok(heap, n, k, n * 31 + k, n % 3);
            k = k + 1;
        }
        n = n + 1;
    }
    bad = bad + kfold_ok(heap, 1000, 7, 5, 0);
    bad = bad + kfold_ok(heap, 1001, 10, 6, 1);
    bad = bad + kfold_ok(heap, 5000, 1000, 6, 1);
    return bad;
}

fn test_train_test_has_n_test_rows[&h](heap: &!h Heap) -> [heap] int {
    var bad = 0;
    var n = 2;
    while n < 60 {
        var t = 1;
        while t < n {
            var out = box_slice(heap, n + 1, 0 - 1);
            borrow mut out as &!ow in {
                if splits.train_test(heap, n, t, n + t, 2, 1000, contents(ow)[0..n]) != 0 {
                    bad = bad + 1;
                }
                var ones = 0;
                var i = 0;
                while i < n {
                    if contents(ow)[i] == 1 {
                        ones = ones + 1;
                    } else if contents(ow)[i] != 0 {
                        bad = bad + 1;
                    }
                    i = i + 1;
                }
                if ones != t {
                    bad = bad + 1;
                }
            }
            unbox_slice(heap, out);
            t = t + 1;
        }
        n = n + 1;
    }
    return bad;
}

// the fraction rule: ceil(n * num / den)
fn test_test_size_from_a_fraction() -> [] int {
    var bad = 0;
    if splits.n_test_for(10, 1, 4) != 3 {
        bad = bad + 1;
    }
    if splits.n_test_for(10, 1, 5) != 2 {
        bad = bad + 1;
    }
    if splits.n_test_for(7, 1, 3) != 3 {
        bad = bad + 1;
    }
    if splits.n_test_for(1000000, 1, 3) != 333334 {
        bad = bad + 1;
    }
    if splits.n_test_for(10, 0, 4) != 0 - 1 || splits.n_test_for(10, 4, 4) != 0 - 1 || splits.n_test_for(0, 1, 4) != 0 - 1 || splits.n_test_for(10, 1, 1000001) != 0 - 1 {
        bad = bad + 1;
    }
    return bad;
}

// stratified: per class and per fold the count is floor or ceil of n_c / k; fold sizes floor or ceil of n / k
fn strat_ok[&h](heap: &!h Heap, n: int, pm: int, k: int, seed: int, rep: int, lo: int, hi: int) -> [heap] int {
    var bad = 0;
    var lab = box_slice(heap, n + 1, 0);
    var out = box_slice(heap, n + 1, 0 - 1);
    var n1 = 0;
    borrow mut lab as &!lw in {
        var i = 0;
        while i < n {
            let z = rng.mix(wrapping_add(seed, wrapping_mul(i + 1, rng.gold())));
            if (z >> 1 & 9223372036854775807) % 1000 < pm {
                contents(lw)[i] = hi;
                n1 = n1 + 1;
            } else {
                contents(lw)[i] = lo;
            }
            i = i + 1;
        }
    }
    let n0 = n - n1;
    if n0 < k || n1 < k {
        unbox_slice(heap, lab);
        unbox_slice(heap, out);
        return 0;
    }
    borrow lab as &lr in {
        borrow mut out as &!ow in {
            if splits.stratified(heap, contents(lr)[0..n], k, seed, rep, 1000000, contents(ow)[0..n]) != 0 {
                bad = bad + 1;
            }
            var c0 = box_slice(heap, k + 1, 0);
            var c1 = box_slice(heap, k + 1, 0);
            borrow mut c0 as &!c0w in {
                borrow mut c1 as &!c1w in {
                    var i = 0;
                    while i < n {
                        let f = contents(ow)[i];
                        if f < 0 || f >= k {
                            bad = bad + 1;
                        } else if contents(lr)[i] == lo {
                            contents(c0w)[f] = contents(c0w)[f] + 1;
                        } else {
                            contents(c1w)[f] = contents(c1w)[f] + 1;
                        }
                        i = i + 1;
                    }
                    var f = 0;
                    while f < k {
                        let a = contents(c0w)[f];
                        let b = contents(c1w)[f];
                        if a < n0 / k || a > (n0 + k - 1) / k || b < n1 / k || b > (n1 + k - 1) / k {
                            bad = bad + 1;
                        }
                        if a + b < n / k || a + b > (n + k - 1) / k {
                            bad = bad + 1;
                        }
                        f = f + 1;
                    }
                }
            }
            unbox_slice(heap, c0);
            unbox_slice(heap, c1);
        }
    }
    unbox_slice(heap, lab);
    unbox_slice(heap, out);
    return bad;
}

fn test_stratified_balance[&h](heap: &!h Heap) -> [heap] int {
    var bad = 0;
    var n = 4;
    while n < 90 {
        var k = 2;
        while k < 9 {
            bad = bad + strat_ok(heap, n, 300, k, n * 7 + k, 0, 0, 1);
            bad = bad + strat_ok(heap, n, 500, k, n * 7 + k, 1, 0, 1);
            bad = bad + strat_ok(heap, n, 850, k, n * 5 + k, 2, 3, 9);
            k = k + 1;
        }
        n = n + 1;
    }
    bad = bad + strat_ok(heap, 3000, 100, 10, 1, 0, 0, 1);
    bad = bad + strat_ok(heap, 3001, 400, 7, 2, 0, 0 - 4, 4);
    return bad;
}

// no shared state: repeat 3 computed before or after repeat 1 gives the same bytes
fn test_repeats_are_independent_of_call_order[&h](heap: &!h Heap) -> [heap] int {
    var bad = 0;
    let n = 200;
    var a1 = box_slice(heap, n + 1, 0);
    var a3 = box_slice(heap, n + 1, 0);
    var b1 = box_slice(heap, n + 1, 0);
    var b3 = box_slice(heap, n + 1, 0);
    borrow mut a1 as &!a1w in {
        borrow mut a3 as &!a3w in {
            borrow mut b1 as &!b1w in {
                borrow mut b3 as &!b3w in {
                    splits.kfold(heap, n, 5, 9, 1, 1000, contents(a1w)[0..n]);
                    splits.kfold(heap, n, 5, 9, 3, 1000, contents(a3w)[0..n]);
                    splits.kfold(heap, n, 5, 9, 3, 1000, contents(b3w)[0..n]);
                    splits.kfold(heap, n, 5, 9, 1, 1000, contents(b1w)[0..n]);
                    if same_ints(contents(a1w), contents(b1w), n) == false || same_ints(contents(a3w), contents(b3w), n) == false {
                        bad = bad + 1;
                    }
                    // and different repeats, seeds and kinds really differ
                    if same_ints(contents(a1w), contents(a3w), n) {
                        bad = bad + 1;
                    }
                    splits.kfold(heap, n, 5, 10, 1, 1000, contents(b1w)[0..n]);
                    if same_ints(contents(a1w), contents(b1w), n) {
                        bad = bad + 1;
                    }
                    splits.train_test(heap, n, 40, 9, 1, 1000, contents(b1w)[0..n]);
                    var ones = 0;
                    var i = 0;
                    while i < n {
                        if contents(b1w)[i] == 1 && contents(a1w)[i] == 0 {
                            ones = ones + 1;
                        }
                        i = i + 1;
                    }
                    if ones == 0 {
                        bad = bad + 1;
                    }
                }
            }
        }
    }
    unbox_slice(heap, a1);
    unbox_slice(heap, a3);
    unbox_slice(heap, b1);
    unbox_slice(heap, b3);
    return bad;
}

// S3: the accepted values are a multiple of m, and no more than m values are lost
fn test_bounded_draw_is_unbiased_by_construction() -> [] int {
    var bad = 0;
    var m = 2;
    var step = 1;
    let top = 9223372036854775807;
    while m < 4611686018427387903 {
        let lim = splits.reject_limit(m);
        // limit + 1 values 0 .. limit are accepted: limit + 1 = 0 mod m, i.e. limit mod m = m - 1
        if lim % m != m - 1 {
            bad = bad + 1;
        }
        // and the loss top - limit is less than m
        if top - lim >= m {
            bad = bad + 1;
        }
        m = m + step;
        if m > 5000 {
            step = step * 2 + 1;
        }
    }
    // powers of two reject nothing; 2^62 + 1 rejects about half
    if splits.reject_limit(4096) != top || splits.reject_limit(2) != top {
        bad = bad + 1;
    }
    if splits.reject_limit(4611686018427387905) != top - 4611686018427387903 {
        bad = bad + 1;
    }
    return bad;
}

fn test_bounded_stays_in_range() -> [] int {
    var bad = 0;
    var s = 12345;
    var i = 0;
    while i < 3000 {
        let m = 2 + i % 97;
        let (v, s2) = splits.bounded(s, m);
        s = s2;
        if v < 0 || v >= m {
            bad = bad + 1;
        }
        i = i + 1;
    }
    // the stream advances one draw per call when nothing is rejected: the state after one call is the state after one advance
    let (v1, s1) = splits.bounded(77, 10);
    if s1 != rng.advance(77) || v1 != (rng.output(rng.advance(77)) >> 1 & 9223372036854775807) % 10 {
        bad = bad + 1;
    }
    return bad;
}

// S1 part: the stream name is derive(derive(seed, kind), index); three vectors written in docs/metrics.md
fn test_stream_names() -> [] int {
    var bad = 0;
    if splits.stream(42, 5, 0) != rng.derive(rng.derive(42, 5), 0) {
        bad = bad + 1;
    }
    if splits.stream(42, 5, 0) == splits.stream(42, 4, 0) || splits.stream(42, 5, 0) == splits.stream(42, 5, 1) || splits.stream(42, 5, 0) == splits.stream(43, 5, 0) {
        bad = bad + 1;
    }
    // derive(derive(42, 4), 0) = f94f852667e9fcae (computed by scripts/oracle_metrics.py's derive; the kinds are the registry of docs/rng.md)
    let s = splits.stream(42, 4, 0);
    if s >> 32 & 0xFFFFFFFF != 0xf94f8526 || s & 0xFFFFFFFF != 0x67e9fcae {
        bad = bad + 1;
    }
    if splits.kind_train_test() != 4 || splits.kind_kfold() != 5 || splits.kind_stratified() != 6 {
        bad = bad + 1;
    }
    return bad;
}

fn test_fold_boundaries() -> [] int {
    var bad = 0;
    // n = 10, k = 3: sizes 4, 3, 3; starts 0, 4, 7, end 10
    if splits.fold_start(10, 3, 0) != 0 || splits.fold_start(10, 3, 1) != 4 || splits.fold_start(10, 3, 2) != 7 || splits.fold_start(10, 3, 3) != 10 {
        bad = bad + 1;
    }
    // n = 12, k = 4: even
    if splits.fold_start(12, 4, 1) != 3 || splits.fold_start(12, 4, 4) != 12 {
        bad = bad + 1;
    }
    // n = 5, k = 5
    if splits.fold_start(5, 5, 4) != 4 || splits.fold_start(5, 5, 5) != 5 {
        bad = bad + 1;
    }
    return bad;
}

// the threshold itself: streams built with the inverse of the SplitMix64 finaliser so that the first draw is EXACTLY the largest
// accepted value (kept), and exactly one above it (rejected, so a second draw is consumed). m = 2^63 - 1 has limit 2^63 - 2.
fn test_bounded_at_the_threshold() -> [] int {
    var bad = 0;
    let m = 9223372036854775807;
    let (v1, s1) = splits.bounded(7257538407534371759, m);
    if v1 != 9223372036854775806 || s1 != rng.advance(7257538407534371759) {
        bad = bad + 1;
    }
    let (v2, s2) = splits.bounded(5697289922173604375, m);
    if s2 != rng.advance(rng.advance(5697289922173604375)) {
        bad = bad + 1;
    }
    if v2 != (rng.output(s2) >> 1 & 9223372036854775807) % m {
        bad = bad + 1;
    }
    return bad;
}

// the cap is inclusive: n = cap is allowed, n = cap + 1 is not
fn test_cap_is_inclusive[&h](heap: &!h Heap) -> [heap] int {
    var bad = 0;
    var out = box_slice(heap, 101, 0);
    borrow mut out as &!ow in {
        if splits.kfold(heap, 100, 2, 1, 0, 100, contents(ow)[0..100]) != 0 {
            bad = bad + 1;
        }
        if splits.kfold(heap, 100, 2, 1, 0, 99, contents(ow)[0..100]) != rules.too_many_rows() {
            bad = bad + 1;
        }
        if splits.train_test(heap, 100, 10, 1, 0, 100, contents(ow)[0..100]) != 0 {
            bad = bad + 1;
        }
        if splits.train_test(heap, 100, 10, 1, 0, 99, contents(ow)[0..100]) != rules.too_many_rows() {
            bad = bad + 1;
        }
        // the largest legal cap and one above
        if splits.kfold(heap, 100, 2, 1, 0, 1073741824, contents(ow)[0..100]) != 0 {
            bad = bad + 1;
        }
        if splits.kfold(heap, 100, 2, 1, 0, 1073741825, contents(ow)[0..100]) != rules.out_of_range() {
            bad = bad + 1;
        }
        // k = n is allowed (every fold one row); k = n + 1 is not
        if splits.kfold(heap, 100, 100, 1, 0, 100, contents(ow)[0..100]) != 0 {
            bad = bad + 1;
        }
        if splits.kfold(heap, 100, 101, 1, 0, 100, contents(ow)[0..100]) != rules.empty_fold() {
            bad = bad + 1;
        }
        // n_test = n - 1 is allowed
        if splits.train_test(heap, 100, 99, 1, 0, 100, contents(ow)[0..100]) != 0 {
            bad = bad + 1;
        }
        if splits.train_test(heap, 100, 100, 1, 0, 100, contents(ow)[0..100]) != rules.empty_fold() {
            bad = bad + 1;
        }
    }
    unbox_slice(heap, out);
    return bad;
}
