import std.test;
import std.buffer;
import std.bytes;
import ml.exact;

// tests of lib/core/exact.cho (scripts/check.sh). Expected values are computed with Python integers and Fractions. A test
// answers 0 to pass.

fn test_mean_small() -> [] int {
    var bad = 0;
    if exact.mean_scaled(0, 10, 4) != 2500000 {
        bad = bad + 1;
    }
    if exact.mean_scaled(0, 0 - 10, 4) != 0 - 2500000 {
        bad = bad + 1;
    }
    if exact.mean_scaled(0, 7, 3) != 2333333 {
        bad = bad + 1;
    }
    if exact.mean_scaled(0, 0 - 7, 3) != 0 - 2333333 {
        bad = bad + 1;
    }
    if exact.mean_scaled(0, 5, 2) != 2500000 {
        bad = bad + 1;
    }
    if exact.mean_scaled(0, 0, 5) != 0 {
        bad = bad + 1;
    }
    return bad;
}

fn test_mean_large() -> [] int {
    var bad = 0;
    if exact.mean_scaled(2999, 999999997, 3) != 999999999999000000 {
        bad = bad + 1;
    }
    if exact.mean_scaled(0 - 1000000000, 0, 1000000) != 0 - 1000000000000000000 {
        bad = bad + 1;
    }
    if exact.mean_scaled(2000, 0, 3) != 666666666666666667 {
        bad = bad + 1;
    }
    return bad;
}

// the remainder sum has not been carried: sq = 4995, sr = 4999999995 is T = 4999999999995
fn test_mean_uncarried() -> [] int {
    var bad = 0;
    if exact.mean_scaled(4995, 4999999995, 5) != 999999999999000000 {
        bad = bad + 1;
    }
    if exact.mean_scaled(0 - 4995, 0 - 4999999995, 5) != 0 - 999999999999000000 {
        bad = bad + 1;
    }
    // opposite signs: 4000 * 1e9 - 3 = 3999999999997 over 3
    if exact.mean_scaled(4000, 0 - 3, 3) != 1333333333332333333 {
        bad = bad + 1;
    }
    return bad;
}

fn test_fraction() -> [] int {
    var bad = 0;
    if exact.fraction_scaled(1, 3) != 333333 {
        bad = bad + 1;
    }
    if exact.fraction_scaled(2, 3) != 666667 {
        bad = bad + 1;
    }
    if exact.fraction_scaled(0, 5) != 0 {
        bad = bad + 1;
    }
    if exact.fraction_scaled(5, 5) != 1000000 {
        bad = bad + 1;
    }
    if exact.fraction_scaled(1, 2000000) != 1 {
        bad = bad + 1;
    }
    return bad;
}

fn test_sum_add() -> [] int {
    var bad = 0;
    region a {
        let acc = alloc_slice[a](2, 0);
        exact.sum_add(acc, 0, 999999999999);
        exact.sum_add(acc, 0, 999999999999);
        exact.sum_add(acc, 0, 0 - 5);
        // 2 * 999999999999 - 5 = 1999999999993 = 1999 * 1e9 + 999999993
        if acc[0] * 1000000000 + acc[1] != 1999999999993 {
            bad = bad + 1;
        }
        if acc[0] != 1998 {
            bad = bad + 1;
        }
    }
    return bad;
}

fn test_squares() -> [] int {
    var bad = 0;
    region a {
        let acc = alloc_slice[a](6, 0);
        exact.square_add(acc, 0, 1999999999999999999);
        exact.square_add(acc, 0, 0 - 1999999999999999999);
        exact.square_add(acc, 0, 3);
        exact.square_add(acc, 0, 0 - 7);
        exact.square_add(acc, 0, 1000000000);
        exact.square_add(acc, 0, 999999999);
        exact.normalise(acc, 0);
        if acc[0] != 61 || acc[1] != 999999998 || acc[2] != 999999993 || acc[3] != 999999999 || acc[4] != 7 || acc[5] != 0 {
            bad = bad + 1;
        }
    }
    return bad;
}

fn test_square_text[&h](heap: &!h Heap) -> [heap] int {
    var bad = 0;
    region a {
        let acc = alloc_slice[a](6, 0);
        acc[0] = 61;
        acc[1] = 999999998;
        acc[2] = 999999993;
        acc[3] = 999999999;
        acc[4] = 7;
        var out = buffer.empty(heap, 64);
        out = exact.limbs_digits(heap, out, acc, 0);
        borrow out as &r in {
            if !bytes.equal(buffer.bytes(r), "7999999999999999993999999998000000061") {
                bad = bad + 1;
            }
        }
        buffer.drop(heap, out);
    }
    return bad;
}
