import std.test;
import std.buffer;
import ml.rng;
import ml.matrix;
import transforms.codes;
import transforms.steps;
import transforms.fit;
import transforms.apply;
import pt;

// Gates X6 (docs/transforms.md): hostile matrices, parameters, column lists and caps through fit, apply and the record decoder; no call may trap, every
// answer is a code of transforms.codes, and the fuzz must also REACH the value paths (it fails if too few fits succeed). A trap ends the test binary,
// so "passes" means no trap. A test answers 0 to pass. (Build line: the one of t_transforms.cho.)

fn d(seed: int, i: int, m: int) -> [] int {
    return rng.uniform(rng.derive(seed, i), m);
}

fn hostile(z: int) -> [] float {
    let k = z % 16;
    if k == 0 {
        return 0.0;
    }
    if k == 1 {
        return 1.0;
    }
    if k == 2 {
        return 0.0 - 1.0;
    }
    if k == 3 {
        return 1.7976931348623157e308;
    }
    if k == 4 {
        return 0.0 - 1.7976931348623157e308;
    }
    if k == 5 {
        return 5.0e-324;
    }
    if k == 6 {
        return 1.0e-300;
    }
    if k == 7 {
        return 0.0 / 0.0;
    }
    if k == 8 {
        return 1.0 / 0.0;
    }
    if k == 9 {
        return 0.0 - 1.0 / 0.0;
    }
    if k == 10 {
        return 0.1;
    }
    if k == 11 {
        return 3.0;
    }
    if k == 12 {
        return 2.5;
    }
    return rng.unit(rng.mix(z)) * 100.0;
}

// a matrix of rows x cols from the seed: mode 0 clean values with ties, 1 hostile values, and some columns missing entirely
fn rand_matrix[&h](heap: &!h Heap, seed: int, rows: int, cols: int, hostile_mode: bool, holes: bool) -> [heap] matrix.Matrix {
    if rows == 0 {
        return matrix.empty(heap);
    }
    let (m0, code) = matrix.make(heap, rows, cols, 1000, 64, 100000);
    if code != 0 {
        return m0;
    }
    let (t, data, miss, r, c, wpc) = matrix.parts(m0);
    var dd = data;
    var mm = miss;
    borrow mut dd as &!dw in {
        borrow mut mm as &!mw in {
            var j = 0;
            while j < c {
                let allmiss = holes && d(seed, 100 + j, 30) == 0;
                var i = 0;
                while i < r {
                    if allmiss || holes && d(seed, 1000 + i * 64 + j, 7) == 0 {
                        matrix.mark_missing(contents(mw), wpc, i, j);
                    } else if hostile_mode {
                        matrix.put(contents(dw), c, i, j, hostile(d(seed, 5000 + i * 64 + j, 1000)));
                    } else {
                        matrix.put(contents(dw), c, i, j, float_of(d(seed, 5000 + i * 64 + j, 6)) / 2.0);
                    }
                    i = i + 1;
                }
                j = j + 1;
            }
        }
    }
    return matrix.assemble(t, dd, mm, r, c, wpc);
}

fn in_band(code: int) -> [] bool {
    return code == 0 || code >= codes.first() && code <= codes.last();
}

fn test_fuzz_fit_apply_and_the_records[&h](heap: &!h Heap) -> [heap] int {
    var bad = 0;
    var b1 = 0;
    var b2 = 0;
    var b3 = 0;
    var b4 = 0;
    var b5 = 0;
    var b6 = 0;
    var fitted = 0;
    var refused = 0;
    var applied = 0;
    var damaged_ok = 0;
    var damaged_bad = 0;
    var round = 0;
    while round < 3000 {
        let seed = round * 7919 + 13;
        let rows = d(seed, 0, 41);
        let cols = 1 + d(seed, 1, 6);
        let x = rand_matrix(heap, seed, rows, cols, round % 7 == 0, true);
        let t = rand_matrix(heap, seed + 1, d(seed, 9, 12) + 1, cols, round % 5 == 0, true);
        // a valid kind with valid parameters nine times in ten
        var kind = 1 + d(seed, 2, 6);
        var pa = 0;
        var pb = 0;
        if kind == 1 {
            pa = d(seed, 3, 3);
        } else if kind == 3 || kind == 4 || kind == 5 {
            pa = d(seed, 3, 2);
        } else if kind == 6 {
            pa = d(seed, 3, 2);
        }
        if kind == 4 || kind == 5 {
            pb = 1 + d(seed, 4, 70);
        } else if kind == 6 {
            pb = 2 + d(seed, 4, 20);
        }
        if d(seed, 11, 10) == 0 {
            kind = d(seed, 12, 9);
            pa = d(seed, 3, 5) - 1;
            pb = d(seed, 4, 300) - 10;
        }
        let sp = fit.Spec { kind: kind, a: pa, b: pb, value: hostile(d(seed, 6, 1000)) };
        let k = d(seed, 5, cols + 2);
        let cb = box_slice(heap, k + 1, 0);
        var cw = cb;
        borrow mut cw as &!w in {
            var i = 0;
            while i < k {
                // mostly ascending valid columns, sometimes anything
                if d(seed, 20 + i, 12) == 0 {
                    contents(w)[i] = d(seed, 40 + i, cols + 3) - 1;
                } else {
                    contents(w)[i] = i;
                }
                i = i + 1;
            }
        }
        borrow cw as &cr in {
            borrow x as &xr in {
                let (st, f) = fit.fit(heap, sp, xr, contents(cr)[0..k], 1);
                if !in_band(f.code) {
                    b1 = b1 + 1;
                }
                if f.code == 0 {
                    fitted = fitted + 1;
                    borrow st as &sr in {
                        var o = buffer.empty(heap, 16);
                        o = steps.encode_payload(heap, o, sr);
                        borrow o as &orr in {
                            let bytes = buffer.bytes(orr);
                            let (dd, c2, wd) = steps.decode(heap, bytes, cols);
                            if c2 != 0 {
                                b2 = b2 + 1;
                            }
                            steps.drop(heap, dd);
                            // apply to a matrix of the right width, with caps from the hostile set
                            borrow t as &tr in {
                                var cap = 100;
                                if d(seed, 7, 4) == 0 {
                                    cap = d(seed, 8, 5);
                                }
                                let (y, u, f2) = apply.apply(heap, sr, tr, 1, 1000, cap, 100000);
                                if !in_band(f2.code) {
                                    b3 = b3 + 1;
                                }
                                if f2.code == 0 {
                                    applied = applied + 1;
                                }
                                matrix.drop(heap, y);
                                // and to a matrix of another width
                                let w2 = rand_matrix(heap, seed + 2, 3, cols + 1, true, true);
                                borrow w2 as &w2r in {
                                    let (y2, u2, f3) = apply.apply(heap, sr, w2r, 1, 1000, 100, 100000);
                                    if f3.code == 0 || !in_band(f3.code) {
                                        b4 = b4 + 1;
                                    }
                                    matrix.drop(heap, y2);
                                }
                                matrix.drop(heap, w2);
                            }
                            // damage the bytes: a flip, a truncation, a hostile 8-byte field; decode must not trap, and an accepted step must apply
                            var tries = 0;
                            while tries < 12 {
                                let at = d(seed, 300 + tries, len(bytes));
                                let copy = box_slice(heap, len(bytes) + 9, byte_of(0));
                                var cp = copy;
                                borrow mut cp as &!cw2 in {
                                    var q = 0;
                                    while q < len(bytes) {
                                        contents(cw2)[q] = bytes[q];
                                        q = q + 1;
                                    }
                                    if tries % 3 == 0 {
                                        contents(cw2)[at] = byte_of(int_of(bytes[at]) ^ 1 << d(seed, 330 + tries, 8));
                                    } else if tries % 3 == 1 {
                                        // an 8-byte field set to a hostile int
                                        let hv = d(seed, 340 + tries, 7);
                                        var v = 0;
                                        if hv == 0 {
                                            v = 0 - 1;
                                        } else if hv == 1 {
                                            v = 1099511627776;
                                        } else if hv == 2 {
                                            v = 9223372036854775807;
                                        } else if hv == 3 {
                                            v = 0 - 9223372036854775807 - 1;
                                        } else if hv == 4 {
                                            v = 8192;
                                        } else if hv == 5 {
                                            v = 1;
                                        }
                                        if at + 8 <= len(bytes) {
                                            var q2 = 0;
                                            while q2 < 8 {
                                                contents(cw2)[at + q2] = byte_of(v >> 8 * q2 & 255);
                                                q2 = q2 + 1;
                                            }
                                        }
                                    }
                                }
                                var cut = len(bytes);
                                if tries % 3 == 2 {
                                    cut = at;
                                }
                                borrow cp as &cpr in {
                                    let (d2, c3, wd2) = steps.decode(heap, contents(cpr)[0..cut], cols);
                                    if !in_band(c3) {
                                        b5 = b5 + 1;
                                    }
                                    if c3 == 0 {
                                        damaged_ok = damaged_ok + 1;
                                        borrow d2 as &d2r in {
                                            borrow t as &tr in {
                                                let (y3, u3, f4) = apply.apply(heap, d2r, tr, 1, 1000, 100, 100000);
                                                if !in_band(f4.code) {
                                                    b6 = b6 + 1;
                                                }
                                                matrix.drop(heap, y3);
                                            }
                                        }
                                    } else {
                                        damaged_bad = damaged_bad + 1;
                                    }
                                    steps.drop(heap, d2);
                                }
                                unbox_slice(heap, cp);
                                tries = tries + 1;
                            }
                        }
                        buffer.drop(heap, o);
                    }
                } else {
                    refused = refused + 1;
                }
                steps.drop(heap, st);
            }
        }
        matrix.drop(heap, x);
        matrix.drop(heap, t);
        unbox_slice(heap, cw);
        round = round + 1;
    }
    // the fuzz must reach the value paths and the refusals
    // each failing class answers its own number
    if b1 > 0 {
        return 2;
    }
    if b2 > 0 {
        return 3;
    }
    if b3 > 0 {
        return 4;
    }
    if b4 > 0 {
        return 5;
    }
    if b5 > 0 {
        return 6;
    }
    if b6 > 0 {
        return 7;
    }
    if fitted < 800 {
        return 8;
    }
    if refused < 800 {
        return 9;
    }
    if applied < 300 {
        return 10;
    }
    if damaged_ok < 100 {
        return 11;
    }
    if damaged_bad < 1000 {
        return 12;
    }
    return bad;
}

// limits before allocation: a descriptor-free check -- an output wider than the cap, a huge bins or max-categories, many columns
fn test_limits_come_before_allocation[&h](heap: &!h Heap) -> [heap] int {
    var bad = 0;
    // 40 columns of 20 categories each: 800 columns out, a cap of 100 refuses before the output is allocated
    let x = rand_matrix(heap, 5, 40, 40, false, false);
    let cb = box_slice(heap, 40, 0);
    var cw = cb;
    borrow mut cw as &!w in {
        var i = 0;
        while i < 40 {
            contents(w)[i] = i;
            i = i + 1;
        }
    }
    borrow cw as &cr in {
        borrow x as &xr in {
            let (st, f) = fit.fit(heap, fit.Spec { kind: 4, a: 0, b: 1024, value: 0.0 }, xr, contents(cr), 1);
            if f.code != 0 {
                bad = bad + 1;
            }
            borrow st as &sr in {
                let (y, u, f2) = apply.apply(heap, sr, xr, 1, 1000, 63, 100000);
                if f2.code != codes.too_many_columns() {
                    bad = bad + 1;
                }
                matrix.drop(heap, y);
                let (y2, u2, f3) = apply.apply(heap, sr, xr, 1, 1000, 1000, 100);
                if f3.code != codes.too_many_cells() {
                    bad = bad + 1;
                }
                matrix.drop(heap, y2);
                // caps that no flag can set: zero, negative, beyond the ceilings
                let (y3, u3, f4) = apply.apply(heap, sr, xr, 0, 0 - 1, 100, 100000);
                if f4.code != codes.out_of_range() {
                    bad = bad + 1;
                }
                matrix.drop(heap, y3);
                let (y4, u4, f5) = apply.apply(heap, sr, xr, 0, 1000, 2147483648, 100000);
                if f5.code != codes.out_of_range() {
                    bad = bad + 1;
                }
                matrix.drop(heap, y4);
            }
            steps.drop(heap, st);
            // bins and max-categories over the ceilings
            let (s2, f6) = fit.fit(heap, fit.Spec { kind: 6, a: 0, b: 1000000000, value: 0.0 }, xr, contents(cr), 1);
            if f6.code != codes.out_of_range() {
                bad = bad + 1;
            }
            steps.drop(heap, s2);
            let (s3, f7) = fit.fit(heap, fit.Spec { kind: 4, a: 0, b: 1000000000, value: 0.0 }, xr, contents(cr), 1);
            if f7.code != codes.out_of_range() {
                bad = bad + 1;
            }
            steps.drop(heap, s3);
        }
    }
    matrix.drop(heap, x);
    unbox_slice(heap, cw);
    return bad;
}
