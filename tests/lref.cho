module lref;

import ml.rng;

// The reference implementations of docs/linalg.md section 2, written directly from the definitions with generic strided
// indexing and no tuning: block partials stored in an array and reduced level by level (NOT the stack the kernels use).
// Tests compare the kernels to these bit for bit.

pub fn k() -> [] int {
    return 256;
}

// level-wise tree over parts[0..m), in place; the result is parts[0]; m = 0 answers 0.0
pub fn tree[&p](parts: &!p [float], m0: int) -> [] float {
    var m = m0;
    if m == 0 {
        return 0.0;
    }
    while m > 1 {
        let h = m / 2;
        var i = 0;
        while i < h {
            parts[i] = parts[2 * i] + parts[2 * i + 1];
            i = i + 1;
        }
        if m % 2 == 1 {
            parts[h] = parts[m - 1];
            m = h + 1;
        } else {
            m = h;
        }
    }
    return parts[0];
}

// number of blocks of n terms
pub fn nblocks(n: int) -> [] int {
    if n <= 0 {
        return 0;
    }
    return (n + k() - 1) / k();
}

// dot of x[xo + i*xs] and y[yo + i*ys], i < n; parts is scratch of at least nblocks(n) elements
pub fn dot[&x, &y, &p](xd: &x [float], xo: int, xs: int, yd: &y [float], yo: int, ys: int, n: int, parts: &!p [float]) -> [] float {
    let nb = nblocks(n);
    var b = 0;
    while b < nb {
        var s = 0.0;
        var i = b * k();
        while i < n && i < (b + 1) * k() {
            s = s + xd[xo + i * xs] * yd[yo + i * ys];
            i = i + 1;
        }
        parts[b] = s;
        b = b + 1;
    }
    return tree(parts, nb);
}

// ---------------------------------------------------------------- test data

// mode 0: unit floats; mode 1: wide magnitudes with cancellation (each value times 2^(-60..60), signs mixed); mode 2: unit
// floats with about a third of the entries +0.0 or -0.0 and some subnormals; mode 3: all ones (exact sums)
pub fn gen[&o](out: &!o [float], n: int, seed: int, mode: int) -> [] int {
    var i = 0;
    while i < n {
        let z = rng.mix(wrapping_add(seed, wrapping_mul(i + 1, rng.gold())));
        var v = rng.unit(z);
        if mode == 1 {
            v = v * 1.0e18;
            if (z >> 3 & 3) == 0 {
                v = v * 0.0000000000000001;
            }
            if (z >> 5 & 7) == 0 {
                v = 0.0 - v * 1.0e-9;
            }
        }
        if mode == 2 {
            let q = (z >> 2) & 7;
            if q == 0 {
                v = 0.0;
            }
            if q == 1 {
                v = 0.0 - 0.0;
            }
            if q == 2 {
                v = v * 1.0e-310;
            }
        }
        if mode == 3 {
            v = 1.0;
        }
        out[i] = v;
        i = i + 1;
    }
    return 0;
}

pub fn same_bits[&a, &b](x: &a [float], y: &b [float], n: int) -> [] int {
    var bad = 0;
    var i = 0;
    while i < n {
        if bits_of(x[i]) != bits_of(y[i]) {
            bad = bad + 1;
        }
        i = i + 1;
    }
    return bad;
}

// ---------------------------------------------------------------- gemv references (definitions, generic strides)

// y_i = dot(X[i, :], w) for i < n; X[i, j] = xd[xo + i*rs + j*cs]
pub fn gemv_n[&x, &w, &y, &p](xd: &x [float], xo: int, rs: int, cs: int, wd: &w [float], wo: int, ws: int, n: int, d: int, out: &!y [float], parts: &!p [float]) -> [] int {
    var i = 0;
    while i < n {
        out[i] = dot(xd, xo + i * rs, cs, wd, wo, ws, d, parts);
        i = i + 1;
    }
    return 0;
}

// g_j = block rule + tree over i of X[i, j] * r[i]
pub fn gemv_t[&x, &r, &g, &p](xd: &x [float], xo: int, rs: int, cs: int, rd: &r [float], ro: int, rstr: int, n: int, d: int, out: &!g [float], parts: &!p [float]) -> [] int {
    var j = 0;
    while j < d {
        out[j] = dot(xd, xo + j * cs, rs, rd, ro, rstr, n, parts);
        j = j + 1;
    }
    return 0;
}

// C[j][k] (j <= k) = block rule + tree over rows i of X[i, j] * X[i, k]; out is d x d row-major, lower triangle untouched
pub fn syrk[&x, &c, &p](xd: &x [float], xo: int, rs: int, cs: int, n: int, d: int, out: &!c [float], parts: &!p [float]) -> [] int {
    var j = 0;
    while j < d {
        var k = j;
        while k < d {
            out[j * d + k] = dot(xd, xo + j * cs, rs, xd, xo + k * cs, rs, n, parts);
            k = k + 1;
        }
        j = j + 1;
    }
    return 0;
}

// ---------------------------------------------------------------- Cholesky and solves (definitions, generic strides)

// a symmetric, strictly diagonally dominant matrix (so positive definite): off-diagonal 0.5 * (E_ij + E_ji), diagonal d + 1 + E_ii
pub fn gen_spd[&o](out: &!o [float], d: int, seed: int, mode: int) -> [] int {
    var i = 0;
    while i < d {
        var j = 0;
        while j < d {
            if i == j {
                out[i * d + j] = float_of(d) + 1.0 + eelem(seed, i * d + j, mode);
            } else {
                out[i * d + j] = 0.5 * (eelem(seed, i * d + j, mode) + eelem(seed, j * d + i, mode));
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}

// element i of the data set (mode 0 only; the SPD matrices are always plain unit floats scaled by mode: mode 1 scales the
// off-diagonal by 2^k pattern to vary magnitudes while keeping dominance)
fn eelem(seed: int, i: int, mode: int) -> [] float {
    let z = rng.mix(wrapping_add(seed, wrapping_mul(i + 1, rng.gold())));
    var v = rng.unit(z);
    if mode == 1 {
        v = v * 0.001;
    }
    return v;
}

// L from A, entry by entry; returns 0 or 9 (not positive definite). L, A: d x d, element (i, j) at o + i*rs + j*cs
pub fn chol[&a, &l](ad: &a [float], ao: int, ars: int, acs: int, ld: &!l [float], lo: int, lrs: int, lcs: int, d: int) -> [] int {
    var j = 0;
    while j < d {
        var i = j;
        while i < d {
            var s = ad[ao + i * ars + j * acs];
            var k = 0;
            while k < j {
                let p = ld[lo + i * lrs + k * lcs] * ld[lo + j * lrs + k * lcs];
                s = s - p;
                k = k + 1;
            }
            if i == j {
                if !(s > 0.0) {
                    return 9;
                }
                ld[lo + i * lrs + j * lcs] = sqrt(s);
            } else {
                ld[lo + i * lrs + j * lcs] = s / ld[lo + j * lrs + j * lcs];
            }
            i = i + 1;
        }
        j = j + 1;
    }
    return 0;
}

// solve with the lower triangle of L: trans = 0 forward ascending k; otherwise L^T x = b with k descending from d - 1
pub fn solve[&l, &b, &x](trans: int, ld: &l [float], lo: int, lrs: int, lcs: int, bd: &b [float], xd: &!x [float], d: int) -> [] int {
    if trans == 0 {
        var i = 0;
        while i < d {
            var s = bd[i];
            var k = 0;
            while k < i {
                s = s - ld[lo + i * lrs + k * lcs] * xd[k];
                k = k + 1;
            }
            xd[i] = s / ld[lo + i * lrs + i * lcs];
            i = i + 1;
        }
        return 0;
    }
    var i = d - 1;
    while i >= 0 {
        var s = bd[i];
        var k = d - 1;
        while k > i {
            s = s - ld[lo + k * lrs + i * lcs] * xd[k];
            k = k - 1;
        }
        xd[i] = s / ld[lo + i * lrs + i * lcs];
        i = i - 1;
    }
    return 0;
}

// C[i][j] = dot of A[i, :] and B[:, j] (block rule + tree over k); A m x p, B p x n, C m x n row-major
pub fn gemm[&a, &b, &c, &p](ad: &a [float], ao: int, ars: int, acs: int, bd: &b [float], bo: int, brs: int, bcs: int, m: int, n: int, kk: int, out: &!c [float], parts: &!p [float]) -> [] int {
    var i = 0;
    while i < m {
        var j = 0;
        while j < n {
            out[i * n + j] = dot(ad, ao + i * ars, acs, bd, bo + j * bcs, brs, kk, parts);
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}
